# 직선 장판: {x,y,z,yaw,wd,l,hl(=l/2),hz(=l-wd/2),t,id}
$summon item_display $(x) $(y) $(z) {Tags:["bg","bg_tg","bgt_$(id)"],Rotation:[$(yaw)f,0f],item:{id:"minecraft:paper",count:1,components:{"minecraft:item_model":"bg:tele/rect_base","minecraft:custom_data":{flash:'rect_flash'}}},item_display:"none",brightness:{sky:15,block:15},view_range:4f,shadow_radius:0f,teleport_duration:2,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0.03f,$(hl)f],scale:[$(wd)f,1f,$(l)f]}}
$summon item_display $(x) $(y) $(z) {Tags:["bg","bg_tg","bgt_$(id)","bg_tg_grow"],Rotation:[$(yaw)f,0f],item:{id:"minecraft:paper",count:1,components:{"minecraft:item_model":"bg:tele/rect_fill","minecraft:custom_data":{kill:1b,gx:$(wd),gz:$(l),ty:0.04,tz:$(hl),t:$(t)}}},item_display:"none",brightness:{sky:15,block:15},view_range:4f,shadow_radius:0f,teleport_duration:2,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0.04f,0f],scale:[$(wd)f,1f,0.01f]}}
$summon item_display $(x) $(y) $(z) {Tags:["bg","bg_tg","bgt_$(id)"],Rotation:[$(yaw)f,0f],item:{id:"minecraft:paper",count:1,components:{"minecraft:item_model":"bg:tele/rect_head","minecraft:custom_data":{kill:1b}}},item_display:"none",brightness:{sky:15,block:15},view_range:4f,shadow_radius:0f,teleport_duration:2,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0.05f,$(hz)f],scale:[$(wd)f,1f,$(wd)f]}}
$scoreboard players set @e[tag=bgt_$(id)] bg_life $(t)
$scoreboard players set @e[tag=bgt_$(id)] bg_age 0
