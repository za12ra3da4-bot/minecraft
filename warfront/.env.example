# ---- server (server/.env or environment variables on your host) ----
# Port the game server listens on (Render/Railway/Fly set PORT automatically).
PORT=3001
# Comma separated list of allowed browser origins, e.g. https://warfront.vercel.app
# Leave empty to allow any origin.
CLIENT_ORIGIN=
# Optional: absolute path of the built client to serve from the game server.
CLIENT_DIST=

# ---- client (client/.env, read at build time by Vite) ----
# URL of the game server when the client is hosted separately (e.g. Vercel).
# Leave empty when the server also serves the client (same origin).
VITE_SERVER_URL=
