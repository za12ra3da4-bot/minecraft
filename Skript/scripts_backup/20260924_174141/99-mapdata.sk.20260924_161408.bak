# =====================================================================================
#  신들의 전쟁: 올림포스  /  99-mapdata.sk  -  맵 좌표 데이터 (자동 생성)
# -------------------------------------------------------------------------------------
#  ★ 직접 고치지 말 것. mc-olympus/mapgen/generate.py 가 맵과 함께 다시 만든다.
#  의존: 00-config, 01-data   (그 외 모듈의 함수는 부르지 않고 변수로만 넘긴다)
#
#  등록하는 변수
#    {oly::tlist::*} {oly::t::<tid>::name/type/home/owner/center}  + 청크 인덱스
#    {oly::clist::*} {oly::c::<cid>::name/capital/owner/home/terr/center/capture/spawn/gate::a/gate::b/altar}
#    {oly::map::spawn::<fid>}  {oly::map::temple::<id>}  {oly::map::lair::<id>::spawn/entrance/radius/name}
#    {oly::map::port::<id>}  {oly::map::olympus::seal::a/b}  {oly::map::tp::<이름>}
#
#  관리자 명령:  /olymap reload | tp <장소> | list | here
#  맵 버전: 8b2d32abf3
# =====================================================================================

on load:
    olyModReady("mapdata")
    if {oly::map::ver} is not "8b2d32abf3":
        olyMapLoad()

function olyMapLoc(x: number, y: number, z: number) :: location:
    return location({_x} + 0.5, {_y}, {_z} + 0.5, world("world"))

function olyMapClear():
    loop {oly::tlist::*}:
        olyTerrUnbindAll(loop-value)
    delete {oly::t::*}
    delete {oly::tlist::*}
    delete {oly::c::*}
    delete {oly::clist::*}
    delete {oly::idx::chunk::*}
    delete {oly::map::*}

function olyMapTerr(tid: text, name: text, type: text, home: text, center: location):
    if {oly::tlist::*} does not contain {_tid}:
        add {_tid} to {oly::tlist::*}
    set {oly::t::%{_tid}%::name} to {_name}
    set {oly::t::%{_tid}%::type} to {_type}
    set {oly::t::%{_tid}%::home} to {_home}
    set {oly::t::%{_tid}%::owner} to {_home}
    set {oly::t::%{_tid}%::center} to {_center}

# ── 'cz,x0,x1;cz,x0,x1' 형식의 청크 행을 영토에 묶는다
function olyMapRows(tid: text, rows: text):
    set {_r::*} to {_rows} split at ";"
    loop {_r::*}:
        set {_p::*} to loop-value split at ","
        set {_cz} to {_p::1} parsed as number
        set {_a} to {_p::2} parsed as number
        set {_b} to {_p::3} parsed as number
        loop integers between {_a} and {_b}:
            olyTerrBind({_tid}, "world", loop-value-2, {_cz})

function olyMapCity(cid: text, name: text, capital: boolean, home: text, terr: text, center: location, capture: location, spawn: location, ga: location, gb: location):
    if {oly::clist::*} does not contain {_cid}:
        add {_cid} to {oly::clist::*}
    set {oly::c::%{_cid}%::name} to {_name}
    set {oly::c::%{_cid}%::capital} to {_capital}
    set {oly::c::%{_cid}%::home} to {_home}
    set {oly::c::%{_cid}%::owner} to {_home}
    set {oly::c::%{_cid}%::terr} to {_terr}
    set {oly::c::%{_cid}%::center} to {_center}
    set {oly::c::%{_cid}%::capture} to {_capture}
    set {oly::c::%{_cid}%::spawn} to {_spawn}
    set {oly::c::%{_cid}%::gate::a} to {_ga}
    set {oly::c::%{_cid}%::gate::b} to {_gb}
    set {oly::c::%{_cid}%::level} to 1
    set {oly::t::%{_terr}%::city} to {_cid}
    set {oly::map::tp::%{_cid}%} to {_spawn}

function olyMapLair(id: text, name: text, spawn: location, entrance: location, radius: number):
    set {oly::map::lair::%{_id}%::name} to {_name}
    set {oly::map::lair::%{_id}%::spawn} to {_spawn}
    set {oly::map::lair::%{_id}%::entrance} to {_entrance}
    set {oly::map::lair::%{_id}%::radius} to {_radius}
    set {oly::map::tp::%{_id}%} to {_entrance}

