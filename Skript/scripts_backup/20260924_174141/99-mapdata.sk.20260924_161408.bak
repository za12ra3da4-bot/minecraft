    # ── 항구
    set {oly::map::port::piraeus} to olyMapLoc(-453, 64, -130)
    set {oly::map::tp::piraeus} to olyMapLoc(-453, 64, -130)
    set {oly::map::port::gytheio} to olyMapLoc(429, 64, -140)
    set {oly::map::tp::gytheio} to olyMapLoc(429, 64, -140)
    set {oly::map::port::lechaion} to olyMapLoc(-358, 64, 196)
    set {oly::map::tp::lechaion} to olyMapLoc(-358, 64, 196)
    set {oly::map::port::aulis} to olyMapLoc(300, 64, 345)
    set {oly::map::tp::aulis} to olyMapLoc(300, 64, 345)

    # ── 월드 설정 (보더 ±512, 스폰 = 신들의 제단)
    make console execute command "worldborder center 0 0"
    make console execute command "worldborder set 1024"
    make console execute command "worldborder damage buffer 2"
    make console execute command "worldborder damage amount 1"
    make console execute command "setworldspawn 0 81 -20"
    send "[올림포스] 맵 데이터 등록 - 영토 %size of {oly::tlist::*}%개, 도시 %size of {oly::clist::*}%개" to console


command /olymap [<text>] [<text>]:
    executable by: players
    trigger:
        if player is not op:
            send "&c관리자만 사용할 수 있습니다."
            stop
        if arg-1 is "reload":
            olyMapLoad()
            send "&a[올림포스] &7맵 데이터를 다시 등록했습니다. 영토 &f%size of {oly::tlist::*}%&7개, 도시 &f%size of {oly::clist::*}%&7개"
            stop
        if arg-1 is "tp":
            if arg-2 is not set:
                send "&7사용법 &f/olymap tp <장소>  &8(/olymap list 로 목록)"
                stop
            if {oly::map::tp::%arg-2%} is not set:
                send "&c그런 장소가 없습니다. &7/olymap list"
                stop
            teleport player to {oly::map::tp::%arg-2%}
            send "&a[올림포스] &f%arg-2% &7(으)로 이동"
            stop
        if arg-1 is "list":
            send "&6[올림포스] 이동 가능한 장소"
            loop {oly::map::tp::*}:
                send "  &f%loop-index%"
            stop
        if arg-1 is "here":
            set {_t} to olyTerrOf(player)
            if {_t} is "none":
                send "&7[올림포스] 이곳은 영토가 아닙니다 (바다/무인도)"
                stop
            send "&6[올림포스] &f%olyTerrName({_t})% &8(%{_t}%) &7타입 &f%olyTerrType({_t})% &7소유 &f%olyFacName(olyTerrOwner({_t}))%"
            stop
        send "&7/olymap reload | tp <장소> | list | here"

