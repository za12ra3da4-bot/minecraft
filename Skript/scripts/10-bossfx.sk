# =====================================================================================
#  신들의 전쟁: 올림포스  /  10-bossfx.sk  -  보스 스킬 공통 (시전 연출 · 연출 엔티티 · 정리)
# -------------------------------------------------------------------------------------
#  의존: 01-data (olyCmd, olyAB, olySec, olyLive), 10-monsters (예고 장판, 판정, 쿨타임)
#  보스별 스킬 = 10-boss-<id>.sk, 연출 함수 = 데이터팩 oly:boss/<id>/fx/..., 리소스 = 리소스팩 oly:fx/..., oly:icon/...
#
#  ■ 스킬이 보스보다 오래 사는 버그를 막는 규칙
#    1) 에폭 {oly::m::<id>::ep} : 소환 · 잠듦 · 사라짐마다 +1.
#       스킬은 시작할 때 olySkBegin() 으로 에폭을 받고, wait 뒤마다 olySkGo() 로 확인한다.
#       (보스 죽음 / 잠듦 / 게임 정지·종료 / 에폭 바뀜 → false 를 돌려주고 바쁨을 푼다 → 스킬은 stop)
#    2) 연출 엔티티는 전부 태그 oly · olyfx · olyfx_<id> · olyfx_<key> → 한 번에 지운다.
#    3) 석화·속박은 attribute modifier(oly:boss_petrify, oly:boss_snare)로만 → 정확히 떼어낸다.
#    4) 보스가 상태이상을 건 플레이어는 {oly::bfx::<id>::touch::<uuid>} 에 적어 두고, 보스가 사라지면 복구한다.
# =====================================================================================

on load:
    olyModReady("bossfx")
    # 재시작 전에 남은 연출 · 석화 정리 (보스 자체는 10-monsters 의 on load 가 정리한다)
    olyCmd("kill @e[tag=olyfx]")
    loop all players:
        olyPRestore(loop-player)
    delete {oly::bfx::*}

on join:
    olyPRestore(player)

on respawn:
    olyPRestore(player)


# =====================================================================================
#  1. 아이콘 글리프 (리소스팩 font oly:icons, U+E100~) · 스킬 이름
# =====================================================================================

# 글리프 = 리소스팩 assets/oly/font/icons.json (tools/boss_fx/build_icons.py 가 같은 순서로 만든다)
