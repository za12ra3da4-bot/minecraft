# 왕관 쟁탈전 — 잘못 복사된 옛 스크립트 자동 정리
#  plugins/Skript/scripts/ 바로 아래에 arena 파일과 같은 이름이 있으면 두 번 로드되어 오류가 난다.
#  그런 파일은 이름 앞에 '-' 를 붙여 꺼 둔다 (Skript 는 '-' 로 시작하는 파일을 안 읽음). 그 뒤 /sk reload all 한 번.
import:
    java.io.File

on load:
    set {_n} to 0
    loop "a01-gen-hud.sk", "a02-gen-map.sk", "a03-gen-boss.sk", "a10-core.sk", "a20-game.sk", "a30-hud.sk", "a40-boss.sk", "a41-skills.sk", "a45-reward.sk", "a50-weapons.sk" and "a60-lobby.sk":
        set {_f} to new File("plugins/Skript/scripts/%loop-value%")
        if {_f}.exists() is true:
            set {_to} to new File("plugins/Skript/scripts/-old-%loop-value%")
            if {_to}.exists() is true:
                {_to}.delete()
            {_f}.renameTo({_to})
            add 1 to {_n}
    if {_n} > 0:
        broadcast "&6[전장] &f옛 스크립트 %{_n}%개를 껐습니다 (scripts 폴더의 -old-*.sk). &e/sk reload all &f을 한 번 더 해주세요."
