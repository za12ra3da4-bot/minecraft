# ═════════════════════════════════════════════════════════════════════════════
#  신화쟁탈전 — 팀 강화 · 기지 함정 (상점 3쪽, 배드워즈처럼)
#   한 명이 코인으로 사면 팀 전체에 적용. 단계(Lv)가 오를수록 비싸짐 → 팀원이 사면 상점을 열고 있는 다른 팀원 화면도 바로 갱신
#   팀 강화: 광산 강화(본진 광석 리젠) · 풍부한 광맥(광물 2배 확률) · 강철 피부(받는 피해 감소) · 코어 보강(코어 체력)
#            치유의 샘(본진에서 재생) · 신속 채굴(성급함)
#   기지 함정: 적이 본진(24칸)에 들어오면 자동 발동 — 경보(알림 · 발광) · 저주(구속 · 피로 · 실명) · 반격의 함성(본진 아군 강화)
#   게임이 시작할 때 모두 Lv.0
# ═════════════════════════════════════════════════════════════════════════════

# 강화 정의: 이름 · 상점 칸 · 아이콘 · 종류(up/trap) · 단계별 가격(0 = 그 단계 없음) · 단계별 효과 설명 (0단계 = 없음)
function bgUpDef(id: text, name: text, slot: number, icon: item, kind: text, p1: number, p2: number, p3: number, d1: text, d2: text, d3: text):
    set {-bg::up::%{_id}%::name} to {_name}
    set {-bg::up::%{_id}%::slot} to {_slot}
    set {-bg::up::%{_id}%::icon} to {_icon}
    set {-bg::up::%{_id}%::kind} to {_kind}
    set {-bg::up::%{_id}%::price::1} to {_p1}
    set {-bg::up::%{_id}%::price::2} to {_p2}
    set {-bg::up::%{_id}%::price::3} to {_p3}
    set {-bg::up::%{_id}%::desc::0} to "없음"
    set {-bg::up::%{_id}%::desc::1} to {_d1}
    set {-bg::up::%{_id}%::desc::2} to {_d2}
    set {-bg::up::%{_id}%::desc::3} to {_d3}
    set {_max} to 1
    if {_p2} > 0:
        set {_max} to 2
    if {_p3} > 0:
        set {_max} to 3
    set {-bg::up::%{_id}%::max} to {_max}
    set {-bg::upslot::%{_slot}%} to {_id}

on load:
    delete {-bg::up::*}
    delete {-bg::upslot::*}
    set {-bg::up::list::*} to "mine", "rich", "armor", "core", "heal", "haste", "sharp", "cdr", "alarm", "curse" and "counter"
    bgUpDef("mine", "광산 강화", 10, iron pickaxe, "up", 80, 160, 260, "본진 광석 리젠 5초", "본진 광석 리젠 4초", "본진 광석 리젠 3초")
    bgUpDef("rich", "풍부한 광맥", 11, gold ingot, "up", 100, 200, 320, "광물 2배 확률 40%%", "광물 2배 확률 75%%", "광물 항상 2배 + 30%% 확률 3배")
    bgUpDef("armor", "강철 피부", 12, iron chestplate, "up", 300, 600, 1000, "받는 피해 -8%%", "받는 피해 -15%%", "받는 피해 -22%%")
    bgUpDef("core", "코어 보강", 13, beacon, "up", 90, 180, 300, "코어 체력 75", "코어 체력 100", "코어 체력 125 + 코어 회복 2배")
    bgUpDef("heal", "치유의 샘", 14, glistering melon slice, "up", 150, 300, 500, "본진 안에서 재생 I", "본진 안에서 재생 II", "본진 안에서 재생 II + 흡수 II")
    bgUpDef("haste", "신속 채굴", 15, golden pickaxe, "up", 80, 180, 300, "팀 전원 성급함 I", "팀 전원 성급함 II", "성급함 II + 팀 전원 신속 I")
    bgUpDef("sharp", "날카로운 칼날", 16, diamond sword, "up", 350, 700, 1200, "주는 피해 +8%%", "주는 피해 +15%%", "주는 피해 +22%%")
    bgUpDef("cdr", "전설의 숨결", 17, nether star, "up", 250, 500, 850, "전설 무기 재사용 대기 -15%%", "전설 무기 재사용 대기 -25%%", "전설 무기 재사용 대기 -35%%")
    bgUpDef("alarm", "경보 함정", 28, bell, "trap", 50, 100, 150, "적 침입 알림 + 발광 5초 (재발동 20초)", "알림 + 발광 12초 (12초)", "알림 + 발광 20초 + 위치 표시 (6초)")
    bgUpDef("curse", "저주 함정", 29, cobweb, "trap", 120, 240, 380, "구속 II 5초 + 나약함 5초", "구속 II 6초 + 채굴 피로 II 10초 + 나약함 6초", "구속 III 6초 + 실명 3초 + 나약함 II 8초 + 독 3초")
    bgUpDef("counter", "반격의 함성", 30, feather, "trap", 120, 240, 380, "본진 아군 신속 I + 저항 I 10초", "신속 II + 저항 I + 힘 I 10초", "신속 II + 저항 II + 힘 I + 재생 II 12초")

function bgUpLv(t: text, id: text) :: number:
    return {-bg::uplv::%{_t}%::%{_id}%} ? 0

function bgUpReset():
    delete {-bg::uplv::*}
    delete {-bg::trapcd::*}
    delete {-bg::inb::*}
    delete {-bg::bbuf::*}

# ─────────────────────────────────────────────────────────── 상점 3쪽 (팀 강화 · 함정)
function bgUpItem(t: text, id: text) :: item:
    set {_lv} to bgUpLv({_t}, {_id})
    set {_max} to {-bg::up::%{_id}%::max}
    set {_it} to {-bg::up::%{_id}%::icon}
    set {_c} to "&b"
    set {_what} to "팀 강화"
    if {-bg::up::%{_id}%::kind} is "trap":
        set {_c} to "&c"
        set {_what} to "기지 함정"
    set name of {_it} to "%{_c}%&l%{-bg::up::%{_id}%::name}% &7[Lv.%{_lv}%/%{_max}%]"
    add "&8%{_what}% · 팀 전체 적용" to {_lore::*}
    add "" to {_lore::*}
    add "&7지금: &f%{-bg::up::%{_id}%::desc::%{_lv}%}%" to {_lore::*}
    if {_lv} < {_max}:
        set {_nx} to {_lv} + 1
        add "&a다음 Lv.%{_nx}%: &f%{-bg::up::%{_id}%::desc::%{_nx}%}%" to {_lore::*}
        add "" to {_lore::*}
        add "&e가격: %{-bg::up::%{_id}%::price::%{_nx}%}% 코인 &7(클릭해서 구매)" to {_lore::*}
    else:
        add "" to {_lore::*}
        add "&6&l최대 단계" to {_lore::*}
    set lore of {_it} to {_lore::*}
    if {_lv} > 0:
        set {_it} to {_lv} of {_it}
    return {_it}

function bgUpFill(inv: inventory, t: text):
    loop {-bg::up::list::*}:
        set slot {-bg::up::%loop-value%::slot} of {_inv} to bgUpItem({_t}, loop-value)
    # 코어 즉시 복구 (a65)
    set slot 31 of {_inv} to bgCoreFixItem({_t})
    # 상점 그림이 없을 때(유리판 상자) 줄 이름
    if {-bg::gui::shop3} is not set:
        set {_a} to nether star named "&b&l팀 강화 &7— 한 명이 사면 팀 전체"
        set slot 9 of {_inv} to {_a}
        set {_b} to tripwire hook named "&c&l기지 함정 &7— 적이 본진에 들어오면 발동"
        set slot 27 of {_inv} to {_b}

# 팀원이 사면 그 팀 사람 중 3쪽을 열고 있는 사람 화면을 바로 갱신
function bgUpRefresh(t: text):
    loop all players:
        if bgTeam(loop-player) is {_t}:
            if {-bg::shop::%uuid of loop-player%} is true:
                if {-bg::shoppage::%uuid of loop-player%} is 3:
                    bgUpFill(current inventory of loop-player, {_t})

function bgUpBuy(p: player, id: text):
    set {_t} to bgTeam({_p})
    if {-bg::on} is not true:
        send "&6[팀 강화] &7게임 중에만 살 수 있습니다." to {_p}
        play sound "entity.villager.no" to {_p}
        stop
    if {_t} is "none":
        send "&6[팀 강화] &7팀에 속한 사람만 살 수 있습니다." to {_p}
        play sound "entity.villager.no" to {_p}
        stop
    set {_lv} to bgUpLv({_t}, {_id})
    if {_lv} >= {-bg::up::%{_id}%::max}:
        send "&6[팀 강화] &7이미 최대 단계입니다." to {_p}
        play sound "entity.villager.no" to {_p}
        stop
    set {_nx} to {_lv} + 1
    set {_price} to {-bg::up::%{_id}%::price::%{_nx}%}
    if ({bg::coin::%uuid of {_p}%} ? 0) < {_price}:
        set {_c} to {bg::coin::%uuid of {_p}%} ? 0
        send "&6[팀 강화] &c코인이 부족합니다. &7(필요 %{_price}%, 보유 %{_c}%)" to {_p}
        play sound "entity.villager.no" to {_p}
        stop
    remove {_price} from {bg::coin::%uuid of {_p}%}
    set {-bg::uplv::%{_t}%::%{_id}%} to {_nx}
    set {_c} to "&b"
    if {-bg::up::%{_id}%::kind} is "trap":
        set {_c} to "&c"
    loop all players:
        if bgTeam(loop-player) is {_t}:
            send "%{-bg::tcol::%{_t}%}%[팀 강화] &f%name of {_p}% 님이 %{_c}%&l%{-bg::up::%{_id}%::name}% Lv.%{_nx}%&f 을(를) 샀습니다! &7(%{-bg::up::%{_id}%::desc::%{_nx}%}%)" to loop-player
            play sound "block.beacon.power_select" to loop-player
            play sound "entity.player.levelup" to loop-player
    # 구매 연출: 팀 전원 머리 위 불사의 토템 빛 + 제목, 본진에 폭죽
    loop all players:
        if bgTeam(loop-player) is {_t}:
            bgTitleP(loop-player, "", "%{_c}%&l%{-bg::up::%{_id}%::name}% Lv.%{_nx}% &f— %{-bg::up::%{_id}%::desc::%{_nx}%}%")
            bgParticle(bgUp(location of loop-player, 1.2), "totem_of_undying", 0.5, 0.8, 0.5, 0.25, 30)
    set {_b} to bgMk("base_%{_t}%")
    bgParticle(bgUp({_b}, 2), "firework", 3, 2, 3, 0.15, 80)
    bgParticle(bgUp({_b}, 1), "end_rod", 4, 1, 4, 0.05, 40)
    bgSoundAt({_b}, "entity.firework_rocket.twinkle", 2, 1)
    if {_id} is "core":
        bgCoreText({_t})
    bgUpRefresh({_t})
    # 산 사람의 보유 코인 칸
    set {_cc} to {bg::coin::%uuid of {_p}%} ? 0
    set {_coin} to sunflower named "&6&l보유 코인: &e%{_cc}%"
    set slot 49 of current inventory of {_p} to {_coin}

# ─────────────────────────────────────────────────────────── 팀 강화 효과
# 강철 피부: 받는 모든 피해 감소 (전투 참가자만)
on damage of player:
    {-bg::on} is true
    set {_t} to bgTeam(victim)
    {_t} is not "none"
    set {_lv} to bgUpLv({_t}, "armor")
    {_lv} > 0
    # -8 / -15 / -22% (너프: 원래 -10 / -20 / -30%)
    set {_r} to 0.08
    if {_lv} is 2:
        set {_r} to 0.15
    else if {_lv} >= 3:
        set {_r} to 0.22
    set damage to damage * (1 - {_r})

# 날카로운 칼날: 사람에게 주는 피해 증가 (전설 무기 스킬 포함)
on damage of player:
    {-bg::on} is true
    attacker is a player
    set {_t} to bgTeam(attacker)
    {_t} is not "none"
    {_t} is not bgTeam(victim)
    set {_lv} to bgUpLv({_t}, "sharp")
    {_lv} > 0
    # +8 / +15 / +22% (너프: 원래 +10 / +20 / +30%)
    set {_r} to 0.08
    if {_lv} is 2:
        set {_r} to 0.15
    else if {_lv} >= 3:
        set {_r} to 0.22
    set damage to damage * (1 + {_r})

# 치유의 샘 · 신속 채굴 (2초마다)
every 2 seconds:
    {-bg::on} is true
    loop {-bg::teams::*}:
        set {_t} to loop-value
        set {_h} to bgUpLv({_t}, "haste")
        if {_h} > 0:
            bgCmd("effect give @a[team=bg_%{_t}%,gamemode=!spectator] haste 3 %min(2, {_h}) - 1% true")
            if {_h} >= 3:
                bgCmd("effect give @a[team=bg_%{_t}%,gamemode=!spectator] speed 3 0 true")
        set {_r} to bgUpLv({_t}, "heal")
        if {_r} > 0:
            set {_b} to bgMk("base_%{_t}%")
            loop all players:
                if bgTeam(loop-player) is {_t}:
                    if bgInOwnBase(loop-player) is true:
                        bgBaseBuff(loop-player, "regeneration", 3, min(2, {_r}) - 1)
                        if {_r} >= 3:
                            bgBaseBuff(loop-player, "absorption", 6, 1)
            # 샘 효과: 본진 바닥에 초록 빛
            bgParticle(bgUp({_b}, 0.3), "happy_villager", 6, 0.3, 6, 0, 10 * {_r})

# 본진 광석 리젠 시간 (광산 강화): 6 → 5 → 4 → 3초 (맵 곳곳 광맥 5초)
function bgMineRegen(t: text) :: number:
    return 6 - bgUpLv({_t}, "mine")

# 전설의 숨결: 전설 무기 재사용 대기 감소 비율 (0 / 0.15 / 0.25 / 0.35)
function bgCdrRate(p: player) :: number:
    set {_lv} to bgUpLv(bgTeam({_p}), "cdr")
    if {_lv} is 1:
        return 0.15
    if {_lv} is 2:
        return 0.25
    if {_lv} >= 3:
        return 0.35
    return 0

# ─────────────────────────────────────────────────────────── 본진 전용 버프 (본진 24칸 안에서만)
function bgInOwnBase(p: player) :: boolean:
    set {_t} to bgTeam({_p})
    if {_t} is "none":
        return false
    set {_b} to bgMk("base_%{_t}%")
    if world of {_p} is not world of {_b}:
        return false
    if bgDist2(location of {_p}, {_b}) < 24:
        return true
    return false

# 본진 버프 주기 + 기록 (나가면 이 기록대로 지움)
function bgBaseBuff(p: player, eff: text, sec: number, amp: number):
    bgCmd("effect give %name of {_p}% %{_eff}% %{_sec}% %{_amp}% true")
    set {-bg::bbuf::%uuid of {_p}%::%{_eff}%} to true

function bgBaseBuffClear(p: player):
    set {_n} to 0
    loop {-bg::bbuf::%uuid of {_p}%::*}:
        bgCmd("effect clear %name of {_p}% %loop-index%")
        add 1 to {_n}
    delete {-bg::bbuf::%uuid of {_p}%::*}
    if {_n} > 0:
        send action bar "&7본진을 나가서 본진 버프(치유의 샘 · 반격의 함성)가 사라졌습니다" to {_p}

# 풍부한 광맥: 광물 2배 확률 40 / 75% · Lv.3 은 항상 2배 + 30% 확률 3배
function bgOreBonus(p: player) :: number:
    set {_lv} to bgUpLv(bgTeam({_p}), "rich")
    if {_lv} <= 0:
        return 1
    set {_r} to random number between 0 and 1
    if {_lv} >= 3:
        if {_r} < 0.3:
            return 3
        return 2
    set {_ch} to 0.4
    if {_lv} is 2:
        set {_ch} to 0.75
    if {_r} < {_ch}:
        return 2
    return 1

# ─────────────────────────────────────────────────────────── 기지 함정
#  0.5초마다: 전투 참가자가 '적 본진 24칸' 안으로 새로 들어오면 그 본진 팀의 함정 발동
every 10 ticks:
    {-bg::on} is true
    loop all players:
        if bgIsFighter(loop-player) is true:
            set {_p} to loop-player
            set {_me} to bgTeam({_p})
            set {_in} to "none"
            loop {-bg::teams::*}:
                if loop-value-2 is not {_me}:
                    set {_b} to bgMk("base_%loop-value-2%")
                    if world of {_p} is world of {_b}:
                        if bgDist2(location of {_p}, {_b}) < 24:
                            set {_in} to loop-value-2
            # 우리 본진을 나가면 본진에서만 주는 버프(치유의 샘 · 반격의 함성)를 없앤다
            if bgInOwnBase({_p}) is false:
                bgBaseBuffClear({_p})
            set {_was} to {-bg::inb::%uuid of {_p}%} ? "none"
            if {_in} is not {_was}:
                set {-bg::inb::%uuid of {_p}%} to {_in}
                if {_in} is not "none":
                    bgTrapFire({_in}, {_p})
        else:
            delete {-bg::inb::%uuid of loop-player%}

# 함정 재발동 대기 (팀 공통 · 초)
function bgTrapReady(key: text, sec: number) :: boolean:
    if {-bg::trapcd::%{_key}%} is set:
        if ({-bg::sec} ? 0) - {-bg::trapcd::%{_key}%} < {_sec}:
            return false
    set {-bg::trapcd::%{_key}%} to {-bg::sec} ? 0
    return true

# 경보 Lv.3 위치 표시: 우리 팀에게만 침입자 머리 위 빨간 빛기둥 (5초, 따라다님)
function bgTrapBeam(p: player, t: text):
    loop 10 times:
        if {_p} is online:
            set {_pl} to location of {_p}
            bgCmd("execute in %bgDim()% run particle dust{color:[1,0.1,0.1],scale:2} %bgC(x-coordinate of {_pl})% %bgN((y-coordinate of {_pl}) + 3)% %bgC(z-coordinate of {_pl})% 0.1 2 0.1 0 15 force @a[team=bg_%{_t}%]")
        wait 10 ticks

function bgTrapFire(t: text, p: player):
    set {_n} to name of {_p}
    set {_pt} to bgTeam({_p})
    set {_tc} to {-bg::tcol::%{_pt}%}
    # 경보
    set {_a} to bgUpLv({_t}, "alarm")
    if {_a} > 0:
        set {_cd} to 20
        if {_a} is 2:
            set {_cd} to 12
        else if {_a} is 3:
            set {_cd} to 6
        if bgTrapReady("%{_t}%::alarm", {_cd}) is true:
            loop all players:
                if bgTeam(loop-player) is {_t}:
                    bgTitleP(loop-player, "&c&l⚠ 적 침입!", "%{_tc}%%{_n}% &f이(가) 본진에 들어왔습니다")
                    send "%{-bg::tcol::%{_t}%}%[경보 함정] &c적 침입! %{_tc}%%{_n}% &7(%{-bg::tname::%{_pt}%}% 팀)" to loop-player
                    play sound "block.bell.use" to loop-player
                    play sound "entity.experience_orb.pickup" to loop-player
            set {_gl} to 5
            if {_a} is 2:
                set {_gl} to 12
            else if {_a} is 3:
                set {_gl} to 20
            bgCmd("effect give %{_n}% glowing %{_gl}% 0 true")
            if {_a} >= 3:
                bgTrapBeam({_p}, {_t})
            send action bar "&c%{-bg::tname::%{_t}%}% 팀의 경보 함정이 울렸습니다!" to {_p}
    # 저주 (침입자마다 25초에 한 번 · 결계 부적이 막음)
    set {_c} to bgUpLv({_t}, "curse")
    if {_c} > 0:
        if bgWardOn({_p}) is true:
            send action bar "&b결계 부적이 %{-bg::tname::%{_t}%}% 팀의 저주 함정을 막았습니다" to {_p}
        else if bgTrapReady("%{_t}%::curse::%uuid of {_p}%", 20) is true:
            if {_c} is 1:
                bgCmd("effect give %{_n}% slowness 5 1 true")
                bgCmd("effect give %{_n}% weakness 5 0 true")
            else if {_c} is 2:
                bgCmd("effect give %{_n}% slowness 6 1 true")
                bgCmd("effect give %{_n}% mining_fatigue 10 1 true")
                bgCmd("effect give %{_n}% weakness 6 0 true")
            else:
                bgCmd("effect give %{_n}% slowness 6 2 true")
                bgCmd("effect give %{_n}% blindness 3 0 true")
                bgCmd("effect give %{_n}% weakness 8 1 true")
                bgCmd("effect give %{_n}% poison 3 0 true")
            bgTitleP({_p}, "", "&5&l저주 함정! &7(%{-bg::tname::%{_t}%}% 팀)")
            play sound "entity.evoker.cast_spell" to {_p}
            bgParticle(location of {_p}, "witch", 0.5, 1, 0.5, 0.1, 40)
            loop all players:
                if bgTeam(loop-player) is {_t}:
                    send "%{-bg::tcol::%{_t}%}%[저주 함정] &f%{_tc}%%{_n}%&f 에게 저주가 걸렸습니다" to loop-player
    # 반격의 함성 (팀 공통 30초에 한 번): 본진 안 아군 강화
    set {_k} to bgUpLv({_t}, "counter")
    if {_k} > 0:
        if bgTrapReady("%{_t}%::counter", 25) is true:
            set {_b} to bgMk("base_%{_t}%")
            loop all players:
                if bgTeam(loop-player) is {_t}:
                    if bgInOwnBase(loop-player) is true:
                        if {_k} is 1:
                            bgBaseBuff(loop-player, "speed", 10, 0)
                            bgBaseBuff(loop-player, "resistance", 10, 0)
                        else if {_k} is 2:
                            bgBaseBuff(loop-player, "speed", 10, 1)
                            bgBaseBuff(loop-player, "resistance", 10, 0)
                            bgBaseBuff(loop-player, "strength", 10, 0)
                        else:
                            bgBaseBuff(loop-player, "speed", 12, 1)
                            bgBaseBuff(loop-player, "resistance", 12, 1)
                            bgBaseBuff(loop-player, "strength", 12, 0)
                            bgBaseBuff(loop-player, "regeneration", 12, 1)
            bgParticle(bgUp({_b}, 1), "totem_of_undying", 5, 1.5, 5, 0.3, 120)
            loop all players:
                if bgTeam(loop-player) is {_t}:
                    if bgInOwnBase(loop-player) is true:
                        bgTitleP(loop-player, "", "&a&l반격의 함성! &f본진의 아군이 강해집니다")
                        play sound "event.raid.horn" to loop-player
