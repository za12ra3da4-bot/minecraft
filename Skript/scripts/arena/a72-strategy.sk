# ═════════════════════════════════════════════════════════════════════════════
#  왕관 쟁탈전 — 전략 · 지휘 · 광석 관리
#   지휘 깃발 (기본템): 우클릭 = 공격 핑 / 웅크리고 우클릭 = 도움 요청 → 우리 팀에게만 보이는 빛나는 핀 · 빛기둥 · 알림
#   광석 설치 막대 (관리자 /광석막대): 우클릭 = 그 자리에 광석 바위 / 웅크리고 우클릭 = 가까운 바위 지우기
#   /전장 광석삭제 : 막대로 놓은 바위 + 데이터팩으로 놓은 광석 전부 지우고 원래 지형으로
# ═════════════════════════════════════════════════════════════════════════════

import:
    org.bukkit.Bukkit

# 바위 블록 무작위 (돌 · 안산암 · 조약돌 · 응회암 · 이끼 조약돌)
function bgSetRock(l: location):
    set {_r} to random integer between 1 and 5
    if {_r} is 1:
        set block at {_l} to stone
    else if {_r} is 2:
        set block at {_l} to andesite
    else if {_r} is 3:
        set block at {_l} to cobblestone
    else if {_r} is 4:
        set block at {_l} to tuff
    else:
        set block at {_l} to mossy cobblestone

# 광석 무작위 (철 3 · 금 4 · 에메랄드 2 · 다이아 1)
function bgSetOre(l: location):
    set {_r} to random integer between 1 and 10
    if {_r} <= 3:
        set block at {_l} to iron ore
    else if {_r} <= 7:
        set block at {_l} to gold ore
    else if {_r} <= 9:
        set block at {_l} to emerald ore
    else:
        set block at {_l} to diamond ore

# ─────────────────────────────────────────────────────────── 지휘 깃발 (기본템 · 핑)
#  나침반은 월드에딧 길잡이 도구라 관리자가 쓰면 순간이동됨 → 깃발(종이 + 그림)로 바꿈
#  우클릭 = 공격 핑 (붉은 핀) / 웅크리고 우클릭 = 도움 요청 (금빛 핀)
#  공중에 빛나는 핀 그림 + 이름표 → 우리 팀에게만 보인다 (다른 팀 · 관전자는 안 보임). 3초 뒤 사라짐, 한 사람당 하나
# 핀을 우리 팀이 아닌 모든 사람에게서 숨긴다 (Skript 기본 기능 hide … from …)
#  소환한 바로 그 틱에 숨겨서 다른 팀 화면에는 아예 안 나타남 · 떠 있는 동안 반복해서 다시 숨김
function bgPingVisible(l: location, id: text, t: text):
    loop entities in radius 8 of {_l}:
        if scoreboard tags of loop-entity contain {_id}:
            add loop-entity to {_es::*}
    # 근처에서 못 찾으면 태그로 서버 전체에서 찾기
    if size of {_es::*} is 0:
        set {_es::*} to ...Bukkit.selectEntities(Bukkit.getConsoleSender(), "@e[tag=%{_id}%]")
    size of {_es::*} > 0
    loop all players:
        if bgTeam(loop-player) is not {_t}:
            add loop-player to {_others::*}
    if size of {_others::*} > 0:
        hide {_es::*} from {_others::*}
    # 2중 안전장치: 서버 API 로도 한 사람씩 직접 숨김 + 나중에 들어온 사람도 기본 숨김 (각각 따로라 하나가 실패해도 나머지는 적용)
    bgPingHideApi({_es::*}, {_t})
    bgPingDefaultHidden({_es::*})

function bgPingHideApi(es: entities, t: text):
    set {_pl} to Bukkit.getPluginManager().getPlugin("Skript")
    loop {_es::*}:
        set {_e} to loop-value
        loop all players:
            if bgTeam(loop-player) is not {_t}:
                loop-player.hideEntity({_pl}, {_e})

function bgPingDefaultHidden(es: entities):
    loop {_es::*}:
        set {_e} to loop-value
        {_e}.setVisibleByDefault(false)

on right click:
    player's tool is paper
    set {_nm} to uncolored name of player's tool
    {_nm} is set
    {_nm} contains "지휘 깃발"
    cancel event
    set {_t} to bgTeam(player)
    if {_t} is "none":
        stop
    if {-bg::pingcd::%uuid of player%} is set:
        if difference between {-bg::pingcd::%uuid of player%} and now < 3 seconds:
            send action bar "&7잠시 뒤에 다시 (3초)" to player
            stop
    set {_b} to target block of player
    if {_b} is not set:
        send action bar "&7너무 멉니다 — 블록을 바라보세요" to player
        stop
    set {-bg::pingcd::%uuid of player%} to now
    set {_l} to location of {_b}
    add 1 to y-coordinate of {_l}
    set {_kind} to "공격"
    set {_img} to "attack"
    set {_col} to "1,0.25,0.2"
    set {_cc} to "&c"
    set {_tc} to "red"
    set {_ic} to "⚔"
    set {_snd} to "block.note_block.bell"
    if player is sneaking:
        set {_kind} to "도움 요청"
        set {_img} to "help"
        set {_col} to "1,0.8,0.2"
        set {_cc} to "&e"
        set {_tc} to "gold"
        set {_ic} to "⛨"
        set {_snd} to "block.note_block.pling"
    set {_id} to "bgp_%name of player%"
    add 1 to {-bg::pingseq::%uuid of player%}
    set {_seq} to {-bg::pingseq::%uuid of player%}
    # 전에 찍은 내 핀은 지운다
    bgCmd("kill @e[tag=%{_id}%]")
    set {_x} to bgC(x-coordinate of {_l})
    set {_z} to bgC(z-coordinate of {_l})
    set {_y} to bgN((y-coordinate of {_l}) + 2.6)
    set {_ty} to bgN((y-coordinate of {_l}) + 1.1)
    bgCmd("execute in %bgDim()% run summon item_display %{_x}% %{_y}% %{_z}% {Tags:[""bg"",""bg_ping"",""%{_id}%""],billboard:""center"",Glowing:1b,glow_color_override:%{-bg::hex::%{_t}%}%,brightness:{sky:15,block:15},view_range:8f,item_display:""none"",interpolation_duration:10,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[2.2f,2.2f,2.2f]},item:{id:""minecraft:paper"",count:1,components:{""minecraft:item_model"":""bg:ping/%{_img}%""}}}")
    bgCmd("execute in %bgDim()% run summon text_display %{_x}% %{_ty}% %{_z}% {Tags:[""bg"",""bg_ping"",""%{_id}%""],billboard:""center"",see_through:1b,shadow:1b,background:1073741824,brightness:{sky:15,block:15},view_range:8f,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1.3f,1.3f,1.3f]},text:[{text:""%{_ic}% %{_kind}%"",color:""%{_tc}%"",bold:true},{text:"" · %name of player%"",color:""white"",bold:false}]}")
    bgPingVisible({_l}, {_id}, {_t})
    loop all players:
        if bgTeam(loop-player) is {_t}:
            send "%{-bg::tcol::%{_t}%}%[핑] &f%name of player% &7→ %{_cc}%&l%{_kind}%! &7(%floor(x-coordinate of {_l})%, %floor(z-coordinate of {_l})%)" to loop-player
            bgTitleP(loop-player, "", "%{_cc}%&l%{_ic}% %{_kind}% &f— %name of player%")
            play sound {_snd} to loop-player
    # 3초: 위아래로 살짝 떠다니고 · 우리 팀에게만 빛기둥 → 3초 뒤 사라짐
    set {_up} to true
    loop 6 times:
        if {_up} is true:
            bgCmd("data merge entity @e[type=item_display,tag=%{_id}%,limit=1] {start_interpolation:0,interpolation_duration:10,transformation:{translation:[0f,0.3f,0f],scale:[2.2f,2.2f,2.2f]}}")
            set {_up} to false
        else:
            bgCmd("data merge entity @e[type=item_display,tag=%{_id}%,limit=1] {start_interpolation:0,interpolation_duration:10,transformation:{translation:[0f,0f,0f],scale:[2.2f,2.2f,2.2f]}}")
            set {_up} to true
        bgCmd("execute in %bgDim()% run particle dust{color:[%{_col}%],scale:2} %{_x}% %bgN((y-coordinate of {_l}) + 3)% %{_z}% 0.1 3 0.1 0 20 force @a[team=bg_%{_t}%]")
        bgCmd("execute in %bgDim()% run particle end_rod %{_x}% %bgN((y-coordinate of {_l}) + 0.4)% %{_z}% 0.6 0.1 0.6 0 4 force @a[team=bg_%{_t}%]")
        bgPingVisible({_l}, {_id}, {_t})
        wait 10 ticks
        # 그새 새 핀을 찍었으면 이 핀 반복은 끝 (새 핀은 새 반복이 맡는다)
        if {-bg::pingseq::%uuid of player%} is not {_seq}:
            stop
    bgCmd("kill @e[tag=%{_id}%]")

on load:
    bgCmd("kill @e[tag=bg_ping]")

# ─────────────────────────────────────────────────────────── 광석 설치 막대 (관리자)
command /광석막대:
    permission: op
    trigger:
        give player blaze rod named "&6&l광석 설치 막대"
        send "&6[광석] &f우클릭: 그 자리에 광석 바위 · 웅크리고 우클릭: 가까운 바위 지우기 · &e/전장 광석삭제 &f: 전부 지우기"

on right click:
    player's tool is blaze rod
    set {_nm} to uncolored name of player's tool
    {_nm} is set
    {_nm} contains "광석 설치 막대"
    player is op
    cancel event
    set {_b} to target block of player
    if {_b} is not set:
        stop
    if player is sneaking:
        bgOreBoulderRemoveNear(location of {_b}, player)
        stop
    bgOreBoulder(location of {_b})
    send action bar "&6광석 바위를 놓았습니다" to player

# 광석 바위 하나: 5x5 안 둥글게, 가운데 4칸 높이 · 광석은 겉면에. 놓기 전 원래 블록을 기억 (지울 때 그대로 되돌림)
function bgOreBoulder(c: location):
    set {_id} to "%floor(x-coordinate of {_c})%_%floor(y-coordinate of {_c})%_%floor(z-coordinate of {_c})%"
    set {bg::oreb::%{_id}%} to {_c}
    set {_k} to 0
    set {_ores} to 0
    set {_maxore} to random integer between 3 and 4
    set {_dx} to -3
    loop 5 times:
        add 1 to {_dx}
        set {_dz} to -3
        loop 5 times:
            add 1 to {_dz}
            set {_dist} to abs({_dx}) + abs({_dz})
            set {_skip} to false
            if {_dist} > 3:
                set {_skip} to true
            if abs({_dx}) is 2:
                if abs({_dz}) is 2:
                    set {_skip} to true
            if {_skip} is false:
                set {_h} to 4 - {_dist}
                if {_h} < 1:
                    set {_h} to 1
                # 바닥 높이 찾기 (위아래 3칸)
                set {_g} to location((x-coordinate of {_c}) + {_dx}, (y-coordinate of {_c}) + 3, (z-coordinate of {_c}) + {_dz}, world of {_c})
                loop 7 times:
                    if block at {_g} is not air:
                        exit loop
                    remove 1 from y-coordinate of {_g}
                set {_hh} to {_h} + 1
                set {_j} to 0
                loop {_hh} times:
                    add 1 to {_j}
                    set {_l} to location(x-coordinate of {_g}, (y-coordinate of {_g}) + {_j} - 1, z-coordinate of {_g}, world of {_g})
                    add 1 to {_k}
                    set {bg::oreb::%{_id}%::l::%{_k}%} to {_l}
                    set {bg::oreb::%{_id}%::t::%{_k}%} to type of block at {_l}
                    set {_outer} to false
                    if {_j} is {_hh}:
                        set {_outer} to true
                    if {_dist} >= 2:
                        set {_outer} to true
                    if {_j} is 1:
                        bgSetRock({_l})
                    else if {_outer} is true:
                        # 바위 하나에 광석은 3~4개만
                        if {_ores} < {_maxore}:
                            if chance of 25%:
                                bgSetOre({_l})
                                add 1 to {_ores}
                            else:
                                bgSetRock({_l})
                        else:
                            bgSetRock({_l})
                    else:
                        bgSetRock({_l})
    bgParticle(bgUp({_c}, 2), "block{block_state:""minecraft:stone""}", 1.5, 1.5, 1.5, 0.1, 40)
    bgSoundAt({_c}, "block.stone.place", 2, 0.6)

function bgOreBoulderRemove(id: text):
    loop {bg::oreb::%{_id}%::l::*}:
        set {_i} to loop-index
        set block at loop-value to {bg::oreb::%{_id}%::t::%{_i}%}
    delete {bg::oreb::%{_id}%::*}
    delete {bg::oreb::%{_id}%}

function bgOreBoulderRemoveNear(l: location, p: player):
    loop {bg::oreb::*}:
        if distance between loop-value and {_l} < 5:
            bgOreBoulderRemove(loop-index)
            send action bar "&6광석 바위를 지웠습니다 (원래 지형으로)" to {_p}
            stop
    send action bar "&7가까운 곳에 막대로 놓은 광석 바위가 없습니다" to {_p}
