import:
    org.bukkit.potion.PotionEffectType

# ═════════════════════════════════════════════════════════════════════════════
#  왕관 쟁탈전 — 관전자 모드 · TNT 함정
#   /관전자 [플레이어] : 켜면 게임이 시작 · 끝나도 아무 일 없음 (팀 · 이동 · 인벤 초기화 · 제목 없음). 다시 치면 꺼짐
#   /TNT함정 [켬|끔]   : 켜 두면 라이터(부싯돌)나 화염구로 TNT 에 불 붙이는 사람을 '밴' 처럼 보이게 킥
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────── 관전자 모드
command /관전자 [<player>]:
    aliases: /nogame
    trigger:
        set {_p} to player
        if arg-1 is set:
            if player is not op:
                send "&c다른 사람의 관전자 모드는 관리자만 바꿀 수 있습니다."
                stop
            set {_p} to arg-1
        if bgOptOut({_p}) is true:
            delete {bg::optout::%uuid of {_p}%}
            bgCmd("tag %name of {_p}% remove bg_optout")
            send "&6[전장] &f관전자 모드 &c꺼짐 &7— 다음 게임부터 참가합니다" to {_p}
            if {_p} is not player:
                send "&6[전장] &f%name of {_p}% 관전자 모드 &c꺼짐"
            stop
        if bgIsFighter({_p}) is true:
            send "&c게임에 참가 중일 때는 켤 수 없습니다. (게임이 끝난 뒤 다시)"
            stop
        set {bg::optout::%uuid of {_p}%} to true
        bgCmd("tag %name of {_p}% add bg_optout")
        if bgTeam({_p}) is not "none":
            bgSetTeam({_p}, "none")
        send "&6[전장] &f관전자 모드 &a켜짐 &7— 게임이 시작되거나 끝나도 하던 것 그대로 계속합니다. 다시 &e/관전자&7 치면 꺼짐" to {_p}
        if {_p} is not player:
            send "&6[전장] &f%name of {_p}% 관전자 모드 &a켜짐"

command /관전자목록:
    permission: op
    trigger:
        set {_n} to 0
        loop all players:
            if bgOptOut(loop-player) is true:
                add 1 to {_n}
                send "&7 - &f%name of loop-player%"
        send "&6[전장] &f관전자 모드 %{_n}%명"

# ─────────────────────────────────────────────────────────── TNT 함정
command /tnt함정 [<text>]:
    permission: op
    trigger:
        if arg-1 is "끔":
            delete {bg::cfg::tnttrap}
        else if arg-1 is "켬":
            set {bg::cfg::tnttrap} to true
        else if {bg::cfg::tnttrap} is true:
            delete {bg::cfg::tnttrap}
        else:
            set {bg::cfg::tnttrap} to true
        if {bg::cfg::tnttrap} is true:
            send "&6[TNT 함정] &a켜짐 &7— TNT 에 라이터 · 화염구로 불 붙이면 '밴' 메시지와 함께 킥 &8(/TNT함정 으로 끄기)"
        else:
            send "&6[TNT 함정] &c꺼짐"

on right click on tnt:
    {bg::cfg::tnttrap} is true
    set {_ok} to false
    if player's tool is flint and steel:
        set {_ok} to true
    if player's tool is fire charge:
        set {_ok} to true
    {_ok} is true
    cancel event
    set {_n} to name of player
    kick player due to colored "&c&l당신 밴이야%nl%%nl%&f왜그러고사세요 ㅋ"
    bgSay("&c[TNT 함정] &e%{_n}%&f 님이 TNT 에 불을 붙이려다 &c&l밴&f 당했습니다 ㅋ")
    bgSound("entity.generic.explode", 0.5, 1.4)

# ─────────────────────────────────────────────────────────── 팀 잠금 (/팀잠금 <팀>)
#  1대1 · 1대1대1 판용: 잠근 팀에는 자동팀 · 중참 · 대기실 발판 · /전장 팀 으로 아무도 배정되지 않는다
#  /팀잠금 <팀> (다시 치면 풀림) · /팀잠금 해제 (전부 풀기) · /팀잠금 (지금 상태)   판이 끝나면 전부 풀림 (bgStop)
function bgTeamId(s: text) :: text:
    loop {-bg::teams::*}:
        if {_s} is loop-value:
            return loop-value
        if {_s} is {-bg::tname::%loop-value%}:
            return loop-value
    if {_s} is "빨강" or "빨간" or "빨":
        return "red"
    if {_s} is "파랑" or "파란" or "파":
        return "blue"
    if {_s} is "초록" or "초" or "녹":
        return "green"
    if {_s} is "노랑" or "노란" or "노":
        return "yellow"
    return "none"

function bgLockStatus() :: text:
    set {_s} to ""
    loop {-bg::teams::*}:
        if bgLocked(loop-value) is true:
            set {_s} to "%{_s}%%{-bg::tcol::%loop-value%}%%{-bg::tname::%loop-value%}% "
    if {_s} is "":
        return "&7없음"
    return {_s}

command /팀잠금 [<text>]:
    aliases: /teamlock
    permission: op
    trigger:
        if arg-1 is not set:
            send "&6[팀잠금] &f잠긴 팀: %bgLockStatus()% &7(/팀잠금 <레드|블루|그린|옐로> · /팀잠금 해제)"
            stop
        if arg-1 is "해제" or "초기화" or "전체해제":
            delete {bg::lock::*}
            bgSay("&6[팀잠금] &f모든 팀 잠금을 풀었습니다.")
            stop
        set {_t} to bgTeamId(arg-1)
        if {_t} is "none":
            send "&c[팀잠금] 팀: 레드 · 블루 · 그린 · 옐로 (red · blue · green · yellow)"
            stop
        if bgLocked({_t}) is true:
            delete {bg::lock::%{_t}%}
            bgSay("&6[팀잠금] %{-bg::tcol::%{_t}%}%%{-bg::tname::%{_t}%}% 팀&f 잠금 해제")
        else:
            set {bg::lock::%{_t}%} to true
            bgSay("&6[팀잠금] %{-bg::tcol::%{_t}%}%%{-bg::tname::%{_t}%}% 팀&f 잠금 — 이 팀에는 아무도 배정되지 않습니다")
            if bgTeamCount({_t}) > 0:
                send "&7  이미 이 팀에 있는 %bgTeamCount({_t})%명은 그대로입니다. &e/전장 자동팀&7 을 다시 하면 다른 팀으로 나뉩니다." to sender
        send "&6[팀잠금] &f잠긴 팀: %bgLockStatus()%" to sender

# ─────────────────────────────────────────────────────────── 중간 참가 (/중참)
#  게임 중에 들어온 사람(관전 중)이 /중참 → 이번 판에 참가한 팀 중 인원이 가장 적은 팀(같으면 점수가 낮은 팀)으로 바로 참가
#  늦게 온 만큼 코인을 채워 줌 (20 + 지난 10초마다 1, 최대 200)
#  관리자: /중참 <닉네임> (대신 넣기) · /중참 끔 | 켬 (중간 참가 막기 · 허용)
function bgMidJoin(p: player):
    if {-bg::on} is not true:
        send "&6[중참] &7지금은 게임 중이 아닙니다 — 대기실에서 팀을 고르세요." to {_p}
        stop
    if bgTeam({_p}) is not "none":
        send "&6[중참] &7이미 %{-bg::tcol::%bgTeam({_p})%}%%{-bg::tname::%bgTeam({_p})%}% 팀&7입니다." to {_p}
        stop
    if bgOptOut({_p}) is true:
        send "&6[중참] &7관전자 모드입니다. 먼저 &e/관전자&7 로 끄세요." to {_p}
        stop
    # 이번 판에 참가한 팀 중에서 (시작할 때 사람이 있던 팀 · 2팀 판이면 그 2팀) 인원이 가장 적은 팀 (같으면 점수가 낮은 팀)
    set {_all::*} to {-bg::playing::*}
    if size of {_all::*} is 0:
        set {_all::*} to {-bg::teams::*}
    # 잠긴 팀(/팀잠금)은 빼고
    loop {_all::*}:
        if bgLocked(loop-value) is false:
            add loop-value to {_cand::*}
    if size of {_cand::*} is 0:
        send "&6[중참] &c들어갈 수 있는 팀이 없습니다 &7(모든 팀이 잠김)" to {_p}
        stop
    set {_best} to "none"
    set {_bn} to 999
    set {_bs} to 999999
    loop {_cand::*}:
        set {_n} to bgTeamCount(loop-value)
        set {_s} to {-bg::score::%loop-value%} ? 0
        if {_n} < {_bn}:
            set {_best} to loop-value
            set {_bn} to {_n}
            set {_bs} to {_s}
        else if {_n} is {_bn}:
            if {_s} < {_bs}:
                set {_best} to loop-value
                set {_bs} to {_s}
    bgSetupTeams()
    bgSetTeam({_p}, {_best})
    set {_c} to min(200, 20 + floor(({-bg::sec} ? 0) / 10))
    if ({bg::coin::%uuid of {_p}%} ? 0) < {_c}:
        set {bg::coin::%uuid of {_p}%} to {_c}
    bgSpawn({_p})
    bgTitleP({_p}, "%{-bg::tcol::%{_best}%}%&l%{-bg::tname::%{_best}%}% 팀 합류!", "&f늦게 온 만큼 코인 &e%{_c}%&f 지급 · &e/상점")
    bgSay("&a[중참] %{-bg::tcol::%{_best}%}%%name of {_p}%&f 님이 %{-bg::tcol::%{_best}%}%%{-bg::tname::%{_best}%}% 팀&f으로 중간 참가했습니다!")

command /중참 [<text>]:
    aliases: /midjoin
    trigger:
        if arg-1 is "끔":
            if player is not op:
                send "&c관리자만 쓸 수 있습니다."
                stop
            set {bg::cfg::nomidjoin} to true
            send "&6[중참] &f중간 참가 &c막음 &7(/중참 켬 으로 허용)"
            stop
        if arg-1 is "켬":
            if player is not op:
                send "&c관리자만 쓸 수 있습니다."
                stop
            delete {bg::cfg::nomidjoin}
            send "&6[중참] &f중간 참가 &a허용"
            stop
        if arg-1 is set:
            if player is not op:
                send "&c다른 사람을 넣는 건 관리자만 할 수 있습니다."
                stop
            set {_t} to arg-1 parsed as player
            if {_t} is not set:
                send "&c플레이어를 찾을 수 없습니다."
                stop
            bgMidJoin({_t})
            stop
        if {bg::cfg::nomidjoin} is true:
            send "&6[중참] &c지금은 관리자가 중간 참가를 막아 두었습니다."
            stop
        bgMidJoin(player)


# ─────────────────────────────────────────────────────────── 힐 (관리자)
#   /힐 : 나   /힐 <플레이어>   /힐 전체 : 접속한 모두
#   체력 · 배고픔 가득 + 불 끄기 + 독 · 시듦 · 허기 · 실명 · 멀미 · 어둠 제거 (코어 파괴 벌칙 같은 게임 효과는 그대로)
function bgHeal(p: player):
    heal {_p}
    set food level of {_p} to 20
    set saturation of {_p} to 20
    extinguish {_p}
    set {_n} to name of {_p}
    loop "poison", "wither", "hunger", "blindness", "nausea" and "darkness":
        bgCmd("effect clear %{_n}% %loop-value%")
    play sound "entity.player.levelup" with volume 0.6 with pitch 1.6 to {_p}
    bgParticle(location of {_p}, "heart", 0.5, 1, 0.5, 0, 8)

command /힐 [<text>]:
    aliases: /heal
    permission: op
    trigger:
        if arg-1 is not set:
            if sender is not a player:
                send "&c콘솔에서는 /힐 <플레이어|전체>"
                stop
            bgHeal(player)
            send "&a[힐] &f체력을 채웠습니다."
            stop
        if arg-1 is "전체" or "all" or "@a" or "모두":
            set {_k} to 0
            loop all players:
                bgHeal(loop-player)
                add 1 to {_k}
            bgSay("&a[힐] &f관리자가 모두의 체력을 채웠습니다 &7(%{_k}%명)")
            stop
        set {_t} to arg-1 parsed as player
        if {_t} is not set:
            send "&c[힐] 플레이어를 찾을 수 없습니다. &7(/힐 · /힐 <플레이어> · /힐 전체)"
            stop
        bgHeal({_t})
        send "&a[힐] &f%name of {_t}%의 체력을 채웠습니다."
        send "&a[힐] &f관리자가 체력을 채워 주었습니다." to {_t}


# ─────────────────────────────────────────────────────────── 구속 중에는 점프 금지
#   구속(slowness)이 걸려도 달리면서 점프하면 빨리 움직일 수 있었음 → 구속이 걸려 있는 동안 점프 힘을 0 으로
#   (병과 점프 값(base)은 건드리지 않고 덧붙이는 효과(modifier)만 넣고 뺌 · 구속이 풀리면 바로 원래대로)
every 5 ticks:
    loop all players:
        set {_pp} to loop-player
        set {_slow} to {_pp}.hasPotionEffect(PotionEffectType.SLOWNESS)
        set {_tagged} to {_pp}.getScoreboardTags().contains("bg_nojump")
        if {_slow} is true:
            if {_tagged} is false:
                bgCmd("tag %name of loop-player% add bg_nojump")
                bgCmd("attribute %name of loop-player% minecraft:jump_strength modifier add bg:nojump -1 add_multiplied_total")
        else if {_tagged} is true:
            bgCmd("tag %name of loop-player% remove bg_nojump")
            bgCmd("attribute %name of loop-player% minecraft:jump_strength modifier remove bg:nojump")

# 나갔다 들어오면 남아 있을 수 있는 점프 금지 풀기
on join:
    remove "bg_nojump" from scoreboard tags of player
    bgCmd("attribute %name of player% minecraft:jump_strength modifier remove bg:nojump")

