# ═════════════════════════════════════════════════════════════════════════════
#  신화 아케이드 — 서버 첫 화면 허브 (여러 컨텐츠를 고르는 오락실 광장)
#   접속하면 허브로 → 오락기 앞 빛나는 발판을 밟거나 /컨텐츠 로 고르기 (오락기 화면에 컨텐츠 이름이 크게 뜸)
#     신화쟁탈전 (대기실) · PvP 온리소드 (전용 네온 경기장) · 경찰과 도둑 (밤 대도시) · 준비 중 1
#   허브에 있는 동안은 그 사람 화면만 밤 · 맑음 (월드 시간은 그대로 → 다른 맵은 아침)
#   /허브 (/hub, /스폰) : 허브로 돌아가기
#   관리자: /허브 건설 [여기] (처음 한 번 · 약 6초) · /허브 전체 (모두 허브로) · /허브 글자 · /허브 위치
#           /컨텐츠 잠금|열기 <신화쟁탈전|온리소드|경도|준비2> (잠그면 관리자 말고는 못 들어감)
#           /신화쟁탈전 [@a|플레이어] : 신화쟁탈전 대기실로 (@a = 접속한 모두, 게임 중인 사람 · 관전자 모드 제외)
#   허브 모양: arena/tools/hubgen.py (데이터팩 bg:hub/build · 표지 좌표 a09-gen-hub.sk)
#   허브 원점 = 광장 가운데 바닥 칸 {bg::hub::x/y/z} (기본: 전장 원점 기준 128, 40, -340 · 연습장 북쪽 하늘)
# ═════════════════════════════════════════════════════════════════════════════

import:
    org.bukkit.WeatherType

function bgHubReady() :: boolean:
    if {bg::hub::built} is true:
        if {bg::hub::x} is set:
            return true
    return false

function bgHubAt(dx: number, dy: number, dz: number) :: location:
    return location({bg::hub::x} + {_dx}, {bg::hub::y} + {_dy}, {bg::hub::z} + {_dz}, bgWorld())

function bgHubMk(n: text) :: location:
    set {_l} to bgHubAt({-bg::hubmk::%{_n}%::x}, {-bg::hubmk::%{_n}%::y}, {-bg::hubmk::%{_n}%::z})
    if {-bg::hubmk::%{_n}%::yaw} is set:
        set yaw of {_l} to {-bg::hubmk::%{_n}%::yaw}
    return {_l}

function bgInHub(p: player) :: boolean:
    if bgHubReady() is false:
        return false
    if world of {_p} is not bgWorld():
        return false
    if bgDist2(location of {_p}, bgHubAt(0.5, 0, 0.5)) > 86:
        return false
    set {_dy} to (y-coordinate of {_p}) - {bg::hub::y}
    if {_dy} < -40:
        return false
    if {_dy} > 80:
        return false
    return true

# 게임 중인 참가자 (허브 · 다른 컨텐츠로 보내면 안 됨)
function bgInGame(p: player) :: boolean:
    if {-bg::on} is true:
        if bgTeam({_p}) is not "none":
            return true
    return false

# 명령에 쓰는 이름 → 컨텐츠 id
function bgHubKey(t: text) :: text:
    if {_t} is "신화쟁탈전" or "신화" or "myth":
        return "myth"
    if {_t} is "온리소드" or "pvp" or "os":
        return "pvp"
    if {_t} is "경도" or "cops" or "kd":
        return "cops"
    if {_t} is "준비2" or "soon2":
        return "soon2"
    return ""

function bgHubName(k: text) :: text:
    if {_k} is "myth":
        return "&6&l신화쟁탈전"
    if {_k} is "pvp":
        return "&c&lPvP 온리소드"
    if {_k} is "cops":
        return "&9&l경찰&f&l과 &c&l도둑"
    return "&e&l준비 중 &7(2)"

function bgHubLocked(k: text) :: boolean:
    if {bg::cfg::clock::%{_k}%} is true:
        return true
    return false

function bgHubCount(k: text) :: number:
    set {_n} to 0
    loop all players:
        if {_k} is "pvp":
            if bgOsOn(loop-player) is true:
                add 1 to {_n}
        else if {_k} is "cops":
            if bgKdOn(loop-player) is true:
                add 1 to {_n}
        else if {_k} is "myth":
            if {-bg::on} is true:
                if bgTeam(loop-player) is not "none":
                    add 1 to {_n}
            else if bgInLobby(loop-player) is true:
                add 1 to {_n}
        else if {_k} is "hub":
            if bgInHub(loop-player) is true:
                add 1 to {_n}
    return {_n}

# 지금 상태 한 줄 (색 코드 없음 — 홀로그램 · 화면 둘 다 씀)
function bgHubStatus(k: text) :: text:
    if {_k} is "soon2":
        return "곧 새로운 컨텐츠가 열립니다"
    if bgHubLocked({_k}) is true:
        return "잠김 · 관리자가 막아 두었습니다"
    set {_n} to bgHubCount({_k})
    if {_k} is "myth":
        if {-bg::on} is true:
            return "게임 진행 중 · 참가자 %{_n}%명 · 관전 / 중참"
        return "대기실 %{_n}%명 · 팀을 골라 4팀 점령전"
    if {_k} is "cops":
        if {-bg::kd::state} is "play":
            set {_f} to bgKdCount("free")
            set {_t} to bgKdCount("thief")
            return "진행 중 · %{_n}%명 · 남은 도둑 %{_f}%/%{_t}%"
        return "대기 %{_n}%명 · 시참 컨텐츠 · 경찰 vs 도둑"
    set {_top} to bgOsTop()
    if {_top} is not "":
        return "%{_n}%명 싸우는 중 · 킬 1위 %{_top}%"
    return "%{_n}%명 싸우는 중 · 다이아 검 하나로 승부"

# ─────────────────────────────────────────────────────────── 허브로 · 컨텐츠로
function bgToHub(p: player):
    if bgHubReady() is false:
        bgToLobby({_p})
        stop
    bgOsDrop({_p})
    bgKdDrop({_p})
    delete {-bg::pk::in::%uuid of {_p}%}
    if {-bg::pvp::%uuid of {_p}%} is true:
        delete {-bg::pvp::%uuid of {_p}%}
        delete {-bg::pvpa::%uuid of {_p}%}
    set {-bg::where::%uuid of {_p}%} to "hub"
    delete {-bg::hubpad::%uuid of {_p}%}
    teleport {_p} to bgHubMk("spawn")
    bgClassReset({_p})
    set gamemode of {_p} to adventure
    heal {_p}
    set food level of {_p} to 20
    clear {_p}'s inventory
    bgCmd("effect clear %name of {_p}%")
    extinguish {_p}
    # 허브에 있는 사람은 신화쟁탈전 팀에서 빠짐 (/신화쟁탈전 으로 대기실에 가서 다시 고름)
    if {-bg::on} is not true:
        if bgTeam({_p}) is not "none":
            bgSetTeam({_p}, "none")
    bgHubNight({_p}, true)

# 신화쟁탈전으로: 게임 전이면 대기실 · 게임 중이면 관전 (/중참 으로 참가)
function bgMythJoin(p: player):
    if bgInGame({_p}) is true:
        stop
    delete {-bg::pk::in::%uuid of {_p}%}
    if {-bg::pvp::%uuid of {_p}%} is true:
        delete {-bg::pvp::%uuid of {_p}%}
        delete {-bg::pvpa::%uuid of {_p}%}
    if {-bg::on} is not true:
        bgToLobby({_p})
        set {_logo} to {-bg::title::logo} ? "&6&l신화쟁탈전"
        bgTitleP({_p}, {_logo}, "&f팀 발판을 밟아 팀을 고르세요 &7· /허브 로 돌아가기")
        stop
    bgMythSpectate({_p})

# 허브 안에서만 그 사람 화면을 한밤중 · 맑음으로 (월드 시간은 안 바뀜 → 다른 맵은 아침 그대로)
function bgHubNight(p: player, on: boolean):
    if {_on} is true:
        set {-bg::hubnight::%uuid of {_p}%} to true
        {_p}.setPlayerTime(18000, false)
        {_p}.setPlayerWeather(WeatherType.CLEAR)
        stop
    delete {-bg::hubnight::%uuid of {_p}%}
    {_p}.resetPlayerTime()
    {_p}.resetPlayerWeather()

function bgHubSoon(p: player):
    bgTitleP({_p}, "&7&l준비 중", "&f곧 새로운 컨텐츠가 열립니다!")
    play sound "block.note_block.bass" to {_p}

function bgHubGo(p: player, k: text):
    if {_k} is "soon2":
        bgHubSoon({_p})
        stop
    if bgHubLocked({_k}) is true:
        if {_p} is not op:
            bgTitleP({_p}, "&c&l잠김", "%bgHubName({_k})%&f 은(는) 지금 관리자가 막아 두었습니다")
            play sound "block.note_block.bass" to {_p}
            stop
        send "&b[허브] &7잠겨 있지만 관리자라 들어갑니다." to {_p}
    if {_k} is "myth":
        play sound "entity.enderman.teleport" to {_p}
        bgMythJoin({_p})
    else if {_k} is "pvp":
        bgOsEnter({_p})
    else if {_k} is "cops":
        bgKdJoin({_p})

# ─────────────────────────────────────────────────────────── 짓기 · 이름표
function bgHubBuild(p: player, here: boolean = false):
    if {_here} is true:
        if world of {_p} is not bgWorld():
            send "&b[허브] &c허브는 전장 월드(%name of bgWorld()%)에만 지을 수 있습니다." to {_p}
            stop
        set {bg::hub::x} to floor(x-coordinate of {_p})
        set {bg::hub::y} to floor(y-coordinate of {_p})
        set {bg::hub::z} to floor(z-coordinate of {_p})
    else if {bg::hub::x} is not set:
        set {bg::hub::x} to floor(({bg::cfg::ox} ? 0) + 128)
        set {bg::hub::y} to floor(({bg::cfg::oy} ? 64) + 40)
        set {bg::hub::z} to floor(({bg::cfg::oz} ? 0) - 340)
    # 섬 바닥(-16) ~ 안테나(+67) 가 월드 높이 안에 들어가게
    set {bg::hub::y} to max(-48, min(250, {bg::hub::y}))
    bgCmd("data merge storage bg:hub {origin:{x:%{bg::hub::x}%,y:%{bg::hub::y}%,z:%{bg::hub::z}%}}")
    send "&b[허브] &f신화 아케이드 허브를 짓는 중... &7(약 6초 · 큰 건물이라 잠깐 끊길 수 있음) &8위치 %{bg::hub::x}% %{bg::hub::y}% %{bg::hub::z}%" to {_p}
    bgCmd("function bg:hub/build")
    wait 250 ticks
    set {bg::hub::built} to true
    teleport {_p} to bgHubMk("spawn")
    wait 40 ticks
    bgHubTexts()
    send "&b[허브] &a허브 완성! &f이제 접속하는 사람은 모두 여기로 옵니다." to {_p}
    # 이어서 온리소드 경기장 (허브 동쪽) · 경도 도시 (허브 북쪽)
    send "&b[허브] &f온리소드 경기장 · 경도 도시 · 포털 파쿠르도 짓는 중... &7(약 35초)" to {_p}
    bgCmd("data merge storage bg:os {origin:{x:%{bg::hub::x} + 230%,y:%{bg::hub::y}%,z:%{bg::hub::z}%}}")
    bgCmd("function bg:os/build")
    wait 100 ticks
    set {bg::os::built} to true
    bgCmd("data merge storage bg:kd {origin:{x:%{bg::hub::x}%,y:%{bg::hub::y}%,z:%{bg::hub::z} - 260%}}")
    bgCmd("function bg:kd/build")
    wait 380 ticks
    set {bg::kd::built} to true
    set {-bg::kd::state} to "wait"
    # 포털 파쿠르 (허브 남쪽 하늘)
    bgCmd("data merge storage bg:pk {origin:{x:%{bg::hub::x}%,y:%{bg::hub::y} + 10%,z:%{bg::hub::z} + 200%}}")
    bgCmd("function bg:pk/build")
    wait 200 ticks
    set {bg::pk::built} to true
    send "&b[허브] &a온리소드 · 경도 · 포털 파쿠르도 완성! &7(경도 안내 글자는 처음 들어갈 때 /경도 글자)" to {_p}
    send "&b[허브] &7오락기 이름표가 안 보이면 &e/허브 글자 &7· 위치 확인 &e/허브 위치" to {_p}

# 오락기 발판 위 떠 있는 이름표 (이름 · 지금 상태 · 안내)
function bgHubTextSet(k: text):
    set {_c} to "gold"
    set {_nm} to "신화쟁탈전"
    if {_k} is "pvp":
        set {_c} to "red"
        set {_nm} to "PvP 온리소드"
    else if {_k} is "cops":
        set {_c} to "blue"
        set {_nm} to "경찰과 도둑"
    else if {_k} is "soon2":
        set {_c} to "yellow"
        set {_nm} to "준비 중"
    set {_st} to bgHubStatus({_k})
    set {_sc} to "white"
    set {_hint} to "▼ 발판을 밟으면 입장"
    if bgHubLocked({_k}) is true:
        set {_sc} to "red"
        set {_hint} to "관리자만 들어갈 수 있습니다"
    if {_k} is "soon2":
        set {_sc} to "gray"
        set {_hint} to "조금만 기다려 주세요"
    bgCmd("execute as @e[type=text_display,tag=bghub_%{_k}%] run data modify entity @s text set value [{text:""%{_nm}%"",color:""%{_c}%"",bold:true},{text:""\n%{_st}%"",color:""%{_sc}%"",bold:false},{text:""\n%{_hint}%"",color:""gray"",bold:false}]")

function bgHubTextAll():
    loop "myth", "pvp", "cops" and "soon2":
        bgHubTextSet(loop-value)

# 오락기 빛나는 화면에 크게 뜨는 오락실 로고 (리소스팩 글꼴 bg:hubscr 의 글자 하나 = 로고 그림 하나, rp/hubscreen.py)
#  화면 앞면에 붙은 text_display (오락기가 보는 방향) · 화면(가로 13 × 세로 9칸) 안 12 × 8.4칸에 맞춰 크기를 정함
#  글꼴 1픽셀 = 크기/40 칸. 로고 아래끝은 text_display 자리보다 2.5픽셀 위 → 로고 가운데를 화면 가운데(바닥 + 18.5)에
function bgHubScreen(k: text):
    set {_g} to {_k}
    if {_k} is "soon2":
        set {_g} to "soon"
    set {_l} to bgHubMk("%{_k}%_screen")
    set {_yaw} to {-bg::hubmk::%{_k}%_screen::yaw} ? 0
    if {-bg::hubscr::%{_g}%::ch} is set:
        set {_w} to {-bg::hubscr::%{_g}%::w}
        set {_h} to {-bg::hubscr::%{_g}%::h}
        set {_s} to min(12 * 40 / {_w}, 8.4 * 40 / {_h})
        set {_y} to (y-coordinate of {_l}) - (2.5 + {_h} / 2) * {_s} / 40
        set {_txt} to "{text:""%{-bg::hubscr::%{_g}%::ch}%"",font:""bg:hubscr"",color:""white""}"
    else:
        # 리소스팩 글꼴이 없을 때: 그냥 글자
        set {_nm} to "신화쟁탈전"
        if {_g} is "pvp":
            set {_nm} to "PvP 온리소드"
        else if {_g} is "cops":
            set {_nm} to "경찰과 도둑"
        else if {_g} is "soon":
            set {_nm} to "준비 중"
        set {_s} to 6
        set {_y} to (y-coordinate of {_l}) - 1
        set {_txt} to "{text:""%{_nm}%"",color:""dark_blue"",bold:true}"
    set {_pos} to "%bgC(x-coordinate of {_l})% %bgN({_y})% %bgC(z-coordinate of {_l})%"
    bgCmd("execute in %bgDim()% run summon text_display %{_pos}% {Tags:[""bghub"",""bghubscr""],Rotation:[%bgN({_yaw})%f,0f],billboard:""fixed"",shadow:0b,background:0,line_width:600,brightness:{sky:15,block:15},view_range:4f,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[%bgN({_s})%f,%bgN({_s})%f,%bgN({_s})%f]},text:%{_txt}%}")

function bgHubTexts():
    bgCmd("kill @e[type=text_display,tag=bghub]")
    loop "myth", "pvp", "cops" and "soon2":
        bgHubScreen(loop-value)
        set {_l} to bgHubMk("%loop-value%_label")
        bgCmd("execute in %bgDim()% run summon text_display %bgC(x-coordinate of {_l})% %bgN(y-coordinate of {_l})% %bgC(z-coordinate of {_l})% {Tags:[""bghub"",""bghub_%loop-value%""],billboard:""center"",shadow:1b,background:1073741824,brightness:{sky:15,block:15},view_range:3f,line_width:300,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1.5f,1.5f,1.5f]},text:{text:""""}}")
    bgHubTextAll()

every 2 seconds:
    bgHubReady() is true
    bgHubCount("hub") > 0
    bgHubTextAll()

# ─────────────────────────────────────────────────────────── 발판 · 허브 안 보호
# 발판에 올라선 순간 한 번만 (내려갔다 다시 올라오면 또)
every 5 ticks:
    bgHubReady() is true
    loop all players:
        set {_pp} to loop-player
        set {_ar} to bgArea({_pp})
        # 허브 · 온리소드 · 경도 = 밤 (그 사람 화면만), 신화쟁탈전 = 원래 시간
        if {_ar} is "myth":
            if {-bg::hubnight::%uuid of {_pp}%} is set:
                bgHubNight({_pp}, false)
        else if {-bg::hubnight::%uuid of {_pp}%} is not set:
            bgHubNight({_pp}, true)
        if {_ar} is "hub":
            set food level of loop-player to 20
            if (y-coordinate of loop-player) < {bg::hub::y} - 6:
                teleport loop-player to bgHubMk("spawn")
                play sound "entity.enderman.teleport" to loop-player
            set {_on} to ""
            loop "myth", "pvp", "cops" and "soon2":
                set {_pl} to bgHubMk("%loop-value-2%_pad")
                if bgDist2(location of loop-player, {_pl}) < 2.6:
                    if abs((y-coordinate of loop-player) - (y-coordinate of {_pl})) < 1.6:
                        set {_on} to loop-value-2
            set {_prev} to {-bg::hubpad::%uuid of loop-player%} ? ""
            if {_on} is not {_prev}:
                set {-bg::hubpad::%uuid of loop-player%} to {_on}
                if {_on} is not "":
                    bgHubGo(loop-player, {_on})

on damage of player:
    bgInHub(victim) is true
    cancel event

on break:
    bgInHub(player) is true
    gamemode of player is not creative
    cancel event

on place:
    bgInHub(player) is true
    gamemode of player is not creative
    cancel event

on drop:
    bgInHub(player) is true
    gamemode of player is not creative
    cancel event

on respawn:
    {-bg::pvp::%uuid of player%} is not true
    bgInGame(player) is false
    bgHubReady() is true
    {-bg::where::%uuid of player%} is "hub"
    set respawn location to bgHubMk("spawn")

on quit:
    delete {-bg::hubnight::%uuid of player%}
    delete {-bg::where::%uuid of player%}
    delete {-bg::hubpad::%uuid of player%}
    delete {-bg::hubgui::%uuid of player%}

# ─────────────────────────────────────────────────────────── 컨텐츠 고르기 화면 (/컨텐츠)
function bgHubMenuItem(p: player, k: text) :: item:
    if {_k} is "myth":
        set {_it} to golden helmet
        set {_lore::*} to "&74팀이 대신전과 제단을 두고 싸우는 점령전", "&7보스 · 전설 무기 · 팀 강화"
    else if {_k} is "pvp":
        set {_it} to iron sword
        set {_lore::*} to "&7다이아 갑옷 + 다이아 검 하나로 싸우는 개인전", "&7처치하면 체력 회복 · 킬 랭킹 · 네온 경기장"
    else if {_k} is "cops":
        set {_it} to iron bars
        set {_lore::*} to "&7밤 대도시에서 경찰 vs 도둑 (시참 컨텐츠)", "&7도둑: 털이 · 탈출 / 경찰: 체포 · 감옥"
    else:
        set {_it} to orange dye
        set {_lore::*} to "&7새로운 컨텐츠를 만드는 중입니다"
    add "" to {_lore::*}
    if {_k} is "soon2":
        add "&8곧 열립니다" to {_lore::*}
    else if bgHubLocked({_k}) is true:
        add "&c잠김 &7(관리자만 입장)" to {_lore::*}
    else:
        add "&f%bgHubStatus({_k})%" to {_lore::*}
        add "" to {_lore::*}
        add "&a▶ 클릭해서 입장" to {_lore::*}
    set name of {_it} to bgHubName({_k})
    set lore of {_it} to {_lore::*}
    return {_it}

function bgHubMenu(p: player):
    set {_gui} to chest inventory with 3 rows named "&8&l신화 아케이드 &8| &7컨텐츠 고르기"
    set {_pane} to black stained glass pane named " "
    loop 27 times:
        set slot loop-number - 1 of {_gui} to {_pane}
    set slot 10 of {_gui} to bgHubMenuItem({_p}, "myth")
    set slot 12 of {_gui} to bgHubMenuItem({_p}, "pvp")
    set slot 14 of {_gui} to bgHubMenuItem({_p}, "cops")
    set slot 16 of {_gui} to bgHubMenuItem({_p}, "soon2")
    set {_h} to nether star named "&b&l허브로"
    set lore of {_h} to "&7오락실 광장으로 돌아갑니다"
    set slot 22 of {_gui} to {_h}
    open {_gui} to {_p}
    set {-bg::hubgui::%uuid of {_p}%} to true
    play sound "block.note_block.chime" to {_p}

on inventory close:
    delete {-bg::hubgui::%uuid of player%}

on inventory drag:
    {-bg::hubgui::%uuid of player%} is true
    cancel event

on inventory click:
    {-bg::hubgui::%uuid of player%} is true
    cancel event
    set {_s} to raw index of event-slot
    set {_k} to ""
    if {_s} is 10:
        set {_k} to "myth"
    else if {_s} is 12:
        set {_k} to "pvp"
    else if {_s} is 14:
        set {_k} to "cops"
    else if {_s} is 16:
        set {_k} to "soon2"
    else if {_s} is 22:
        close player's inventory
        if bgInGame(player) is true:
            send "&b[허브] &c게임 중에는 허브로 갈 수 없습니다." to player
            stop
        bgToHub(player)
        stop
    {_k} is not ""
    close player's inventory
    play sound "ui.button.click" to player
    wait 1 tick
    bgHubGo(player, {_k})

# ─────────────────────────────────────────────────────────── 컨텐츠마다 다른 서버처럼 (명령어 나누기)
#  허브 · 온리소드 연습장에서는 신화쟁탈전 명령어를 못 씀 (신화쟁탈전 안에서만)
#   참가자 명령 (/상점 · /코인 · /로비 · /중참 · /팀 · /팀채팅) = 모두 막음
#   관리자 명령 (/전장 · /팀잠금 · /네메시스 · /코인주기 …) = 관리자(OP)는 어디서든 씀 (운영용), 아닌 사람은 막음
#  신화쟁탈전 안에서는 온리소드 입장 명령 (/연습장 · /무기) 을 못 씀 → /허브 의 PvP 오락기로 (/연습장 랭킹 · 전적은 됨)
#  어디서나: /허브 · /신화쟁탈전 · /컨텐츠 · /리팩 · /힐 · /업데이트테스트
function bgArea(p: player) :: text:
    if {-bg::pk::in::%uuid of {_p}%} is true:
        return "pk"
    if {-bg::kd::in::%uuid of {_p}%} is true:
        return "kd"
    if {-bg::os::in::%uuid of {_p}%} is true:
        return "os"
    if bgInHub({_p}) is true:
        return "hub"
    return "myth"

on load:
    set {-bg::cmdzone::myth_player::*} to "상점", "shop", "코인", "로비", "lobby", "중참", "midjoin", "팀", "tc", "팀채팅", "연습장", "pvp장", "pvp" and "무기"
    set {-bg::cmdzone::myth_admin::*} to "전장", "bg", "코인주기", "givecoin", "코인설정", "자유팀선택", "팀초기화", "광석막대", "관전자", "nogame", "관전자목록", "tnt함정", "팀잠금", "teamlock", "네메시스" and "nemesis"

on command:
    sender is a player
    bgHubReady() is true
    set {_c} to "%command%"
    if {_c} contains ":":
        set {_c} to last element of ({_c} split at ":")
    set {_area} to bgArea(player)
    {_area} is not "myth"
    set {_block} to false
    if {-bg::cmdzone::myth_player::*} contains {_c}:
        set {_block} to true
    else if {-bg::cmdzone::myth_admin::*} contains {_c}:
        if player is not op:
            set {_block} to true
    {_block} is true
    cancel event
    if {_area} is "hub":
        send "&b[허브] &7여기는 허브입니다. 신화쟁탈전 명령어는 신화쟁탈전 안에서만 쓸 수 있어요. &e/신화쟁탈전 &7으로 이동"
    else if {_area} is "os":
        send "&c[온리소드] &7신화쟁탈전 명령어는 신화쟁탈전 안에서만 쓸 수 있어요. &e/온리소드 나가기 &7또는 &e/허브"
    else if {_area} is "pk":
        send "&d[파쿠르] &7신화쟁탈전 명령어는 신화쟁탈전 안에서만 쓸 수 있어요. &e/파쿠르 나가기 &7또는 &e/허브"
    else:
        send "&9[경도] &7신화쟁탈전 명령어는 신화쟁탈전 안에서만 쓸 수 있어요. &e/경도 나가기 &7또는 &e/허브"
    play sound "block.note_block.bass" to player

# ─────────────────────────────────────────────────────────── 명령
command /허브 [<text>] [<text>]:
    aliases: /hub, /스폰
    trigger:
        set {_op} to true
        if sender is a player:
            if player is not op:
                set {_op} to false
        if {_op} is true:
            if arg-1 is "건설":
                if sender is not a player:
                    send "&c게임 안에서 실행해 주세요."
                    stop
                if arg-2 is "여기":
                    bgHubBuild(player, true)
                else:
                    bgHubBuild(player)
                stop
            if arg-1 is "위치":
                if {bg::hub::x} is not set:
                    send "&b[허브] &f아직 위치가 없습니다. &e/허브 건설 &f(기본 위치) 또는 &e/허브 건설 여기"
                    stop
                set {_b} to "&c아직 안 지어짐 &7(/허브 건설)"
                if bgHubReady() is true:
                    set {_b} to "&a지어짐"
                send "&b[허브] &f위치 &e%{bg::hub::x}% %{bg::hub::y}% %{bg::hub::z}% &7(%name of bgWorld()%) · %{_b}%"
                stop
            if arg-1 is "글자":
                bgHubTexts()
                send "&b[허브] &f오락기 이름표를 다시 만들었습니다."
                stop
            if arg-1 is "전체" or "@a":
                if bgHubReady() is false:
                    send "&b[허브] &c허브가 아직 없습니다. &e/허브 건설"
                    stop
                set {_n} to 0
                loop all players:
                    if bgInGame(loop-player) is false:
                        if bgOptOut(loop-player) is false:
                            bgToHub(loop-player)
                            add 1 to {_n}
                broadcast "&b[허브] &f관리자가 &e%{_n}%명&f을 허브로 불렀습니다."
                stop
        if sender is not a player:
            send "&c사용법: /허브 전체 · /허브 위치 &7(컨텐츠별 전체 이동: /신화쟁탈전 전체 · /경도 전체 · /파쿠르 전체)"
            stop
        if bgHubReady() is false:
            send "&b[허브] &c허브가 아직 없습니다. &7관리자가 &e/허브 건설 &7을 한 번 실행해 주세요."
            stop
        if bgInGame(player) is true:
            send "&b[허브] &c게임 중에는 허브로 갈 수 없습니다."
            stop
        bgToHub(player)
        play sound "entity.enderman.teleport" to player

command /신화쟁탈전 [<text>]:
    aliases: /myth
    trigger:
        if arg-1 is not set:
            if sender is not a player:
                send "&c사용법: /신화쟁탈전 @a · /신화쟁탈전 <플레이어>"
                stop
            if bgInGame(player) is true:
                send "&6[신화쟁탈전] &7이미 게임 중입니다."
                stop
            bgHubGo(player, "myth")
            stop
        if sender is a player:
            if player is not op:
                send "&c다른 사람을 보내는 건 관리자만 할 수 있습니다."
                stop
        if arg-1 is "@a" or "전체" or "all":
            set {_n} to 0
            loop all players:
                if bgInGame(loop-player) is false:
                    if bgOptOut(loop-player) is false:
                        bgMythJoin(loop-player)
                        add 1 to {_n}
            broadcast "&6[신화쟁탈전] &f관리자가 &e%{_n}%명&f을 신화쟁탈전으로 보냈습니다."
            stop
        set {_t} to arg-1 parsed as player
        if {_t} is not set:
            send "&c플레이어를 찾을 수 없습니다: %arg-1%"
            stop
        if bgInGame({_t}) is true:
            send "&6[신화쟁탈전] &7%name of {_t}% 은(는) 이미 게임 중입니다."
            stop
        bgMythJoin({_t})
        send "&6[신화쟁탈전] &f%name of {_t}% 을(를) 신화쟁탈전으로 보냈습니다."

command /컨텐츠 [<text>] [<text>]:
    aliases: /content
    trigger:
        if arg-1 is "잠금" or "열기":
            if sender is a player:
                if player is not op:
                    send "&c관리자만 쓸 수 있습니다."
                    stop
            set {_a2} to arg-2 ? ""
            set {_k} to bgHubKey({_a2})
            if {_k} is "":
                send "&b[허브] &f/컨텐츠 %arg-1% <신화쟁탈전|온리소드|경도|준비2>"
                stop
            if arg-1 is "잠금":
                set {bg::cfg::clock::%{_k}%} to true
                set {_m} to ""
                if {_k} is "pvp":
                    set {_m} to " &7(온리소드에 있던 %bgOsKickAll()%명 허브로)"
                else if {_k} is "cops":
                    set {_n} to 0
                    loop all players:
                        if bgKdOn(loop-player) is true:
                            bgKdLeave(loop-player)
                            add 1 to {_n}
                    set {_m} to " &7(경도에 있던 %{_n}%명 허브로)"
                broadcast "&b[허브] %bgHubName({_k})% &f이(가) &c잠겼습니다%{_m}%"
            else:
                delete {bg::cfg::clock::%{_k}%}
                broadcast "&b[허브] %bgHubName({_k})% &f이(가) &a열렸습니다 &7— 허브 오락기에서 입장"
            if bgHubReady() is true:
                bgHubTextAll()
            stop
        if arg-1 is "목록" or "상태":
            loop "myth", "pvp", "cops" and "soon2":
                send "&b[허브] %bgHubName(loop-value)% &7— &f%bgHubStatus(loop-value)%"
            stop
        if sender is not a player:
            send "&c사용법: /컨텐츠 잠금|열기 <신화쟁탈전|온리소드|경도|준비2> · /컨텐츠 목록"
            stop
        if bgInGame(player) is true:
            send "&b[허브] &c게임 중에는 다른 컨텐츠로 갈 수 없습니다."
            stop
        bgHubMenu(player)

# ─────────────────────────────────────────────────────────── 탭 목록 (Tab): 있는 곳끼리 묶기
#  마크 탭 목록은 팀 이름 순서로 정렬됨 → 0hub(허브) · 0hubpk(파쿠르: 서로 안 보이고 안 밀림) · 1myth(신화쟁탈전 대기) · bg_*(신화쟁탈전 팀) · kd_*(경도) · os(온리소드)
#  위(머리말)에 제목, 아래(꼬리말)에 곳마다 인원
on load:
    bgCmd("team add 0hub")
    bgCmd("team add 1myth")
    bgCmd("team add os_play")
    bgCmd("team modify 0hub color aqua")
    bgCmd("team modify 1myth color gold")
    bgCmd("team modify os_play color red")
    bgCmd("team modify 0hub prefix [{text:"""",font:""bg:hubscr"",color:""white""},{text:"" "",font:""minecraft:default""}]")
    # 파쿠르: 같은 팀끼리도 투명한 사람이 안 보이게 · 이름표 숨김 · 몸끼리 안 밀림
    bgCmd("team add 0hubpk")
    bgCmd("team modify 0hubpk color aqua")
    bgCmd("team modify 0hubpk collisionRule never")
    bgCmd("team modify 0hubpk nametagVisibility never")
    bgCmd("team modify 0hubpk seeFriendlyInvisibles false")
    bgCmd("team modify 0hubpk prefix [{text:"""",font:""bg:hubscr"",color:""white""},{text:"" "",font:""minecraft:default""}]")
    bgCmd("team modify 1myth prefix [{text:"""",font:""bg:hubscr"",color:""white""},{text:"" "",font:""minecraft:default""}]")
    bgCmd("team modify os_play prefix [{text:"""",font:""bg:hubscr"",color:""white""},{text:"" "",font:""minecraft:default""}]")

every 1 second:
    set {_nh} to 0
    set {_nm} to 0
    set {_no} to 0
    set {_nk} to 0
    set {_np} to 0
    loop all players:
        set {_pp} to loop-player
        set {_ar} to bgArea({_pp})
        set {_want} to ""
        if {_ar} is "hub":
            add 1 to {_nh}
            set {_want} to "0hub"
        else if {_ar} is "os":
            add 1 to {_no}
            set {_want} to "os_play"
        else if {_ar} is "kd":
            add 1 to {_nk}
        else if {_ar} is "pk":
            add 1 to {_np}
            set {_want} to "0hubpk"
        else:
            add 1 to {_nm}
            if bgTeam({_pp}) is "none":
                set {_want} to "1myth"
        set {_u} to "%uuid of {_pp}%"
        if {_want} is "":
            delete {-bg::tabteam::%{_u}%}
        else if {-bg::tabteam::%{_u}%} is not {_want}:
            set {-bg::tabteam::%{_u}%} to {_want}
            bgCmd("team join %{_want}% %name of {_pp}%")
    set {_head} to "§b§l신화 아케이드§r%nl%§7오락기 앞 발판으로 컨텐츠 이동 · /허브"
    # 문자열 (String, String) 짝으로 넘겨야 맞는 메서드가 잡힘 — colored 는 Adventure 컴포넌트라 안 맞음
    set {_foot} to "§b허브 §f%{_nh}%명  §6신화쟁탈전 §f%{_nm}%명  §c온리소드 §f%{_no}%명  §9경도 §f%{_nk}%명  §d파쿠르 §f%{_np}%명"
    loop all players:
        set {_pp} to loop-player
        {_pp}.setPlayerListHeaderFooter({_head}, {_foot})

on quit:
    delete {-bg::tabteam::%uuid of player%}

# ─────────────────────────────────────────────────────────── 나가기 버튼 (게임 로비 · 대기실 9번 칸, 우클릭 → 허브)
function bgExitItem(p: player):
    bgCmd("item replace entity %name of {_p}% hotbar.8 with paper[item_model=""bg:kd/exit"",custom_name={text:""나가기"",color:""red"",bold:true,italic:false},lore=[{text:""우클릭: 허브로 돌아가기"",color:""gray"",italic:false}]]")

on right click:
    player's tool is paper
    set {_nm} to uncolored name of player's tool
    {_nm} contains "나가기"
    cancel event
    set {_ar} to bgArea(player)
    if {_ar} is "kd":
        bgKdLeave(player)
    else if {_ar} is "pk":
        bgPkLeave(player)
    else if {_ar} is "os":
        bgOsLeave(player)
    else if {_ar} is "myth":
        if bgInGame(player) is true:
            send action bar "&c게임 중에는 나갈 수 없습니다" to player
            stop
        bgToHub(player)
    play sound "entity.enderman.teleport" to player
