# ═════════════════════════════════════════════════════════════════════════════
#  신화 아케이드 — 서버 첫 화면 허브 (여러 컨텐츠를 고르는 오락실 광장)
#   접속하면 허브로 → 오락기 앞 빛나는 발판을 밟거나, 나침반 우클릭 · /컨텐츠 로 고르기
#     신화쟁탈전 (대기실) · PvP 연습장 (투기장 고르기) · 준비 중 2
#   /허브 (/hub, /스폰) : 허브로 돌아가기
#   관리자: /허브 건설 [여기] (처음 한 번 · 약 6초) · /허브 전체 (모두 허브로) · /허브 글자 · /허브 위치
#           /컨텐츠 잠금|열기 <신화쟁탈전|연습장|준비1|준비2> (잠그면 관리자 말고는 못 들어감)
#           /신화쟁탈전 [@a|플레이어] : 신화쟁탈전 대기실로 (@a = 접속한 모두, 게임 중인 사람 · 관전자 모드 제외)
#   허브 모양: arena/tools/hubgen.py (데이터팩 bg:hub/build · 표지 좌표 a09-gen-hub.sk)
#   허브 원점 = 광장 가운데 바닥 칸 {bg::hub::x/y/z} (기본: 전장 원점 기준 128, 40, -340 · 연습장 북쪽 하늘)
# ═════════════════════════════════════════════════════════════════════════════

function bgHubReady() :: boolean:
    if {bg::hub::built} is true:
        if {bg::hub::x} is set:
            return true
    return false

function bgHubAt(dx: number, dy: number, dz: number) :: location:
    return location({bg::hub::x} + {_dx}, {bg::hub::y} + {_dy}, {bg::hub::z} + {_dz}, bgWorld())

function bgHubMk(n: text) :: location:
    set {_l} to bgHubAt({-bg::hubmk::%{_n}%::x}, {-bg::hubmk::%{_n}%::y}, {-bg::hubmk::%{_n}%::z})
    if {-bg::hubmk::%{_n}%::yaw} is set:
        set yaw of {_l} to {-bg::hubmk::%{_n}%::yaw}
    return {_l}

function bgInHub(p: player) :: boolean:
    if bgHubReady() is false:
        return false
    if world of {_p} is not bgWorld():
        return false
    if bgDist2(location of {_p}, bgHubAt(0.5, 0, 0.5)) > 86:
        return false
    set {_dy} to (y-coordinate of {_p}) - {bg::hub::y}
    if {_dy} < -40:
        return false
    if {_dy} > 80:
        return false
    return true

# 게임 중인 참가자 (허브 · 다른 컨텐츠로 보내면 안 됨)
function bgInGame(p: player) :: boolean:
    if {-bg::on} is true:
        if bgTeam({_p}) is not "none":
            return true
    return false

# 명령에 쓰는 이름 → 컨텐츠 id
function bgHubKey(t: text) :: text:
    if {_t} is "신화쟁탈전" or "신화" or "myth":
        return "myth"
    if {_t} is "연습장" or "pvp" or "PvP연습장":
        return "pvp"
    if {_t} is "준비1" or "soon1":
        return "soon1"
    if {_t} is "준비2" or "soon2":
        return "soon2"
    return ""

function bgHubName(k: text) :: text:
    if {_k} is "myth":
        return "&6&l신화쟁탈전"
    if {_k} is "pvp":
        return "&c&lPvP 연습장"
    if {_k} is "soon1":
        return "&d&l준비 중 &7(1)"
    return "&e&l준비 중 &7(2)"

function bgHubLocked(k: text) :: boolean:
    if {bg::cfg::clock::%{_k}%} is true:
        return true
    if {_k} is "pvp":
        if {bg::cfg::pvplock} is true:
            return true
    return false

function bgHubCount(k: text) :: number:
    set {_n} to 0
    loop all players:
        if {_k} is "pvp":
            if {-bg::pvp::%uuid of loop-player%} is true:
                add 1 to {_n}
        else if {_k} is "myth":
            if {-bg::on} is true:
                if bgTeam(loop-player) is not "none":
                    add 1 to {_n}
            else if bgInLobby(loop-player) is true:
                add 1 to {_n}
        else if {_k} is "hub":
            if bgInHub(loop-player) is true:
                add 1 to {_n}
    return {_n}

# 지금 상태 한 줄 (색 코드 없음 — 홀로그램 · 화면 둘 다 씀)
function bgHubStatus(k: text) :: text:
    if {_k} is "soon1" or "soon2":
        return "곧 새로운 컨텐츠가 열립니다"
    if bgHubLocked({_k}) is true:
        return "잠김 · 관리자가 막아 두었습니다"
    set {_n} to bgHubCount({_k})
    if {_k} is "myth":
        if {-bg::on} is true:
            return "게임 진행 중 · 참가자 %{_n}%명 · 관전 / 중참"
        return "대기실 %{_n}%명 · 팀을 골라 4팀 점령전"
    return "%{_n}%명 싸우는 중 · 전설 무기 무료"

# ─────────────────────────────────────────────────────────── 허브로 · 컨텐츠로
function bgHubCompass() :: item:
    set {_i} to compass named "&b&l컨텐츠 고르기 &7(우클릭)"
    set lore of {_i} to "&7신화 아케이드의 컨텐츠를 고릅니다", "&7오락기 앞 빛나는 발판을 밟아도 됩니다"
    return {_i}

function bgToHub(p: player):
    if bgHubReady() is false:
        bgToLobby({_p})
        stop
    if {-bg::pvp::%uuid of {_p}%} is true:
        delete {-bg::pvp::%uuid of {_p}%}
        delete {-bg::pvpa::%uuid of {_p}%}
    set {-bg::where::%uuid of {_p}%} to "hub"
    delete {-bg::hubpad::%uuid of {_p}%}
    teleport {_p} to bgHubMk("spawn")
    bgClassReset({_p})
    set gamemode of {_p} to adventure
    heal {_p}
    set food level of {_p} to 20
    clear {_p}'s inventory
    bgCmd("effect clear %name of {_p}%")
    extinguish {_p}
    # 허브에 있는 사람은 신화쟁탈전 팀에서 빠짐 (/신화쟁탈전 으로 대기실에 가서 다시 고름)
    if {-bg::on} is not true:
        if bgTeam({_p}) is not "none":
            bgSetTeam({_p}, "none")
    set slot 4 of {_p}'s inventory to bgHubCompass()

# 신화쟁탈전으로: 게임 전이면 대기실 · 게임 중이면 관전 (/중참 으로 참가)
function bgMythJoin(p: player):
    if bgInGame({_p}) is true:
        stop
    if {-bg::pvp::%uuid of {_p}%} is true:
        delete {-bg::pvp::%uuid of {_p}%}
        delete {-bg::pvpa::%uuid of {_p}%}
    if {-bg::on} is not true:
        bgToLobby({_p})
        set {_logo} to {-bg::title::logo} ? "&6&l신화쟁탈전"
        bgTitleP({_p}, {_logo}, "&f팀 발판을 밟아 팀을 고르세요 &7· /허브 로 돌아가기")
        stop
    bgMythSpectate({_p})

function bgHubSoon(p: player):
    bgTitleP({_p}, "&7&l준비 중", "&f곧 새로운 컨텐츠가 열립니다!")
    play sound "block.note_block.bass" to {_p}

function bgHubGo(p: player, k: text):
    if {_k} is "soon1" or "soon2":
        bgHubSoon({_p})
        stop
    if bgHubLocked({_k}) is true:
        if {_p} is not op:
            bgTitleP({_p}, "&c&l잠김", "%bgHubName({_k})%&f 은(는) 지금 관리자가 막아 두었습니다")
            play sound "block.note_block.bass" to {_p}
            stop
        send "&b[허브] &7잠겨 있지만 관리자라 들어갑니다." to {_p}
    if {_k} is "myth":
        play sound "entity.enderman.teleport" to {_p}
        bgMythJoin({_p})
    else if {_k} is "pvp":
        bgPvpSelect({_p})

# ─────────────────────────────────────────────────────────── 짓기 · 이름표
function bgHubBuild(p: player, here: boolean = false):
    if {_here} is true:
        if world of {_p} is not bgWorld():
            send "&b[허브] &c허브는 전장 월드(%name of bgWorld()%)에만 지을 수 있습니다." to {_p}
            stop
        set {bg::hub::x} to floor(x-coordinate of {_p})
        set {bg::hub::y} to floor(y-coordinate of {_p})
        set {bg::hub::z} to floor(z-coordinate of {_p})
    else if {bg::hub::x} is not set:
        set {bg::hub::x} to floor(({bg::cfg::ox} ? 0) + 128)
        set {bg::hub::y} to floor(({bg::cfg::oy} ? 64) + 40)
        set {bg::hub::z} to floor(({bg::cfg::oz} ? 0) - 340)
    # 섬 바닥(-16) ~ 안테나(+67) 가 월드 높이 안에 들어가게
    set {bg::hub::y} to max(-48, min(250, {bg::hub::y}))
    bgCmd("data merge storage bg:hub {origin:{x:%{bg::hub::x}%,y:%{bg::hub::y}%,z:%{bg::hub::z}%}}")
    send "&b[허브] &f신화 아케이드 허브를 짓는 중... &7(약 6초 · 큰 건물이라 잠깐 끊길 수 있음) &8위치 %{bg::hub::x}% %{bg::hub::y}% %{bg::hub::z}%" to {_p}
    bgCmd("function bg:hub/build")
    wait 110 ticks
    set {bg::hub::built} to true
    teleport {_p} to bgHubMk("spawn")
    wait 40 ticks
    bgHubTexts()
    send "&b[허브] &a허브 완성! &f이제 접속하는 사람은 모두 여기로 옵니다." to {_p}
    send "&b[허브] &7오락기 이름표가 안 보이면 &e/허브 글자 &7· 위치 확인 &e/허브 위치" to {_p}

# 오락기 발판 위 떠 있는 이름표 (이름 · 지금 상태 · 안내)
function bgHubTextSet(k: text):
    set {_c} to "gold"
    set {_nm} to "신화쟁탈전"
    if {_k} is "pvp":
        set {_c} to "red"
        set {_nm} to "PvP 연습장"
    else if {_k} is "soon1":
        set {_c} to "light_purple"
        set {_nm} to "준비 중"
    else if {_k} is "soon2":
        set {_c} to "yellow"
        set {_nm} to "준비 중"
    set {_st} to bgHubStatus({_k})
    set {_sc} to "white"
    set {_hint} to "▼ 발판을 밟으면 입장"
    if bgHubLocked({_k}) is true:
        set {_sc} to "red"
        set {_hint} to "관리자만 들어갈 수 있습니다"
    if {_k} is "soon1" or "soon2":
        set {_sc} to "gray"
        set {_hint} to "조금만 기다려 주세요"
    bgCmd("execute as @e[type=text_display,tag=bghub_%{_k}%] run data modify entity @s text set value [{text:""%{_nm}%"",color:""%{_c}%"",bold:true},{text:""\n%{_st}%"",color:""%{_sc}%"",bold:false},{text:""\n%{_hint}%"",color:""gray"",bold:false}]")

function bgHubTextAll():
    loop "myth", "pvp", "soon1" and "soon2":
        bgHubTextSet(loop-value)

function bgHubTexts():
    bgCmd("kill @e[type=text_display,tag=bghub]")
    loop "myth", "pvp", "soon1" and "soon2":
        set {_l} to bgHubMk("%loop-value%_label")
        bgCmd("execute in %bgDim()% run summon text_display %bgC(x-coordinate of {_l})% %bgN(y-coordinate of {_l})% %bgC(z-coordinate of {_l})% {Tags:[""bghub"",""bghub_%loop-value%""],billboard:""center"",shadow:1b,background:1073741824,brightness:{sky:15,block:15},view_range:3f,line_width:300,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1.5f,1.5f,1.5f]},text:{text:""""}}")
    bgHubTextAll()

every 2 seconds:
    bgHubReady() is true
    bgHubCount("hub") > 0
    bgHubTextAll()

# ─────────────────────────────────────────────────────────── 발판 · 허브 안 보호
# 발판에 올라선 순간 한 번만 (내려갔다 다시 올라오면 또)
every 5 ticks:
    bgHubReady() is true
    loop all players:
        if bgInHub(loop-player) is true:
            set food level of loop-player to 20
            if (y-coordinate of loop-player) < {bg::hub::y} - 6:
                teleport loop-player to bgHubMk("spawn")
                play sound "entity.enderman.teleport" to loop-player
            set {_on} to ""
            loop "myth", "pvp", "soon1" and "soon2":
                set {_pl} to bgHubMk("%loop-value-2%_pad")
                if bgDist2(location of loop-player, {_pl}) < 2.6:
                    if abs((y-coordinate of loop-player) - (y-coordinate of {_pl})) < 1.6:
                        set {_on} to loop-value-2
            set {_prev} to {-bg::hubpad::%uuid of loop-player%} ? ""
            if {_on} is not {_prev}:
                set {-bg::hubpad::%uuid of loop-player%} to {_on}
                if {_on} is not "":
                    bgHubGo(loop-player, {_on})

on damage of player:
    bgInHub(victim) is true
    cancel event

on break:
    bgInHub(player) is true
    gamemode of player is not creative
    cancel event

on place:
    bgInHub(player) is true
    gamemode of player is not creative
    cancel event

on drop:
    bgInHub(player) is true
    gamemode of player is not creative
    cancel event

on right click:
    player's tool is compass
    bgInHub(player) is true
    cancel event
    bgHubMenu(player)

on respawn:
    {-bg::pvp::%uuid of player%} is not true
    bgInGame(player) is false
    bgHubReady() is true
    {-bg::where::%uuid of player%} is "hub"
    set respawn location to bgHubMk("spawn")

on quit:
    delete {-bg::where::%uuid of player%}
    delete {-bg::hubpad::%uuid of player%}
    delete {-bg::hubgui::%uuid of player%}

# ─────────────────────────────────────────────────────────── 컨텐츠 고르기 화면 (/컨텐츠 · 나침반)
function bgHubMenuItem(p: player, k: text) :: item:
    if {_k} is "myth":
        set {_it} to golden helmet
        set {_lore::*} to "&74팀이 대신전과 제단을 두고 싸우는 점령전", "&7보스 · 전설 무기 · 팀 강화"
    else if {_k} is "pvp":
        set {_it} to iron sword
        set {_lore::*} to "&7석영 투기장 · 용암 투기장", "&7전설 무기를 공짜로 골라 자유 대전"
    else if {_k} is "soon1":
        set {_it} to purple dye
        set {_lore::*} to "&7새로운 컨텐츠를 만드는 중입니다"
    else:
        set {_it} to orange dye
        set {_lore::*} to "&7새로운 컨텐츠를 만드는 중입니다"
    add "" to {_lore::*}
    if {_k} is "soon1" or "soon2":
        add "&8곧 열립니다" to {_lore::*}
    else if bgHubLocked({_k}) is true:
        add "&c잠김 &7(관리자만 입장)" to {_lore::*}
    else:
        add "&f%bgHubStatus({_k})%" to {_lore::*}
        add "" to {_lore::*}
        add "&a▶ 클릭해서 입장" to {_lore::*}
    set name of {_it} to bgHubName({_k})
    set lore of {_it} to {_lore::*}
    return {_it}

function bgHubMenu(p: player):
    set {_gui} to chest inventory with 3 rows named "&8&l신화 아케이드 &8| &7컨텐츠 고르기"
    set {_pane} to black stained glass pane named " "
    loop 27 times:
        set slot loop-number - 1 of {_gui} to {_pane}
    set slot 10 of {_gui} to bgHubMenuItem({_p}, "myth")
    set slot 12 of {_gui} to bgHubMenuItem({_p}, "pvp")
    set slot 14 of {_gui} to bgHubMenuItem({_p}, "soon1")
    set slot 16 of {_gui} to bgHubMenuItem({_p}, "soon2")
    set {_h} to compass named "&b&l허브로"
    set lore of {_h} to "&7오락실 광장으로 돌아갑니다"
    set slot 22 of {_gui} to {_h}
    open {_gui} to {_p}
    set {-bg::hubgui::%uuid of {_p}%} to true
    play sound "block.note_block.chime" to {_p}

on inventory close:
    delete {-bg::hubgui::%uuid of player%}

on inventory drag:
    {-bg::hubgui::%uuid of player%} is true
    cancel event

on inventory click:
    {-bg::hubgui::%uuid of player%} is true
    cancel event
    set {_s} to raw index of event-slot
    set {_k} to ""
    if {_s} is 10:
        set {_k} to "myth"
    else if {_s} is 12:
        set {_k} to "pvp"
    else if {_s} is 14:
        set {_k} to "soon1"
    else if {_s} is 16:
        set {_k} to "soon2"
    else if {_s} is 22:
        close player's inventory
        if bgInGame(player) is true:
            send "&b[허브] &c게임 중에는 허브로 갈 수 없습니다." to player
            stop
        bgToHub(player)
        stop
    {_k} is not ""
    close player's inventory
    play sound "ui.button.click" to player
    wait 1 tick
    bgHubGo(player, {_k})

# ─────────────────────────────────────────────────────────── 명령
command /허브 [<text>] [<text>]:
    aliases: /hub, /스폰
    trigger:
        set {_op} to true
        if sender is a player:
            if player is not op:
                set {_op} to false
        if {_op} is true:
            if arg-1 is "건설":
                if sender is not a player:
                    send "&c게임 안에서 실행해 주세요."
                    stop
                if arg-2 is "여기":
                    bgHubBuild(player, true)
                else:
                    bgHubBuild(player)
                stop
            if arg-1 is "위치":
                if {bg::hub::x} is not set:
                    send "&b[허브] &f아직 위치가 없습니다. &e/허브 건설 &f(기본 위치) 또는 &e/허브 건설 여기"
                    stop
                set {_b} to "&c아직 안 지어짐 &7(/허브 건설)"
                if bgHubReady() is true:
                    set {_b} to "&a지어짐"
                send "&b[허브] &f위치 &e%{bg::hub::x}% %{bg::hub::y}% %{bg::hub::z}% &7(%name of bgWorld()%) · %{_b}%"
                stop
            if arg-1 is "글자":
                bgHubTexts()
                send "&b[허브] &f오락기 이름표를 다시 만들었습니다."
                stop
            if arg-1 is "전체" or "@a":
                if bgHubReady() is false:
                    send "&b[허브] &c허브가 아직 없습니다. &e/허브 건설"
                    stop
                set {_n} to 0
                loop all players:
                    if bgInGame(loop-player) is false:
                        if bgOptOut(loop-player) is false:
                            bgToHub(loop-player)
                            add 1 to {_n}
                broadcast "&b[허브] &f관리자가 &e%{_n}%명&f을 허브로 불렀습니다."
                stop
        if sender is not a player:
            send "&c사용법: /허브 전체 · /허브 위치"
            stop
        if bgHubReady() is false:
            send "&b[허브] &c허브가 아직 없습니다. &7관리자가 &e/허브 건설 &7을 한 번 실행해 주세요."
            stop
        if bgInGame(player) is true:
            send "&b[허브] &c게임 중에는 허브로 갈 수 없습니다."
            stop
        bgToHub(player)
        play sound "entity.enderman.teleport" to player

command /신화쟁탈전 [<text>]:
    aliases: /myth
    trigger:
        if arg-1 is not set:
            if sender is not a player:
                send "&c사용법: /신화쟁탈전 @a · /신화쟁탈전 <플레이어>"
                stop
            if bgInGame(player) is true:
                send "&6[신화쟁탈전] &7이미 게임 중입니다."
                stop
            bgHubGo(player, "myth")
            stop
        if sender is a player:
            if player is not op:
                send "&c다른 사람을 보내는 건 관리자만 할 수 있습니다."
                stop
        if arg-1 is "@a" or "전체" or "all":
            set {_n} to 0
            loop all players:
                if bgInGame(loop-player) is false:
                    if bgOptOut(loop-player) is false:
                        bgMythJoin(loop-player)
                        add 1 to {_n}
            broadcast "&6[신화쟁탈전] &f관리자가 &e%{_n}%명&f을 신화쟁탈전으로 보냈습니다."
            stop
        set {_t} to arg-1 parsed as player
        if {_t} is not set:
            send "&c플레이어를 찾을 수 없습니다: %arg-1%"
            stop
        if bgInGame({_t}) is true:
            send "&6[신화쟁탈전] &7%name of {_t}% 은(는) 이미 게임 중입니다."
            stop
        bgMythJoin({_t})
        send "&6[신화쟁탈전] &f%name of {_t}% 을(를) 신화쟁탈전으로 보냈습니다."

command /컨텐츠 [<text>] [<text>]:
    aliases: /content
    trigger:
        if arg-1 is "잠금" or "열기":
            if sender is a player:
                if player is not op:
                    send "&c관리자만 쓸 수 있습니다."
                    stop
            set {_a2} to arg-2 ? ""
            set {_k} to bgHubKey({_a2})
            if {_k} is "":
                send "&b[허브] &f/컨텐츠 %arg-1% <신화쟁탈전|연습장|준비1|준비2>"
                stop
            if arg-1 is "잠금":
                set {bg::cfg::clock::%{_k}%} to true
                set {_m} to ""
                if {_k} is "pvp":
                    set {bg::cfg::pvplock} to true
                    set {_m} to " &7(연습장에 있던 %bgPvpKickAll()%명 허브로)"
                broadcast "&b[허브] %bgHubName({_k})% &f이(가) &c잠겼습니다%{_m}%"
            else:
                delete {bg::cfg::clock::%{_k}%}
                if {_k} is "pvp":
                    delete {bg::cfg::pvplock}
                broadcast "&b[허브] %bgHubName({_k})% &f이(가) &a열렸습니다 &7— 허브 오락기에서 입장"
            if bgHubReady() is true:
                bgHubTextAll()
            stop
        if arg-1 is "목록" or "상태":
            loop "myth", "pvp", "soon1" and "soon2":
                send "&b[허브] %bgHubName(loop-value)% &7— &f%bgHubStatus(loop-value)%"
            stop
        if sender is not a player:
            send "&c사용법: /컨텐츠 잠금|열기 <신화쟁탈전|연습장|준비1|준비2> · /컨텐츠 목록"
            stop
        if bgInGame(player) is true:
            send "&b[허브] &c게임 중에는 다른 컨텐츠로 갈 수 없습니다."
            stop
        bgHubMenu(player)
