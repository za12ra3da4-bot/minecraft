# ═════════════════════════════════════════════════════════════════════════════
#  경찰과 도둑 (경도) — 허브 보라 오락기로 들어가는 시참 컨텐츠 (밤 네온 대도시, arena/tools/copsgen.py)
#   대기실 = 랜드마크 타워 꼭대기 전망대. 관리자가 /경도 시작 [경찰 수] → 역할 배정
#   도둑: 도시 곳곳으로 흩어짐 · 털이 장소 6곳 (은행 · 카지노 · 보석상 · 창고 · 박물관 · 편의점) 앞에 6초 서 있으면 돈가방 +1 (경찰 출동 전엔 못 텀)
#         건물 안 통(배럴)을 뒤져 해킹 칩을 찾고 → 털이 장소(숨겨짐)에서 칩 1개로 털기
#         팀 목표 돈가방(도둑 수 × 1.5)을 채우면 탈출 시작:
#           · 헬기: 헬기장 빌딩 3곳(북동 7층 · 북서 · 남동 5층) 옥상 중 한 곳 — 60초마다 다른 옥상으로 날아감 (15초 전 예고)
#           · 하수구: 도로 가장자리 밸브 3개를 4초씩 돌리면 도로 가운데 맨홀이 40초 열림 (경찰에게도 알림)
#         맵: 일반 건물 자리가 배치 3벌 중 무작위 (/경도 건설 · /경도 맵바꾸기) — 특수 건물 · 탈출구 · 털이 장소는 늘 같은 자리
#         헬기는 돈가방을 1개 이상 들고 있는 도둑만 탈 수 있음 (가방 1개가 탑승권) → '탈출 성공' (전망대로) · 판은 계속
#         판 끝: 탈출 성공 / 탈출 실패 명단을 따로 · 도둑 3명 중 1명꼴 (올림) 이상 탈출해야 도둑 승리
#         사람이 많을수록 털이 장소 다시 털 수 있는 시간이 짧아짐 (40초 → 최소 20초)
#         연막탄 2개 (던지면 주변 경찰 3초 실명) · 잡히면 감옥 → 동료가 초록 구출 발판을 밟으면 전원 탈옥 (5초 보호)
#   경찰: 도둑과 동시에 출발 (경찰서) · 경찰봉(네더라이트 검 성능)으로 도둑 체력을 다 깎으면 체포 (죽지 않고 감옥) · 무전기 · 레이더
#         직급: 지금 감옥에 있는 (내가 잡은) 도둑 수 · 도둑 수에 비례 (경장 15% · 경사 30% · 경위 50%) · 탈옥하면 강등
#         경장 신속 I · 경사 추격 진주 2 + 수갑 3 · 경위 도둑 추적기 + 신속 II
#   탈옥하면 신속 IV 에서 4초에 걸쳐 점점 느려지는 가속
#         도둑 전원 체포 또는 시간 종료 → 경찰 승리
#   허브 · 신화쟁탈전과 별개 서버처럼: 피해 없음 (체포만) · 블록 못 부숨 · 밤 · 이름표는 같은 편만
#   /경도 (/kd) 들어가기 · /경도 나가기 · /경도 전적 [플레이어] · /경도 랭킹
#   관리자: /경도 시작 [경찰수] · /경도 종료 · /경도 시간 <분> · /경도 목표 <개|자동> · /경도 건설 · /경도 글자
#   도시 원점 = 허브 원점 + (0, 0, -260)  (storage bg:kd0 · kd1 · kd2 origin — 배치마다)
# ═════════════════════════════════════════════════════════════════════════════

function bgKdOn(p: player) :: boolean:
    if {-bg::kd::in::%uuid of {_p}%} is true:
        return true
    return false

function bgKdReady() :: boolean:
    if {bg::kd::built} is true:
        if {bg::hub::x} is set:
            return true
    return false

function bgKdAt(dx: number, dy: number, dz: number) :: location:
    return location({bg::hub::x} + {_dx}, {bg::hub::y} + {_dy}, {bg::hub::z} - 260 + {_dz}, bgWorld())

function bgKdMk(n: text) :: location:
    set {_l} to bgKdAt({-bg::kdmk::%{_n}%::x}, {-bg::kdmk::%{_n}%::y}, {-bg::kdmk::%{_n}%::z})
    if {-bg::kdmk::%{_n}%::yaw} is set:
        set yaw of {_l} to {-bg::kdmk::%{_n}%::yaw}
    return {_l}

function bgKdRole(p: player) :: text:
    return {-bg::kd::role::%uuid of {_p}%} ? ""

function bgKdJailed(p: player) :: boolean:
    if {-bg::kd::jail::%uuid of {_p}%} is true:
        return true
    return false

function bgKdEsc(p: player) :: boolean:
    if {-bg::kd::esc::%uuid of {_p}%} is true:
        return true
    return false

function bgKdState() :: text:
    return {-bg::kd::state} ? "wait"

function bgKdSay(m: text):
    loop all players:
        if bgKdOn(loop-player) is true:
            send "&9[경도] &f%{_m}%" to loop-player

function bgKdTitle(t: text, s: text):
    loop all players:
        if bgKdOn(loop-player) is true:
            bgTitleP(loop-player, {_t}, {_s})

function bgKdSound(s: text, pitch: number):
    loop all players:
        if bgKdOn(loop-player) is true:
            play sound {_s} with volume 1 and pitch {_pitch} to loop-player

function bgKdTime(s: number) :: text:
    set {_m} to floor({_s} / 60)
    set {_r} to mod(floor({_s}), 60)
    if {_r} < 10:
        return "%{_m}%:0%{_r}%"
    return "%{_m}%:%{_r}%"

# 숫자 세기: role = cop · thief · free (안 잡힌 도둑) · all
function bgKdCount(r: text) :: number:
    set {_n} to 0
    loop all players:
        if bgKdOn(loop-player) is true:
            set {_ro} to bgKdRole(loop-player)
            if {_r} is "all":
                add 1 to {_n}
            else if {_r} is "free":
                if {_ro} is "thief":
                    if bgKdJailed(loop-player) is false:
                        if bgKdEsc(loop-player) is false:
                            add 1 to {_n}
            else if {_r} is "esc":
                if bgKdEsc(loop-player) is true:
                    add 1 to {_n}
            else if {_ro} is {_r}:
                add 1 to {_n}
    return {_n}

# 막힌 칸이면 위로 (차 · 물건 위에 떨어지지 않게)
function bgKdSafe(l: location) :: location:
    loop 6 times:
        if block at {_l} is air:
            if block at bgUp({_l}, 1) is air:
                return {_l}
        set {_l} to bgUp({_l}, 1)
    return {_l}

function bgKdThiefSpot() :: location:
    return bgKdSafe(bgKdMk("thief_%random integer between 0 and 11%"))

# 이름표 색 · 같은 편만 이름 보임 (도둑은 숨기 쉽게)
function bgKdTeams():
    bgCmd("team add kd_cop")
    bgCmd("team add kd_thief")
    bgCmd("team add kd_wait")
    bgCmd("team modify kd_cop color blue")
    bgCmd("team modify kd_thief color red")
    bgCmd("team modify kd_wait color aqua")
    bgCmd("team modify kd_cop prefix [{text:"""",font:""bg:hubscr"",color:""white""},{text:"" "",font:""minecraft:default""}]")
    bgCmd("team modify kd_thief prefix [{text:"""",font:""bg:hubscr"",color:""white""},{text:"" "",font:""minecraft:default""}]")
    bgCmd("team modify kd_wait prefix [{text:"""",font:""bg:hubscr"",color:""white""},{text:"" "",font:""minecraft:default""}]")
    bgCmd("team modify kd_thief nametagVisibility hideForOtherTeams")
    bgCmd("team modify kd_cop nametagVisibility hideForOtherTeams")
    bgCmd("team modify kd_cop friendlyFire false")
    bgCmd("team modify kd_thief friendlyFire false")
    # 몸으로 밀기 없음 (경찰이 도둑을 몸으로 밀어 떨어뜨리기 · 끼이기 방지)
    bgCmd("team modify kd_cop collisionRule never")
    bgCmd("team modify kd_thief collisionRule never")
    bgCmd("team modify kd_wait collisionRule never")

function bgKdClear(p: player):
    bgClassReset({_p})
    # 경도에선 안 밀림 (맞아도 · 부딪혀도): 넉백 저항 100%
    bgCmd("attribute %name of {_p}% minecraft:knockback_resistance base set 1")
    clear {_p}'s inventory
    bgCmd("effect clear %name of {_p}%")
    extinguish {_p}
    heal {_p}
    set food level of {_p} to 20
    set gamemode of {_p} to adventure

function bgKdCopKit(p: player):
    bgKdClear({_p})
    set {_n} to name of {_p}
    bgCmd("item replace entity %{_n}% armor.head with leather_helmet[dyed_color=1381706,unbreakable={}]")
    bgCmd("item replace entity %{_n}% armor.chest with leather_chestplate[dyed_color=2052283,unbreakable={}]")
    bgCmd("item replace entity %{_n}% armor.legs with leather_leggings[dyed_color=1381706,unbreakable={}]")
    bgCmd("item replace entity %{_n}% armor.feet with leather_boots[dyed_color=1381706,unbreakable={}]")
    bgCmd("item replace entity %{_n}% hotbar.0 with blaze_rod[item_model=""bg:kd/baton"",item_name={text:""경찰봉"",color:""blue"",bold:true},lore=[{text:""도둑 체력을 다 깎으면 체포 · 들고 있던 돈가방 압수"",color:""gray"",italic:false},{text:""네더라이트 검 성능 (공격력 8 · 공격 속도 1.6)"",color:""dark_gray"",italic:false}],attribute_modifiers=[{type:""minecraft:attack_damage"",id:""bg:baton_damage"",amount:7.0,operation:""add_value"",slot:""mainhand""},{type:""minecraft:attack_speed"",id:""bg:baton_speed"",amount:-2.4,operation:""add_value"",slot:""mainhand""}]]")
    bgCmd("item replace entity %{_n}% hotbar.1 with echo_shard[item_model=""bg:kd/radio"",item_name={text:""무전기"",color:""aqua"",bold:true},lore=[{text:""우클릭: 5초 동안 가장 가까운 도둑 방향 · 거리 (25초마다)"",color:""gray"",italic:false}]]")
    bgCmd("effect give %{_n}% speed infinite 0 true")
    bgCmd("team join kd_cop %{_n}%")

function bgKdThiefKit(p: player):
    bgKdClear({_p})
    set {_n} to name of {_p}
    bgCmd("item replace entity %{_n}% armor.head with leather_helmet[dyed_color=1315860,unbreakable={}]")
    bgCmd("item replace entity %{_n}% armor.chest with leather_chestplate[dyed_color=10040115,unbreakable={}]")
    bgCmd("item replace entity %{_n}% hotbar.0 with snowball[item_model=""bg:kd/smoke"",item_name={text:""연막탄"",color:""gray"",bold:true},lore=[{text:""던지면 주변 경찰이 3초 동안 앞이 안 보임"",color:""gray"",italic:false}]] 2")
    bgCmd("item replace entity %{_n}% hotbar.1 with feather[item_model=""bg:kd/shoes"",item_name={text:""운동화"",color:""red"",bold:true},lore=[{text:""우클릭: 4초 질주 (20초마다)"",color:""gray"",italic:false}]]")
    set {-bg::kd::carry::%uuid of {_p}%} to 0
    bgCmd("team join kd_thief %{_n}%")

# ─────────────────────────────────────────────────────────── 들어가기 · 나가기
function bgKdJoin(p: player):
    if bgKdState() is "remap":
        send "&9[경도] &f다음 판 맵을 섞는 중이에요. &7잠시 뒤에 다시 들어와 주세요 (약 20초)" to {_p}
        stop
    if bgKdReady() is false:
        if {_p} is op:
            send "&9[경도] &f도시가 아직 없어서 지금 짓습니다..." to {_p}
            bgKdBuild({_p})
            stop
        send "&9[경도] &f도시가 아직 없습니다. &7관리자가 &e/경도 건설 &7을 한 번 해 주세요" to {_p}
        stop
    if bgInGame({_p}) is true:
        send "&9[경도] &7신화쟁탈전 게임 중에는 갈 수 없습니다." to {_p}
        stop
    if bgKdOn({_p}) is true:
        stop
    delete {-bg::pk::in::%uuid of {_p}%}
    bgOsDrop({_p})
    delete {-bg::pvp::%uuid of {_p}%}
    delete {-bg::pvpa::%uuid of {_p}%}
    if {-bg::on} is not true:
        if bgTeam({_p}) is not "none":
            bgSetTeam({_p}, "none")
    bgKdTeams()
    set {-bg::kd::in::%uuid of {_p}%} to true
    set {-bg::where::%uuid of {_p}%} to "kd"
    delete {-bg::kd::role::%uuid of {_p}%}
    delete {-bg::kd::jail::%uuid of {_p}%}
    delete {-bg::kd::esc::%uuid of {_p}%}
    bgKdClear({_p})
    set {_u} to "%uuid of {_p}%"
    if bgKdState() is "play":
        if ({-bg::kd::rj::%{_u}%::round} ? -1) is ({-bg::kd::round} ? 0):
            bgKdRestore({_p})
            stop
    if bgKdState() is "play":
        # 판 중간에 오면 도둑으로 바로 참가
        set {-bg::kd::role::%uuid of {_p}%} to "thief"
        bgKdThiefKit({_p})
        teleport {_p} to bgKdThiefSpot()
        bgTitleP({_p}, "&c&l도둑으로 참가!", "&f털이 장소에서 돈가방을 훔쳐 헬기장으로 탈출하세요")
        bgKdSay("&e%name of {_p}%&f 도둑으로 중간 참가")
    else:
        bgCmd("team join kd_wait %name of {_p}%")
        teleport {_p} to bgKdMk("wait")
        bgExitItem({_p})
        bgTitleP({_p}, "&9&l경찰&f과 &c&l도둑", "&f대기실 — 관리자가 시작하면 역할이 정해집니다")
        set {_n} to bgKdCount("all")
        bgKdSay("&e%name of {_p}%&f 입장 &7(대기 %{_n}%명)")
    play sound "block.note_block.pling" to {_p}

# 같은 판에 다시 들어온 사람: 나가기 전 상태 그대로 (경찰 · 도둑 · 감옥 · 탈출)
function bgKdRestore(p: player):
    set {_u} to "%uuid of {_p}%"
    set {_r} to {-bg::kd::rj::%{_u}%::role} ? "thief"
    set {-bg::kd::role::%{_u}%} to {_r}
    if {_r} is "cop":
        bgKdCopKit({_p})
        teleport {_p} to bgKdMk("cop_spawn")
        bgTitleP({_p}, "&9&l경찰로 복귀", "&f나가기 전 역할 그대로")
    else:
        bgKdThiefKit({_p})
        if {-bg::kd::rj::%{_u}%::esc} is true:
            set {-bg::kd::esc::%{_u}%} to true
            teleport {_p} to bgKdMk("wait")
            bgTitleP({_p}, "&a&l탈출한 상태로 복귀", "&f전망대에서 구경")
        else if {-bg::kd::rj::%{_u}%::jail} is true:
            set {-bg::kd::jail::%{_u}%} to true
            if {-bg::kd::rj::%{_u}%::by} is set:
                set {-bg::kd::by::%{_u}%} to {-bg::kd::rj::%{_u}%::by}
            teleport {_p} to bgKdMk("jail")
            bgTitleP({_p}, "&c&l다시 감옥으로", "&f나갔다 들어와도 감옥은 그대로예요")
        else:
            teleport {_p} to bgKdThiefSpot()
            bgTitleP({_p}, "&c&l도둑으로 복귀", "&f나가기 전 역할 그대로")
    delete {-bg::kd::rj::%{_u}%::*}
    bgKdSay("&e%name of {_p}%&f 복귀 &7(나가기 전 상태 그대로)")

# 서버에 다시 들어오면 (진행 중인 같은 판이면) 경도로 바로 돌려보냄
on join:
    set {_u} to "%uuid of player%"
    {-bg::kd::rj::%{_u}%::round} is set
    wait 40 ticks
    player is online
    bgKdState() is "play"
    ({-bg::kd::rj::%{_u}%::round} ? -1) is ({-bg::kd::round} ? 0)
    bgKdJoin(player)

# 경도에서 빼기만 (순간이동 없음) · 판 중이면 승부 확인
function bgKdDrop(p: player):
    if bgKdOn({_p}) is false:
        stop
    bgKdUnboard({_p})
    # 판 중에 나가면 역할 · 감옥 · 탈출 상태를 기억 → 다시 들어오면 그대로 (감옥에서 나갔다 들어와 풀려나는 버그 막기)
    if bgKdState() is "play":
        if bgKdRole({_p}) is not "":
            set {_u} to "%uuid of {_p}%"
            set {-bg::kd::rj::%{_u}%::round} to {-bg::kd::round} ? 0
            set {-bg::kd::rj::%{_u}%::role} to bgKdRole({_p})
            set {-bg::kd::rj::%{_u}%::jail} to bgKdJailed({_p})
            set {-bg::kd::rj::%{_u}%::esc} to bgKdEsc({_p})
            set {-bg::kd::rj::%{_u}%::by} to {-bg::kd::by::%{_u}%}
    delete {-bg::kd::in::%uuid of {_p}%}
    delete {-bg::kd::role::%uuid of {_p}%}
    delete {-bg::kd::jail::%uuid of {_p}%}
    delete {-bg::kd::esc::%uuid of {_p}%}
    delete {-bg::kd::prog::%uuid of {_p}%}
    bgCmd("team leave %name of {_p}%")
    bgCmd("effect clear %name of {_p}%")
    bgCmd("attribute %name of {_p}% minecraft:knockback_resistance base set 0")
    if bgKdState() is "play":
        bgKdCheck()

# 판 중 (경찰 · 도둑 역할이 있는 사람) 에는 나가기 버튼 · /경도 나가기 · /허브 로 못 나감 → 안내
function bgKdNoLeave(p: player) :: boolean:
    if bgKdOn({_p}) is false:
        return false
    if bgKdState() is not "play":
        return false
    if bgKdRole({_p}) is "":
        return false
    send action bar "&c경도 판 중에는 나갈 수 없어요!" to {_p}
    send "&9[경도] &c판이 진행 중이라 나갈 수 없어요. &7판이 끝나면 나가기 버튼으로 나갈 수 있어요." to {_p}
    play sound "block.note_block.bass" to {_p}
    return true

function bgKdLeave(p: player):
    bgKdDrop({_p})
    bgToHub({_p})

# ─────────────────────────────────────────────────────────── 판 시작 · 끝
function bgKdStart(s: command sender, cops: number = 0):
    if bgKdReady() is false:
        send "&9[경도] &c도시가 없습니다. /경도 건설" to {_s}
        stop
    if bgKdState() is "play":
        send "&9[경도] &c이미 진행 중입니다. (/경도 종료)" to {_s}
        stop
    if bgKdState() is "remap":
        send "&9[경도] &c맵을 바꾸는 중입니다. 잠시 뒤에 시작하세요." to {_s}
        stop
    loop all players:
        if bgKdOn(loop-player) is true:
            add loop-player to {_ps::*}
    set {_n} to size of {_ps::*}
    if {_n} < 2:
        send "&9[경도] &c2명 이상 있어야 합니다. (지금 %{_n}%명)" to {_s}
        stop
    set {_c} to {_cops}
    if {_c} < 1:
        set {_c} to max(1, round({_n} / 4))
    set {_c} to min({_c}, {_n} - 1)
    bgKdTeams()
    set {_ps::*} to shuffled {_ps::*}
    set {_i} to 0
    loop {_ps::*}:
        add 1 to {_i}
        delete {-bg::kd::jail::%uuid of loop-value%}
        delete {-bg::kd::esc::%uuid of loop-value%}
        if {_i} <= {_c}:
            set {-bg::kd::role::%uuid of loop-value%} to "cop"
        else:
            set {-bg::kd::role::%uuid of loop-value%} to "thief"
    set {_t} to {_n} - {_c}
    # 목표 돈가방: 도둑 수 × 1.5 (올림 · 최소 3) · 탈출해야 할 도둑 수: 3명 중 1명꼴 (올림)
    set {-bg::kd::goal} to {bg::cfg::kd_goal} ? max(3, ceil({_t} * 1.5))
    set {-bg::kd::need} to max(1, ceil({_t} / 3))
    set {-bg::kd::hcdmax} to max(20, min(40, 46 - {_t} * 2))
    set {-bg::kd::bags} to 0
    set {-bg::kd::open} to false
    delete {-bg::kd::lastcall}
    set {-bg::kd::left} to ({bg::cfg::kd_min} ? 8) * 60
    set {-bg::kd::hold} to 0
    set {-bg::kd::radar} to 60
    delete {-bg::kd::hcd::*}
    delete {-bg::kd::loot::*}
    bgKdValveReset()
    bgKdValvesPlace()
    delete {-bg::kd::vp::*}
    delete {-bg::kd::sewer}
    delete {-bg::kd::hitcd::*}
    bgCmd("function bg:kd%{bg::kd::layout} ? 0%/fl")
    bgKdHeliHome()
    bgKdCover(false)
    bgKdBeams()
    delete {-bg::kd::merit::*}
    delete {-bg::kd::rank::*}
    delete {-bg::kd::by::*}
    delete {-bg::kd::prog::*}
    add 1 to {-bg::kd::round}
    delete {-bg::kd::rj::*}
    set {-bg::kd::state} to "play"
    bgKdTexts()
    loop {_ps::*}:
        if bgKdRole(loop-value) is "thief":
            bgKdThiefKit(loop-value)
            teleport loop-value to bgKdThiefSpot()
            bgTitleP(loop-value, "&c&l당신은 도둑!", "&f경찰과 동시에 출발! · 팀 돈가방 %{-bg::kd::goal}%개 → 헬기 시동 · %{-bg::kd::need}%명 탈출하면 승리")
        else:
            bgKdCopKit(loop-value)
            teleport loop-value to bgKdMk("cop_spawn")
            bgTitleP(loop-value, "&9&l당신은 경찰!", "&f바로 출동! · 경찰봉으로 도둑 체력을 다 깎으면 체포")
    bgKdSay("&f판 시작! &9경찰 %{_c}%명 &7vs &c도둑 %{_t}%명 &7· 팀 목표 돈가방 &6%{-bg::kd::goal}%개 &7· 도둑 승리 = &a%{-bg::kd::need}%명 탈출 &7· 제한 %bgKdTime({-bg::kd::left})%")
    bgKdSay("&7감옥 · 구출 발판 · 탈출 헬기는 빛 기둥으로 보여요 · &e털이 장소는 직접 찾기 &7· 털려면 &b해킹 칩&7 (건물 안 통을 뒤지면 나옴)")
    bgKdSound("entity.ender_dragon.growl", 1.4)

function bgKdEnd(win: text, why: text):
    if bgKdState() is not "play":
        stop
    set {-bg::kd::state} to "end"
    delete {-bg::kd::loot::*}
    delete {-bg::kd::srch::*}
    delete {-bg::kd::srchloc::*}
    delete {-bg::kd::srchp::*}
    delete {-bg::kd::sewer}
    bgKdValveReset()
    bgKdCover(false)
    loop all players:
        if bgKdOn(loop-player) is true:
            if bgKdRole(loop-player) is "thief":
                if bgKdEsc(loop-player) is true:
                    add name of loop-player to {_ok::*}
                else if bgKdJailed(loop-player) is true:
                    add "%name of loop-player% &8(체포)" to {_no::*}
                else:
                    add "%name of loop-player% &8(못 빠져나감)" to {_no::*}
    loop all players:
        if bgKdOn(loop-player) is true:
            set {_r} to bgKdRole(loop-player)
            if {_win} is "none":
                bgTitleP(loop-player, "&7&l판 종료", "&f%{_why}%")
            else if {_r} is "thief":
                if bgKdEsc(loop-player) is true:
                    bgTitleP(loop-player, "&c&l도둑 승리!", "&a탈출 성공 &7· &f%{_why}%")
                    add 1 to {bg::kd::wins::%uuid of loop-player%}
                    play sound "ui.toast.challenge_complete" to loop-player
                else:
                    bgTitleP(loop-player, "&7&l탈출 실패", "&f%{_why}%")
            else if {_win} is "cop":
                bgTitleP(loop-player, "&9&l경찰 승리!", "&f%{_why}%")
                add 1 to {bg::kd::wins::%uuid of loop-player%}
                play sound "ui.toast.challenge_complete" to loop-player
            else:
                bgTitleP(loop-player, "&c&l경찰 패배", "&f%{_why}%")
    if {_win} is "cop":
        bgKdSay("&9&l경찰 승리! &f%{_why}%")
    else if {_win} is "thief":
        bgKdSay("&c&l도둑 승리! &f%{_why}%")
    else:
        bgKdSay("&7판 종료 — %{_why}%")
    if size of {_ok::*} > 0:
        set {_sep} to "&7, &f"
        bgKdSay("&a&l탈출 성공 %size of {_ok::*}%명 &f%join {_ok::*} with {_sep}%")
    else:
        bgKdSay("&a&l탈출 성공 &70명")
    if size of {_no::*} > 0:
        set {_sep} to "&7, &f"
        bgKdSay("&c&l탈출 실패 %size of {_no::*}%명 &f%join {_no::*} with {_sep}%")
    bgKdTexts()
    bgKdBeams()
    wait 10 seconds
    loop all players:
        bgKdUnboard(loop-player)
    delete {-bg::kd::abd::*}
    bgCmd("kill @e[type=item_display,tag=bgkd_hcam]")
    bgCmd("function bg:kd%{bg::kd::layout} ? 0%/fl_rm")
    loop all players:
        if bgKdOn(loop-player) is true:
            delete {-bg::kd::role::%uuid of loop-player%}
            delete {-bg::kd::jail::%uuid of loop-player%}
            delete {-bg::kd::esc::%uuid of loop-player%}
    if {bg::cfg::kd_noremap} is not true:
        bgKdRemap()
        stop
    set {-bg::kd::state} to "wait"
    loop all players:
        if bgKdOn(loop-player) is true:
            bgKdClear(loop-player)
            bgCmd("team join kd_wait %name of loop-player%")
            teleport loop-player to bgKdMk("wait")
            bgExitItem(loop-player)
    bgKdTexts()
    bgKdSay("&f대기실로 돌아왔습니다. 다음 판은 관리자가 &e/경도 시작")

function bgKdCheck():
    bgKdState() is "play"
    if bgKdCount("cop") is 0:
        bgKdEnd("thief", "경찰이 모두 나갔습니다")
        stop
    if bgKdCount("thief") is 0:
        bgKdEnd("cop", "도둑이 모두 나갔습니다")
        stop
    set {_e} to bgKdCount("esc")
    set {_need} to {-bg::kd::need} ? 1
    # 필요 인원을 채워도 바로 끝내지 않음 → 남은 도둑도 60초 안에 탈 수 있게 (마지막 탑승)
    if {_e} >= {_need}:
        if {-bg::kd::lastcall} is not true:
            set {-bg::kd::lastcall} to true
            set {-bg::kd::left} to min({-bg::kd::left}, 60)
            bgKdTitle("&a&l도둑 승리 확정!", "&f남은 도둑도 &e60초&f 안에 헬기에 타세요!")
    if bgKdCount("free") is 0:
        if {_e} >= {_need}:
            bgKdEnd("thief", "도둑 %{_e}%명 탈출 성공! (필요 %{_need}%명)")
        else if {_e} > 0:
            bgKdEnd("cop", "남은 도둑 전원 체포 · 탈출 %{_e}%/%{_need}%명으로 부족")
        else:
            bgKdEnd("cop", "도둑 전원 체포!")

# ─────────────────────────────────────────────────────────── 체포 · 구출 · 털이 · 탈출
function bgKdArrest(t: player, c: player):
    set {-bg::kd::jail::%uuid of {_t}%} to true
    set {-bg::kd::by::%uuid of {_t}%} to "%uuid of {_c}%"
    set {_lost} to {-bg::kd::carry::%uuid of {_t}%} ? 0
    if {_lost} > 0:
        set {-bg::kd::bags} to max(0, {-bg::kd::bags} - {_lost})
        set {-bg::kd::carry::%uuid of {_t}%} to 0
        bgCmd("clear %name of {_t}% rabbit_hide")
        bgKdSay("&9%name of {_c}%&f 이(가) 돈가방 &6%{_lost}%개&f 압수! &7(돈가방 %{-bg::kd::bags}%/%{-bg::kd::goal}%)")
    bgParticle(location of {_t}, "flash", 0, 0, 0, 0, 1)
    bgParticle(location of {_t}, "crit", 0.5, 1, 0.5, 0.3, 40)
    delete {-bg::kd::prog::%uuid of {_t}%}
    bgCmd("effect clear %name of {_t}%")
    teleport {_t} to bgKdMk("jail")
    bgTitleP({_t}, "&c&l체포!", "&f동료가 감옥 앞 초록 발판을 밟으면 풀려납니다")
    play sound "block.iron_door.close" to {_t}
    play sound "entity.experience_orb.pickup" with volume 1 and pitch 0.8 to {_c}
    add 1 to {bg::kd::arrests::%uuid of {_c}%}
    set {bg::kd::name::%uuid of {_c}%} to name of {_c}
    set {_f} to bgKdCount("free")
    set {_a} to bgKdCount("thief")
    bgKdSay("&9%name of {_c}%&f 이(가) &c%name of {_t}%&f 체포! &7(남은 도둑 %{_f}%/%{_a}%)")
    bgKdCheck()

# 탈옥 가속: 신속 IV 로 튀어 나가서 1초마다 한 단계씩 약해지다 4초 뒤 끝 (높은 단계는 낮은 단계로 안 덮이므로 매번 지우고 다시)
function bgKdBurst(p: player):
    set {_a} to 3
    while {_a} >= 0:
        if {_p} is not online:
            stop
        bgCmd("effect clear %name of {_p}% speed")
        bgCmd("effect give %name of {_p}% speed 2 %{_a}% true")
        bgParticle(location of {_p}, "cloud", 0.3, 0.1, 0.3, 0.02, 4 + {_a} * 3)
        wait 20 ticks
        remove 1 from {_a}
    bgCmd("effect clear %name of {_p}% speed")

function bgKdRescue(r: player):
    set {_n} to 0
    loop all players:
        if bgKdOn(loop-player) is true:
            if bgKdJailed(loop-player) is true:
                delete {-bg::kd::jail::%uuid of loop-player%}
                set {-bg::kd::imm::%uuid of loop-player%} to now
                teleport loop-player to bgKdMk("jail_out")
                bgKdBurst(loop-player)
                bgTitleP(loop-player, "&a&l탈옥!", "&f%name of {_r}% 이(가) 구해 줬습니다 · 5초 보호 · 순간 가속!")
                add 1 to {_n}
    {_n} > 0
    set {-bg::kd::rescd} to now
    add {_n} to {bg::kd::rescues::%uuid of {_r}%}
    bgKdSay("&a%name of {_r}%&f 이(가) 감옥을 부쉈다! &a%{_n}%명 탈옥")
    bgKdSound("block.iron_door.open", 1.2)

# 도둑 보상 음료 (마시면 효과 · 빈 병 안 남음 · 빨리 마심)
#  energy = 에너지 드링크 (8초 신속 II) · jump = 점프 드링크 (10초 점프 강화 II) · stealth = 스텔스 드링크 (4초 투명)
function bgKdDrink(p: player, k: text):
    set {_nm} to "에너지 드링크"
    set {_col} to "gold"
    set {_rgb} to 16747546
    set {_ef} to "speed"
    set {_amp} to 1
    set {_dur} to 160
    set {_desc} to "마시면 8초 동안 신속 II"
    if {_k} is "jump":
        set {_nm} to "점프 드링크"
        set {_col} to "green"
        set {_rgb} to 8191744
        set {_ef} to "jump_boost"
        set {_dur} to 200
        set {_desc} to "마시면 10초 동안 점프 강화 II"
    else if {_k} is "stealth":
        set {_nm} to "스텔스 드링크"
        set {_col} to "white"
        set {_rgb} to 12632272
        set {_ef} to "invisibility"
        set {_amp} to 0
        set {_dur} to 80
        set {_desc} to "마시면 4초 동안 투명"
    bgCmd("give %name of {_p}% potion[!use_remainder,consumable={consume_seconds:0.6f,animation:""drink"",sound:""entity.generic.drink"",has_consume_particles:false},potion_contents={custom_color:%{_rgb}%,custom_effects:[{id:""minecraft:%{_ef}%"",amplifier:%{_amp}%b,duration:%{_dur}%,show_particles:false,show_icon:true}]},item_name={text:""%{_nm}%"",color:""%{_col}%"",bold:true},lore=[{text:""%{_desc}%"",color:""gray"",italic:false}]] 1")

function bgKdSteal(p: player, i: number):
    add 1 to {-bg::kd::bags}
    add 1 to {-bg::kd::carry::%uuid of {_p}%}
    bgCmd("give %name of {_p}% rabbit_hide[item_model=""bg:kd/bag"",item_name={text:""돈가방"",color:""gold"",bold:true},lore=[{text:""잡히면 압수됩니다! 헬기장으로 탈출하세요"",color:""gray"",italic:false}]]")
    set {-bg::kd::hcd::%{_i}%} to {-bg::kd::hcdmax} ? 40
    # 털이 보상 (무작위 하나)
    set {_rw} to random integer between 1 and 4
    if {_rw} is 1:
        bgCmd("give %name of {_p}% snowball[item_model=""bg:kd/smoke"",item_name={text:""연막탄"",color:""gray"",bold:true},lore=[{text:""던지면 주변 경찰이 3초 동안 앞이 안 보임"",color:""gray"",italic:false}]] 1")
        send action bar "&6보상: &f연막탄 +1" to {_p}
    else if {_rw} is 2:
        bgKdDrink({_p}, "energy")
        send action bar "&6보상: &6에너지 드링크 &7(마시면 8초 신속 II)" to {_p}
    else if {_rw} is 3:
        bgKdDrink({_p}, "stealth")
        send action bar "&6보상: &f스텔스 드링크 &7(마시면 4초 투명)" to {_p}
    else:
        delete {-bg::kd::cds::%uuid of {_p}%}
        bgKdDrink({_p}, "jump")
        send action bar "&6보상: &a점프 드링크 &7+ 운동화 재충전" to {_p}
    add 1 to {bg::kd::steals::%uuid of {_p}%}
    set {bg::kd::name::%uuid of {_p}%} to name of {_p}
    bgParticle(location of {_p}, "wax_on", 0.6, 1, 0.6, 0, 30)
    play sound "entity.player.levelup" to {_p}
    bgKdSay("&6%name of {_p}%&f 이(가) &6%{-bg::kd::heistname::%{_i}%}%&f 털이 성공! &7(돈가방 &6%{-bg::kd::bags}%/%{-bg::kd::goal}%&7)")
    if {-bg::kd::bags} >= {-bg::kd::goal}:
        if {-bg::kd::open} is not true:
            set {-bg::kd::open} to true
            set {-bg::kd::helit} to 60
            set {-bg::kd::hstate} to "land"
            bgKdBeams()
            bgKdTitle("&6&l탈출 헬기 시동!", "&e%bgKdHeliName({bg::kd::helipos} ? 0)% &f· 60초 안에 타면 이륙 때 탈출 &7· 밸브 3개 → 하수구")
            bgKdSound("entity.wither.spawn", 1.6)
            bgKdTexts()

# heli = 헬기 이륙 (탄 사람은 헬기를 따라 날다가 사라질 때 전망대로 · bgKdHeliDepart)
function bgKdEscape(p: player, heli: boolean = false):
    set {-bg::kd::esc::%uuid of {_p}%} to true
    delete {-bg::kd::prog::%uuid of {_p}%}
    add 1 to {bg::kd::escapes::%uuid of {_p}%}
    set {bg::kd::name::%uuid of {_p}%} to name of {_p}
    if {_heli} is true:
        bgTitleP({_p}, "&a&l탈출 성공!", "&f헬기가 이륙합니다 &7· 도둑 %{-bg::kd::need} ? 1%명이 탈출하면 승리")
    else:
        bgParticle(location of {_p}, "firework", 1, 2, 1, 0.1, 60)
        bgCmd("effect clear %name of {_p}%")
        teleport {_p} to bgKdMk("wait")
        bgTitleP({_p}, "&a&l탈출 성공!", "&f하수구로 빠져나왔습니다 &7· 도둑 %{-bg::kd::need} ? 1%명이 탈출하면 승리 · 전망대에서 구경")
    play sound "ui.toast.challenge_complete" to {_p}
    set {_e} to bgKdCount("esc")
    set {_f} to bgKdCount("free")
    bgKdSay("&a🚁 %name of {_p}% 탈출 성공! &7(탈출 &a%{_e}%/%{-bg::kd::need} ? 1%명 &7· 아직 도시에 %{_f}%명)")
    bgKdCheck()

on damage of player:
    bgKdOn(victim) is true
    cancel event
    attacker is a player
    # 던진 것 (수갑 · 연막탄) 은 경찰봉 타격으로 안 셈 — 경찰이 던진 수갑이 도둑에 맞으면 3초 느려짐
    if damage cause is projectile:
        if bgKdState() is "play":
            if bgKdRole(attacker) is "cop":
                if bgKdRole(victim) is "thief":
                    if bgKdJailed(victim) is false:
                        bgCmd("effect give %name of victim% slowness 3 2 true")
                        bgCmd("effect give %name of victim% glowing 3 0 true")
                        send title " " with subtitle "&9⛓ 수갑에 맞았다! &f3초 동안 느려짐" to victim for 30 ticks with fade in 0 ticks and fade out 6 ticks
                        send action bar "&9⛓ 수갑 명중!" to attacker
                        play sound "block.chain.place" with volume 1 and pitch 1.2 at location of victim
        stop
    bgKdState() is "play"
    set {_c} to attacker
    set {_t} to victim
    bgKdRole({_c}) is "cop"
    bgKdRole({_t}) is "thief"
    bgKdJailed({_t}) is false
    bgKdEsc({_t}) is false
    bgKdJailed({_c}) is false
    if {-bg::kd::imm::%uuid of {_t}%} is set:
        if difference between {-bg::kd::imm::%uuid of {_t}%} and now < 5 seconds:
            send action bar "&7탈옥 직후 5초 보호 중" to {_c}
            stop
    set {_hold} to {-bg::kd::hold} ? 0
    {_hold} <= 0
    # 마크 그대로 싸움: 경찰봉 = 네더라이트 검 성능 (공격력 8 · 공격 속도 1.6 · 치명타 · 덜 모은 타격은 약하게 — 전부 마크 기본)
    #  도둑 체력이 다 닳는 순간 = 체포 (죽지 않음: 그 한 대는 막고 체력 회복 → 감옥)
    #  밀치기 없음: 이벤트는 막아 둔 채 데미지만 직접 깎음 (차지·치명타 반영된 값 그대로)
    if damage >= health of {_t}:
        heal {_t}
        bgKdArrest({_t}, {_c})
        stop
    set health of {_t} to health of {_t} - damage
    {_t}.playHurtAnimation(0)
    bgSoundAt(location of {_t}, "entity.player.hurt", 1, 1)

# 연막탄: 맞은 자리 주변 경찰 3초 실명 (느려짐 없음 → 연막 안에서도 뛰고 점프 가능)
on projectile hit:
    event-projectile is a snowball
    set {_s} to shooter of event-projectile
    {_s} is a player
    bgKdOn({_s}) is true
    bgKdRole({_s}) is "thief"
    set {_l} to location of event-projectile
    bgParticle({_l}, "campfire_cosy_smoke", 1.6, 1.2, 1.6, 0.01, 60)
    bgParticle({_l}, "large_smoke", 2, 1, 2, 0.02, 40)
    play sound "entity.generic.extinguish_fire" at {_l}
    loop all players:
        if bgKdOn(loop-player) is true:
            if bgKdRole(loop-player) is "cop":
                if distance between loop-player and {_l} < 5:
                    bgCmd("effect give %name of loop-player% blindness 3 0 true")
                    send action bar "&7연막탄! 앞이 안 보입니다" to loop-player

# 매 5틱: 털이 진행 · 구출 발판 · 탈출
every 5 ticks:
    bgKdState() is "play"
    loop all players:
        bgKdOn(loop-player) is true
        bgKdRole(loop-player) is "thief"
        bgKdJailed(loop-player) is false
        bgKdEsc(loop-player) is false
        bgKdAboard(loop-player) is false
        set {_p} to loop-player
        set {_u} to "%uuid of {_p}%"
        # 털이 장소
        set {_at} to -1
        loop 6 times:
            set {_i} to loop-number - 1
            set {_h} to bgKdMk("heist_%{_i}%")
            if bgDist2(location of {_p}, {_h}) < 2.4:
                if abs((y-coordinate of {_p}) - (y-coordinate of {_h})) < 2:
                    set {_at} to {_i}
        if {_at} >= 0:
            if ({-bg::kd::hold} ? 0) > 0:
                send action bar "&7경찰 출동 전에는 털 수 없습니다 &8(%{-bg::kd::hold}%초) &7— 지금은 숨을 곳을 찾으세요" to {_p}
            else if ({-bg::kd::hcd::%{_at}%} ? 0) > 0:
                send action bar "&7%{-bg::kd::heistname::%{_at}%}% — 다시 털 수 있을 때까지 &c%{-bg::kd::hcd::%{_at}%}%초" to {_p}
            else if {_p} does not have tripwire hook:
                send action bar "&b해킹 칩&f이 있어야 털 수 있어요 &7— 건물 안 통(배럴)을 우클릭해서 찾아보세요" to {_p}
            else:
                add 5 to {-bg::kd::prog::%{_u}%}
                set {_pr} to {-bg::kd::prog::%{_u}%}
                set {_bar} to ""
                set {_k} to 0
                while {_k} < 16:
                    add 1 to {_k}
                    if {_k} * 7.5 <= {_pr}:
                        set {_bar} to "%{_bar}%&6■"
                    else:
                        set {_bar} to "%{_bar}%&8■"
                send action bar "&6%{-bg::kd::heistname::%{_at}%}% 털이 중 %{_bar}%" to {_p}
                play sound "block.note_block.hat" with volume 0.5 and pitch (0.8 + {_pr} / 120) to {_p}
                if {_pr} >= 120:
                    delete {-bg::kd::prog::%{_u}%}
                    bgCmd("clear %name of {_p}% tripwire_hook 1")
                    bgKdSteal({_p}, {_at})
        else:
            delete {-bg::kd::prog::%{_u}%}
        # 구출 발판
        if bgDist2(location of {_p}, bgKdMk("rescue")) < 1.9:
            if {-bg::kd::rescd} is not set:
                bgKdRescue({_p})
            else if difference between {-bg::kd::rescd} and now > 12 seconds:
                bgKdRescue({_p})
        # 탈출
        if {-bg::kd::open} is true:
            # 옥상 헬기 타는 문 앞 (아래층에서 겹치지 않게 높이도 확인) → 탑승 (이륙할 때 탈출)
            if ({-bg::kd::hstate} ? "land") is "land":
                set {_el} to bgKdHeliEsc()
                if bgDist2(location of {_p}, {_el}) < 4:
                    if abs((y-coordinate of {_p}) - (y-coordinate of {_el})) < 3:
                        bgKdBoard({_p})
            if {-bg::kd::sewer} is set:
                if bgDist2(location of {_p}, bgKdMk("sewer")) < 2.2:
                    if abs((y-coordinate of {_p}) - (y-coordinate of bgKdMk("sewer"))) < 3:
                        bgKdEscape({_p})

# 위쪽 보스바: 남은 시간 · 돈가방 · 남은 도둑 (경도에 있는 사람만 = 태그 bgkd)
function bgKdBar():
    bgCmd("bossbar add bg:kd {text:""경찰과 도둑""}")
    bgCmd("bossbar set bg:kd players @a[tag=bgkd]")
    if bgKdState() is not "play":
        bgCmd("bossbar set bg:kd color blue")
        bgCmd("bossbar set bg:kd max 1")
        bgCmd("bossbar set bg:kd value 1")
        set {_n} to bgKdCount("all")
        bgCmd("bossbar set bg:kd name [{text:""경찰과 도둑 "",color:""aqua"",bold:true},{text:""· 대기 %{_n}%명 · 관리자가 시작하면 역할이 정해집니다"",color:""white""}]")
        stop
    set {_max} to max(60, ({bg::cfg::kd_min} ? 8) * 60)
    bgCmd("bossbar set bg:kd max %{_max}%")
    bgCmd("bossbar set bg:kd value %max(0, {-bg::kd::left})%")
    set {_f} to bgKdCount("free")
    set {_t} to bgKdCount("thief")
    set {_tm} to bgKdTime(max(0, {-bg::kd::left}))
    set {_e} to bgKdCount("esc")
    if {-bg::kd::open} is true:
        bgCmd("bossbar set bg:kd color yellow")
        bgCmd("bossbar set bg:kd name [{text:""🚁 헬기 시동! "",color:""gold"",bold:true},{text:""%{_tm}% · 남은 도둑 %{_f}% · 탈출 %{_e}%/%{-bg::kd::need} ? 1%명"",color:""white""}]")
    else:
        bgCmd("bossbar set bg:kd color red")
        bgCmd("bossbar set bg:kd name [{text:""%{_tm}% "",color:""yellow"",bold:true},{text:""· 돈가방 %{-bg::kd::bags}%/%{-bg::kd::goal}% · 남은 도둑 %{_f}%/%{_t}% · 탈출 필요 %{-bg::kd::need} ? 1%명"",color:""white""}]")

# 매초: 시간 · 출동 대기 · 레이더 · 화면 표시 · 떨어짐 · 배고픔
every 1 second:
    set {-bg::kd::n} to 0
    loop all players:
        if bgKdOn(loop-player) is true:
            add 1 to {-bg::kd::n}
            bgCmd("tag %name of loop-player% add bgkd")
        else:
            bgCmd("tag %name of loop-player% remove bgkd")
    bgKdBar()
    loop 6 times:
        if ({-bg::kd::hcd::%loop-number - 1%} ? 0) > 0:
            remove 1 from {-bg::kd::hcd::%loop-number - 1%}
    if bgKdState() is "play":
        remove 1 from {-bg::kd::left}
        if ({-bg::kd::hold} ? 0) > 0:
            remove 1 from {-bg::kd::hold}
            if {-bg::kd::hold} is 0:
                loop all players:
                    if bgKdOn(loop-player) is true:
                        if bgKdRole(loop-player) is "cop":
                            teleport loop-player to bgKdMk("cop_spawn")
                            bgCmd("effect clear %name of loop-player% blindness")
                            bgTitleP(loop-player, "&9&l출동!", "&f도둑을 찾아 체포하세요")
                bgKdTitle("", "&9경찰 출동! 🚨")
                bgKdSound("item.goat_horn.sound.1", 1)
        else:
            remove 1 from {-bg::kd::radar}
            if {-bg::kd::radar} <= 0:
                set {-bg::kd::radar} to 60
                loop all players:
                    if bgKdOn(loop-player) is true:
                        if bgKdRole(loop-player) is "thief":
                            if bgKdJailed(loop-player) is false:
                                bgCmd("effect give %name of loop-player% glowing 3 0 true")
                bgKdSay("&b📡 경찰 레이더! &f도둑 위치가 3초 동안 보입니다")
                bgKdSound("block.beacon.power_select", 1.8)
        if {-bg::kd::left} is 60 or 30 or 10:
            bgKdSay("&e남은 시간 %{-bg::kd::left}%초!")
        if {-bg::kd::left} <= 0:
            set {_e} to bgKdCount("esc")
            if {_e} >= ({-bg::kd::need} ? 1):
                bgKdEnd("thief", "도둑 %{_e}%명 탈출 성공!")
            else if {_e} > 0:
                bgKdEnd("cop", "시간 종료 — 탈출 %{_e}%/%{-bg::kd::need} ? 1%명으로 부족")
            else:
                bgKdEnd("cop", "시간 종료 — 아무도 탈출하지 못했습니다")
    loop all players:
        bgKdOn(loop-player) is true
        set food level of loop-player to 20
        set {_r} to bgKdRole(loop-player)
        set {_st} to bgKdState()
        set {_tm} to bgKdTime({-bg::kd::left} ? 0)
        set {_bags} to "&6돈가방 %{-bg::kd::bags} ? 0%/%{-bg::kd::goal} ? 0%"
        if {-bg::kd::open} is true:
            set {_bags} to "&a&l탈출구 열림!"
        set {_na} to bgKdCount("all")
        set {_nf} to bgKdCount("free")
        set {_nt} to bgKdCount("thief")
        set {_nc} to bgKdCount("cop")
        if {_st} is not "play":
            send action bar "&9경찰&f과 &c도둑 &8| &f대기 %{_na}%명 &8| &7관리자가 /경도 시작" to loop-player
        else if {_r} is "cop":
            set {_hold} to ""
            if ({-bg::kd::hold} ? 0) > 0:
                set {_hold} to " &8| &e출동까지 %{-bg::kd::hold}%초"
            send action bar "&9&l경찰 &8| &f남은 도둑 &c%{_nf}%/%{_nt}% &8| %{_bags}% &8| &f%{_tm}% &8| &b레이더 %{-bg::kd::radar}%초%{_hold}%" to loop-player
        else if bgKdAboard(loop-player) is true:
            if bgKdEsc(loop-player) is true:
                send action bar "&a&l🚁 탈출 성공! &8| &f헬기를 타고 떠나는 중…" to loop-player
            else:
                send action bar "&a&l🚁 탑승 중 &8| &f이륙까지 &e%{-bg::kd::helit} ? 0%초 &8| &7탑승 %bgKdAboardN()%명 &8| &f%{_tm}%" to loop-player
            # 웅크려서 카메라에서 떨어지면 다시 붙임
            if loop-player.getSpectatorTarget() is not set:
                bgCmd("spectate @e[type=item_display,tag=bgkd_hcam,limit=1] %name of loop-player%")
        else if bgKdEsc(loop-player) is true:
            send action bar "&a&l탈출 성공 &8| &f판이 끝나길 기다리는 중 &8| &f%{_tm}%" to loop-player
        else if bgKdJailed(loop-player) is true:
            send action bar "&7&l감옥 &8| &f동료가 초록 구출 발판을 밟으면 탈옥 &8| %{_bags}% &8| &f%{_tm}%" to loop-player
        else if {-bg::kd::open} is true:
            set {_hd} to round(distance between loop-player and bgKdHeliEsc())
            set {_sw} to "&7하수구: 밸브 %bgKdValves()%/3"
            if {-bg::kd::sewer} is set:
                set {_sw} to "&b&l하수구 열림!"
            set {_hs} to {-bg::kd::hstate} ? "land"
            if {_hs} is "away":
                send action bar "&e🚁 &f%{-bg::kd::helit} ? 0%초 뒤 &e%bgKdHeliName({-bg::kd::helito} ? 1)%&f에 헬기 착륙 &8| %{_sw}% &8| &f%{_tm}%" to loop-player
            else if {_hs} is "fly":
                send action bar "&e🚁 헬기 비행 중… &8| %{_sw}% &8| &f%{_tm}%" to loop-player
            else:
                send action bar "&e&l🚁 %bgKdHeliName({bg::kd::helipos} ? 0)% &f%{_hd}%m &8| &c이륙까지 %{-bg::kd::helit} ? 0%초 &8| %{_sw}% &8| &f%{_tm}%" to loop-player
        else if {-bg::kd::prog::%uuid of loop-player%} is not set:
            send action bar "&c&l도둑 &8| %{_bags}% &8| &f남은 시간 %{_tm}% &8| &9경찰 %{_nc}%명 &8| &7레이더 %{-bg::kd::radar}%초" to loop-player
        # 도시 밖으로 떨어지면 제자리로
        if (y-coordinate of loop-player) < {bg::hub::y} - 8:
            if {_st} is not "play":
                teleport loop-player to bgKdMk("wait")
            else if bgKdEsc(loop-player) is true:
                teleport loop-player to bgKdMk("wait")
            else if bgKdJailed(loop-player) is true:
                teleport loop-player to bgKdMk("jail")
            else if {_r} is "cop":
                teleport loop-player to bgKdMk("cop_spawn")
            else:
                teleport loop-player to bgKdThiefSpot()
    # 털이 장소 · 헬기장 반짝이
    bgKdReady() is true
    bgKdState() is "play"
    loop 6 times:
        set {_h} to bgKdMk("heist_%loop-number - 1%")
        if ({-bg::kd::hcd::%loop-number - 1%} ? 0) > 0:
            bgParticle(bgUp({_h}, 1), "smoke", 0.5, 0.5, 0.5, 0, 5)
        else:
            bgParticle(bgUp({_h}, 1), "wax_on", 0.6, 0.6, 0.6, 0, 6)
    if {-bg::kd::open} is true:
        if {-bg::kd::heliflying} is not true:
            bgParticle(bgUp(bgKdHeliEsc(), 1), "end_rod", 2, 4, 2, 0.02, 30)
        if {-bg::kd::sewer} is set:
            bgParticle(bgUp(bgKdMk("sewer"), 0.5), "bubble_column_up", 0.8, 0.5, 0.8, 0.05, 20)
    bgParticle(bgUp(bgKdMk("rescue"), 1), "happy_villager", 0.8, 0.3, 0.8, 0, 6)

# 떠 있는 안내 글자 (털이 장소 · 구출 발판 · 헬기장 · 감옥)
function bgKdText(id: text, l: location, txt: text):
    # 털이 장소(h0~h5) · 밸브(v0~v2) 글자는 가까이 가야 보임 (벽 너머 X) — 직접 찾아다니게
    if first character of {_id} is "h" or "v":
        bgCmd("execute in %bgDim()% run summon text_display %bgC(x-coordinate of {_l})% %bgN((y-coordinate of {_l}) + 2.6)% %bgC(z-coordinate of {_l})% {Tags:[""bgkd"",""bgkd_%{_id}%""],billboard:""center"",shadow:1b,background:1073741824,brightness:{sky:15,block:15},view_range:0.5f,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1.4f,1.4f,1.4f]},text:%{_txt}%}")
        stop
    bgCmd("execute in %bgDim()% run summon text_display %bgC(x-coordinate of {_l})% %bgN((y-coordinate of {_l}) + 2.6)% %bgC(z-coordinate of {_l})% {Tags:[""bgkd"",""bgkd_%{_id}%""],billboard:""center"",shadow:1b,see_through:1b,background:1073741824,brightness:{sky:15,block:15},view_range:4f,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1.4f,1.4f,1.4f]},text:%{_txt}%}")

# 위치 빛 기둥: 가늘고 긴 발광 블록 디스플레이 (발광 테두리는 건물 너머로도 보임)
function bgKdPillar(l: location, blk: text, col: number, h: number):
    bgCmd("execute in %bgDim()% run summon block_display %bgC(x-coordinate of {_l})% %bgN(y-coordinate of {_l})% %bgC(z-coordinate of {_l})% {Tags:[""bgkd"",""bgkd_pillar""],block_state:{Name:""minecraft:%{_blk}%""},Glowing:1b,glow_color_override:%{_col}%,brightness:{sky:15,block:15},view_range:64f,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.2f,0f,-0.2f],scale:[0.4f,%{_h}%f,0.4f]}}")

function bgKdTexts():
    bgKdReady() is true
    bgCmd("kill @e[type=text_display,tag=bgkd]")
    bgCmd("kill @e[type=block_display,tag=bgkd_pillar]")
    # 위치 표시 = 신호기 빛줄기 (발광 디스플레이 기둥 대신)
    bgKdBeams()
    if {-bg::kd::open} is true:
        loop 3 times:
            set {_vi} to loop-number - 1
            if {-bg::kd::valve::%{_vi}%} is set:
                bgKdText("v%{_vi}%", bgKdValvePos({_vi}), "[{text:""🔧 밸브 %{_vi} + 1%"",color:""green"",bold:true},{text:""\n돌아감"",color:""white""}]")
            else:
                bgKdText("v%{_vi}%", bgKdValvePos({_vi}), "[{text:""🔧 밸브 %{_vi} + 1%"",color:""aqua"",bold:true},{text:""\n우클릭 연타로 돌리기 (3개 → 하수구)"",color:""white""}]")
        if {-bg::kd::sewer} is set:
            bgKdText("sewer", bgKdMk("sewer"), "[{text:""🕳 하수구 열림!"",color:""aqua"",bold:true},{text:""\n맨홀로 들어가면 탈출"",color:""green""}]")
        else:
            bgKdText("sewer", bgKdMk("sewer"), "[{text:""🕳 하수구 맨홀"",color:""gray"",bold:true},{text:""\n밸브 3개를 돌리면 열림"",color:""gray""}]")
    loop 6 times:
        set {_i} to loop-number - 1
        bgKdText("h%{_i}%", bgKdMk("heist_%{_i}%"), "[{text:""💰 %{-bg::kd::heistname::%{_i}%}%"",color:""gold"",bold:true},{text:""\n6초 서 있으면 털기"",color:""white"",bold:false}]")
    bgKdText("rescue", bgKdMk("rescue"), "[{text:""🔓 구출 발판"",color:""green"",bold:true},{text:""\n밟으면 감옥 전원 탈옥"",color:""white"",bold:false}]")
    if {-bg::kd::heliflying} is not true:
        if {-bg::kd::open} is true:
            bgKdText("escape", bgKdHeliEsc(), "[{text:""🚁 탈출 헬기"",color:""gold"",bold:true},{text:""\n시동 걸림! 타고 있으면 이륙 때 탈출"",color:""green"",bold:true}]")
        else:
            bgKdText("escape", bgKdHeliEsc(), "[{text:""🚁 탈출 헬기"",color:""gold"",bold:true},{text:""\n잠김 · 돈가방을 다 모으면 시동"",color:""gray"",bold:false}]")
    loop 3 times:
        set {_gi} to loop-number - 1
        bgKdText("gate%{_gi}%", bgKdMk("heli_gate_%{_gi}%"), "[{text:""🚁 %bgKdHeliName({_gi})%"",color:""gold"",bold:true},{text:""\n안쪽 계단으로 옥상까지 (헬기가 올 수 있음)"",color:""white"",bold:false}]")
    bgKdText("jail", bgKdMk("jail"), "{text:""감옥"",color:""red"",bold:true}")

# 배치 3벌 (일반 건물 자리만 다름 · 특수 건물 · 도로 · 표지는 같음) 중 지난번과 다른 하나
function bgKdBuildRaw():
    set {_old} to {bg::kd::layout} ? -1
    set {_v} to random integer between 0 and 2
    if {_v} is {_old}:
        set {_v} to mod({_v} + 1, 3)
    set {bg::kd::layout} to {_v}
    set {bg::kd::helipos} to 0
    add 1 to {-bg::kd::hgen}
    set {-bg::kd::hstate} to "land"
    delete {-bg::kd::heliflying}
    delete {-bg::kd::rotsp}
    delete {-bg::kd::hloc}
    delete {bg::kd::mcover}
    delete {bg::kd::vsel::*}
    bgCmd("data merge storage bg:kd%{_v}% {origin:{x:%{bg::hub::x}%,y:%{bg::hub::y}%,z:%{bg::hub::z} - 260%}}")
    bgCmd("function bg:kd%{_v}%/build")

function bgKdBuild(p: player):
    if {bg::hub::x} is not set:
        send "&9[경도] &f허브 위치가 먼저 필요합니다. &e/허브 건설" to {_p}
        stop
    if bgKdState() is "play":
        send "&9[경도] &c판이 진행 중에는 도시를 다시 지을 수 없습니다. &7(/경도 종료 먼저)" to {_p}
        stop
    loop all players:
        if bgKdOn(loop-player) is true:
            bgKdLeave(loop-player)
    send "&9[경도] &f도시를 짓는 중... &7(배치를 새로 섞음 · 30초쯤 · 렉 안 걸리게 조금씩)" to {_p}
    bgKdBuildRaw()
    loop 1200 times:
        wait 10 ticks
        if bgBuilt("kd%{bg::kd::layout}%") is true:
            exit loop
    set {bg::kd::built} to true
    set {-bg::kd::state} to "wait"
    teleport {_p} to bgKdMk("wait")
    wait 40 ticks
    bgKdTexts()
    send "&9[경도] &a도시 완성! &7(/경도 글자 · /경도 시작)" to {_p}

on break:
    bgKdOn(player) is true
    gamemode of player is not creative
    cancel event

on place:
    bgKdOn(player) is true
    gamemode of player is not creative
    cancel event

on drop:
    bgKdOn(player) is true
    gamemode of player is not creative
    cancel event

on quit:
    bgKdDrop(player)

# ─────────────────────────────────────────────────────────── 명령
command /경도 [<text>] [<text>]:
    aliases: /kd
    trigger:
        set {_op} to true
        if sender is a player:
            if player is not op:
                set {_op} to false
        if {_op} is true:
            if arg-1 is "시작":
                set {_c} to (arg-2 parsed as integer) ? 0
                bgKdStart(sender, {_c})
                stop
            if arg-1 is "종료":
                bgKdEnd("none", "관리자가 끝냈습니다")
                stop
            if arg-1 is "시간":
                set {_m} to arg-2 parsed as integer
                if {_m} is set:
                    set {bg::cfg::kd_min} to max(2, min(30, {_m}))
                send "&9[경도] &f제한 시간 &e%{bg::cfg::kd_min} ? 8%분"
                stop
            if arg-1 is "목표":
                set {_m} to arg-2 parsed as integer
                if {_m} is set:
                    set {bg::cfg::kd_goal} to max(1, min(30, {_m}))
                else:
                    delete {bg::cfg::kd_goal}
                set {_g} to "자동 (도둑 수 + 1, 3~8)"
                if {bg::cfg::kd_goal} is set:
                    set {_g} to "%{bg::cfg::kd_goal}%개"
                send "&9[경도] &f목표 돈가방: &e%{_g}%"
                stop
            if arg-1 is "자동맵":
                if {bg::cfg::kd_noremap} is true:
                    delete {bg::cfg::kd_noremap}
                    send "&9[경도] &f판이 끝나면 맵 자동으로 바꾸기: &a켜짐"
                else:
                    set {bg::cfg::kd_noremap} to true
                    send "&9[경도] &f판이 끝나면 맵 자동으로 바꾸기: &c꺼짐"
                stop
            if arg-1 is "건설" or "맵바꾸기":
                if sender is a player:
                    bgKdBuild(player)
                stop
            # 전체 이동: 서버의 모든 사람 (신화쟁탈전 게임 중 · 관전 끔 제외) → 경도 대기실
            if arg-1 is "전체" or "@a" or "all":
                if bgKdReady() is false:
                    send "&9[경도] &c도시가 아직 없습니다. &e/경도 건설 &7을 먼저 해 주세요"
                    stop
                set {_n} to 0
                loop all players:
                    if bgKdOn(loop-player) is false:
                        if bgInGame(loop-player) is false:
                            if bgOptOut(loop-player) is false:
                                delete {-bg::forced::%uuid of loop-player%}
                                bgKdJoin(loop-player)
                                bgForcedSet(loop-player, "kd")
                                add 1 to {_n}
                broadcast "&9[경도] &f관리자가 &e%{_n}%명&f을 경찰과 도둑으로 보냈습니다."
                stop
            if arg-1 is "글자":
                bgKdTexts()
                send "&9[경도] &f안내 글자를 다시 만들었습니다."
                stop
            if arg-1 is "전적초기화":
                delete {bg::kd::wins::*}
                delete {bg::kd::arrests::*}
                delete {bg::kd::steals::*}
                delete {bg::kd::escapes::*}
                delete {bg::kd::rescues::*}
                broadcast "&9[경도] &f전적을 초기화했습니다."
                stop
        if arg-1 is "랭킹" or "순위":
            set {_ids::*} to sorted indices of {bg::kd::wins::*} in descending order
            send "&9&l[경도 랭킹] &7승리 순위 10위"
            set {_i} to 0
            loop {_ids::*}:
                add 1 to {_i}
                if {_i} <= 10:
                    set {_u} to loop-value
                    set {_nm} to {bg::kd::name::%{_u}%} ? "?"
                    send "&e  %{_i}%위 &f%{_nm}% &7— &6%{bg::kd::wins::%{_u}%}%승 &9체포 %{bg::kd::arrests::%{_u}%} ? 0% &6털이 %{bg::kd::steals::%{_u}%} ? 0% &a구출 %{bg::kd::rescues::%{_u}%} ? 0% &d탈출 %{bg::kd::escapes::%{_u}%} ? 0%"
            if {_i} is 0:
                send "&7  아직 기록이 없습니다."
            stop
        if sender is not a player:
            send "&c사용법: /경도 시작 [경찰수] · 종료 · 시간 <분> · 목표 <개> · 랭킹"
            stop
        if arg-1 is "나가기":
            if bgForced(player) is true:
                stop
            if bgKdNoLeave(player) is true:
                stop
            if bgKdOn(player) is true:
                bgKdLeave(player)
            else:
                send "&9[경도] &7경도에 있지 않습니다."
            stop
        if arg-1 is "전적":
            set {_t} to player
            if arg-2 is set:
                set {_t} to arg-2 parsed as offline player
            set {_u} to "%uuid of {_t}%"
            set {_nm} to {bg::kd::name::%{_u}%} ? name of {_t}
            send "&9[경도] &f%{_nm}% &7— &6%{bg::kd::wins::%{_u}%} ? 0%승 &9체포 %{bg::kd::arrests::%{_u}%} ? 0% &6털이 %{bg::kd::steals::%{_u}%} ? 0% &a구출 %{bg::kd::rescues::%{_u}%} ? 0% &d탈출 %{bg::kd::escapes::%{_u}%} ? 0%"
            stop
        if bgKdOn(player) is true:
            send "&9[경도] &f/경도 나가기 · 전적 · 랭킹 &7(관리자: 시작 · 종료 · 시간 · 목표)"
            stop
        bgHubGo(player, "cops")

# ─────────────────────────────────────────────────────────── 능력 아이템 (우클릭)
#  경찰 무전기: 가장 가까운 도둑 방향 화살표 · 거리 (25초) / 도둑 운동화: 4초 질주 (20초)
function bgKdArrow(p: player, l: location) :: text:
    set {_dx} to (x-coordinate of {_l}) - (x-coordinate of {_p})
    set {_dz} to (z-coordinate of {_l}) - (z-coordinate of {_p})
    set {_ty} to atan2({_dz}, -1 * {_dx})
    set {_py} to {_p}.getLocation().getYaw()
    # 내가 보는 방향 기준 (오른쪽으로 돌면 + ) · 마크 기본 글꼴에 있는 화살표만
    set {_d} to mod({_ty} - {_py} + 540, 360) - 180
    set {_i} to mod(round({_d} / 45) + 8, 8)
    set {_ar::*} to "↑", "↗", "→", "↘", "↓", "↙", "←" and "↖"
    return {_ar::%{_i} + 1%}

# 무전기: 5초 동안 화살표 · 거리를 계속 갱신 (도둑이 움직여도 따라감)
function bgKdRadioTrack(p: player, tg: player):
    loop 50 times:
        if {_p} is not online:
            stop
        if {_tg} is not online:
            stop
        if bgKdJailed({_tg}) is true:
            send title "&a✔" with subtitle "&7그 도둑은 이미 잡혔어요" to {_p} for 20 ticks with fade in 0 ticks and fade out 10 ticks
            stop
        if bgKdEsc({_tg}) is true:
            stop
        set {_a} to bgKdArrow({_p}, location of {_tg})
        set {_dd} to round(distance between {_p} and {_tg})
        if loop-number < 50:
            send title "&b&l%{_a}%" with subtitle "&b📡 가장 가까운 도둑 &f%{_dd}%m &7(%ceil((50 - loop-number) / 10)%초)" to {_p} for 6 ticks with fade in 0 ticks and fade out 0 ticks
        else:
            send title "&b&l%{_a}%" with subtitle "&b📡 가장 가까운 도둑 &f%{_dd}%m" to {_p} for 4 ticks with fade in 0 ticks and fade out 10 ticks
        wait 2 ticks

on right click:
    bgKdOn(player) is true
    bgKdState() is "play"
    if player's tool is echo shard:
        cancel event
        bgKdRole(player) is "cop"
        if {-bg::kd::cdr::%uuid of player%} is set:
            if difference between {-bg::kd::cdr::%uuid of player%} and now < 25 seconds:
                send action bar "&7무전기 재충전 중..." to player
                stop
        set {_best} to 9999
        loop all players:
            if bgKdOn(loop-player) is true:
                if bgKdRole(loop-player) is "thief":
                    if bgKdJailed(loop-player) is false:
                        if bgKdEsc(loop-player) is false:
                            set {_dd} to distance between player and loop-player
                            if {_dd} < {_best}:
                                set {_best} to {_dd}
                                set {_tg} to loop-player
        if {_tg} is not set:
            send action bar "&7잡을 도둑이 없습니다" to player
            stop
        set {-bg::kd::cdr::%uuid of player%} to now
        bgKdRadioTrack(player, {_tg})
        play sound "block.note_block.bit" with volume 1 and pitch 1.6 to player
        play sound "block.note_block.bit" with volume 0.4 and pitch 0.8 to {_tg}
        send action bar "&c삐빅… 경찰 무전기에 위치가 잡혔다!" to {_tg}
    else if player's tool is feather:
        cancel event
        bgKdRole(player) is "thief"
        if {-bg::kd::cds::%uuid of player%} is set:
            if difference between {-bg::kd::cds::%uuid of player%} and now < 20 seconds:
                send action bar "&7운동화 끈 다시 묶는 중..." to player
                stop
        set {-bg::kd::cds::%uuid of player%} to now
        bgCmd("effect give %name of player% speed 4 2 true")
        bgParticle(location of player, "cloud", 0.4, 0.1, 0.4, 0.05, 20)
        play sound "entity.breeze.wind_burst" with volume 0.8 and pitch 1.3 to player
        send action bar "&c&l질주!" to player

# 옥상 헬기 로터 (블록 디스플레이) — 메인 로터는 엔티티 방향을 돌리고 (teleport_duration 2 = 부드럽게)
#  꼬리 로터는 x 축 둘레 회전(left_rotation)을 바꿔 보간 · 경도에 사람이 있을 때만 · 탈출 시동이 걸리면 빨라짐
every 2 ticks:
    ({-bg::kd::n} ? 0) > 0
    set {_sp} to 17
    if {-bg::kd::open} is true:
        set {_sp} to 37
    if {-bg::kd::rotsp} is set:
        set {_sp} to {-bg::kd::rotsp}
    bgCmd("execute as @e[type=block_display,tag=kd_rotor] at @s run tp @s ~ ~ ~ ~%{_sp}% ~")
    set {-bg::kd::tra} to mod(({-bg::kd::tra} ? 0) + 1.1, 6.2832)
    bgCmd("execute as @e[type=block_display,tag=kd_trot] run data merge entity @s {start_interpolation:0,interpolation_duration:2,transformation:{left_rotation:{angle:%bgN({-bg::kd::tra})%f,axis:[1f,0f,0f]}}}")

# ─────────────────────────────────────────────────────────── 파밍: 건물 안 통(배럴) 뒤지기 (도둑 · 판 중)
#  우클릭하고 통 옆에서 3초 뒤지면 나옴 (멀어지면 취소) · 통마다 45초에 한 번 (판 끝나면 초기화)
#  해킹 칩(털이에 필요 · 1개 씀) 45% · 연막탄 · 신속 · 점프 · 꽝
on right click on barrel:
    bgKdOn(player) is true
    cancel event
    bgKdState() is "play"
    bgKdRole(player) is "thief"
    bgKdJailed(player) is false
    set {_k} to "%x-coordinate of event-block%_%y-coordinate of event-block%_%z-coordinate of event-block%"
    if {-bg::kd::loot::%{_k}%} is set:
        if difference between {-bg::kd::loot::%{_k}%} and now < 45 seconds:
            send action bar "&7이미 뒤진 통이에요 — 다른 건물로!" to player
            stop
    set {_u} to "%uuid of player%"
    if {-bg::kd::srch::%{_u}%} is {_k}:
        stop
    # 뒤지기 시작 — 통 옆(2.5칸 안)에 3초 있어야 나옴 · 멀어지면 취소
    set {-bg::kd::srch::%{_u}%} to {_k}
    set {-bg::kd::srchloc::%{_u}%} to location of event-block
    set {-bg::kd::srchp::%{_u}%} to 0
    play sound "block.barrel.open" to player

every 5 ticks:
    loop all players:
        set {_p} to loop-player
        set {_u} to "%uuid of {_p}%"
        {-bg::kd::srch::%{_u}%} is set
        set {_ok} to true
        if bgKdOn({_p}) is false:
            set {_ok} to false
        else if bgKdState() is not "play":
            set {_ok} to false
        else if bgKdJailed({_p}) is true:
            set {_ok} to false
        else if distance between {_p} and {-bg::kd::srchloc::%{_u}%} > 2.8:
            set {_ok} to false
            send action bar "&7통에서 멀어져서 뒤지기를 그만뒀어요" to {_p}
        if {_ok} is false:
            delete {-bg::kd::srch::%{_u}%}
            delete {-bg::kd::srchloc::%{_u}%}
            delete {-bg::kd::srchp::%{_u}%}
        else:
            add 5 to {-bg::kd::srchp::%{_u}%}
            set {_pr} to {-bg::kd::srchp::%{_u}%}
            set {_bar} to ""
            set {_n} to 0
            while {_n} < 12:
                add 1 to {_n}
                if {_n} * 5 <= {_pr}:
                    set {_bar} to "%{_bar}%&e■"
                else:
                    set {_bar} to "%{_bar}%&8■"
            send action bar "&6통 뒤지는 중 %{_bar}%" to {_p}
            if mod({_pr}, 15) is 0:
                play sound "block.barrel.close" with volume 0.4 and pitch (0.8 + {_pr} / 100) to {_p}
            if {_pr} >= 60:
                set {_bk} to {-bg::kd::srch::%{_u}%}
                set {-bg::kd::loot::%{_bk}%} to now
                set {_l} to {-bg::kd::srchloc::%{_u}%}
                delete {-bg::kd::srch::%{_u}%}
                delete {-bg::kd::srchloc::%{_u}%}
                delete {-bg::kd::srchp::%{_u}%}
                bgKdLoot({_p}, {_l})

# 통에서 나오는 것 (해킹 칩 45% · 연막탄 · 신속 · 점프 · 꽝)
function bgKdLoot(p: player, l: location):
    bgParticle({_l}, "happy_villager", 0.4, 0.4, 0.4, 0, 8)
    set {_r} to random integer between 1 and 100
    if {_r} <= 45:
        bgCmd("give %name of {_p}% tripwire_hook[item_name={text:""해킹 칩"",color:""aqua"",bold:true},lore=[{text:""털이 장소에서 금고를 열 때 1개 씀"",color:""gray"",italic:false}]] 1")
        send action bar "&b✦ 해킹 칩 발견! &7— 털이 장소를 찾아가세요" to {_p}
        play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.4 to {_p}
    else if {_r} <= 60:
        bgCmd("give %name of {_p}% snowball[item_model=""bg:kd/smoke"",item_name={text:""연막탄"",color:""gray"",bold:true}] 1")
        send action bar "&6연막탄 +1" to {_p}
    else if {_r} <= 72:
        bgKdDrink({_p}, "energy")
        send action bar "&6에너지 드링크 +1 &7(마시면 8초 신속 II)" to {_p}
    else if {_r} <= 82:
        bgKdDrink({_p}, "jump")
        send action bar "&a점프 드링크 +1 &7(마시면 10초 점프 강화)" to {_p}
    else:
        send action bar "&8꽝… 빈 통이에요" to {_p}

# ─────────────────────────────────────────────────────────── 경찰 직급 (지금 감옥에 있는, 내가 잡은 도둑 수)
#  기준은 판의 도둑 수에 비례: 경장 = max(1, 도둑×15%) · 경사 = max(2, 도둑×30%) · 경위 = max(3, 도둑×50%) 명 (올림)
#  도둑이 탈옥해 수가 줄면 그 자리에서 강등 (아이템도 회수) · 1초마다 확인
#  순경(0) → 경장(1): 상시 신속 I → 경사(2): 추격 진주 2 + 수갑 3 (던지면 맞은 도둑 3초 느려짐)
#  → 경위(3): 도둑 추적기 (우클릭: 가장 가까운 도둑 4초 발광 · 30초) + 상시 신속 II
function bgKdRankName(r: number) :: text:
    if {_r} >= 3:
        return "&6경위"
    if {_r} is 2:
        return "&e경사"
    if {_r} is 1:
        return "&b경장"
    return "&7순경"

function bgKdRankNeed(r: number) :: number:
    set {_t} to bgKdCount("thief")
    if {_r} >= 3:
        return max(3, ceil({_t} * 0.5))
    if {_r} is 2:
        return max(2, ceil({_t} * 0.3))
    return max(1, ceil({_t} * 0.15))

# 실적 기록 (통계) — 내가 잡은 도둑이 감옥에 있는 동안 5초마다 +1
every 5 seconds:
    bgKdState() is "play"
    loop all players:
        bgKdOn(loop-player) is true
        bgKdRole(loop-player) is "thief"
        bgKdJailed(loop-player) is true
        set {_c} to {-bg::kd::by::%uuid of loop-player%}
        {_c} is set
        add 1 to {-bg::kd::merit::%{_c}%}
        add 1 to {bg::kd::meritall::%{_c}%}

every 1 second:
    bgKdState() is "play"
    delete {_jn::*}
    loop all players:
        if bgKdOn(loop-player) is true:
            if bgKdRole(loop-player) is "thief":
                if bgKdJailed(loop-player) is true:
                    set {_c} to {-bg::kd::by::%uuid of loop-player%}
                    if {_c} is set:
                        add 1 to {_jn::%{_c}%}
    set {_n1} to bgKdRankNeed(1)
    set {_n2} to bgKdRankNeed(2)
    set {_n3} to bgKdRankNeed(3)
    loop all players:
        bgKdOn(loop-player) is true
        bgKdRole(loop-player) is "cop"
        set {_u} to "%uuid of loop-player%"
        set {_j} to {_jn::%{_u}%} ? 0
        set {_r} to 0
        if {_j} >= {_n3}:
            set {_r} to 3
        else if {_j} >= {_n2}:
            set {_r} to 2
        else if {_j} >= {_n1}:
            set {_r} to 1
        set {_old} to {-bg::kd::rank::%{_u}%} ? 0
        if {_r} >= 3:
            bgCmd("effect give %name of loop-player% speed 3 1 true")
        else if {_r} >= 1:
            bgCmd("effect give %name of loop-player% speed 3 0 true")
        if {_r} > {_old}:
            set {-bg::kd::rank::%{_u}%} to {_r}
            bgTitleP(loop-player, "&9&l진급! %bgKdRankName({_r})%", "&f내가 가둔 도둑 %{_j}%명 &7· 탈옥하면 강등")
            play sound "ui.toast.challenge_complete" to loop-player
            if {_r} >= 2:
                if {_old} < 2:
                    bgCmd("give %name of loop-player% ender_pearl[item_name={text:""추격 진주"",color:""dark_aqua"",bold:true}] 2")
                    bgCmd("give %name of loop-player% snowball[item_name={text:""수갑"",color:""blue"",bold:true},lore=[{text:""던져 맞히면 도둑이 3초 동안 느려짐"",color:""gray"",italic:false}]] 3")
            if {_r} >= 3:
                if {_old} < 3:
                    bgCmd("give %name of loop-player% recovery_compass[item_name={text:""도둑 추적기"",color:""gold"",bold:true},lore=[{text:""우클릭: 가장 가까운 도둑 4초 발광 (30초마다)"",color:""gray"",italic:false}]] 1")
            bgKdSay("&9%name of loop-player%&f 경찰이 %bgKdRankName({_r})%&f(으)로 진급!")
        else if {_r} < {_old}:
            set {-bg::kd::rank::%{_u}%} to {_r}
            bgTitleP(loop-player, "&c&l강등… %bgKdRankName({_r})%", "&f가둔 도둑이 빠져나갔습니다 &7(지금 %{_j}%명)")
            play sound "entity.villager.no" to loop-player
            if {_r} < 3:
                bgCmd("clear %name of loop-player% recovery_compass")
            if {_r} < 2:
                bgCmd("clear %name of loop-player% ender_pearl")
                bgCmd("clear %name of loop-player% snowball")
            if {_r} is 0:
                bgCmd("effect clear %name of loop-player% speed")

# 경위: 도둑 추적기 — 가장 가까운 (안 잡힌 · 탈출 안 한) 도둑을 4초 발광 · 30초마다
on right click:
    bgKdOn(player) is true
    player's tool is recovery compass
    cancel event
    bgKdRole(player) is "cop"
    bgKdState() is "play"
    set {_u} to "%uuid of player%"
    if {-bg::kd::trk::%{_u}%} is set:
        if difference between {-bg::kd::trk::%{_u}%} and now < 30 seconds:
            send action bar "&7추적기 재충전 중…" to player
            stop
    set {_best} to 9999
    loop all players:
        if bgKdOn(loop-player) is true:
            if bgKdRole(loop-player) is "thief":
                if bgKdJailed(loop-player) is false:
                    if bgKdEsc(loop-player) is false:
                        set {_d} to distance between player and loop-player
                        if {_d} < {_best}:
                            set {_best} to {_d}
                            set {_t} to loop-player
    {_t} is set
    set {-bg::kd::trk::%{_u}%} to now
    bgCmd("effect give %name of {_t}% glowing 4 0 true")
    send action bar "&6📡 추적! &f%name of {_t}% &7— &e%round({_best})%m" to player
    send action bar "&c삐빅… 경위 추적기에 잡혔다! (4초)" to {_t}
    play sound "block.note_block.pling" with volume 1 and pitch 1.8 to player

# ─────────────────────────────────────────────────────────── 탈출 헬기 (옥상 헬기장 3곳: 북동 · 북서 · 남동)
#  돈가방을 다 모으면 지금 헬기장에서 60초 동안 탑승 → 이륙 (탄 사람 전원 탈출 · 못 탄 사람은 두고 감)
#  → 도시 위를 날아 구름 속으로 사라짐 → 20초 뒤 다른 옥상에 내려와 다시 60초 탑승 … (날거나 없는 동안은 못 탐)
#  탄 사람 = 관전 모드로 헬기 뒤를 따라가는 카메라 (item_display bgkd_hcam) 를 봄
#  헬기 = 블록 디스플레이 (몸체 kd_heli · 메인 로터 kd_rotor · 꼬리 로터 kd_trot)
#   몸체 기준점 하나의 위치 · 방향(yaw) · 기울기(pitch, + = 기수 숙임) 로 로터 축 자리를 계산해 절대 좌표로 순간이동
#   (teleport_duration 2 · 2틱마다 = 부드럽게) · {-bg::kd::hgen} 이 바뀌면 (판 시작 · 다시 짓기) 진행 중 애니메이션은 멈춤
function bgKdHeliName(i: number) :: text:
    if {_i} is 1:
        return "북서 빌딩 옥상"
    if {_i} is 2:
        return "남동 빌딩 옥상"
    return "북동 헬기장 타워"

function bgKdHeliEsc() :: location:
    return bgKdMk("escape_%{bg::kd::helipos} ? 0%")

function bgKdAboard(p: player) :: boolean:
    if {-bg::kd::abd::%uuid of {_p}%} is true:
        return true
    return false

function bgKdAboardN() :: number:
    set {_n} to 0
    loop all players:
        if bgKdAboard(loop-player) is true:
            add 1 to {_n}
    return {_n}

function bgKdRig(l: location, yw: number, pt: number):
    set {_cy} to cos({_yw})
    set {_sy} to sin({_yw})
    set {_cp} to cos({_pt})
    set {_sp} to sin({_pt})
    set {_x} to x-coordinate of {_l}
    set {_y} to y-coordinate of {_l}
    set {_z} to z-coordinate of {_l}
    bgCmd("execute as @e[type=block_display,tag=kd_heli,tag=!kd_rotor,tag=!kd_trot] at @s run tp @s %bgC({_x})% %bgN({_y})% %bgC({_z})% %bgN({_yw})% %bgN({_pt})%")
    # 메인 로터 축 (0, 4.125, -0.25) · 꼬리 로터 축 (0.406, 3.125, -6.875) — 몸체 기준 (블록 · 앞 = +z)
    set {_my} to 4.125 * {_cp} + 0.25 * {_sp}
    set {_mz} to 4.125 * {_sp} - 0.25 * {_cp}
    bgCmd("execute as @e[type=block_display,tag=kd_rotor] at @s run tp @s %bgC({_x} - {_mz} * {_sy})% %bgN({_y} + {_my})% %bgC({_z} + {_mz} * {_cy})% ~ 0")
    set {_ty} to 3.125 * {_cp} + 6.875 * {_sp}
    set {_tz} to 3.125 * {_sp} - 6.875 * {_cp}
    bgCmd("execute as @e[type=block_display,tag=kd_trot] at @s run tp @s %bgC({_x} + 0.406 * {_cy} - {_tz} * {_sy})% %bgN({_y} + {_ty})% %bgC({_z} + 0.406 * {_sy} + {_tz} * {_cy})% %bgN({_yw})% %bgN({_pt})%")
    # 뒤따라가는 카메라 (꼬리 뒤 17 · 위 5.5 · 살짝 내려다봄)
    bgCmd("execute as @e[type=item_display,tag=bgkd_hcam] at @s run tp @s %bgC({_x} + 17 * {_sy})% %bgN({_y} + 5.5)% %bgC({_z} - 17 * {_cy})% %bgN({_yw})% 12")
    set {-bg::kd::hloc} to {_l}
    set {-bg::kd::hyaw} to {_yw}
    set {-bg::kd::hpit} to {_pt}

function bgKdHeliVis(on: boolean):
    set {_v} to "0f"
    if {_on} is true:
        set {_v} to "3f"
    bgCmd("execute as @e[type=block_display,tag=kd_heli] run data merge entity @s {view_range:%{_v}%}")

function bgKdSmooth(t: number) :: number:
    set {_t} to max(0, min(1, {_t}))
    return {_t} * {_t} * (3 - 2 * {_t})

# 판 시작 · 다시 지을 때: 처음 자리 (북동) 에 내려앉은 모습으로
function bgKdHeliHome():
    add 1 to {-bg::kd::hgen}
    set {bg::kd::helipos} to 0
    set {-bg::kd::hstate} to "land"
    delete {-bg::kd::heliflying}
    delete {-bg::kd::rotsp}
    delete {-bg::kd::abd::*}
    bgCmd("kill @e[type=item_display,tag=bgkd_hcam]")
    bgKdRig(bgKdMk("heli_0"), 90, 0)
    bgKdHeliVis(true)

# 헬기 타기: 관전 모드로 헬기 뒤 카메라에 붙음 (이륙하면 탈출 성공)
function bgKdBoard(p: player):
    set {-bg::kd::abd::%uuid of {_p}%} to true
    delete {-bg::kd::prog::%uuid of {_p}%}
    bgCmd("effect clear %name of {_p}%")
    if {-bg::kd::hloc} is not set:
        set {-bg::kd::hloc} to bgKdMk("heli_%{bg::kd::helipos} ? 0%")
        set {-bg::kd::hyaw} to 90
        set {-bg::kd::hpit} to 0
    bgCmd("kill @e[type=item_display,tag=bgkd_hcam]")
    bgCmd("execute in %bgDim()% run summon item_display %bgC(x-coordinate of {-bg::kd::hloc})% %bgN(y-coordinate of {-bg::kd::hloc})% %bgC(z-coordinate of {-bg::kd::hloc})% {Tags:[""bgkd_hcam""],teleport_duration:2}")
    bgKdRig({-bg::kd::hloc}, {-bg::kd::hyaw}, {-bg::kd::hpit})
    set gamemode of {_p} to spectator
    wait 1 tick
    bgCmd("spectate @e[type=item_display,tag=bgkd_hcam,limit=1] %name of {_p}%")
    bgTitleP({_p}, "&a&l🚁 탑승!", "&f이륙까지 &e%{-bg::kd::helit} ? 0%초 &7· 헬기가 뜨는 순간 탈출 성공")
    play sound "block.iron_door.close" with volume 1 and pitch 0.8 to {_p}
    bgKdSay("&e🚁 %name of {_p}% 헬기 탑승! &7(탑승 %bgKdAboardN()%명 · 이륙까지 %{-bg::kd::helit} ? 0%초)")

function bgKdUnboard(p: player):
    {-bg::kd::abd::%uuid of {_p}%} is true
    delete {-bg::kd::abd::%uuid of {_p}%}
    bgCmd("execute as %name of {_p}% run spectate")
    set gamemode of {_p} to adventure

# 이륙 → 도시 위로 날아 구름 속으로 (약 9초)
function bgKdHeliDepart():
    set {_g} to {-bg::kd::hgen} ? 0
    set {-bg::kd::hstate} to "fly"
    set {-bg::kd::heliflying} to true
    set {-bg::kd::rotsp} to 58
    set {_f} to {bg::kd::helipos} ? 0
    set {_p0} to bgKdMk("heli_%{_f}%")
    set {_w} to world of {_p0}
    # 탄 사람 전원 탈출 (뜨는 순간)
    set {_n} to 0
    loop all players:
        if bgKdAboard(loop-player) is true:
            if bgKdOn(loop-player) is true:
                add 1 to {_n}
                bgKdEscape(loop-player, true)
    if {_n} > 0:
        bgKdTitle("&a&l🚁 헬기 이륙!", "&f도둑 &a%{_n}%명&f 탈출 · 못 탄 도둑은 다음 헬기를 기다리세요")
    else:
        bgKdTitle("&e&l🚁 헬기 이륙", "&7아무도 타지 않았습니다 · 20초 뒤 다른 옥상에 다시 옴")
    bgKdTexts()
    # 1) 떠오르기 (6칸 · 2.4초): 아래로 바람 · 살짝 흔들림
    loop 24 times:
        if ({-bg::kd::hgen} ? 0) is not {_g}:
            stop
        set {_e} to bgKdSmooth(loop-number / 24)
        bgKdRig(bgUp({_p0}, 6 * {_e}), 90 + 2.5 * sin(loop-number * 30) * (1 - {_e}), 1.5 * sin(loop-number * 20))
        if mod(loop-number, 2) is 0:
            bgParticle({_p0}, "cloud", 3.5, 0.1, 3.5, 0.15, 30)
            bgParticle({_p0}, "poof", 2.5, 0.1, 2.5, 0.1, 10)
        if mod(loop-number, 6) is 0:
            bgSoundAt({-bg::kd::hloc}, "entity.ender_dragon.flap", 1.2, 0.7)
        wait 2 ticks
    # 2) 기수 숙이며 도시 가운데 쪽 (35° 꺾어) 으로 돌아 가속 · 상승 (7초)
    set {_c} to bgKdAt(0, 0, 0)
    set {_dx} to (x-coordinate of {_c}) - (x-coordinate of {_p0})
    set {_dz} to (z-coordinate of {_c}) - (z-coordinate of {_p0})
    set {_hd} to atan2({_dz}, -1 * {_dx}) + 35
    set {_turn} to mod({_hd} - 90 + 540, 360) - 180
    set {_px} to x-coordinate of {_p0}
    set {_pz} to z-coordinate of {_p0}
    set {_y0} to (y-coordinate of {_p0}) + 6
    set {_prev} to 0
    loop 70 times:
        if ({-bg::kd::hgen} ? 0) is not {_g}:
            stop
        set {_u} to loop-number / 70
        set {_yw} to 90 + {_turn} * bgKdSmooth({_u} * 3)
        set {_pt} to 17 * bgKdSmooth({_u} * 2)
        set {_d} to 90 * {_u} * {_u}
        set {_st} to {_d} - {_prev}
        set {_prev} to {_d}
        set {_px} to {_px} - sin({_yw}) * {_st}
        set {_pz} to {_pz} + cos({_yw}) * {_st}
        set {_l} to location({_px}, {_y0} + 55 * ({_u} ^ 1.6), {_pz}, {_w})
        bgKdRig({_l}, {_yw}, {_pt})
        if mod(loop-number, 8) is 0:
            if loop-number <= 32:
                bgSoundAt({_l}, "entity.ender_dragon.flap", 1.2, 0.75)
        if mod(loop-number, 2) is 0:
            bgParticle(location({_px} + sin({_yw}) * 6, (y-coordinate of {_l}) + 2.5, {_pz} - cos({_yw}) * 6, {_w}), "campfire_cosy_smoke", 0.2, 0.2, 0.2, 0.01, 2)
        wait 2 ticks
    # 3) 구름 속으로 사라짐
    bgParticle({-bg::kd::hloc}, "cloud", 4, 2.5, 4, 0.05, 160)
    bgParticle({-bg::kd::hloc}, "white_smoke", 3, 2, 3, 0.02, 60)
    bgKdHeliVis(false)
    delete {-bg::kd::rotsp}
    wait 10 ticks
    loop all players:
        if bgKdAboard(loop-player) is true:
            bgKdUnboard(loop-player)
            if bgKdOn(loop-player) is true:
                teleport loop-player to bgKdMk("wait")
                bgParticle(location of loop-player, "firework", 1, 2, 1, 0.1, 60)
                bgTitleP(loop-player, "&a&l탈출 성공!", "&f헬기로 빠져나왔습니다 &7· 전망대에서 구경")
    bgCmd("kill @e[type=item_display,tag=bgkd_hcam]")
    if ({-bg::kd::hgen} ? 0) is not {_g}:
        stop
    set {-bg::kd::hstate} to "away"
    set {-bg::kd::helit} to 20
    if {-bg::kd::lastcall} is true:
        set {-bg::kd::helit} to 8
    set {-bg::kd::helito} to mod({_f} + (random integer between 1 and 2), 3)
    if bgKdState() is "play":
        bgKdSay("&e🚁 헬기가 구름 속으로 사라졌습니다 &7— &f%{-bg::kd::helit}%초 뒤 &e%bgKdHeliName({-bg::kd::helito})%&f에 다시 내려옵니다")

# 구름 속에서 나타나 새 옥상으로 (약 9.5초): 다가오며 감속 → 기수 들기 → 내려앉기
function bgKdHeliArrive(to: number):
    set {_g} to {-bg::kd::hgen} ? 0
    set {-bg::kd::hstate} to "fly"
    set {-bg::kd::rotsp} to 52
    set {_p1} to bgKdMk("heli_%{_to}%")
    set {_w} to world of {_p1}
    set {_c} to bgKdAt(0, 0, 0)
    set {_dx} to (x-coordinate of {_c}) - (x-coordinate of {_p1})
    set {_dz} to (z-coordinate of {_c}) - (z-coordinate of {_p1})
    set {_ln} to max(1, sqrt({_dx} * {_dx} + {_dz} * {_dz}))
    set {_sx} to (x-coordinate of {_p1}) + {_dx} / {_ln} * 65
    set {_sz} to (z-coordinate of {_p1}) + {_dz} / {_ln} * 65
    set {_sy} to (y-coordinate of {_p1}) + 50
    set {_ay} to atan2(-1 * {_dz}, {_dx})
    set {_turn} to mod(90 - {_ay} + 540, 360) - 180
    set {_hy} to (y-coordinate of {_p1}) + 7
    bgKdRig(location({_sx}, {_sy}, {_sz}, {_w}), {_ay}, 14)
    wait 3 ticks
    bgKdHeliVis(true)
    bgParticle(location({_sx}, {_sy}, {_sz}, {_w}), "cloud", 4, 2.5, 4, 0.05, 160)
    bgKdSay("&e🚁 헬기가 &f%bgKdHeliName({_to})%&e(으)로 내려오고 있습니다!")
    loop 64 times:
        if ({-bg::kd::hgen} ? 0) is not {_g}:
            stop
        set {_u} to loop-number / 64
        set {_e} to 1 - ((1 - {_u}) ^ 3)
        set {_yw} to {_ay} + {_turn} * bgKdSmooth(({_u} - 0.5) / 0.5)
        set {_pt} to 14 - 24 * bgKdSmooth({_u} / 0.8) + 10 * bgKdSmooth(({_u} - 0.8) / 0.2)
        set {_l} to location({_sx} + ((x-coordinate of {_p1}) - {_sx}) * {_e}, {_sy} + ({_hy} - {_sy}) * {_e}, {_sz} + ((z-coordinate of {_p1}) - {_sz}) * {_e}, {_w})
        bgKdRig({_l}, {_yw}, {_pt})
        if mod(loop-number, 8) is 0:
            if loop-number >= 32:
                bgSoundAt({_l}, "entity.ender_dragon.flap", 1.2, 0.75)
        wait 2 ticks
    loop 30 times:
        if ({-bg::kd::hgen} ? 0) is not {_g}:
            stop
        set {_e} to bgKdSmooth(loop-number / 30)
        bgKdRig(bgUp({_p1}, 7 * (1 - {_e})), 90 + 2 * sin(loop-number * 25) * (1 - {_e}), 1.5 * sin(loop-number * 20) * (1 - {_e}))
        if mod(loop-number, 2) is 0:
            bgParticle({_p1}, "cloud", 3.5, 0.1, 3.5, 0.15, 30)
            bgParticle({_p1}, "poof", 2.5, 0.1, 2.5, 0.1, 10)
        if mod(loop-number, 6) is 0:
            bgSoundAt({_p1}, "entity.ender_dragon.flap", 1.2, 0.7)
        wait 2 ticks
    bgKdRig({_p1}, 90, 0)
    bgParticle({_p1}, "poof", 3, 0.1, 3, 0.12, 40)
    bgSoundAt({_p1}, "block.anvil.land", 0.6, 0.6)
    delete {-bg::kd::rotsp}
    set {bg::kd::helipos} to {_to}
    set {-bg::kd::hstate} to "land"
    delete {-bg::kd::heliflying}
    set {-bg::kd::helit} to 60
    if {-bg::kd::lastcall} is true:
        set {-bg::kd::helit} to max(10, min(60, ({-bg::kd::left} ? 60) - 5))
    bgKdTexts()
    bgKdSay("&a🚁 헬기 착륙: &f%bgKdHeliName({_to})% &7— &e%{-bg::kd::helit}%초&f 안에 타면 이륙 때 탈출!")
    bgKdSound("block.beacon.activate", 1.2)

# 매초: 탑승 시간 · 이륙 · 다시 오기
every 1 second:
    bgKdState() is "play"
    {-bg::kd::open} is true
    set {_hs} to {-bg::kd::hstate} ? "land"
    if {_hs} is "land":
        remove 1 from {-bg::kd::helit}
        # 판이 끝나기 전에 꼭 뜸 (탄 사람이 억울하지 않게)
        if {-bg::kd::helit} > ({-bg::kd::left} ? 999) - 3:
            set {-bg::kd::helit} to max(0, ({-bg::kd::left} ? 999) - 3)
        if {-bg::kd::helit} is 10:
            bgKdSay("&e🚁 10초 뒤 이륙! &f아직 안 탄 도둑은 서두르세요")
        if {-bg::kd::helit} <= 10:
            if {-bg::kd::helit} > 0:
                set {-bg::kd::rotsp} to 37 + (10 - {-bg::kd::helit}) * 2.1
                bgParticle(bgKdMk("heli_%{bg::kd::helipos} ? 0%"), "cloud", 2.5, 0.1, 2.5, 0.05 + (10 - {-bg::kd::helit}) * 0.01, 8)
        if {-bg::kd::helit} <= 0:
            bgKdHeliDepart()
    else if {_hs} is "away":
        remove 1 from {-bg::kd::helit}
        if {-bg::kd::helit} <= 0:
            set {-bg::kd::hstate} to "fly"
            bgKdHeliArrive({-bg::kd::helito} ? 1)

# ─────────────────────────────────────────────────────────── 하수구 밸브
function bgKdValves() :: number:
    set {_n} to 0
    loop 3 times:
        if {-bg::kd::valve::%loop-number - 1%} is set:
            add 1 to {_n}
    return {_n}

# 밸브 경고등 색 (빨강 = 아직 · 초록 = 돌아감) · 맨홀 뚜껑 밀기
function bgKdValveLamp(i: number, on: boolean):
    set {_b} to "redstone_block"
    if {_on} is true:
        set {_b} to "lime_concrete"
    bgCmd("execute as @e[type=block_display,tag=kd_vl%{_i}%] run data merge entity @s {block_state:{Name:""minecraft:%{_b}%""}}")

function bgKdValveReset():
    delete {-bg::kd::valve::*}
    delete {-bg::kd::vclk::*}
    loop 3 times:
        bgKdValveLamp(loop-number - 1, false)

function bgKdCover(open: boolean):
    set {_cur} to {bg::kd::mcover} ? false
    if {_cur} is {_open}:
        stop
    set {_d} to -0.25
    delete {bg::kd::mcover}
    if {_open} is true:
        set {bg::kd::mcover} to true
        set {_d} to 0.25
    play sound "block.iron_trapdoor.open" with volume 1.5 and pitch 0.6 at bgKdMk("sewer")
    loop 12 times:
        bgCmd("execute as @e[type=block_display,tag=kd_mcover] at @s run tp @s ~%bgN({_d})% ~ ~")
        wait 2 ticks

function bgKdValve(i: number, p: player):
    set {-bg::kd::valve::%{_i}%} to true
    bgKdValveLamp({_i}, true)
    bgKdBeams()
    set {_n} to bgKdValves()
    play sound "block.iron_door.open" with volume 1 and pitch 0.6 at location of {_p}
    if {_n} >= 3:
        set {-bg::kd::sewer} to now
        bgKdBeams()
        bgKdCover(true)
        bgKdTitle("&b&l하수구 열림!", "&f40초 동안 맨홀로 탈출 가능 &7(도로 가운데 · 하늘색 빛 기둥)")
        bgKdSound("block.water.ambient", 1)
    else:
        bgKdSay("&b🔧 %name of {_p}%&f 이(가) 밸브 %{_i} + 1%을(를) 돌렸다! &7(%{_n}%/3) &9경찰은 밸브를 지키세요")
    bgKdTexts()

every 1 second:
    {-bg::kd::sewer} is set
    difference between {-bg::kd::sewer} and now > 40 seconds
    delete {-bg::kd::sewer}
    bgKdValveReset()
    bgKdCover(false)
    bgKdBeams()
    bgKdSay("&7🕳 하수구가 다시 닫혔다 — 밸브 3개를 다시 돌려야 열림")
    bgKdTexts()

# (빛줄기 신호기는 쓰지 않음 — 위치 표시는 발광 기둥만. 예전 호출이 남아 있어도 아무 일 없게)
# 신호기 빛줄기 켜고 끄기 (copsgen.py beam: 표지 아래 3칸에 3×3 받침 — 철 블록 = 켜짐)
#  감옥 · 구출 발판 = 늘 켜짐 (지을 때) · 헬기 옥상 = 탈출이 열리고 헬기가 그 옥상에 앉아 있을 때 · 하수구 = 열렸을 때
function bgKdBeam(l: location, on: boolean, off: text):
    set {_x} to floor(x-coordinate of {_l})
    set {_y} to floor(y-coordinate of {_l}) - 3
    set {_z} to floor(z-coordinate of {_l})
    set {_b} to {_off}
    if {_on} is true:
        set {_b} to "iron_block"
    bgCmd("execute in %bgDim()% run fill %{_x} - 1% %{_y}% %{_z} - 1% %{_x} + 1% %{_y}% %{_z} + 1% minecraft:%{_b}%")

function bgKdBeams():
    bgKdReady() is true
    set {_open} to false
    if bgKdState() is "play":
        if {-bg::kd::open} is true:
            set {_open} to true
    loop 3 times:
        set {_k} to loop-number - 1
        set {_h} to false
        if {_open} is true:
            if ({-bg::kd::hstate} ? "land") is "land":
                if ({bg::kd::helipos} ? 0) is {_k}:
                    set {_h} to true
        bgKdBeam(bgKdMk("heli_%{_k}%"), {_h}, "gray_concrete")
    set {_s} to false
    if {_open} is true:
        if {-bg::kd::sewer} is set:
            set {_s} to true
    bgKdBeam(bgKdMk("sewer"), {_s}, "blue_terracotta")

# ─────────────────────────────────────────────────────────── 판 끝나면 자동으로 맵 바꾸기
#  결과 10초 뒤 → 경도에 있는 사람은 도시 위 하늘에서 관전 모드 → 다른 배치로 다시 짓기 (약 35초) → 대기실로
#  끄기 · 켜기: /경도 자동맵
function bgKdRemap():
    set {-bg::kd::state} to "remap"
    set {_sky} to bgKdAt(0.5, 70, 30.5)
    set pitch of {_sky} to 50
    set yaw of {_sky} to 180
    loop all players:
        if bgKdOn(loop-player) is true:
            bgKdClear(loop-player)
            set gamemode of loop-player to spectator
            teleport loop-player to {_sky}
            bgTitleP(loop-player, "&9&l다음 판 맵 섞는 중…", "&f건물 배치가 바뀝니다 &7(약 35초 · 하늘에서 구경)")
    bgKdBuildRaw()
    loop 1200 times:
        wait 10 ticks
        if bgBuilt("kd%{bg::kd::layout}%") is true:
            exit loop
    set {-bg::kd::state} to "wait"
    loop all players:
        if bgKdOn(loop-player) is true:
            set gamemode of loop-player to adventure
            teleport loop-player to bgKdMk("wait")
            bgExitItem(loop-player)
            bgCmd("team join kd_wait %name of loop-player%")
    wait 40 ticks
    bgKdTexts()
    bgKdSay("&f새 맵 완성! &7(배치 %({bg::kd::layout} ? 0) + 1%) &f다음 판은 관리자가 &e/경도 시작")

# ─────────────────────────────────────────────────────────── 밸브 자리 랜덤 (후보 8곳 중 3곳 · 판마다)
#  후보 표지 vc_<k> (본체) · vcw_<k> (바퀴) · vcl_<k> (경고등) — 블록 디스플레이 kd_vb · kd_vw · kd_vl <밸브번호> 를 순간이동
#  지금 자리는 {bg::kd::vsel::<밸브번호>} (다시 지으면 0 · 1 · 2 = 처음 자리)
function bgKdValvePos(i: number) :: location:
    set {_c} to {bg::kd::vsel::%{_i}%} ? {_i}
    return bgKdMk("vc_%{_c}%")

function bgKdValveMove(i: number, c: number):
    set {_c0} to bgKdMk("vc_%{_c}%")
    bgCmd("execute in %bgDim()% run tp @e[type=interaction,tag=kd_vi%{_i}%] %bgC(x-coordinate of {_c0})% %bgN(y-coordinate of {_c0})% %bgC(z-coordinate of {_c0})%")
    loop "vb", "vw" and "vl":
        set {_m} to "vc"
        if loop-value is "vw":
            set {_m} to "vcw"
        else if loop-value is "vl":
            set {_m} to "vcl"
        set {_l} to bgKdMk("%{_m}%_%{_c}%")
        bgCmd("execute in %bgDim()% run tp @e[type=block_display,tag=kd_%loop-value%%{_i}%] %bgC(x-coordinate of {_l})% %bgN(y-coordinate of {_l})% %bgC(z-coordinate of {_l})% %bgN(yaw of {_l})% 0")
    set {bg::kd::vsel::%{_i}%} to {_c}

function bgKdValvesPlace():
    bgKdReady() is true
    set {_pool::*} to 0, 1, 2, 3, 4, 5, 6 and 7
    loop 3 times:
        set {_pick} to random element out of {_pool::*}
        remove {_pick} from {_pool::*}
        bgKdValveMove(loop-number - 1, {_pick})

# ─────────────────────────────────────────────────────────── 밸브 돌리기: 우클릭 연타 (밸브의 보이지 않는 클릭 판정 kd_vi<번호>)
#  한 번 클릭 = 바퀴가 한 칸 돌고 게이지 +1 (한 사람당 0.1초에 한 번까지) · 24번이면 돌아감 · 여럿이 같이 돌려도 됨
#  2초 동안 아무도 안 돌리면 게이지가 조금씩 줄어듦 · 돈가방 목표를 채운 뒤부터
on right click on entity:
    bgKdOn(player) is true
    event-entity is not a player
    set {_vi} to -1
    loop 3 times:
        if distance between event-entity and bgKdValvePos(loop-number - 1) < 1.2:
            set {_vi} to loop-number - 1
    {_vi} >= 0
    cancel event
    bgKdState() is "play"
    if bgKdRole(player) is not "thief":
        send action bar "&7밸브는 도둑만 돌릴 수 있어요" to player
        stop
    if bgKdJailed(player) is true:
        stop
    if {-bg::kd::open} is not true:
        send action bar "&7🔧 밸브는 돈가방 목표 &6%{-bg::kd::bags} ? 0%/%{-bg::kd::goal} ? 0% &7를 채우면 돌릴 수 있어요" to player
        stop
    if {-bg::kd::sewer} is set:
        send action bar "&b하수구가 이미 열려 있어요 — 도로 가운데 맨홀로!" to player
        stop
    if {-bg::kd::valve::%{_vi}%} is set:
        send action bar "&a밸브 %{_vi} + 1%은(는) 이미 돌렸어요 &7(%bgKdValves()%/3)" to player
        stop
    set {_u} to "%uuid of player%"
    if {-bg::kd::vclkt::%{_u}%} is set:
        if difference between {-bg::kd::vclkt::%{_u}%} and now < 0.1 seconds:
            stop
    set {-bg::kd::vclkt::%{_u}%} to now
    add 1 to {-bg::kd::vclk::%{_vi}%}
    set {-bg::kd::vlast::%{_vi}%} to now
    set {_n} to {-bg::kd::vclk::%{_vi}%}
    bgCmd("execute as @e[type=block_display,tag=kd_vw%{_vi}%] at @s run tp @s ~ ~ ~ ~22 ~")
    play sound "block.chain.step" with volume 0.7 and pitch (0.6 + {_n} / 24) at location of event-entity
    set {_bar} to ""
    set {_k} to 0
    while {_k} < 12:
        add 1 to {_k}
        if {_k} * 2 <= {_n}:
            set {_bar} to "%{_bar}%&b■"
        else:
            set {_bar} to "%{_bar}%&8■"
    send action bar "&b🔧 밸브 %{_vi} + 1% 돌리는 중 %{_bar}% &7(우클릭 연타)" to player
    if {_n} >= 24:
        delete {-bg::kd::vclk::%{_vi}%}
        bgKdValve({_vi}, player)

every 1 second:
    bgKdState() is "play"
    loop 3 times:
        set {_vi} to loop-number - 1
        if ({-bg::kd::vclk::%{_vi}%} ? 0) > 0:
            if difference between {-bg::kd::vlast::%{_vi}%} and now > 2 seconds:
                remove 3 from {-bg::kd::vclk::%{_vi}%}
                if {-bg::kd::vclk::%{_vi}%} <= 0:
                    delete {-bg::kd::vclk::%{_vi}%}
