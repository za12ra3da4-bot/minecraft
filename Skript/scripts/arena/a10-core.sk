# ═════════════════════════════════════════════════════════════════════════════
#  왕관 쟁탈전 — 공용 (설정 · 명령 실행기 · 좌표 · 팀)
#  필요: Skript 2.9+ , skript-reflect
#  a01~a03 (자동 생성 데이터) 이 먼저 로드된다 (파일 이름 순서)
# ═════════════════════════════════════════════════════════════════════════════
import:
    net.minecraft.server.MinecraftServer

on load:
    # 저장되는 설정 (처음 한 번만 기본값)
    if {bg::cfg::world} is not set:
        set {bg::cfg::world} to "world"
    if {bg::cfg::ox} is not set:
        set {bg::cfg::ox} to -128
        set {bg::cfg::oy} to 40
        set {bg::cfg::oz} to -128
    if {bg::cfg::goal} is not set:
        set {bg::cfg::goal} to 1500          # 목표 점수
    if {bg::cfg::minutes} is not set:
        set {bg::cfg::minutes} to 30         # 제한 시간
    if {bg::cfg::boss_first} is not set:
        set {bg::cfg::boss_first} to 180     # 첫 보스 (초)
    if {bg::cfg::boss_every} is not set:
        set {bg::cfg::boss_every} to 300     # 보스 간격 (초, 처치/퇴각 후부터)
    set {-bg::on} to false
    set {-bg::teams::*} to "red", "blue", "green" and "yellow"
    set {-bg::tname::red} to "레드"
    set {-bg::tname::blue} to "블루"
    set {-bg::tname::green} to "그린"
    set {-bg::tname::yellow} to "옐로"
    set {-bg::tcol::red} to "&c"
    set {-bg::tcol::blue} to "&9"
    set {-bg::tcol::green} to "&a"
    set {-bg::tcol::yellow} to "&e"
    set {-bg::tvan::red} to "red"
    set {-bg::tvan::blue} to "blue"
    set {-bg::tvan::green} to "green"
    set {-bg::tvan::yellow} to "yellow"
    set {-bg::tid} to 0

# ── 조용한 명령 실행 (데이터팩 함수처럼 출력 억제). {bg::cfg::debug} = true 이면 콘솔로 (오류 확인용)
function bgCmd(c: text):
    if {bg::cfg::debug} is true:
        make console execute command {_c}
        stop
    set {_srv} to MinecraftServer.getServer()
    set {_src} to {_srv}.createCommandSourceStack().withSuppressedOutput()
    # 문법 오류면 실행하지 않고 콘솔 · 관리자에게 알린다 (조용히 실패하는 것 방지, 처음 20개만)
    set {_pr} to {_srv}.getCommands().getDispatcher().parse({_c}, {_src})
    if {_pr}.getReader().canRead() is true:
        add 1 to {-bg::cmderr}
        if {-bg::cmderr} <= 20:
            send "[전장] 명령 오류: %{_c}%" to console
            loop all players:
                if loop-player is op:
                    send "&c[전장] 명령 오류 (콘솔 확인): &7%{_c}%" to loop-player
        stop
    {_srv}.getCommands().performPrefixedCommand({_src}, {_c})

# ── 숫자 → 명령용 텍스트 (소수 2자리)
function bgN(n: number) :: text:
    set {_r} to round({_n} * 100) / 100
    return "%{_r}%"

# 좌표용: 정수면 ".0" 을 붙인다 (마크는 정수 x·z 를 블록 가운데(+0.5)로 옮기기 때문)
function bgC(n: number) :: text:
    set {_r} to round({_n} * 100) / 100
    if {_r} is floor({_r}):
        return "%{_r}%.0"
    return "%{_r}%"

function bgWorld() :: world:
    set {_w} to world({bg::cfg::world})
    if {_w} is set:
        return {_w}
    # 설정한 월드 이름이 없으면 첫 번째 월드로 (서버 level-name 이 world 가 아닐 때)
    loop all worlds:
        set {bg::cfg::world} to name of loop-world
        return loop-world

# 명령용 차원 이름 (기본 월드 = overworld, 그 외 = 월드 폴더 이름)
function bgDim() :: text:
    if {bg::cfg::world} is "world":
        return "minecraft:overworld"
    return "minecraft:%{bg::cfg::world}%"

# ── 맵 로컬 → 월드 좌표
function bgAt(x: number, y: number, z: number) :: location:
    return location({_x} + {bg::cfg::ox}, {_y} + {bg::cfg::oy}, {_z} + {bg::cfg::oz}, bgWorld())

# ── 마커 위치 (a02-gen-map)
function bgMk(n: text) :: location:
    return bgAt({-bg::mk::%{_n}%::x}, {-bg::mk::%{_n}%::y}, {-bg::mk::%{_n}%::z})

function bgMkR(n: text) :: number:
    if {-bg::mk::%{_n}%::radius} is set:
        return {-bg::mk::%{_n}%::radius}
    return 6

# ── 수평 거리
function bgDist2(a: location, b: location) :: number:
    set {_dx} to (x-coordinate of {_a}) - (x-coordinate of {_b})
    set {_dz} to (z-coordinate of {_a}) - (z-coordinate of {_b})
    return sqrt({_dx} * {_dx} + {_dz} * {_dz})

# ── 팀
function bgTeam(p: player) :: text:
    if {bg::team::%uuid of {_p}%} is set:
        return {bg::team::%uuid of {_p}%}
    return "none"

function bgSetTeam(p: player, t: text):
    set {bg::team::%uuid of {_p}%} to {_t}
    if {_t} is "none":
        bgCmd("team leave %name of {_p}%")
        delete {bg::team::%uuid of {_p}%}
        stop
    bgCmd("team join bg_%{_t}% %name of {_p}%")
    send "&6[전장] &f당신은 %{-bg::tcol::%{_t}%}%%{-bg::tname::%{_t}%}% 팀&f 입니다." to {_p}

function bgTeamCount(t: text) :: number:
    set {_n} to 0
    loop all players:
        if bgTeam(loop-player) is {_t}:
            add 1 to {_n}
    return {_n}

# ── 전투 참가자 (게임 중 · 팀 있음 · 서바이벌/모험)
function bgIsFighter(p: player) :: boolean:
    if {-bg::on} is not true:
        return false
    if bgTeam({_p}) is "none":
        return false
    if gamemode of {_p} is spectator or creative:
        return false
    return true

function bgSetupTeams():
    loop {-bg::teams::*}:
        set {_t} to loop-value
        bgCmd("team add bg_%{_t}%")
        bgCmd("team modify bg_%{_t}% color %{-bg::tvan::%{_t}%}%")
        bgCmd("team modify bg_%{_t}% friendlyFire false")
        bgCmd("team modify bg_%{_t}% seeFriendlyInvisibles true")
        bgCmd("team modify bg_%{_t}% nametagVisibility hideForOtherTeams")
        bgCmd("team modify bg_%{_t}% prefix {text:""[%{-bg::tname::%{_t}%}%] "",color:""%{-bg::tvan::%{_t}%}%""}")

# ── 전체 알림
function bgSay(msg: text):
    broadcast "&6[전장] &f%{_msg}%"

# 숫자(틱) → 시간 (변수 뒤에 "ticks" 를 바로 붙일 수 없어서)
function bgTicks(n: number) :: timespan:
    return "%max(0, round({_n}))% ticks" parsed as timespan

function bgTitle(t: text, s: text, fi: number, st: number, fo: number):
    set {_a} to bgTicks({_st})
    set {_b} to bgTicks({_fi})
    set {_c} to bgTicks({_fo})
    loop all players:
        send title {_t} with subtitle {_s} to loop-player for {_a} with fade in {_b} and fade out {_c}

function bgSound(s: text, vol: number, pitch: number):
    bgCmd("execute as @a at @s run playsound %{_s}% master @s ~ ~ ~ %bgN({_vol})% %bgN({_pitch})%")

function bgSoundAt(l: location, s: text, vol: number, pitch: number):
    bgCmd("playsound %{_s}% hostile @a %bgC(x-coordinate of {_l})% %bgN(y-coordinate of {_l})% %bgC(z-coordinate of {_l})% %bgN({_vol})% %bgN({_pitch})%")

function bgParticle(l: location, p: text, dx: number, dy: number, dz: number, spd: number, n: number):
    bgCmd("particle %{_p}% %bgC(x-coordinate of {_l})% %bgN(y-coordinate of {_l})% %bgC(z-coordinate of {_l})% %bgN({_dx})% %bgN({_dy})% %bgN({_dz})% %bgN({_spd})% %{_n}% force")

# ── 원점 동기화 (데이터팩 저장소에도)
function bgSyncOrigin():
    bgCmd("data merge storage bg:map {origin:{x:%{bg::cfg::ox}%,y:%{bg::cfg::oy}%,z:%{bg::cfg::oz}%}}")
