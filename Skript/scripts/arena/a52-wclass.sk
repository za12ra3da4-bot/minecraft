# ═════════════════════════════════════════════════════════════════════════════
#  신화쟁탈전 — 직업별 특수 무기 (a50 · a56 · a57 무기를 직업에 묶는다)
#   전사 = 검 종류 · 궁수 = 활 · 지팡이 · 던지는 무기 (원거리) · 수호자 = 도끼 · 망치 · 낫 · 창 (무거운 무기)
#   · 상점 1쪽에는 내 직업 무기만 진열 · 다른 직업 무기는 스킬 · 근접 공격 모두 안 됨
#   · 직업을 바꿨는데 다른 직업 무기를 들고 있으면 → 화면 가운데 '무기 교환' 창이 떠서 새 직업 무기로 무료 교환 (또는 30% 환불)
#   · /무기교환 — 창 다시 열기
#  무기마다 직업: {-bg::w::<무기>::cls} (0 전사 · 1 궁수 · 2 수호자). 새 무기 파일(a57)도 여기 표에 직접 적는다
# ═════════════════════════════════════════════════════════════════════════════

on load:
    # 전사 — 검
    loop "thunder", "wind", "blackiron", "tiger" and "b_talos":
        set {-bg::w::%loop-value%::cls} to 0
    # 궁수 — 활 · 지팡이 · 던지는 무기
    loop "frost", "staff", "skull", "chakram", "storm", "peachwood", "b_sphinx" and "b_ladon":
        set {-bg::w::%loop-value%::cls} to 1
    # 수호자 — 도끼 · 망치 · 낫 · 사슬 · 건틀렛 · 기병창
    loop "dragon", "phoenix", "gauntlet", "scythe", "chain", "lance" and "b_cyclops":
        set {-bg::w::%loop-value%::cls} to 2
    set {-bg::clsweap::0} to "검"
    set {-bg::clsweap::1} to "활 · 원거리 무기"
    set {-bg::clsweap::2} to "도끼 · 둔기"
    set {-bg::clscol::0} to "&c"
    set {-bg::clscol::1} to "&a"
    set {-bg::clscol::2} to "&9"

function bgPCls(p: player) :: number:
    return {bg::cls::%uuid of {_p}%} ? 0

function bgWCls(w: text) :: number:
    return {-bg::w::%{_w}%::cls} ? 0

# 이 사람이 이 무기를 쓸 수 있나 (게임 밖 대기실 등에서는 제한 없음)
function bgWClsOk(p: player, w: text) :: boolean:
    if bgIsFighter({_p}) is false:
        return true
    if {-bg::w::%{_w}%::cls} is not set:
        return true
    if bgWCls({_w}) is bgPCls({_p}):
        return true
    return false

function bgWClsName(w: text) :: text:
    set {_c} to bgWCls({_w})
    return "%{-bg::clscol::%{_c}%}%%{-bg::cls::%{_c}%}%"

# 직업별 상점 무기 · 보스 무기 목록
function bgClassWeapons(c: number) :: texts:
    loop {-bg::w::list::*}:
        if bgWCls(loop-value) is {_c}:
            add loop-value to {_out::*}
    return {_out::*}

function bgClassBoss(c: number) :: texts:
    loop {-bg::w::bosslist::*}:
        if bgWCls(loop-value) is {_c}:
            add loop-value to {_out::*}
    return {_out::*}

function bgHasWeapon(p: player, w: text) :: boolean:
    loop all items in {_p}'s inventory:
        if bgIsLegend(loop-item) is {_w}:
            return true
    return false

# 가방에서 직업이 안 맞는 첫 무기 ("" = 없음)
function bgWMismatch(p: player) :: text:
    loop all items in {_p}'s inventory:
        set {_w} to bgIsLegend(loop-item)
        if {_w} is not "":
            if bgWCls({_w}) is not bgPCls({_p}):
                return {_w}
    return ""

# ─────────────────────────────────────────────────────────── 무기 교환 창
#  ┌ 금 ─ 보라 ─ 자홍 [ 지금 무기 ] 자홍 ─ 보라 ─ 금 ┐   1줄: 이전 직업 · 지금 무기 · 새 직업
#  │          ▼ 새 직업 무기를 고르세요 ▼          │   3~4줄: 새 직업 무기 14칸 (마우스를 올리면 스킬 영상)
#  └ 금 ─ 보라 ─ [나중에] ─ [30% 환불] ─ [안내] ─ 금 ┘
function bgWExPane(c: text) :: item:
    if {_c} is "y":
        return yellow stained glass pane named " "
    if {_c} is "p":
        return purple stained glass pane named " "
    if {_c} is "m":
        return magenta stained glass pane named " "
    if {_c} is "g":
        return gray stained glass pane named "&8빈 칸"
    return black stained glass pane named " "

function bgWExCheck(p: player):
    set {_w} to bgWMismatch({_p})
    if {_w} is "":
        if {-bg::wex::%uuid of {_p}%} is set:
            close {_p}'s inventory
        delete {-bg::wex::%uuid of {_p}%}
        stop
    bgWExOpen({_p}, {_w})

function bgWExOpen(p: player, w: text):
    set {_u} to uuid of {_p}
    set {_c} to bgPCls({_p})
    set {_oc} to bgWCls({_w})
    set {_gui} to chest inventory with 6 rows named "&8✦ &5&l무기 교환 &8✦ %{-bg::clscol::%{_c}%}%%{-bg::cls::%{_c}%}% 전용으로"
    # 장식 (6줄 · 금 모서리 · 보라 테두리 · 가운데 자홍 액자)
    set {_pat::*} to "y", "p", "p", "m", "m", "m", "p", "p", "y", "y", "k", "k", "m", "x", "m", "k", "k", "y", "y", "k", "k", "m", "x", "m", "k", "k", "y", "p", "x", "x", "x", "x", "x", "x", "x", "p", "p", "x", "x", "x", "x", "x", "x", "x", "p", "y", "p", "x", "p", "x", "p", "x", "p" and "y"
    loop 54 times:
        set {_k} to {_pat::%loop-number%}
        if {_k} is not "x":
            set slot loop-number - 1 of {_gui} to bgWExPane({_k})
    # 이전 직업 · 지금 무기 · 새 직업
    set {_oi} to iron sword
    if {_oc} is 1:
        set {_oi} to bow
    else if {_oc} is 2:
        set {_oi} to iron axe
    set name of {_oi} to "&7이전 직업: %{-bg::clscol::%{_oc}%}%&l%{-bg::cls::%{_oc}%}%"
    set lore of {_oi} to "&8%{-bg::clsweap::%{_oc}%}% 전용"
    set slot 10 of {_gui} to {_oi}
    set {_ni} to iron sword
    if {_c} is 1:
        set {_ni} to bow
    else if {_c} is 2:
        set {_ni} to iron axe
    set name of {_ni} to "&f새 직업: %{-bg::clscol::%{_c}%}%&l%{-bg::cls::%{_c}%}%"
    set lore of {_ni} to "&7%{-bg::clsweap::%{_c}%}% 만 쓸 수 있습니다"
    set slot 16 of {_gui} to {_ni}
    set {_info::*} to "&c지금 직업으로는 쓸 수 없는 무기", "&7아래에서 새 무기를 고르면 &a무료로 교환"
    set slot 13 of {_gui} to bgWShopItem({_w}, "&6&l%{-bg::w::%{_w}%::name}% &8(%bgWClsName({_w})% &8전용)", {_info::*})
    set {_ar} to spectral arrow named "&e&l▼ &f새 무기를 고르세요 &e&l▼"
    set lore of {_ar} to "&7마우스를 올리면 스킬 미리보기 영상이 나옵니다", "&7같은 무기를 이미 가지고 있으면 목록에 안 나옵니다"
    set slot 22 of {_gui} to {_ar}
    # 새 직업 무기 (상점 무기 ↔ 상점 무기 · 보스 무기 ↔ 보스 무기)
    delete {-bg::wexs::%{_u}%::*}
    if {_w} starts with "b_":
        set {_list::*} to bgClassBoss({_c})
    else:
        set {_list::*} to bgClassWeapons({_c})
    set {_slots::*} to 28, 29, 30, 31, 32, 33, 34, 37, 38, 39, 40, 41, 42 and 43
    set {_i} to 0
    loop {_list::*}:
        if bgHasWeapon({_p}, loop-value) is false:
            add 1 to {_i}
            if {_i} <= 14:
                set {_s} to {_slots::%{_i}%}
                set {_inf::*} to "&a&l클릭하면 이 무기로 교환 &7(무료)", "&7재사용 대기 &f%bgWCd({_p}, loop-value)%초"
                set slot {_s} of {_gui} to bgWShopItem(loop-value, "&6&l%{-bg::w::%loop-value%::name}% %{-bg::clscol::%{_c}%}%(%{-bg::cls::%{_c}%}%)", {_inf::*})
                set {-bg::wexs::%{_u}%::%{_s}%} to loop-value
    loop 14 times:
        if loop-number > {_i}:
            set slot {_slots::%loop-number%} of {_gui} to bgWExPane("g")
    # 아래 줄: 나중에 · 환불 · 안내
    set {_later} to clock named "&7&l나중에"
    set lore of {_later} to "&7창을 닫습니다", "&e/무기교환 &7으로 언제든 다시 열 수 있어요"
    set slot 47 of {_gui} to {_later}
    if {_w} starts with "b_":
        set {_rf} to barrier named "&c&l버리기"
        set lore of {_rf} to "&7보스 무기는 환불 없이 사라집니다"
    else:
        set {_back} to floor({-bg::w::%{_w}%::price} * 0.3)
        set {_rf} to gold ingot named "&6&l반납하고 &e%{_back}% 코인"
        set lore of {_rf} to "&7교환 대신 가격의 30%%를 돌려받습니다"
    set slot 49 of {_gui} to {_rf}
    set {_bk} to book named "&e&l직업별 무기"
    set lore of {_bk} to "&c전사 &7— 검", "&a궁수 &7— 활 · 지팡이 · 던지는 무기", "&9수호자 &7— 도끼 · 망치 · 낫 · 창", "", "&7다른 직업 무기는 스킬도, 근접 공격도 안 됩니다"
    set slot 51 of {_gui} to {_bk}
    open {_gui} to {_p}
    set {-bg::wex::%{_u}%} to {_w}
    play sound "block.enchantment_table.use" to {_p}
    play sound "block.amethyst_block.chime" to {_p}
    bgParticle(location of {_p}, "enchant", 0.8, 1.2, 0.8, 0.6, 40)

on inventory close:
    delete {-bg::wex::%uuid of player%}

on inventory drag:
    {-bg::wex::%uuid of player%} is set
    cancel event

on inventory click:
    {-bg::wex::%uuid of player%} is set
    cancel event
    if {-bg::shopclk::%uuid of player%} is set:
        if difference between {-bg::shopclk::%uuid of player%} and now < 0.25 seconds:
            stop
    set {-bg::shopclk::%uuid of player%} to now
    set {_s} to raw index of event-slot
    set {_old} to {-bg::wex::%uuid of player%}
    if {_s} is 47:
        close player's inventory
        send "&5[무기 교환] &7나중에 &e/무기교환 &7으로 다시 열 수 있어요." to player
        stop
    if {_s} is 49:
        bgWExRefund(player, {_old})
        stop
    set {_new} to {-bg::wexs::%uuid of player%::%{_s}%}
    {_new} is set
    bgWExSwap(player, {_old}, {_new})

function bgWExTake(p: player, w: text) :: boolean:
    if bgHasWeapon({_p}, {_w}) is false:
        return false
    bgCmd("clear %name of {_p}% %{-bg::w::%{_w}%::base}%[minecraft:custom_data={bgw:""%{_w}%""}] 1")
    delete {bg::owned::%uuid of {_p}%::%{_w}%}
    return true

function bgWExSwap(p: player, old: text, new: text):
    if bgHasWeapon({_p}, {_new}) is true:
        stop
    if bgWExTake({_p}, {_old}) is false:
        bgWExCheck({_p})
        stop
    if {_new} does not start with "b_":
        set {bg::owned::%uuid of {_p}%::%{_new}%} to true
    bgGiveWeapon({_p}, {_new})
    send "&5[무기 교환] &f%{-bg::w::%{_old}%::name}% &7→ &6&l%{-bg::w::%{_new}%::name}%" to {_p}
    bgTitleP({_p}, "&6&l%{-bg::w::%{_new}%::name}%", "&f교환 완료! 우클릭으로 전용 스킬")
    play sound "ui.toast.challenge_complete" to {_p}
    play sound "block.anvil.use" to {_p}
    bgParticle(location of {_p}, "totem_of_undying", 0.6, 1, 0.6, 0.4, 40)
    wait 3 ticks
    bgWExCheck({_p})

function bgWExRefund(p: player, old: text):
    if bgWExTake({_p}, {_old}) is false:
        bgWExCheck({_p})
        stop
    if {_old} starts with "b_":
        send "&5[무기 교환] &7%{-bg::w::%{_old}%::name}% 을(를) 버렸습니다." to {_p}
    else:
        set {_back} to floor({-bg::w::%{_old}%::price} * 0.3)
        add {_back} to {bg::coin::%uuid of {_p}%}
        send "&5[무기 교환] &f%{-bg::w::%{_old}%::name}% 반납 &e+%{_back}% 코인 &7(보유 %{bg::coin::%uuid of {_p}%}%)" to {_p}
        play sound "entity.experience_orb.pickup" to {_p}
    wait 3 ticks
    bgWExCheck({_p})

command /무기교환:
    aliases: /weaponswap
    trigger:
        if bgWMismatch(player) is "":
            send "&5[무기 교환] &7지금 직업(%{-bg::clscol::%bgPCls(player)%}%%{-bg::cls::%bgPCls(player)%}%&7)과 안 맞는 무기가 없습니다."
            stop
        bgWExCheck(player)
