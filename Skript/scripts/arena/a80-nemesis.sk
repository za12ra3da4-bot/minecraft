# ═════════════════════════════════════════════════════════════════════════════
#  신화쟁탈전 — 복수의 신 네메시스 (역전 이벤트)
#   후반(제한 시간 절반 이후)에 1등 팀 점수가 2등의 2배 이상이면 한 판에 한 번 나타난다
#   미니 보스보다 훨씬 강한 '최종 심판' — 하지만 억울하지 않게:
#    · 20초 전에 예고 · 1등 팀 본진 성벽 바깥 땅 위(본진 중심에서 26~38칸)에 나온다 (성벽 위 · 공중 X)
#    · 1등 팀만 노리고, 1등 팀만 때릴 수 있다 (다른 팀은 맞지도 않고 때리지도 못함)
#    · 1등 팀 본진(18칸) 안으로는 못 들어간다 → 스폰킬 없음 · 스킬도 본진 안은 안 맞음
#    · 체력 200 + 1등 팀 두 번째 사람부터 1명당 40 (최대 600) · 갑옷 · 한 대 하트 4 + 흡혈 · 넉백 안 먹음
#    · 체력 50% 아래 '격노': 그림자 4마리 소환 · 스킬 간격 짧아짐 · 심판의 검 3갈래
#    · 120초가 지나면 떠난다 · 1등 팀이 쓰러뜨리면 +150점 + 팀원 코인 +15
#   도망치면 손해 (본진에 숨어서 120초 버티기 방지):
#    · 외면 — 1등 팀이 10초 넘게 한 대도 안 때리면 그동안 초당 -{bg::cfg::nem_tax}점 (기본 2)
#    · 최후의 심판 — 120초 안에 못 쓰러뜨리고 떠나면 1등 팀 점수 {bg::cfg::nem_fine}% 몰수 (기본 30)
#   그동안 1등 팀은 네메시스를 막느라 바쁘고, 다른 팀은 거점을 되찾을 기회
#   모습: 키 9블록 · 날개폭 12블록 — 흑요석·은 갑옷과 금 장식, 가슴의 '심판의 눈', 날개 투구 · 가면 · 금관, 두 겹 후광과 빛살,
#    날개 두 쌍(따로 움직이는 첫째깃), 8자락 옷자락, 룬 대검, 정의의 저울, 떠다니는 수정 4개 (arena/tools/rp/bosses/nemesis.py · 파츠 85개)
#    히트박스 = 투명한 위더 스켈레톤 (2.6배) · 파츠는 매 틱 히트박스를 따라감
#    애니메이션 rise(등장: 접은 날개를 활짝 · 3초 동안 안 움직임) / idle / glide / slash / death (a08-gen-nemesis.sk)
#   보스바: 미니 보스와 같은 그림 보스바 (이름판 '네메시스' · 초상화 · 체력/잔상 · 시전 게이지 · 40% 아래 격노 배너) — 이름표에 남은 시간
#   스킬 (6~8초마다 하나, 격노 때 4~6초 · 바닥 경고가 다 차면 판정 · 1등 팀만 맞음 · 자기 본진 안은 안전):
#    · 심판의 검  — 가장 가까운 1등 팀원 쪽으로 폭 6 · 길이 22 직선 베기 (하트 5) · 격노 땐 3갈래
#    · 응보의 저울 — 1등 팀원 최대 5명 발밑에 원 (반지름 3.5, 하트 4 + 구속 II)
#    · 날개 폭풍  — 네메시스 둘레 반지름 10 (하트 3.5 + 하늘로 날려 버림)
#    · 천벌       — 32칸 안 1등 팀원 전원 발밑에 따라다니는 원 → 2초 뒤 하늘에서 벼락 (하트 5)
#    · 그림자 소환 — 격노할 때 한 번, 1등 팀만 노리는 '복수의 그림자'(벡스) 4마리
#   시전하는 동안은 제자리에 멈춘다
#  관리자: /네메시스 [팀] (시험용 즉시 소환) · /네메시스 제거
#  설정: {bg::cfg::nem_ratio} (기본 2 = 2배) · {bg::cfg::nem_min} (1등 최소 점수, 기본 200) · {bg::cfg::nem_reward} (보상 점수, 기본 150)
#        {bg::cfg::nem_tax} (외면 초당 감점, 기본 2) · {bg::cfg::nem_fine} (못 잡으면 몰수 %, 기본 30)
# ═════════════════════════════════════════════════════════════════════════════
import:
    org.bukkit.Bukkit
    org.bukkit.attribute.Attribute

on load:
    # 리로드로 상태 변수가 지워지면 남은 모델 · 히트박스가 떠다니지 않게 정리
    delete {-bg::nem::alive}
    bgCmd("function bg:boss/nemesis/remove")
    bgCmd("kill @e[type=text_display,tag=bgn_nemesis]")
    bgCmd("kill @e[tag=bg_nemesis]")
    bgCmd("kill @e[tag=bg_nemvex]")
    delete {-bg::nem::vex}
    bgCmd("bossbar remove bg:nemesis")
    bgCmd("bossbar remove bg:nemhud")
    delete {-bg::nem::casting}
    if {bg::cfg::nem_ratio} is not set:
        set {bg::cfg::nem_ratio} to 2
    if {bg::cfg::nem_min} is not set:
        set {bg::cfg::nem_min} to 200
    if {bg::cfg::nem_reward} is not set:
        set {bg::cfg::nem_reward} to 150
    # 예전 기본값(50 · 300)이 저장돼 있으면 새 기본값 150 으로 (한 번만)
    if {bg::cfg::nem_tax} is not set:
        set {bg::cfg::nem_tax} to 2
    if {bg::cfg::nem_fine} is not set:
        set {bg::cfg::nem_fine} to 30
    if {bg::cfg::nem_reward_v2} is not set:
        set {bg::cfg::nem_reward} to 150
        set {bg::cfg::nem_reward_v2} to true

# 지금 1등 팀과 (그 팀을 뺀) 2등 점수
function bgNemTop() :: text:
    set {_best} to -1
    set {_w} to "none"
    loop {-bg::teams::*}:
        if ({-bg::score::%loop-value%} ? 0) > {_best}:
            set {_best} to {-bg::score::%loop-value%} ? 0
            set {_w} to loop-value
    return {_w}

function bgNemSecond(t: text) :: number:
    set {_s} to 0
    loop {-bg::teams::*}:
        if loop-value is not {_t}:
            if bgTeamCount(loop-value) > 0:
                if ({-bg::score::%loop-value%} ? 0) > {_s}:
                    set {_s} to {-bg::score::%loop-value%} ? 0
    return {_s}

# 매초: 조건을 보고 한 번만 발동 · 살아 있으면 움직임 관리
every 1 second:
    if {-bg::on} is not true:
        if {-bg::nem::alive} is true:
            bgNemRemove("")
        delete {-bg::nem::done}
        stop
    if {-bg::nem::alive} is true:
        bgNemTick()
        stop
    {-bg::nem::done} is not true
    # 후반만 (제한 시간의 절반 이후)
    {-bg::sec} >= {bg::cfg::minutes} * 30
    set {_t} to bgNemTop()
    {_t} is not "none"
    set {_b} to {-bg::score::%{_t}%} ? 0
    {_b} >= {bg::cfg::nem_min}
    set {_s} to max(bgNemSecond({_t}), 1)
    {_b} >= {_s} * {bg::cfg::nem_ratio}
    bgNemStart({_t})

function bgNemStart(t: text):
    set {-bg::nem::done} to true
    set {-bg::nem::team} to {_t}
    set {_tn} to "%{-bg::tcol::%{_t}%}%%{-bg::tname::%{_t}%}%"
    bgSay("&5&l[복수의 신] &f%{_tn}% 팀&f이 너무 앞서갑니다. &d20초 뒤&f 네메시스가 %{_tn}% 팀&f 본진 앞에 나타납니다!")
    loop all players:
        if bgTeam(loop-player) is {_t}:
            send title "&5&l복수의 신이 깨어납니다" with subtitle "&f쓰러뜨리면 &e+%{bg::cfg::nem_reward}%점 &7· &c도망치면 점수 %{bg::cfg::nem_fine}%%% 몰수" to loop-player for 4 seconds
            send "&5&l[복수의 신] &f120초 안에 쓰러뜨리세요! &c숨어서 버티면 손해: &f10초 넘게 안 때리면 &c초당 -%{bg::cfg::nem_tax}%점&f, 못 잡고 떠나면 &c점수 %{bg::cfg::nem_fine}%%% 몰수" to loop-player
        else if bgTeam(loop-player) is not "none":
            send title "&5&l복수의 신이 깨어납니다" with subtitle "&f%{_tn}% 팀&f을 노립니다 — 지금이 거점을 되찾을 기회!" to loop-player for 4 seconds
    bgSound("entity.wither.ambient", 1, 0.6)
    wait 20 seconds
    if {-bg::on} is not true:
        stop
    bgNemSpawn({_t})

# 땅 찾기: (x, z) 에서 기준 높이 y0 의 -5 ~ +8 사이, 발밑이 단단하고 위로 4칸이 비어 있는 가장 낮은 자리
function bgNemGround(x: number, z: number, w: world, y0: number) :: location:
    loop 14 times:
        set {_y} to floor({_y0}) - 6 + loop-number
        set {_b} to block at location({_x}, {_y}, {_z}, {_w})
        if {_b}.getType().isSolid() is true:
            set {_ok} to true
            loop 4 times:
                set {_a} to block at location({_x}, {_y} + loop-number-2, {_z}, {_w})
                if {_a}.isPassable() is not true:
                    set {_ok} to false
            if {_ok} is true:
                return location({_x}, {_y} + 1, {_z}, {_w})

# 1등 팀 본진 중심에서 대신전 쪽으로 26~38칸 (성벽 바깥) — 본진 바닥 높이 근처의 땅 위만 (성벽 위 · 지붕 위 X)
function bgNemHome(t: text) :: location:
    set {_b} to bgMk("base_%{_t}%")
    set {_c} to bgMk("temple_core")
    set {_dx} to (x-coordinate of {_c}) - (x-coordinate of {_b})
    set {_dz} to (z-coordinate of {_c}) - (z-coordinate of {_b})
    set {_d} to sqrt({_dx} * {_dx} + {_dz} * {_dz})
    if {_d} < 1:
        set {_d} to 1
    set {_ux} to {_dx} / {_d}
    set {_uz} to {_dz} / {_d}
    set {_by} to y-coordinate of {_b}
    set {_w} to world of {_b}
    set {_dist::*} to 30, 34, 26, 38 and 42
    set {_side::*} to 0, 6, -6, 12 and -12
    loop {_dist::*}:
        set {_dd} to loop-value
        loop {_side::*}:
            set {_ss} to loop-value-2
            set {_x} to (x-coordinate of {_b}) + {_ux} * {_dd} - {_uz} * {_ss}
            set {_z} to (z-coordinate of {_b}) + {_uz} * {_dd} + {_ux} * {_ss}
            set {_l} to bgNemGround({_x}, {_z}, {_w}, {_by})
            if {_l} is set:
                if abs((y-coordinate of {_l}) - {_by}) <= 4:
                    return {_l}
    # 못 찾으면 대신전 쪽 30칸, 본진 바닥 높이
    return location((x-coordinate of {_b}) + {_ux} * 30, {_by} + 1, (z-coordinate of {_b}) + {_uz} * 30, {_w})

function bgNemSpawn(t: text):
    set {_l} to bgNemHome({_t})
    set {-bg::nem::home} to {_l}
    spawn a wither skeleton at {_l}
    set {_e} to last spawned entity
    set {-bg::nem::ent} to {_e}
    set {-bg::nem::alive} to true
    set {-bg::nem::left} to 120
    add "bg" to scoreboard tags of {_e}
    add "bg_nemesis" to scoreboard tags of {_e}
    set name of {_e} to "&5&l복수의 신 네메시스"
    {_e}.setRemoveWhenFarAway(false)
    {_e}.setPersistent(true)
    {_e}.setSilent(true)
    # 이름표는 모델 머리 위 글자(text_display)로 — 투명 히트박스의 이름표는 모델 가슴께에 떠서 숨김
    {_e}.setCustomNameVisible(false)
    set tool of {_e} to air
    # 체력: 200 + 1등 팀 두 번째 사람부터 1명당 40 (최대 600) · 한 대 8 (하트 4) · 갑옷 · 넉백 안 먹음
    set {_n} to bgTeamCount({_t})
    set {_hp} to min(600, 200 + 40 * max(0, {_n} - 1))
    set {-bg::nem::max} to {_hp}
    set {_u} to "%uuid of {_e}%"
    bgCmd("attribute %{_u}% minecraft:max_health base set %{_hp}%")
    bgCmd("attribute %{_u}% minecraft:attack_damage base set 8")
    bgCmd("attribute %{_u}% minecraft:armor base set 8")
    bgCmd("attribute %{_u}% minecraft:armor_toughness base set 4")
    bgCmd("attribute %{_u}% minecraft:scale base set 2.6")
    bgCmd("attribute %{_u}% minecraft:movement_speed base set 0.34")
    bgCmd("attribute %{_u}% minecraft:follow_range base set 48")
    bgCmd("attribute %{_u}% minecraft:knockback_resistance base set 1")
    {_e}.getAttribute(Attribute.MAX_HEALTH).setBaseValue({_hp})
    {_e}.setHealth({_hp})
    bgCmd("effect give %{_u}% invisibility infinite 0 true")
    bgCmd("effect give %{_u}% fire_resistance infinite 0 true")
    set {-bg::nem::uuid} to {_u}
    # 모델 파츠 소환 (히트박스 위치) + 머리 위 이름
    bgCmd("execute as %{_u}% at @s run function bg:boss/nemesis/spawn")
    bgCmd("execute as %{_u}% at @s run summon text_display ~ ~ ~ {Tags:[""bg"",""bgn"",""bgn_nemesis""],billboard:""center"",see_through:1b,shadow:1b,background:0,teleport_duration:2,view_range:3f,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,12.5f,0f],scale:[2.2f,2.2f,2.2f]},text:{text:""복수의 신 네메시스"",color:""light_purple"",bold:true}}")
    set {-bg::nem::lastloc} to location of {_e}
    # 등장 연출: 빛기둥 + 천둥 · 3초 동안 날개를 펴며 떠오름 (그동안 움직이지 않음)
    set ai of {_e} to false
    bgNemAnim("rise")
    bgParticle({_l}, "end_rod", 0.4, 12, 0.4, 0.02, 260)
    bgParticle({_l}, "reverse_portal", 3, 3, 3, 0.1, 300)
    bgSound("item.trident.thunder", 1, 0.7)
    bgNemWake({_e})
    set {-bg::nem::trail} to {_hp}
    # 마지막으로 1등 팀에게 맞은 때 (등장 연출 3초 + 10초 여유)
    set {-bg::nem::lasthit} to now
    set {-bg::nem::taxed} to 0
    set {-bg::nem::cd} to 4
    delete {-bg::nem::raged}
    delete {-bg::nem::casting}
    delete {-bg::nem::hudlast}
    bgCmd("bossbar remove bg:nemhud")
    bgBarInit("bg:nemhud")
    bgCmd("bossbar set bg:nemhud players @a[tag=!bg_optout]")
    set {_tn} to "%{-bg::tcol::%{_t}%}%%{-bg::tname::%{_t}%}%"
    bgSay("&5&l[복수의 신] &f네메시스가 %{_tn}% 팀&f 본진 앞에 나타났습니다! &7(120초 · %{_tn}% 팀&7만 공격 · 쓰러뜨리면 +%{bg::cfg::nem_reward}%점 · 코인 +15 · &c못 잡으면 %{_tn}% 팀&c 점수 %{bg::cfg::nem_fine}%%% 몰수&7)")
    bgSound("entity.wither.spawn", 0.8, 0.8)

function bgNemTick():
    set {_e} to {-bg::nem::ent}
    if {_e} is not alive:
        bgNemRemove("")
        stop
    set {_t} to {-bg::nem::team}
    remove 1 from {-bg::nem::left}
    if {-bg::nem::left} <= 0:
        # 최후의 심판: 못 쓰러뜨렸으면 점수 몰수
        set {_sc} to {-bg::score::%{_t}%} ? 0
        set {_fine} to floor({_sc} * {bg::cfg::nem_fine} / 100)
        bgNemFine({_t}, {_fine})
        set {_tn} to "%{-bg::tcol::%{_t}%}%%{-bg::tname::%{_t}%}%"
        bgNemRemove("&5&l[복수의 신] &f%{_tn}% 팀&f이 심판을 피했습니다 — &c&l최후의 심판! &f%{_tn}% 팀&c 점수 -%{_fine}% &7(%{bg::cfg::nem_fine}%%% 몰수 · 외면 감점 합계 -%{-bg::nem::taxed}%)")
        loop all players:
            if bgTeam(loop-player) is {_t}:
                send title "&4&l최후의 심판" with subtitle "&c점수 -%{_fine}% &7— 네메시스를 쓰러뜨리지 못했습니다" to loop-player for 3 seconds
        bgSound("entity.lightning_bolt.thunder", 1, 0.6)
        stop
    # 외면: 1등 팀이 10초 넘게 한 대도 안 때리면 초당 감점
    if difference between {-bg::nem::lasthit} and now > 13 seconds:
        bgNemFine({_t}, {bg::cfg::nem_tax})
        add {bg::cfg::nem_tax} to {-bg::nem::taxed}
        loop all players:
            if bgTeam(loop-player) is {_t}:
                send action bar "&c&l네메시스를 외면하는 중! &f초당 &c-%{bg::cfg::nem_tax}%점 &7(지금까지 -%{-bg::nem::taxed}%) &f— 때려야 멈춥니다" to loop-player
    # 1등 팀 본진 안으로는 못 들어감 (스폰킬 방지) → 나올 자리로 되돌림
    set {_b} to bgMk("base_%{_t}%")
    if world of {_e} is world of {_b}:
        if bgDist2(location of {_e}, {_b}) < 18:
            teleport {_e} to {-bg::nem::home}
    # 1등 팀에서 가장 가까운 사람을 노린다 (다른 팀은 안 노림)
    set {_best} to 49
    loop all players:
        if bgTeam(loop-player) is {_t}:
            if gamemode of loop-player is survival or adventure:
                if world of loop-player is world of {_e}:
                    set {_d} to distance between loop-player and {_e}
                    if {_d} < {_best}:
                        # 본진 안에 숨은 사람은 안 쫓음
                        if bgDist2(location of loop-player, {_b}) >= 16:
                            set {_best} to {_d}
                            set {_p} to loop-player
    if {-bg::nem::casting} is not true:
        if {_p} is set:
            set target of {_e} to {_p}
        else:
            delete target of {_e}
    bgCmd("data merge entity @e[type=text_display,tag=bgn_nemesis,limit=1] {text:[{text:""복수의 신 네메시스"",color:""light_purple"",bold:true},{text:""  %{-bg::nem::left}%초"",color:""white"",bold:false}]}")
    # 스킬: 등장 연출이 끝난 뒤, 시전 중이 아닐 때 쿨다운이 다 되면
    {-bg::nem::casting} is not true
    {-bg::nem::anim} is not "rise"
    remove 1 from {-bg::nem::cd}
    {-bg::nem::cd} <= 0
    set {-bg::nem::cd} to random integer between 6 and 8
    if bgNemRage() is true:
        set {-bg::nem::cd} to random integer between 4 and 6
    # 격노 첫 순간: 그림자 소환 (한 번)
    if bgNemRage() is true:
        if {-bg::nem::raged} is not true:
            set {-bg::nem::raged} to true
            bgNemEnrage({_e})
            stop
    set {_k} to random integer between 1 and 4
    if {_k} is 1:
        bgNemVerdict({_e})
    else if {_k} is 2:
        bgNemScales({_e})
    else if {_k} is 3:
        bgNemWings({_e})
    else:
        bgNemSmite({_e})

function bgNemRemove(msg: text):
    set {_e} to {-bg::nem::ent}
    delete {-bg::nem::alive}
    delete {-bg::nem::ent}
    if {_e} is alive:
        bgParticle(location of {_e}, "reverse_portal", 1.5, 2.5, 1.5, 0.05, 160)
        kill {_e}
    bgCmd("kill @e[tag=bg_nemesis]")
    bgCmd("kill @e[tag=bg_nemvex]")
    bgNemParts()
    bgCmd("bossbar remove bg:nemhud")
    delete {-bg::nem::casting}
    if {_msg} is not "":
        bgSay({_msg})

# 1등 팀 점수 깎기 (0 아래로는 안 내려감)
function bgNemFine(t: text, n: number):
    {_n} > 0
    set {_sc} to {-bg::score::%{_t}%} ? 0
    set {-bg::score::%{_t}%} to max(0, {_sc} - {_n})

# ─────────────────────────────────────────────────────────── 모델 (파츠 동기화 · 애니메이션)
function bgNemParts():
    bgCmd("function bg:boss/nemesis/remove")
    bgCmd("kill @e[type=text_display,tag=bgn_nemesis]")

function bgNemAnim(a: text):
    if {-bg::anim::nemesis::%{_a}%::n} is not set:
        stop
    set {-bg::nem::anim} to {_a}
    set {-bg::nem::frame} to 0
    set {-bg::nem::ft} to {-bg::anim::nemesis::%{_a}%::t::0}
    set {-bg::nem::animdone} to false
    bgCmd("function bg:boss/nemesis/anim/%{_a}%/0")

function bgNemAnimStep():
    if {-bg::nem::animdone} is true:
        stop
    set {_a} to {-bg::nem::anim}
    remove 1 from {-bg::nem::ft}
    if {-bg::nem::ft} > 0:
        stop
    set {_f} to {-bg::nem::frame} + 1
    if {_f} >= {-bg::anim::nemesis::%{_a}%::n}:
        if {-bg::anim::nemesis::%{_a}%::loop} is true:
            set {_f} to 0
        else:
            set {-bg::nem::animdone} to true
            stop
    set {-bg::nem::frame} to {_f}
    set {-bg::nem::ft} to {-bg::anim::nemesis::%{_a}%::t::%{_f}%}
    bgCmd("function bg:boss/nemesis/anim/%{_a}%/%{_f}%")

# 매 틱: 파츠가 히트박스를 따라감 · 움직이면 활공 / 멈추면 떠 있기 (베는 중이면 그대로)
every tick:
    {-bg::nem::alive} is true
    set {_e} to {-bg::nem::ent}
    {_e} is alive
    bgCmd("execute as %{-bg::nem::uuid}% at @s run function bg:boss/nemesis/tp")
    bgCmd("execute as %{-bg::nem::uuid}% at @s run tp @e[type=text_display,tag=bgn_nemesis,distance=..16] ~ ~ ~")
    set {_mv} to false
    if {-bg::nem::lastloc} is set:
        if world of {_e} is world of {-bg::nem::lastloc}:
            if distance between location of {_e} and {-bg::nem::lastloc} > 0.04:
                set {_mv} to true
    set {-bg::nem::lastloc} to location of {_e}
    if {-bg::nem::casting} is true:
        add 1 to {-bg::nem::castT}
    if {-bg::nem::anim} is "slash" or "rise":
        if {-bg::nem::animdone} is not true:
            bgNemAnimStep()
            stop
    if {_mv} is true:
        if {-bg::nem::anim} is not "glide":
            bgNemAnim("glide")
    else if {-bg::nem::anim} is not "idle":
        bgNemAnim("idle")
    bgNemAnimStep()

# 등장 연출이 끝나면 움직이기 시작
function bgNemWake(e: entity):
    wait 66 ticks
    if {_e} is alive:
        set ai of {_e} to true
        bgParticle(location of {_e}, "sonic_boom", 0, 0, 0, 0, 1)
        bgSound("entity.ender_dragon.growl", 0.7, 1.3)

# 쓰러짐: 날개가 꺾이며 가라앉고 보랏빛으로 흩어진다
function bgNemDeath(l: location):
    bgNemAnim("death")
    bgParticle({_l}, "reverse_portal", 1.5, 2.5, 1.5, 0.05, 200)
    wait 14 ticks
    bgCmd("function bg:boss/nemesis/anim/death/1")
    wait 22 ticks
    bgParticle({_l}, "end_rod", 1.2, 2, 1.2, 0.08, 80)
    bgNemParts()

# ─────────────────────────────────────────────────────────── 그림 보스바 (미니 보스와 같은 틀)
function bgNemRage() :: boolean:
    set {_e} to {-bg::nem::ent}
    if {_e} is not alive:
        return false
    if (health of {_e}) * 2 <= {-bg::nem::max} * 0.4:
        return true
    return false

function bgHudNem() :: text:
    set {_e} to {-bg::nem::ent}
    set {_max} to {-bg::nem::max}
    set {_hp} to max(0, ceil((health of {_e}) * 2))
    set {_fw} to {-bg::hud::fill_w}
    set {_tr} to max({_hp}, ({-bg::nem::trail} ? {_hp}) - {_max} * 0.012)
    set {-bg::nem::trail} to {_tr}
    set {_tp} to round({_fw} * min(1, {_tr} / {_max}))
    set {_hpx} to round({_fw} * min(1, {_hp} / {_max}))
    if {_hp} > 0:
        if {_hpx} is 0:
            set {_hpx} to 1
    set {_st} to "normal"
    if bgNemRage() is true:
        set {_st} to "rage"
    set {_c} to 0
    set {_dia} to "idle"
    if {-bg::nem::casting} is true:
        set {_c} to min(1, {-bg::nem::castT} / max(1, {-bg::nem::castN}))
        set {_dia} to "lit"
    set {_cpx} to round({-bg::hud::cast_w} * {_c})
    set {_s} to "%{-bg::hud::boss_back}%%{-bg::hud::trail::%{_tp}%}%%{-bg::hud::hp::%{_hpx}%}%%{-bg::hud::boss_front}%"
    set {_s} to "%{_s}%%{-bg::hud::banner::%{_st}%}%%{-bg::hud::name::nemesis}%%{-bg::hud::portrait::nemesis}%%{-bg::hud::status::%{_st}%}%"
    set {_s} to "%{_s}%%{-bg::hud::cast::%{_cpx}%}%%{-bg::hud::diamond::%{_dia}%}%"
    set {_d} to bgDigits("%{_hp}%/%{_max}%", {-bg::hud::boss_x} + 120, "bd")
    return "%{_s}%%{_d}%"

every 4 ticks:
    {-bg::nem::alive} is true
    {-bg::hud::ready} is true
    {-bg::nem::ent} is alive
    set {_s} to bgHudNem()
    if ({-bg::nem::hudlast} ? "") is not {_s}:
        set {-bg::nem::hudlast} to {_s}
        bgHudName("bg:nemhud", {_s})

# ─────────────────────────────────────────────────────────── 스킬 도우미
# 맞을 수 있는 사람: 1등 팀 · 생존/모험 · 자기 본진(16칸) 밖
function bgNemCanHit(p: player) :: boolean:
    if bgTeam({_p}) is not {-bg::nem::team}:
        return false
    if gamemode of {_p} is not survival or adventure:
        return false
    set {_b} to bgMk("base_%{-bg::nem::team}%")
    if world of {_p} is world of {_b}:
        if bgDist2(location of {_p}, {_b}) < 16:
            return false
    return true

function bgNemTargets(c: location, r: number) :: players:
    loop all players:
        if bgNemCanHit(loop-player) is true:
            if world of loop-player is world of {_c}:
                if bgDist2(location of loop-player, {_c}) <= {_r}:
                    add loop-player to {_ps::*}
    return {_ps::*}

function bgNemXYZ(l: location) :: text:
    return "x:%bgC(x-coordinate of {_l})%,y:%bgN(y-coordinate of {_l})%,z:%bgC(z-coordinate of {_l})%"

function bgNemFloor(l: location) :: location:
    return location(x-coordinate of {_l}, floor((y-coordinate of {_l}) + 0.05), z-coordinate of {_l}, world of {_l})

# 시전 시작: 제자리에 멈추고 보스바 시전 게이지 · 스킬 이름 알림
function bgNemCast(e: entity, nm: text, ticks: number):
    set {-bg::nem::casting} to true
    set {-bg::nem::castT} to 0
    set {-bg::nem::castN} to {_ticks}
    set ai of {_e} to false
    loop all players:
        if world of loop-player is world of {_e}:
            if distance between loop-player and {_e} < 48:
                send action bar "&5&l✦ 네메시스 — %{_nm}% &5&l✦" to loop-player
    bgSoundAt(location of {_e}, "entity.evoker.prepare_attack", 2, 0.6)

function bgNemCastEnd(e: entity):
    delete {-bg::nem::casting}
    if {_e} is alive:
        set ai of {_e} to true

function bgNemFace(e: entity, yaw: number):
    bgCmd("execute as %{-bg::nem::uuid}% at @s run tp @s ~ ~ ~ %bgN({_yaw})% 0")

# 1등 팀에서 가장 가까운 사람 (본진 안 제외, 24칸 안)
function bgNemNearest(c: location) :: player:
    set {_best} to 24
    loop bgNemTargets({_c}, 24):
        set {_d} to bgDist2(location of loop-value, {_c})
        if {_d} < {_best}:
            set {_best} to {_d}
            set {_p} to loop-value
    return {_p}

# ─────────────────────────────────────────────────────────── 스킬 1 · 심판의 검 (직선 베기 · 격노 땐 3갈래)
function bgNemVerdict(e: entity):
    set {_pos} to bgNemFloor(location of {_e})
    set {_p} to bgNemNearest({_pos})
    if {_p} is not set:
        stop
    set {_yaw0} to bgYawTo({_pos}, location of {_p})
    set {_t} to 28
    set {_yaws::*} to {_yaw0}
    if bgNemRage() is true:
        set {_t} to 22
        set {_yaws::*} to {_yaw0}, {_yaw0} - 35 and {_yaw0} + 35
    set {_wd} to 6
    set {_len} to 22
    bgNemCast({_e}, "심판의 검", {_t})
    bgNemFace({_e}, {_yaw0})
    loop {_yaws::*}:
        bgCmd("execute in %bgDim()% run function bg:tele/rect {%bgNemXYZ({_pos})%,yaw:%bgN(loop-value)%,wd:%bgN({_wd})%,l:%bgN({_len})%,hl:%bgN({_len} / 2)%,hz:%bgN({_len} - {_wd} / 2)%,t:%{_t}%,id:nem%bgTid()%}")
    wait bgTicks({_t} - 8)
    if {_e} is not alive:
        stop
    bgNemAnim("slash")
    wait 8 ticks
    if {_e} is not alive:
        stop
    loop bgNemTargets({_pos}, {_len} + 2):
        set {_hit} to false
        loop {_yaws::*}:
            set {_dx} to (x-coordinate of loop-value-1) - (x-coordinate of {_pos})
            set {_dz} to (z-coordinate of loop-value-1) - (z-coordinate of {_pos})
            set {_along} to {_dx} * bgFwdX(loop-value-2) + {_dz} * bgFwdZ(loop-value-2)
            set {_perp} to abs({_dx} * bgFwdZ(loop-value-2) - {_dz} * bgFwdX(loop-value-2))
            if {_along} >= -0.6:
                if {_along} <= {_len}:
                    if {_perp} <= {_wd} / 2 + 0.3:
                        if abs((y-coordinate of loop-value-1) - (y-coordinate of {_pos})) < 5:
                            set {_hit} to true
        if {_hit} is true:
            bgHit(loop-value-1, 5, {_pos}, 1.6, 0.6)
    loop {_yaws::*}:
        bgImpactLine({_pos}, loop-value, {_wd}, {_len}, "wax_on")
    bgSoundAt({_pos}, "item.trident.thunder", 1.5, 1.4)
    bgNemCastEnd({_e})

# ─────────────────────────────────────────────────────────── 스킬 2 · 응보의 저울 (최대 3명 발밑)
function bgNemScales(e: entity):
    set {_pos} to bgNemFloor(location of {_e})
    set {_ps::*} to bgNemTargets({_pos}, 24)
    if size of {_ps::*} is 0:
        stop
    set {_t} to 32
    if bgNemRage() is true:
        set {_t} to 26
    bgNemCast({_e}, "응보의 저울", {_t})
    set {_n} to 0
    loop {_ps::*}:
        add 1 to {_n}
        if {_n} <= 5:
            set {_l} to bgNemFloor(location of loop-value)
            add {_l} to {_ls::*}
            bgCmd("execute in %bgDim()% run function bg:tele/circle {%bgNemXYZ({_l})%,d:7,t:%{_t}%,id:nem%bgTid()%}")
            send title "" with subtitle "&5응보의 저울이 당신을 잽니다 — 피하세요!" to loop-value for 2 seconds
    bgParticle(location of {_e}, "enchant", 2, 4, 2, 1, 120)
    wait bgTicks({_t})
    if {_e} is not alive:
        stop
    loop {_ls::*}:
        set {_l} to loop-value
        loop bgNemTargets({_l}, 3.5):
            if abs((y-coordinate of loop-value-2) - (y-coordinate of {_l})) < 5:
                bgHit(loop-value-2, 4, {_l}, 0.6, 0.8)
                bgCmd("effect give %name of loop-value-2% slowness 3 1 true")
        bgImpactCircle({_l}, 3.5, "wax_on")
    bgSoundAt({_pos}, "block.anvil.land", 1.5, 0.6)
    bgNemCastEnd({_e})

# ─────────────────────────────────────────────────────────── 스킬 3 · 날개 폭풍 (주변 밀쳐내기)
function bgNemWings(e: entity):
    set {_pos} to bgNemFloor(location of {_e})
    if size of bgNemTargets({_pos}, 16) is 0:
        stop
    set {_t} to 30
    if bgNemRage() is true:
        set {_t} to 22
    bgNemCast({_e}, "날개 폭풍", {_t})
    bgCmd("execute in %bgDim()% run function bg:tele/circle {%bgNemXYZ({_pos})%,d:20,t:%{_t}%,id:nem%bgTid()%}")
    # 날개를 접었다가 (등장 동작 1번 장면) …
    bgNemAnimAt("rise", 1)
    set {-bg::nem::ft} to {_t} + 2
    wait bgTicks({_t})
    if {_e} is not alive:
        stop
    # … 활짝 (2번 장면부터 이어서 재생)
    bgNemAnimAt("rise", 2)
    loop bgNemTargets({_pos}, 10):
        if abs((y-coordinate of loop-value) - (y-coordinate of {_pos})) < 5:
            bgHit(loop-value, 3.5, {_pos}, 2.4, 1.1)
    bgImpactCircle({_pos}, 10, "cloud")
    bgSoundAt({_pos}, "entity.ender_dragon.flap", 2, 0.6)
    bgNemCastEnd({_e})

# ─────────────────────────────────────────────────────────── 스킬 4 · 천벌 (따라다니는 원 → 하늘에서 벼락)
function bgNemSmite(e: entity):
    set {_pos} to bgNemFloor(location of {_e})
    set {_ps::*} to bgNemTargets({_pos}, 32)
    if size of {_ps::*} is 0:
        stop
    set {_t} to 44
    if bgNemRage() is true:
        set {_t} to 36
    bgNemCast({_e}, "천벌", {_t})
    bgNemAnimAt("rise", 3)
    set {-bg::nem::ft} to {_t} + 2
    # 사람마다 원 하나 (id 기억) — 처음 28틱(격노 20틱)은 따라다니다가 마지막 16틱은 그 자리에 고정
    set {_i} to 0
    loop {_ps::*}:
        add 1 to {_i}
        set {_id::%{_i}%} to "nem%bgTid()%"
        set {_who::%{_i}%} to loop-value
        bgCmd("execute in %bgDim()% run function bg:tele/circle {%bgNemXYZ(bgNemFloor(location of loop-value))%,d:6,t:%{_t}%,id:%{_id::%{_i}%}%}")
        send title "&5&l천벌" with subtitle "&f하늘이 당신을 겨눕니다 — 멈추면 맞습니다!" to loop-value for 2 seconds
    bgSoundAt({_pos}, "entity.lightning_bolt.thunder", 1, 1.6)
    set {_follow} to {_t} - 16
    loop {_follow} / 4 times:
        wait 4 ticks
        if {_e} is not alive:
            stop
        loop {_i} times:
            set {_q} to {_who::%loop-number-2%}
            if {_q} is online:
                bgCmd("execute in %bgDim()% run function bg:tele/move {id:%{_id::%loop-number-2%}%,x:%bgC(x-coordinate of {_q})%,y:%bgN(floor((y-coordinate of {_q}) + 0.05))%,z:%bgC(z-coordinate of {_q})%}")
                set {_at::%loop-number-2%} to bgNemFloor(location of {_q})
    wait 16 ticks
    if {_e} is not alive:
        stop
    loop {_i} times:
        set {_l} to {_at::%loop-number%}
        if {_l} is not set:
            set {_l} to bgNemFloor(location of {_who::%loop-number%})
        bgParticle(location(x-coordinate of {_l}, (y-coordinate of {_l}) + 10, z-coordinate of {_l}, world of {_l}), "end_rod", 0.15, 10, 0.15, 0.02, 120)
        bgParticle({_l}, "electric_spark", 1.5, 0.5, 1.5, 0.3, 80)
        bgSoundAt({_l}, "entity.lightning_bolt.impact", 2, 0.8)
        loop bgNemTargets({_l}, 3):
            if abs((y-coordinate of loop-value-2) - (y-coordinate of {_l})) < 6:
                bgHit(loop-value-2, 5, {_l}, 0.4, 0.9)
        bgImpactCircle({_l}, 3, "wax_on")
    bgNemCastEnd({_e})

# ─────────────────────────────────────────────────────────── 격노 (체력 50% 아래 첫 순간 · 한 번)
function bgNemEnrage(e: entity):
    bgNemCast({_e}, "격노 — 복수의 그림자", 40)
    bgNemAnimAt("rise", 2)
    bgSay("&5&l[복수의 신] &c네메시스가 격노합니다! &f복수의 그림자가 %{-bg::tcol::%{-bg::nem::team}%}%%{-bg::tname::%{-bg::nem::team}%}% 팀&f을 덮칩니다.")
    bgSoundAt(location of {_e}, "entity.wither.spawn", 2, 1.4)
    bgParticle(location of {_e}, "sonic_boom", 0, 0, 0, 0, 1)
    bgParticle(location of {_e}, "reverse_portal", 4, 4, 4, 0.2, 400)
    loop 4 times:
        set {_a} to loop-number * 90
        set {_l} to location((x-coordinate of {_e}) + cos({_a}) * 3, (y-coordinate of {_e}) + 3, (z-coordinate of {_e}) + sin({_a}) * 3, world of {_e})
        spawn a vex at {_l}
        set {_v} to last spawned entity
        add "bg" to scoreboard tags of {_v}
        add "bg_nemvex" to scoreboard tags of {_v}
        set name of {_v} to "&5복수의 그림자"
        bgCmd("attribute %uuid of {_v}% minecraft:max_health base set 16")
        bgCmd("attribute %uuid of {_v}% minecraft:attack_damage base set 5")
        heal {_v}
        {_v}.setGlowing(true)
    set {-bg::nem::vex} to true
    wait 40 ticks
    bgNemCastEnd({_e})

# 그림자: 1등 팀만 노리고 · 1등 팀만 때림 · 1등 팀만 그림자를 때릴 수 있음
every 1 second:
    {-bg::nem::vex} is true
    set {_found} to 0
    loop all entities:
        if loop-entity has scoreboard tag "bg_nemvex":
            add 1 to {_found}
            set {_v} to loop-entity
            if {-bg::nem::alive} is not true:
                kill {_v}
            else:
                set {_vl} to location of {_v}
                set {_best} to 40
                delete {_p}
                loop all players:
                    if bgNemCanHit(loop-player) is true:
                        set {_pl} to location of loop-player
                        if world of {_pl} is world of {_vl}:
                            set {_d} to distance between {_pl} and {_vl}
                            if {_d} < {_best}:
                                set {_best} to {_d}
                                set {_p} to loop-player
                if {_p} is set:
                    set target of {_v} to {_p}
                else:
                    delete target of {_v}
    if {_found} is 0:
        delete {-bg::nem::vex}

on target:
    event-entity has scoreboard tag "bg_nemvex"
    if target is not a player:
        cancel event
        stop
    if bgTeam(target) is not {-bg::nem::team}:
        cancel event

on damage:
    victim has scoreboard tag "bg_nemvex"
    if attacker is a player:
        if bgTeam(attacker) is not {-bg::nem::team}:
            cancel event

on damage of player:
    attacker has scoreboard tag "bg_nemvex"
    if bgTeam(victim) is not {-bg::nem::team}:
        cancel event

on death:
    victim has scoreboard tag "bg_nemvex"
    clear drops

# 애니메이션을 특정 장면부터
function bgNemAnimAt(a: text, f: number):
    if {-bg::anim::nemesis::%{_a}%::n} is not set:
        stop
    set {-bg::nem::anim} to {_a}
    set {-bg::nem::frame} to {_f}
    set {-bg::nem::ft} to {-bg::anim::nemesis::%{_a}%::t::%{_f}%}
    set {-bg::nem::animdone} to false
    bgCmd("function bg:boss/nemesis/anim/%{_a}%/%{_f}%")

# 다른 팀은 노리지 않는다
on target:
    event-entity has scoreboard tag "bg_nemesis"
    if target is not a player:
        cancel event
        stop
    if bgTeam(target) is not {-bg::nem::team}:
        cancel event

# 다른 팀은 때리지도 맞지도 않는다 · 1등 팀이 맞아도 시듦은 안 걸림
on damage:
    victim has scoreboard tag "bg_nemesis"
    if attacker is a player:
        if bgTeam(attacker) is {-bg::nem::team}:
            set {-bg::nem::lasthit} to now
        else:
            cancel event
            send action bar "&5네메시스는 %{-bg::tname::%{-bg::nem::team}%}% 팀만 노립니다 — 지금은 거점을 노리세요" to attacker
    else:
        cancel event

on damage of player:
    attacker has scoreboard tag "bg_nemesis"
    if bgTeam(victim) is not {-bg::nem::team}:
        cancel event
        stop
    if {-bg::nem::anim} is not "slash":
        bgNemAnim("slash")
    else if {-bg::nem::animdone} is true:
        bgNemAnim("slash")
    play sound "entity.player.attack.sweep" with volume 1.2 with pitch 0.7 at location of victim
    # 흡혈: 한 대마다 최대 체력의 1%
    if attacker is alive:
        heal attacker by {-bg::nem::max} * 0.01 / 2
    wait 1 tick
    remove wither from victim

on death:
    victim has scoreboard tag "bg_nemesis"
    clear drops
    if {-bg::nem::alive} is true:
        set {_t} to {-bg::nem::team}
        delete {-bg::nem::alive}
        delete {-bg::nem::ent}
        delete {-bg::nem::casting}
        bgCmd("bossbar remove bg:nemhud")
        bgNemDeath(location of victim)
        bgAddScore({_t}, {bg::cfg::nem_reward}, true)
        bgCoinTeam({_t}, 15, "네메시스 격퇴")
        bgSay("&5&l[복수의 신] %{-bg::tcol::%{_t}%}%%{-bg::tname::%{_t}%}% 팀&f이 네메시스를 막아 냈습니다! &e+%{bg::cfg::nem_reward}%점 · 팀원 코인 +15")
        bgSound("ui.toast.challenge_complete", 0.8, 1)

command /네메시스 [<text>]:
    aliases: /nemesis
    permission: op
    trigger:
        if arg-1 is "제거":
            bgNemRemove("&5&l[복수의 신] &7관리자가 네메시스를 거두었습니다.")
            stop
        if {-bg::on} is not true:
            send "&c[복수의 신] 게임 중에만 소환할 수 있습니다."
            stop
        if {-bg::nem::alive} is true:
            send "&c[복수의 신] 이미 나와 있습니다. (/네메시스 제거)"
            stop
        set {_t} to bgNemTop()
        if arg-1 is set:
            set {_t} to bgTeamId(arg-1)
        if {_t} is "none":
            send "&c[복수의 신] 팀: 레드 · 블루 · 그린 · 옐로"
            stop
        set {-bg::nem::done} to true
        set {-bg::nem::team} to {_t}
        bgNemSpawn({_t})
