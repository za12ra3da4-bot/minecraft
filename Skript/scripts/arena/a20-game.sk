# ═════════════════════════════════════════════════════════════════════════════
#  왕관 쟁탈전 — 게임 흐름 · 점령 · 점수 · 버프 · 병과 · 부활 · 본진 보호 · 명령
#
#  점령 지점 5곳:  왕좌의 성소(가운데, 초당 +3)  +  제단 4곳(초당 +1, 팀 버프)
#    불꽃 = 힘 I   수호 = 저항 I   바람 = 신속 I   생명 = 2초마다 회복 · 포만
#  처치 +10,  보스 처치(가장 많이 때린 팀) +150 · 보스 축복
#  목표 점수 또는 제한 시간 → 최고 점수 팀 승리
# ═════════════════════════════════════════════════════════════════════════════

on load:
    set {-bg::clsdesc::0} to "&c체력 12칸 &7· &f공격력 +2 &7· &f공격 속도 +10%%"
    set {-bg::clsdesc::1} to "&a체력 9칸 &7· &f이동 +15%% &7· &f낙하 피해 줄음 &7· &f점프 높음"
    set {-bg::clsdesc::2} to "&9체력 14칸 &7· &f방어 +3 &7· &f넉백 저항 50%% &7· &f이동 -8%%"

on load:
    set {-bg::pts::*} to "temple", "ares", "athena", "hermes" and "demeter"
    set {-bg::ptmk::temple} to "temple_core"
    set {-bg::ptr::temple} to 9
    set {-bg::ptname::temple} to "왕좌의 성소"
    loop "ares", "athena", "hermes" and "demeter":
        set {-bg::ptmk::%loop-value%} to "altar_%loop-value%"
        set {-bg::ptr::%loop-value%} to bgMkR("altar_%loop-value%")
    set {-bg::ptname::ares} to "불꽃 제단"
    set {-bg::ptname::athena} to "수호 제단"
    set {-bg::ptname::hermes} to "바람 제단"
    set {-bg::ptname::demeter} to "생명 제단"
    set {-bg::ptbuff::ares} to "힘"
    set {-bg::ptbuff::athena} to "저항"
    set {-bg::ptbuff::hermes} to "신속"
    set {-bg::ptbuff::demeter} to "재생"
    set {-bg::ptscore::temple} to 3
    set {-bg::ptscore::ares} to 1
    set {-bg::ptscore::athena} to 1
    set {-bg::ptscore::hermes} to 1
    set {-bg::ptscore::demeter} to 1
    set {-bg::hex::red} to 14693424
    set {-bg::hex::blue} to 3963120
    set {-bg::hex::green} to 4638790
    set {-bg::hex::yellow} to 15779880
    set {-bg::glass::red} to "red"
    set {-bg::glass::blue} to "blue"
    set {-bg::glass::green} to "lime"
    set {-bg::glass::yellow} to "yellow"
    set {-bg::cls::0} to "전사"
    set {-bg::cls::1} to "궁수"
    set {-bg::cls::2} to "수호자"

# ─────────────────────────────────────────────────────────── 시작 / 종료
function bgStart():
    if {-bg::mk::ready} is not true:
        bgSay("&c맵 데이터(a02-gen-map.sk)가 없습니다.")
        stop
    bgSetupTeams()
    bgSyncOrigin()
    # 연습장에 있던 사람은 대기실로 (연습 무기는 회수)
    loop all players:
        if {-bg::pvp::%uuid of loop-player%} is true:
            delete {-bg::pvp::%uuid of loop-player%}
            bgToLobby(loop-player)
    delete {-bg::pvp::*}
    set {-bg::sec} to 0
    set {-bg::on} to false
    loop {-bg::teams::*}:
        set {-bg::score::%loop-value%} to 0
        set {-bg::sfrac::%loop-value%} to 0
    loop {-bg::pts::*}:
        set {-bg::own::%loop-value%} to "none"
        set {-bg::capt::%loop-value%} to "none"
        set {-bg::capv::%loop-value%} to 0
        set {-bg::contest::%loop-value%} to false
    set {-bg::boss::next} to {bg::cfg::boss_first}
    bgCoreReset()
    # 코인은 게임이 끝날 때 초기화된다 → 시작할 땐 최소 20 (관리자가 미리 준 코인은 유지)
    delete {bg::owned::*}
    loop all players:
        if bgTeam(loop-player) is not "none":
            if ({bg::coin::%uuid of loop-player%} ? 0) < 20:
                set {bg::coin::%uuid of loop-player%} to 20
    bgHudCreate()
    loop all players:
        if bgTeam(loop-player) is not "none":
            bgSpawn(loop-player)
    loop 5 times:
        set {_n} to 6 - loop-number
        bgTitle("&6&l%{_n}%", "&f왕관 쟁탈전이 곧 시작됩니다", 0, 22, 0)
        bgSound("block.note_block.hat", 1, 1)
        wait 1 second
    bgTitle("&6&l왕관 쟁탈전", "&f대신전과 제단을 점령하라!", 5, 50, 15)
    bgSound("entity.ender_dragon.growl", 0.6, 1.2)
    set {-bg::on} to true
    bgSay("목표 &e%{bg::cfg::goal}%점&f · 제한 시간 &e%{bg::cfg::minutes}%분")
    bgSay("&6코인 버는 법&f: 10초마다 +1 · 처치 +10 · 지점 점령 +15(팀 전원) · 점령한 지점 하나당 10초마다 +1 · 보스 처치 +40(팀 전원)")
    bgSay("&6/상점&f (자기 본진에서) — 갑옷 · 소모품 · 전설 무기. &6/코인&f 으로 잔액 확인")

# 따라잡기: 1등과 150점 넘게 벌어진 팀은 점령 점수 · 처치 점수 1.5배
function bgCatchup(t: text) :: number:
    set {_best} to 0
    loop {-bg::teams::*}:
        if ({-bg::score::%loop-value%} ? 0) > {_best}:
            set {_best} to {-bg::score::%loop-value%}
    if {_best} - ({-bg::score::%{_t}%} ? 0) >= 150:
        return 1.5
    return 1

# 1등 팀 (다른 팀보다 100점 넘게 앞설 때만)
function bgLeader() :: text:
    set {_best} to -1
    set {_second} to -1
    set {_w} to "none"
    loop {-bg::teams::*}:
        set {_s} to {-bg::score::%loop-value%} ? 0
        if {_s} > {_best}:
            set {_second} to {_best}
            set {_best} to {_s}
            set {_w} to loop-value
        else if {_s} > {_second}:
            set {_second} to {_s}
    if {_best} - {_second} >= 100:
        return {_w}
    return "none"

function bgStop(reason: text):
    if {-bg::on} is not true:
        stop
    set {-bg::on} to false
    bgBossRemove()
    bgCoreReset()
    bgRewardClear()
    bgCmd("function bg:tele/clear_all")
    set {_best} to -1
    set {_win} to "none"
    loop {-bg::teams::*}:
        if {-bg::score::%loop-value%} > {_best}:
            set {_best} to {-bg::score::%loop-value%}
            set {_win} to loop-value
    bgTitle("%{-bg::tcol::%{_win}%}%&l%{-bg::tname::%{_win}%}% 팀 승리!", "&f%{_reason}% · %{_best}%점", 10, 100, 20)
    bgSound("ui.toast.challenge_complete", 1, 1)
    bgSay("&e%{_reason}%&f — %{-bg::tcol::%{_win}%}%%{-bg::tname::%{_win}%}% 팀&f 승리 (%{_best}%점)")
    loop {-bg::teams::*}:
        bgSay("  %{-bg::tcol::%loop-value%}%%{-bg::tname::%loop-value%}%&f : %{-bg::score::%loop-value%}%점")
    # 자유 팀 선택은 판마다 꺼짐 (관리자가 /자유팀선택 으로 다시 켬)
    delete {-bg::freeteam}
    wait 5 seconds
    if {-bg::on} is not true:
        bgHudRemove()
        # 게임 끝: 코인 · 산 장비 · 전설 무기 초기화
        delete {bg::coin::*}
        delete {bg::owned::*}
        loop all players:
            bgToLobby(loop-player)

function bgCheckEnd():
    loop {-bg::teams::*}:
        if {-bg::score::%loop-value%} >= {bg::cfg::goal}:
            bgStop("목표 점수 달성")
            stop
    if {-bg::sec} >= {bg::cfg::minutes} * 60:
        bgStop("시간 종료")

function bgAddScore(t: text, n: number):
    if {_t} is "none":
        stop
    # 소수점(따라잡기 1.5배)은 모아 두었다가 정수만 점수에
    add {_n} to {-bg::sfrac::%{_t}%}
    set {_w} to floor({-bg::sfrac::%{_t}%})
    remove {_w} from {-bg::sfrac::%{_t}%}
    add {_w} to {-bg::score::%{_t}%}

# ─────────────────────────────────────────────────────────── 매초
every 1 second:
    {-bg::on} is true
    add 1 to {-bg::sec}
    loop {-bg::pts::*}:
        bgCapturePoint(loop-value)
    loop {-bg::pts::*}:
        set {_o} to {-bg::own::%loop-value%}
        if {_o} is not "none":
            bgAddScore({_o}, {-bg::ptscore::%loop-value%} * bgCatchup({_o}))
    bgBuffTick()
    bgBaseGuard()
    bgClassPads()
    bgBossClock()
    bgCheckEnd()

# ─────────────────────────────────────────────────────────── 점령
function bgCapturePoint(p: text):
    set {_c} to bgMk({-bg::ptmk::%{_p}%})
    set {_r} to {-bg::ptr::%{_p}%}
    set {_present} to 0
    set {_who} to "none"
    loop {-bg::teams::*}:
        set {_n::%loop-value%} to 0
    loop all players:
        if bgIsFighter(loop-player) is true:
            if world of loop-player is world of {_c}:
                if bgDist2(location of loop-player, {_c}) <= {_r}:
                    if abs((y-coordinate of loop-player) - (y-coordinate of {_c})) < 7:
                        add 1 to {_n::%bgTeam(loop-player)%}
                        add loop-player to {_on::*}
    loop {-bg::teams::*}:
        if {_n::%loop-value%} > 0:
            add 1 to {_present}
            set {_who} to loop-value
    set {-bg::contest::%{_p}%} to false
    set {_own} to {-bg::own::%{_p}%}
    set {_capt} to {-bg::capt::%{_p}%}
    set {_v} to {-bg::capv::%{_p}%}
    if {_present} >= 2:
        set {-bg::contest::%{_p}%} to true
        loop {_on::*}:
            send action bar "&c⚔ %{-bg::ptname::%{_p}%}% 쟁탈 중 — 다른 팀을 몰아내세요" to loop-value
        stop
    if {_present} is 0:
        if {_own} is not "none":
            set {-bg::capt::%{_p}%} to {_own}
            set {-bg::capv::%{_p}%} to min(100, {_v} + 5)
        else:
            set {-bg::capv::%{_p}%} to max(0, {_v} - 2)
        stop
    # 한 팀만 있음
    set {_k} to {_n::%{_who}%}
    if {_p} is "temple":
        # 중앙 성소는 오래 걸린다 (혼자 약 29초)
        set {_rate} to min(10, 3.5 + 2 * ({_k} - 1))
    else:
        # 제단은 1.5배 빠르게 (혼자 약 9초)
        set {_rate} to min(30, 12 + 6 * ({_k} - 1))
    if {_capt} is not {_who}:
        if {_v} > 0:
            # 남이 점령한 지점을 빼앗을 때는 1.6배 느리게 (빼앗고 뺏기는 난장판 완화)
            if {_own} is not "none":
                set {_rate} to {_rate} / 1.6
            set {_v} to max(0, {_v} - {_rate})
            if {_v} is 0:
                if {_own} is not "none":
                    set {-bg::own::%{_p}%} to "none"
                    bgSay("%{-bg::tcol::%{_own}%}%%{-bg::tname::%{_own}%}% 팀&f이 &e%{-bg::ptname::%{_p}%}%&f 을 잃었습니다!")
                    bgSoundAt({_c}, "block.beacon.deactivate", 3, 1)
                    bgPointVisual({_p}, "none")
                set {_capt} to {_who}
        else:
            set {_capt} to {_who}
    else if {_own} is not {_who}:
        set {_v} to min(100, {_v} + {_rate})
        if {_v} >= 100:
            set {-bg::own::%{_p}%} to {_who}
            bgSay("%{-bg::tcol::%{_who}%}%%{-bg::tname::%{_who}%}% 팀&f이 &e%{-bg::ptname::%{_p}%}%&f 을 점령했습니다!")
            bgSoundAt({_c}, "block.beacon.activate", 3, 1)
            bgSound("block.bell.use", 0.5, 1.4)
            bgPointVisual({_p}, {_who})
            bgCoinTeam({_who}, 15, "점령")
    else:
        set {_v} to min(100, {_v} + {_rate})
    set {-bg::capt::%{_p}%} to {_capt}
    set {-bg::capv::%{_p}%} to {_v}
    set {_bar} to bgGauge({_v})
    loop {_on::*}:
        if {_own} is {_who}:
            send action bar "%{-bg::tcol::%{_who}%}%%{-bg::ptname::%{_p}%}% &7방어 중 %{_bar}%" to loop-value
        else:
            send action bar "&e%{-bg::ptname::%{_p}%}% &f점령 중 %{_bar}% &e%floor({_v})%%%" to loop-value

function bgGauge(v: number) :: text:
    set {_f} to floor({_v} / 10)
    set {_s} to "&a"
    loop 10 times:
        if loop-number is {_f} + 1:
            set {_s} to "%{_s}%&8"
        set {_s} to "%{_s}%▮"
    return {_s}

# 점령 표시: 제단 위 점령 링 (리소스팩 deco/cap_ring_<팀>) 교체 · 불꽃 입자
function bgPointVisual(p: text, t: text):
    set {_c} to bgMk({-bg::ptmk::%{_p}%})
    set {_m} to "neutral"
    if {_t} is not "none":
        set {_m} to {_t}
    bgCmd("execute as @e[type=item_display,tag=bg_cap_%{_p}%] run data modify entity @s item.components.""minecraft:item_model"" set value ""bg:deco/cap_ring_%{_m}%""")
    bgParticle({_c}, "firework", 2, 3, 2, 0.1, 60)

# ─────────────────────────────────────────────────────────── 버프
function bgBuffTick():
    if {-bg::own::ares} is not "none":
        bgCmd("effect give @a[team=bg_%{-bg::own::ares}%,gamemode=!spectator] strength 3 0 true")
    if {-bg::own::athena} is not "none":
        bgCmd("effect give @a[team=bg_%{-bg::own::athena}%,gamemode=!spectator] resistance 3 0 true")
    if {-bg::own::hermes} is not "none":
        bgCmd("effect give @a[team=bg_%{-bg::own::hermes}%,gamemode=!spectator] speed 3 0 true")
    if {-bg::own::demeter} is not "none":
        if mod({-bg::sec}, 2) is 0:
            loop all players:
                if bgTeam(loop-player) is {-bg::own::demeter}:
                    if bgIsFighter(loop-player) is true:
                        heal loop-player by 0.5
                        set food level of loop-player to 20
    # 보스 축복 (a40)
    loop {-bg::teams::*}:
        if {-bg::bless::%loop-value%::until} is set:
            if {-bg::bless::%loop-value%::until} > {-bg::sec}:
                bgBlessApply(loop-value, {-bg::bless::%loop-value%::boss})
            else:
                delete {-bg::bless::%loop-value%::until}
                bgSay("%{-bg::tcol::%loop-value%}%%{-bg::tname::%loop-value%}% 팀&f의 보스 축복이 끝났습니다.")

# ─────────────────────────────────────────────────────────── 부활 · 병과
function bgBaseSpawnLoc(t: text) :: location:
    set {_i} to random integer between 0 and 6
    set {_n} to "base_%{_t}%_spawn_%{_i}%"
    set {_l} to bgMk({_n})
    if {-bg::mk::%{_n}%::yaw} is set:
        set yaw of {_l} to {-bg::mk::%{_n}%::yaw}
    return {_l}

function bgSpawn(p: player):
    set {_t} to bgTeam({_p})
    if {_t} is "none":
        stop
    set gamemode of {_p} to survival
    teleport {_p} to bgBaseSpawnLoc({_t})
    heal {_p}
    set food level of {_p} to 20
    bgKit({_p})
    bgCmd("effect give %name of {_p}% resistance 3 4 true")

function bgKit(p: player):
    set {_n} to name of {_p}
    set {_t} to bgTeam({_p})
    set {_c} to 0
    if {bg::cls::%uuid of {_p}%} is set:
        set {_c} to {bg::cls::%uuid of {_p}%}
    bgCmd("clear %{_n}%")
    bgCmd("effect clear %{_n}%")
    # 시작 장비는 약하게 (팀 색 가죽) — 좋은 장비는 상점에서 코인으로. 병과는 바지로만 구분
    bgCmd("item replace entity %{_n}% armor.head with leather_helmet[dyed_color=%{-bg::hex::%{_t}%}%,unbreakable={},enchantments={""minecraft:binding_curse"":1}]")
    bgCmd("item replace entity %{_n}% armor.chest with leather_chestplate[dyed_color=%{-bg::hex::%{_t}%}%,unbreakable={},enchantments={""minecraft:binding_curse"":1}]")
    bgCmd("item replace entity %{_n}% armor.feet with leather_boots[dyed_color=%{-bg::hex::%{_t}%}%,unbreakable={},enchantments={""minecraft:binding_curse"":1}]")
    bgClassGear({_p}, {_c})
    bgCmd("give %{_n}% bread 8")
    bgCmd("give %{_n}% compass[custom_name={text:""지휘 나침반"",color:""aqua"",bold:true,italic:false},lore=[{text:""우클릭: 공격 지점 · 웅크리고 우클릭: 방어 지점 (팀에게 표시)"",color:""gray"",italic:false}],enchantments={""minecraft:binding_curse"":1}] 1")
    bgCmd("give %{_n}% iron_pickaxe[unbreakable={},enchantments={""minecraft:binding_curse"":1},custom_name={text:""광부의 곡괭이"",color:""gold"",italic:false},lore=[{text:""본진 광석 바위 · 맵 곳곳 광맥을 캐서 상점에 팔기"",color:""gray"",italic:false}]]")
    bgShopRestore({_p})

# 병과 장비: 바지 + 기본 무기 (다른 갑옷 · 산 물건은 건드리지 않음)
#  전사 = 사슬 바지 · 돌 검 · 활 · 화살 8   궁수 = 팀 색 가죽 바지 · 나무 검 · 활 · 화살 24   수호자 = 철 바지 · 돌 도끼
# 병과 능력치 (속성) — 병과를 바꾸거나 부활할 때 적용, 대기실로 가면 기본값
#  전사   : 체력 12칸 · 공격력 +2 · 공격 속도 +10%
#  궁수   : 체력 9칸  · 이동 속도 +15% · 낙하 피해 줄음 · 점프 조금 높음
#  수호자 : 체력 14칸 · 방어 +3 · 넉백 저항 50% · 이동 속도 -8%
function bgClassStats(p: player, c: number):
    set {_n} to name of {_p}
    set {_hp} to 24
    set {_atk} to 3
    set {_spd} to 0.1
    set {_armor} to 0
    set {_kb} to 0
    set {_aspd} to 4.4
    set {_fall} to 3
    set {_jump} to 0.42
    if {_c} is 1:
        set {_hp} to 18
        set {_atk} to 1
        set {_spd} to 0.115
        set {_aspd} to 4
        set {_fall} to 7
        set {_jump} to 0.48
    else if {_c} is 2:
        set {_hp} to 28
        set {_atk} to 1
        set {_spd} to 0.092
        set {_armor} to 3
        set {_kb} to 0.5
        set {_aspd} to 4
    bgCmd("attribute %{_n}% minecraft:max_health base set %{_hp}%")
    bgCmd("attribute %{_n}% minecraft:attack_damage base set %{_atk}%")
    bgCmd("attribute %{_n}% minecraft:movement_speed base set %{_spd}%")
    bgCmd("attribute %{_n}% minecraft:armor base set %{_armor}%")
    bgCmd("attribute %{_n}% minecraft:knockback_resistance base set %{_kb}%")
    bgCmd("attribute %{_n}% minecraft:attack_speed base set %{_aspd}%")
    bgCmd("attribute %{_n}% minecraft:safe_fall_distance base set %{_fall}%")
    bgCmd("attribute %{_n}% minecraft:jump_strength base set %{_jump}%")
    if health of {_p} > {_hp} / 2:
        set health of {_p} to {_hp} / 2

# 기본 능력치로 (대기실 · 연습장 · 게임 끝)
function bgClassReset(p: player):
    set {_n} to name of {_p}
    bgCmd("attribute %{_n}% minecraft:max_health base set 20")
    bgCmd("attribute %{_n}% minecraft:attack_damage base set 1")
    bgCmd("attribute %{_n}% minecraft:movement_speed base set 0.1")
    bgCmd("attribute %{_n}% minecraft:armor base set 0")
    bgCmd("attribute %{_n}% minecraft:knockback_resistance base set 0")
    bgCmd("attribute %{_n}% minecraft:attack_speed base set 4")
    bgCmd("attribute %{_n}% minecraft:safe_fall_distance base set 3")
    bgCmd("attribute %{_n}% minecraft:jump_strength base set 0.42")

function bgClassGear(p: player, c: number):
    bgClassStats({_p}, {_c})
    set {_n} to name of {_p}
    set {_t} to bgTeam({_p})
    if {_c} is 0:
        bgCmd("item replace entity %{_n}% armor.legs with chainmail_leggings[unbreakable={},enchantments={""minecraft:binding_curse"":1},trim=%bgTrim({_p})%]")
        bgCmd("give %{_n}% stone_sword[unbreakable={},enchantments={""minecraft:binding_curse"":1}]")
        bgCmd("give %{_n}% bow[unbreakable={},enchantments={""minecraft:binding_curse"":1}]")
        bgCmd("give %{_n}% arrow 8")
    else if {_c} is 1:
        bgCmd("item replace entity %{_n}% armor.legs with leather_leggings[dyed_color=%{-bg::hex::%{_t}%}%,unbreakable={},enchantments={""minecraft:binding_curse"":1}]")
        bgCmd("give %{_n}% wooden_sword[unbreakable={},enchantments={""minecraft:binding_curse"":1}]")
        bgCmd("give %{_n}% bow[unbreakable={},enchantments={""minecraft:binding_curse"":1}]")
        bgCmd("give %{_n}% arrow 24")
    else:
        bgCmd("item replace entity %{_n}% armor.legs with iron_leggings[unbreakable={},enchantments={""minecraft:binding_curse"":1},trim=%bgTrim({_p})%]")
        bgCmd("give %{_n}% stone_axe[unbreakable={},enchantments={""minecraft:binding_curse"":1}]")

# 병과 바꾸기: 예전 병과의 기본 무기 · 화살만 빼고 새 병과 것을 준다
function bgClassSwitch(p: player, c: number):
    set {_n} to name of {_p}
    bgCmd("clear %{_n}% stone_sword")
    bgCmd("clear %{_n}% wooden_sword")
    bgCmd("clear %{_n}% stone_axe")
    bgCmd("clear %{_n}% bow")
    bgCmd("clear %{_n}% arrow")
    bgCmd("effect clear %{_n}% slowness")
    bgClassGear({_p}, {_c})

# 본진의 병과 발판 (base_<팀>_class_0..2) 위에 서면 병과 변경
function bgClassPads():
    loop all players:
        set {_t} to bgTeam(loop-player)
        if bgIsFighter(loop-player) is true:
            loop 3 times:
                set {_i} to loop-number - 1
                set {_m} to "base_%{_t}%_class_%{_i}%"
                if {-bg::mk::%{_m}%::x} is set:
                    if bgDist2(location of loop-player, bgMk({_m})) < 1.6:
                        if {bg::cls::%uuid of loop-player%} is not {_i}:
                            set {bg::cls::%uuid of loop-player%} to {_i}
                            # 바지와 기본 무기만 바뀐다 (다른 갑옷 · 음식 · 산 물건은 그대로)
                            bgClassSwitch(loop-player, {_i})
                            send title "&6%{-bg::cls::%{_i}%}%" with subtitle "%{-bg::clsdesc::%{_i}%}%" to loop-player for 40 ticks
                            play sound "block.anvil.use" to loop-player

# 본진 보호: 적 팀이 본진 안쪽(16칸)에 들어오면 초당 2칸 피해. 자기 본진에서는 회복
function bgBaseGuard():
    loop all players:
        if bgIsFighter(loop-player) is true:
            set {_me} to bgTeam(loop-player)
            loop {-bg::teams::*}:
                set {_b} to bgMk("base_%loop-value-2%")
                if world of loop-player is world of {_b}:
                    if bgDist2(location of loop-player, {_b}) < 16:
                        if loop-value-2 is {_me}:
                            heal loop-player by 0.5
                        else if bgWardOn(loop-player) is true:
                            send action bar "&b결계 부적이 %{-bg::tname::%loop-value-2%}% 팀의 수호 결계를 막는 중" to loop-player
                        else:
                            damage loop-player by 2
                            send action bar "&c%{-bg::tname::%loop-value-2%}% 팀 본진의 수호 결계! 물러나세요 &7(상점: 결계 부적)" to loop-player

on death of player:
    {-bg::on} is true
    bgTeam(victim) is not "none"
    # 죽으면 특수무기 재사용 대기 초기화 (부활하면 바로 쓸 수 있음 — 화면 표시와 실제를 맞춤)
    delete {-bg::wcd::%uuid of victim%::*}
    # 아무것도 떨어뜨리지 않음 — 전설 무기 · 산 장비는 부활할 때 다시 받는다 (bgKit → bgShopRestore)
    # 복사 방지: 죽는 순간 '가방에 실제로 들고 있던' 전설 무기만 부활 때 돌려준다
    #  (버렸거나 상자에 넣어 둔 것은 돌려주지 않음 — 그건 바닥/상자에 그대로 있으니까)
    # 전설 무기 · 캔 광물은 그 자리에 떨어뜨린다 (약탈 — 주운 사람이 쓸 수 있음, 부활 때 돌려주지 않음)
    loop {-bg::w::all::*}:
        delete {bg::owned::%uuid of victim%::%loop-value%}
    loop drops:
        if bgIsLegend(loop-item) is not "":
            add loop-item to {_ores::*}
            send "&c[전장] &f전설 무기 &6%{-bg::w::%bgIsLegend(loop-item)%::name}%&f 을(를) 떨어뜨렸습니다!" to victim
        else if bgOreVal(loop-item) > 0:
            add loop-item to {_ores::*}
    clear drops
    if size of {_ores::*} > 0:
        drop {_ores::*} at location of victim
    if attacker is a player:
        if bgTeam(attacker) is not bgTeam(victim):
            if bgTeam(attacker) is not "none":
                # 앞서가는 팀을 잡으면 현상금 (점수 +15), 뒤처진 팀은 처치 점수 1.5배
                set {_ks} to 10 * bgCatchup(bgTeam(attacker))
                if bgLeader() is bgTeam(victim):
                    set {_ks} to {_ks} + 5
                bgAddScore(bgTeam(attacker), {_ks})
                set death message to "%{-bg::tcol::%bgTeam(attacker)%}%%name of attacker% &7⚔ %{-bg::tcol::%bgTeam(victim)%}%%name of victim%"
                stop
    set death message to "%{-bg::tcol::%bgTeam(victim)%}%%name of victim% &7쓰러짐"

on respawn:
    {-bg::on} is true
    bgTeam(player) is not "none"
    set respawn location to bgBaseSpawnLoc(bgTeam(player))
    wait 1 tick
    # 부활 대기 (기본 5초, /전장 리스폰 <초>) — 그동안 관전 모드
    set {_d} to {bg::cfg::respawn} ? 5
    if {_d} > 0:
        set gamemode of player to spectator
        loop {_d} times:
            send title "&c&l쓰러짐" with subtitle "&f%{_d} - loop-number + 1%초 뒤 부활" to player for 25 ticks
            wait 1 second
            if player is not online:
                stop
            if {-bg::on} is not true:
                stop
        set gamemode of player to survival
        teleport player to bgBaseSpawnLoc(bgTeam(player))
        heal player
    bgKit(player)
    bgCmd("effect give %name of player% resistance 3 4 true")

on join:
    wait 2 ticks
    if {-bg::on} is true:
        if bgTeam(player) is not "none":
            bgCmd("team join bg_%bgTeam(player)% %name of player%")
            bgSpawn(player)

# 맵 밖으로 나가기 방지 (경계 벽 + 혹시 넘어가면 본진으로)
every 10 ticks:
    {-bg::on} is true
    loop all players:
        if bgIsFighter(loop-player) is true:
            set {_lx} to (x-coordinate of loop-player) - {bg::cfg::ox}
            set {_lz} to (z-coordinate of loop-player) - {bg::cfg::oz}
            set {_ly} to (y-coordinate of loop-player) - {bg::cfg::oy}
            set {_out} to false
            if {_lx} < 1:
                set {_out} to true
            if {_lx} > 255:
                set {_out} to true
            if {_lz} < 1:
                set {_out} to true
            if {_lz} > 255:
                set {_out} to true
            if {_ly} < 2:
                set {_out} to true
            if {_ly} > 110:
                set {_out} to true
            if {_out} is true:
                teleport loop-player to bgBaseSpawnLoc(bgTeam(loop-player))
                send action bar "&c전장 밖으로는 나갈 수 없습니다" to loop-player

# 맵 보호 (게임 중 참가자)
on break:
    bgIsFighter(player) is true
    cancel event

on place:
    bgIsFighter(player) is true
    cancel event

on bucket empty:
    bgIsFighter(player) is true
    cancel event

# ─────────────────────────────────────────────────────────── 명령
command /전장 [<text>] [<text>] [<text>] [<text>]:
    aliases: /bg
    permission: op
    trigger:
        if arg-1 is not set:
            send "&6[전장] &f/전장 건설 (내 위치) | 건설 원점 | 장식 | 광석바위 | 맵패치 | 연습장건설 | 원점 x y z | 월드 이름 | 팀 <플레이어> <red|blue|green|yellow|none>"
            send "&6[전장] &f/전장 자동팀 | 시작 | 종료 | 보스 [talos|sphinx|ladon|cyclops] | 보스제거"
            send "&6[전장] &f/전장 코인 <플레이어|all> <n> | 점수 <팀> <n> | 목표 <n> | 시간 <분> | 이동 <마커>"
            stop
        if arg-1 is "건설":
            # 기본: 명령을 친 사람이 서 있는 곳이 맵 한가운데(대전 앞 광장) 지면이 된다.  '/전장 건설 원점' = 저장된 원점 그대로
            if arg-2 is not "원점":
                if sender is a player:
                    set {_l} to location of player
                    set {bg::cfg::world} to name of world of player
                    set {bg::cfg::ox} to floor(x-coordinate of {_l}) - 128
                    set {bg::cfg::oz} to floor(z-coordinate of {_l}) - 128
                    set {bg::cfg::oy} to floor(y-coordinate of {_l}) - 25
                    send "&6[전장] &f지금 서 있는 곳을 맵 중심으로 짓습니다 (256×256, 원점 %{bg::cfg::ox}% %{bg::cfg::oy}% %{bg::cfg::oz}%)"
            bgSyncOrigin()
            bgCmd("function bg:map/build/start")
            bgSay("맵 건설을 시작합니다 (수십 초 걸립니다).")
        else if arg-1 is "로비":
            bgToLobby(player)
        else if arg-1 is "경계":
            bgSyncOrigin()
            bgCmd("function bg:map/border with storage bg:map origin")
            send "&6[전장] &f맵 경계 벽(보이지 않는 벽)을 세웠습니다."
        else if arg-1 is "진단":
            bgDiag(player)
        else if arg-1 is "보스바시험":
            bgHudTest(player)
        else if arg-1 is "장식":
            bgSyncOrigin()
            # 장식 = 디스플레이 · NPC · 코어 표시 같은 '엔티티'만 다시 소환 (블록은 건드리지 않음 → 직접 고친 맵 안전)
            bgCmd("function bg:map/decor")
            send "&6[전장] &f장식(디스플레이 · 상인 · 코어)을 다시 배치했습니다. &7블록은 건드리지 않습니다."
        else if arg-1 is "광석바위":
            # 본진 광석 바위 (블록을 덮어씀 — 그 자리 5x5 만)
            bgSyncOrigin()
            send "&6[전장] &e광석 놓는 중... &7(본진 바위 + 맵 곳곳 광맥 40곳)"
            bgCmd("function bg:map/ores_fl")
            wait 40 ticks
            bgCmd("function bg:map/ores")
            wait 5 ticks
            bgCmd("function bg:map/ores_rm")
            send "&6[전장] &f본진 광석 바위 + 맵 곳곳 광맥을 놓았습니다. &7(그 자리 블록을 덮어씀)"
        else if arg-1 is "광석삭제":
            # 막대로 놓은 광석 바위 + 데이터팩으로 놓은 광석(본진 바위 · 맵 광맥) 전부 지우고 원래 지형으로
            delete {bg::oreq::*}
            set {_n} to 0
            loop {bg::oreb::*}:
                bgOreBoulderRemove(loop-index)
                add 1 to {_n}
            bgSyncOrigin()
            send "&6[전장] &e광석 지우는 중... &7(막대 바위 %{_n}%개 + 본진 바위 · 맵 광맥)"
            bgCmd("function bg:map/ores_fl")
            wait 40 ticks
            bgCmd("function bg:map/ores_clear")
            wait 5 ticks
            bgCmd("function bg:map/ores_rm")
            send "&6[전장] &f광석을 전부 지웠습니다. &7(원래 지형으로 되돌림)"
        else if arg-1 is "맵패치":
            # 예전 광산 자리 원래 지형으로 + 갇히는 곳 사다리 (블록을 덮어씀 — 한 번만)
            bgSyncOrigin()
            send "&6[전장] &e맵 패치 중... &7(예전 광산 자리 8곳 원래 지형으로 · 갇히는 곳 사다리 · 메우기)"
            bgCmd("function bg:map/patch_fl")
            wait 40 ticks
            bgCmd("function bg:map/patch")
            wait 5 ticks
            bgCmd("function bg:map/patch_rm")
            send "&6[전장] &f맵 패치 완료."
        else if arg-1 is "원점":
            set {bg::cfg::ox} to arg-2 parsed as integer
            set {bg::cfg::oy} to arg-3 parsed as integer
            set {bg::cfg::oz} to arg-4 parsed as integer
            bgSyncOrigin()
            send "&6[전장] &f원점 = %{bg::cfg::ox}% %{bg::cfg::oy}% %{bg::cfg::oz}%"
        else if arg-1 is "월드":
            set {bg::cfg::world} to arg-2
            send "&6[전장] &f월드 = %arg-2%"
        else if arg-1 is "팀":
            set {_p} to arg-2 parsed as player
            if {_p} is not set:
                send "&c플레이어를 찾을 수 없습니다."
                stop
            if {-bg::tname::%arg-3%} is not set:
                if arg-3 is not "none":
                    send "&c팀: red / blue / green / yellow / none"
                    stop
            bgSetupTeams()
            bgSetTeam({_p}, arg-3)
        else if arg-1 is "자동팀":
            bgSetupTeams()
            set {_i} to 0
            loop all players:
                if gamemode of loop-player is not spectator:
                    set {_t} to {-bg::teams::%mod({_i}, 4) + 1%}
                    bgSetTeam(loop-player, {_t})
                    add 1 to {_i}
            bgSay("%{_i}%명을 네 팀으로 나눴습니다.")
        else if arg-1 is "시작":
            bgStart()
        else if arg-1 is "종료":
            bgStop("관리자 종료")
        else if arg-1 is "보스":
            set {_b} to arg-2
            if {_b} is not set:
                set {_b} to random element out of {-bg::bd::list::*}
            if {-bg::bd::%{_b}%::name} is not set:
                send "&c보스: talos / sphinx / ladon / cyclops"
                stop
            bgBossSpawn({_b})
        else if arg-1 is "보스제거":
            bgBossRemove()
        else if arg-1 is "코인":
            # /전장 코인 <플레이어|all> <수>  (음수면 뺌)
            set {_n} to arg-3 parsed as integer
            if {_n} is not set:
                send "&c사용법: /전장 코인 <플레이어|all> <수>"
                stop
            if arg-2 is "all":
                loop all players:
                    add {_n} to {bg::coin::%uuid of loop-player%}
                    send "&6[코인] &f관리자가 &e%{_n}%&f 코인을 줬습니다 (보유 %{bg::coin::%uuid of loop-player%}%)" to loop-player
                send "&6[전장] &f모든 플레이어에게 %{_n}% 코인"
                stop
            set {_p} to arg-2 parsed as player
            if {_p} is not set:
                send "&c플레이어를 찾을 수 없습니다."
                stop
            add {_n} to {bg::coin::%uuid of {_p}%}
            send "&6[코인] &f관리자가 &e%{_n}%&f 코인을 줬습니다 (보유 %{bg::coin::%uuid of {_p}%}%)" to {_p}
            send "&6[전장] &f%name of {_p}% 코인 %{_n}% → 보유 %{bg::coin::%uuid of {_p}%}%"
        else if arg-1 is "리스폰":
            set {bg::cfg::respawn} to arg-2 parsed as integer
            send "&6[전장] &f부활 대기 = %{bg::cfg::respawn}%초"
        else if arg-1 is "연습장비우기":
            set {_n} to 0
            loop all players:
                if {-bg::pvp::%uuid of loop-player%} is true:
                    bgPvpLeave(loop-player)
                    add 1 to {_n}
            send "&6[전장] &f연습장에 있던 %{_n}%명을 대기실로 보냈습니다."
        else if arg-1 is "팩":
            # /전장 팩 켬|끔|자동 — 왕관 쟁탈전 리소스팩을 이 스크립트가 보낼지 (Nexo 등과 같이 쓸 때는 끔)
            if arg-2 is "켬":
                set {bg::cfg::packsend} to "on"
            else if arg-2 is "끔":
                set {bg::cfg::packsend} to "off"
            else:
                delete {bg::cfg::packsend}
            set {_m} to "자동 (Nexo 있으면 끔)"
            if {bg::cfg::packsend} is set:
                set {_m} to {bg::cfg::packsend}
            send "&6[전장] &f리소스팩 보내기: &e%{_m}%"
        else if arg-1 is "연습장건설":
            bgPvpBuild(player)
        else if arg-1 is "무기":
            # /전장 무기 <무기id|all|boss> [플레이어]  (보스 전용 무기도 지급)
            if arg-2 is not set:
                send "&6[전장] &f/전장 무기 <id|all|boss> [플레이어]"
                send "&7무기 id: %join {-bg::w::all::*} with "", ""%"
                stop
            set {_p} to player
            if arg-3 is set:
                set {_p} to arg-3 parsed as player
            if {_p} is not set:
                send "&c플레이어를 찾을 수 없습니다."
                stop
            if arg-2 is "all":
                set {_ws::*} to {-bg::w::all::*}
            else if arg-2 is "boss":
                set {_ws::*} to {-bg::w::bosslist::*}
            else if {-bg::w::%arg-2%::name} is set:
                add arg-2 to {_ws::*}
            else:
                send "&c없는 무기 id: %arg-2% &7(%join {-bg::w::all::*} with "", ""%)"
                stop
            loop {_ws::*}:
                bgGiveWeapon({_p}, loop-value)
                if {-bg::on} is true:
                    set {bg::owned::%uuid of {_p}%::%loop-value%} to true
            send "&6[전장] &f%name of {_p}%에게 무기 %size of {_ws::*}%개 지급"
            send "&6[관리자] &f무기를 받았습니다: &e%join {_ws::*} with "", ""%" to {_p}
        else if arg-1 is "점수":
            set {-bg::score::%arg-2%} to arg-3 parsed as integer
        else if arg-1 is "목표":
            set {bg::cfg::goal} to arg-2 parsed as integer
            send "&6[전장] &f목표 점수 = %{bg::cfg::goal}%"
        else if arg-1 is "시간":
            set {bg::cfg::minutes} to arg-2 parsed as integer
            send "&6[전장] &f제한 시간 = %{bg::cfg::minutes}%분"
        else if arg-1 is "이동":
            if {-bg::mk::%arg-2%::x} is set:
                teleport player to bgMk(arg-2)
            else:
                send "&c마커 없음. 예: temple_core, altar_ares, lair_forge, base_red"
