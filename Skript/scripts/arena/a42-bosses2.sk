# ═════════════════════════════════════════════════════════════════════════════
#  신화쟁탈전 — 맵 전용 보스 4종 (보스마다 스킬 3개, 바닥 경고 → 게이지가 차면 판정)
#
#  빙하 왕국  서리 거인 이미르 (채석장)   빙하 붕괴(얼음 기둥 줄) · 눈사태(얼음 덩어리 낙하) · 절대 영도(바깥 고리 빙결 → 안쪽 폭발)
#            서리 늑대 펜리르 (정원)     서리 도약(사냥감에게 덮침) · 빙결 포효(앞 부채꼴 서리 숨) · 얼음 송곳니(모두의 발밑 얼음 가시)
#  화산 군도  화염 거인 수르트 (대장간)   멸망의 검(일직선 내려찍기 + 불길) · 화염 비(운석) · 라그나로크(불의 고리 세 겹)
#            지옥견 케르베로스 (모래 신전) 지옥 돌진(직선 돌진 + 불길) · 삼두 화염(세 방향 불 숨) · 용암 웅덩이(모두의 발밑)
#  어느 맵에서 어느 보스가 나오는지 = a09 {-bg::mapboss::<맵>::*}
#  모델 · 애니메이션 = arena/tools/rp/bosses/{ymir,fenrir,surtr,cerberus}.py (a03-gen-boss.sk 로 들어옴)
# ═════════════════════════════════════════════════════════════════════════════

on load:
    set {-bg::boss2::*} to "ymir", "fenrir", "surtr" and "cerberus"
    set {-bg::bskills::ymir::*} to "glacier", "avalanche" and "zero"
    set {-bg::bskills::fenrir::*} to "pounce", "frostbreath" and "fangs"
    set {-bg::bskills::surtr::*} to "doom", "meteor" and "ragnarok"
    set {-bg::bskills::cerberus::*} to "charge", "triflame" and "lavapool"
    set {-bg::bmelee::ymir} to "smash"
    set {-bg::bmelee::fenrir} to "bite"
    set {-bg::bmelee::surtr} to "smash"
    set {-bg::bmelee::cerberus} to "bite"
    set {-bg::breach::ymir} to 5.5
    set {-bg::breach::fenrir} to 5
    set {-bg::breach::surtr} to 6
    set {-bg::breach::cerberus} to 5
    set {-bg::bspd::ymir} to 0.22
    set {-bg::bspd::fenrir} to 0.32
    set {-bg::bspd::surtr} to 0.21
    set {-bg::bspd::cerberus} to 0.3
    set {-bg::blessname::ymir} to "만년설 갑옷 (저항 · 흡수)"
    set {-bg::blessname::fenrir} to "늑대의 질주 (신속 · 점프)"
    set {-bg::blessname::surtr} to "무스펠의 불꽃 (화염 저항 · 성급함)"
    set {-bg::blessname::cerberus} to "지옥문의 파수꾼 (적 전원 발광 · 화염 저항)"
    # 맵마다 나오는 보스 (나머지 두 투기장은 원래 보스)
    set {-bg::mapboss::olympus::*} to "talos", "sphinx", "ladon" and "cyclops"
    set {-bg::mapboss::frost::*} to "ymir", "fenrir", "talos" and "sphinx"
    set {-bg::mapboss::volcano::*} to "surtr", "cerberus", "ladon" and "cyclops"

function bgIsBoss2(id: text) :: boolean:
    if {-bg::boss2::*} contains {_id}:
        return true
    return false

# a40 bgBossSkill 에서 넘어옴
function bgBossSkill2(id: text, s: text, g: number):
    if {_id} is "ymir":
        if {_s} is "glacier":
            bgSkYmirGlacier({_g})
        else if {_s} is "avalanche":
            bgSkYmirAvalanche({_g})
        else:
            bgSkYmirZero({_g})
    else if {_id} is "fenrir":
        if {_s} is "pounce":
            bgSkFenrirPounce({_g})
        else if {_s} is "frostbreath":
            bgSkFenrirBreath({_g})
        else:
            bgSkFenrirFangs({_g})
    else if {_id} is "surtr":
        if {_s} is "doom":
            bgSkSurtrDoom({_g})
        else if {_s} is "meteor":
            bgSkSurtrMeteor({_g})
        else:
            bgSkSurtrRagnarok({_g})
    else:
        if {_s} is "charge":
            bgSkCerbCharge({_g})
        else if {_s} is "triflame":
            bgSkCerbTriflame({_g})
        else:
            bgSkCerbLava({_g})

# 기여도 보상 (a40 bgBossBuff 에서)
function bgBossBuff2(p: player, id: text):
    set {_n} to name of {_p}
    if {_id} is "ymir":
        bgCmd("effect give %{_n}% resistance 45 0 true")
        bgCmd("effect give %{_n}% absorption 60 1 true")
        send "&b  만년설의 힘 &7— 저항 I 45초 · 흡수 II 60초" to {_p}
    else if {_id} is "fenrir":
        bgCmd("effect give %{_n}% speed 45 1 true")
        bgCmd("effect give %{_n}% jump_boost 45 1 true")
        send "&b  늑대의 힘 &7— 신속 II · 점프 강화 II 45초" to {_p}
    else if {_id} is "surtr":
        bgCmd("effect give %{_n}% fire_resistance 60 0 true")
        bgCmd("effect give %{_n}% strength 30 0 true")
        send "&6  무스펠의 힘 &7— 화염 저항 60초 · 힘 I 30초" to {_p}
    else:
        bgCmd("effect give %{_n}% fire_resistance 60 0 true")
        bgCmd("effect give %{_n}% speed 45 0 true")
        bgCmd("effect give %{_n}% haste 45 1 true")
        send "&c  지옥견의 힘 &7— 화염 저항 60초 · 신속 I · 성급함 II 45초" to {_p}

# 3분 축복 (a40 bgBlessApply 에서, 매초)
function bgBlessApply2(t: text, b: text):
    set {_sel} to "@a[team=bg_%{_t}%,gamemode=!spectator]"
    if {_b} is "ymir":
        bgCmd("effect give %{_sel}% resistance 3 0 true")
        if mod({-bg::sec}, 10) is 0:
            bgCmd("effect give %{_sel}% absorption 10 0 true")
    else if {_b} is "fenrir":
        bgCmd("effect give %{_sel}% speed 3 0 true")
        bgCmd("effect give %{_sel}% jump_boost 3 0 true")
    else if {_b} is "surtr":
        bgCmd("effect give %{_sel}% fire_resistance 3 0 true")
        bgCmd("effect give %{_sel}% haste 3 1 true")
    else:
        bgCmd("effect give %{_sel}% fire_resistance 3 0 true")
        bgCmd("effect give @a[team=!bg_%{_t}%,team=!,gamemode=!spectator] glowing 3 0 true")

# ─────────────────────────────────────────────────────────── 도우미
# 하늘에서 블록 덩어리가 떨어짐 (t 틱 뒤 l 에 닿음)
function bgDropBlock(l: location, blk: text, s: number, t: number):
    set {_id} to "bgdrop%bgTid()%"
    set {_h} to 14
    bgCmd("execute in %bgDim()% run summon block_display %bgC(x-coordinate of {_l})% %bgN((y-coordinate of {_l}) + {_h})% %bgC(z-coordinate of {_l})% {Tags:[""bg"",""bgfx"",""%{_id}%""],block_state:{Name:""minecraft:%{_blk}%""},brightness:{sky:15,block:12},teleport_duration:%min(59, max(2, round({_t})))%,transformation:{left_rotation:[0.2f,0.3f,0.1f,0.92f],right_rotation:[0f,0f,0f,1f],translation:[%bgN({_s} / -2)%f,0f,%bgN({_s} / -2)%f],scale:[%bgN({_s})%f,%bgN({_s})%f,%bgN({_s})%f]}}")
    wait 2 ticks
    bgCmd("execute in %bgDim()% run tp @e[tag=%{_id}%,limit=1] %bgC(x-coordinate of {_l})% %bgN(y-coordinate of {_l})% %bgC(z-coordinate of {_l})%")
    wait bgTicks(max(1, {_t} - 2))
    bgParticle(bgUp({_l}, 0.5), "block{block_state:""minecraft:%{_blk}%""}", {_s} * 0.4, 0.4, {_s} * 0.4, 0.2, 30)
    wait 4 ticks
    bgCmd("kill @e[tag=%{_id}%]")

# 보스를 l 로 n 틱에 걸쳐 옮김 (돌진 · 도약)
function bgBossMoveTo(g: number, l: location, yaw: number, n: number):
    set {_a} to bgBossPos()
    loop {_n} times:
        if bgOk({_g}) is false:
            stop
        set {_f} to loop-number / {_n}
        set {_q} to location((x-coordinate of {_a}) + ((x-coordinate of {_l}) - (x-coordinate of {_a})) * {_f}, y-coordinate of {_a}, (z-coordinate of {_a}) + ((z-coordinate of {_l}) - (z-coordinate of {_a})) * {_f}, world of {_a})
        bgCmd("execute in %bgDim()% run tp %{-bg::boss::uuid}% %bgC(x-coordinate of {_q})% %bgN(y-coordinate of {_q})% %bgC(z-coordinate of {_q})% %bgN({_yaw})% 0")
        bgBossSync()
        wait 1 tick

# 투기장 안쪽으로 (집에서 maxr 안)
function bgInLair(l: location, maxr: number) :: location:
    set {_h} to {-bg::boss::home}
    set {_d} to bgDist2({_l}, {_h})
    if {_d} <= {_maxr}:
        return location(x-coordinate of {_l}, y-coordinate of {_h}, z-coordinate of {_l}, world of {_h})
    set {_k} to {_maxr} / {_d}
    return location((x-coordinate of {_h}) + ((x-coordinate of {_l}) - (x-coordinate of {_h})) * {_k}, y-coordinate of {_h}, (z-coordinate of {_h}) + ((z-coordinate of {_l}) - (z-coordinate of {_h})) * {_k}, world of {_h})

# 맞은 사람 얼리기 (얼음 껍질 + 구속)
function bgLateFreeze(g: number, c: location, r: number, t: number):
    wait bgTicks({_t})
    if bgOk({_g}) is false:
        stop
    set {_ps::*} to bgLairPlayers()
    loop {_ps::*}:
        if bgInCircle(loop-value, {_c}, {_r}) is true:
            bgFreezeShell(loop-value, 40)

# ═══════════════════════════════════════════════════════════ 서리 거인 이미르
# 빙하 붕괴: 검을 땅에 꽂으면 대상 쪽으로 얼음 기둥 줄 3개(격노 5) — 맞으면 구속
function bgSkYmirGlacier(g: number):
    set {_pos} to bgBossPos()
    set {_yaw} to bgAimYaw()
    bgBossFace({_yaw})
    set {_offs::*} to -30, 0 and 30
    if {-bg::boss::rage} is true:
        set {_offs::*} to -60, -30, 0, 30 and 60
    set {_t} to bgRT(34, 26)
    bgCastLen({_t} + 16)
    bgAnim("plunge")
    bgSoundAt({_pos}, "entity.player.hurt_freeze", 2, 0.5)
    loop {_offs::*}:
        set {_y} to {_yaw} + loop-value
        bgTRect({_pos}, {_y}, 3.5, 18, {_t})
        bgLateRect({_g}, {_pos}, {_y}, 3.5, 18, {_t}, 3.5, 0.3, 0.9, "frost", "slowness 3 2")
    wait bgTicks({_t})
    if bgOk({_g}) is false:
        stop
    bgSoundAt({_pos}, "block.glass.break", 3, 0.5)
    loop {_offs::*}:
        set {_y} to {_yaw} + loop-value
        loop 5 times:
            set {_j} to loop-number-2
            bgIceSpikes(bgOff({_pos}, {_y}, 3 + {_j} * 3, 0))
    bgSkillDone({_g}, 16)

# 눈사태: 하늘에서 얼음 덩어리 7개(격노 10) — 사람 발밑 + 아무 데나, 차례로 떨어짐
function bgSkYmirAvalanche(g: number):
    set {_n} to bgRage(7, 10)
    set {_t} to bgRT(30, 24)
    set {_gap} to 4
    bgCastLen(({_n} - 1) * {_gap} + {_t})
    bgAnim("raise")
    bgSoundAt(bgBossPos(), "entity.ravager.roar", 2, 0.6)
    set {_ps::*} to bgLairPlayers()
    set {_k} to 0
    loop {_n} times:
        if bgOk({_g}) is false:
            stop
        add 1 to {_k}
        set {_l} to bgRandLair(15)
        if {_k} <= size of {_ps::*}:
            set {_pp} to {_ps::%{_k}%}
            if {_pp} is online:
                set {_l} to bgInLair(location of {_pp}, 17)
        bgTCircle({_l}, 7, {_t})
        bgDropBlock({_l}, "packed_ice", 2.6, {_t})
        bgLateCircle({_g}, {_l}, 3.5, {_t}, 3.5, 0.8, 0.6, "frost", "slowness 2 1")
        wait bgTicks({_gap})
    bgSkillDone({_g}, {_t})

# 절대 영도: 바깥 고리가 먼저 얼고(빙결) → 안쪽이 폭발 — 안으로 들어갔다가 다시 나와야 산다
function bgSkYmirZero(g: number):
    set {_pos} to bgBossPos()
    set {_a} to bgRT(40, 32)
    set {_b} to {_a} + bgRT(26, 20)
    bgCastLen({_b} + 6)
    bgAnim("stomp")
    bgSoundAt({_pos}, "entity.player.hurt_freeze", 3, 0.4)
    bgTDonut({_pos}, 34, {_a})
    bgLateDonut({_g}, {_pos}, 6.5, 17, {_a}, 3, 0.2, 0.4, "frost", "slowness 4 3")
    bgLateFreeze({_g}, {_pos}, 17, {_a})
    wait bgTicks({_a})
    if bgOk({_g}) is false:
        stop
    bgAnim("raise")
    bgTCircle({_pos}, 13, {_b} - {_a})
    bgLateCircle({_g}, {_pos}, 6.5, {_b} - {_a}, 4.5, 1.6, 0.8, "frost", "")
    bgSkillDone({_g}, {_b} - {_a} + 6)

# ═══════════════════════════════════════════════════════════ 서리 늑대 펜리르
# 서리 도약: 대상이 있던 곳으로 덮침 (격노 두 번)
function bgSkFenrirPounce(g: number):
    set {_n} to bgRage(1, 2)
    set {_t} to bgRT(26, 20)
    bgCastLen({_n} * ({_t} + 12))
    loop {_n} times:
        if bgOk({_g}) is false:
            stop
        set {_p} to {-bg::boss::target}
        if {_p} is not set:
            exit loop
        set {_pos} to bgBossPos()
        set {_l} to bgInLair(location of {_p}, 16)
        set {_yaw} to bgYawTo({_pos}, {_l})
        bgBossFace({_yaw})
        bgTCircle({_l}, 9, {_t})
        bgAnim("pounce")
        bgSoundAt({_pos}, "entity.wolf.growl", 3, 0.5)
        bgLateCircle({_g}, {_l}, 4.5, {_t}, 3.5, 1.2, 0.7, "frost", "slowness 2 2")
        wait bgTicks({_t} - 5)
        if bgOk({_g}) is false:
            stop
        bgBossMoveTo({_g}, {_l}, {_yaw}, 5)
        wait 12 ticks
    bgSkillDone({_g}, 2)

# 빙결 포효: 앞 부채꼴 90° 서리 숨 (맞으면 얼음 껍질) — 격노 때 다른 사람 쪽으로 한 번 더
function bgSkFenrirBreath(g: number):
    set {_pos} to bgBossPos()
    set {_yaw} to bgAimYaw()
    bgBossFace({_yaw})
    set {_t} to bgRT(32, 26)
    set {_total} to {_t}
    if {-bg::boss::rage} is true:
        set {_total} to {_t} + 26
    bgCastLen({_total})
    bgAnim("breath")
    bgSoundAt({_pos}, "entity.wolf.howl", 3, 0.6)
    bgTCone({_pos}, {_yaw}, 90, 12, {_t})
    bgLateCone({_g}, {_pos}, {_yaw}, 90, 12, {_t}, 3, 0.8, 0.3, "frost", "slowness 4 2")
    wait bgTicks({_t})
    if bgOk({_g}) is false:
        stop
    set {_ps::*} to bgLairPlayers()
    loop {_ps::*}:
        if bgInCone(loop-value, {_pos}, {_yaw}, 90, 12) is true:
            bgFreezeShell(loop-value, 40)
    loop 8 times:
        bgParticle(bgOff(bgUp({_pos}, 2), {_yaw}, loop-number * 1.4, 0), "snowflake", loop-number * 0.4, 0.6, loop-number * 0.4, 0.05, 20)
    if {-bg::boss::rage} is true:
        set {_y2} to {_yaw} + 120
        if size of {_ps::*} > 1:
            set {_y2} to bgYawTo({_pos}, location of random element out of {_ps::*})
        bgBossFace({_y2})
        bgAnim("breath")
        bgTCone({_pos}, {_y2}, 90, 12, 22)
        bgLateCone({_g}, {_pos}, {_y2}, 90, 12, 22, 2.5, 0.8, 0.3, "frost", "slowness 3 2")
        bgSkillDone({_g}, 26)
        stop
    bgCastEnd()

# 얼음 송곳니: 투기장 안 모두의 발밑에서 얼음 가시 (격노 두 번째 물결)
function bgSkFenrirFangs(g: number):
    set {_t} to bgRT(30, 24)
    set {_w} to bgRage(1, 2)
    bgCastLen({_w} * ({_t} + 10))
    bgAnim("howl")
    bgSoundAt(bgBossPos(), "entity.wolf.howl", 3, 0.8)
    loop {_w} times:
        if bgOk({_g}) is false:
            stop
        set {_ps::*} to bgLairPlayers()
        loop {_ps::*}:
            set {_l} to location of loop-value-2
            bgTCircle({_l}, 5, {_t})
            bgLateCircle({_g}, {_l}, 2.5, {_t}, 3, 0.2, 1.1, "frost", "slowness 2 1")
            bgLateSpikes({_g}, {_l}, {_t})
        wait bgTicks({_t} + 10)
    bgSkillDone({_g}, 2)

function bgLateSpikes(g: number, l: location, t: number):
    wait bgTicks({_t})
    if bgOk({_g}) is false:
        stop
    bgIceSpikes({_l})

# ═══════════════════════════════════════════════════════════ 화염 거인 수르트
# 멸망의 검: 대상 쪽 넓은 일직선 내려찍기 (격노 때 양옆 두 줄 더) → 그 길에 불길 4초
function bgSkSurtrDoom(g: number):
    set {_pos} to bgBossPos()
    set {_yaw} to bgAimYaw()
    bgBossFace({_yaw})
    set {_t} to bgRT(40, 32)
    bgCastLen({_t} + 10)
    bgAnim("plunge")
    bgSoundAt({_pos}, "item.firecharge.use", 3, 0.5)
    bgTRect({_pos}, {_yaw}, 6, 20, {_t})
    bgLateRect({_g}, {_pos}, {_yaw}, 6, 20, {_t}, 4.5, 1.0, 0.8, "fire", "")
    if {-bg::boss::rage} is true:
        set {_sides::*} to -28 and 28
        loop {_sides::*}:
            bgTRect({_pos}, {_yaw} + loop-value, 3.5, 16, {_t})
            bgLateRect({_g}, {_pos}, {_yaw} + loop-value, 3.5, 16, {_t}, 3, 0.6, 0.6, "fire", "")
    wait bgTicks({_t})
    if bgOk({_g}) is false:
        stop
    strike lightning effect at bgOff({_pos}, {_yaw}, 10, 0)
    loop 4 times:
        set {_l} to bgOff({_pos}, {_yaw}, 3 + loop-number * 4, 0)
        add {_l} to {_locs::*}
        bgTDecal({_l}, "scorch", 5, 80, random number between 0 and 360)
    bgHazard({_g}, {_locs::*}, 2.5, 80, "fire")
    bgSkillDone({_g}, 10)

# 화염 비: 운석 6개(격노 9) — 사람 발밑 + 아무 데나, 떨어진 자리는 3초 불바닥
function bgSkSurtrMeteor(g: number):
    set {_n} to bgRage(6, 9)
    set {_t} to bgRT(34, 26)
    set {_gap} to 5
    bgCastLen(({_n} - 1) * {_gap} + {_t})
    bgAnim("raise")
    bgSoundAt(bgBossPos(), "entity.blaze.shoot", 3, 0.5)
    set {_ps::*} to bgLairPlayers()
    set {_k} to 0
    loop {_n} times:
        if bgOk({_g}) is false:
            stop
        add 1 to {_k}
        set {_l} to bgRandLair(15)
        if {_k} <= size of {_ps::*}:
            set {_pp} to {_ps::%{_k}%}
            if {_pp} is online:
                set {_l} to bgInLair(location of {_pp}, 17)
        bgTCircle({_l}, 7, {_t})
        bgDropBlock({_l}, "magma_block", 2.4, {_t})
        bgLateCircle({_g}, {_l}, 3.5, {_t}, 3.5, 0.8, 0.6, "fire", "")
        bgLateBurn({_g}, {_l}, {_t})
        wait bgTicks({_gap})
    bgSkillDone({_g}, {_t})

function bgLateBurn(g: number, l: location, t: number):
    wait bgTicks({_t})
    if bgOk({_g}) is false:
        stop
    bgTDecal({_l}, "scorch", 4, 60, random number between 0 and 360)
    add {_l} to {_one::*}
    bgHazard({_g}, {_one::*}, 2, 60, "fire")

# 라그나로크: 검을 들고 돌며 불의 고리가 안 → 밖 세 번 (격노 때 마지막에 한 번 더 안쪽)
function bgSkSurtrRagnarok(g: number):
    set {_pos} to bgBossPos()
    set {_a} to bgRT(28, 22)
    set {_b} to bgRT(40, 32)
    set {_c} to bgRT(52, 42)
    set {_end} to {_c}
    if {-bg::boss::rage} is true:
        set {_end} to {_c} + 20
    bgCastLen({_end})
    bgAnim("spin")
    bgSoundAt({_pos}, "entity.blaze.ambient", 3, 0.4)
    bgTCircle({_pos}, 11, {_a})
    bgTDonut({_pos}, 23, {_b})
    bgTDonut({_pos}, 35, {_c})
    bgLateCircle({_g}, {_pos}, 5.5, {_a}, 3.5, 0.6, 0.8, "fire", "")
    bgLateDonut({_g}, {_pos}, 5, 11.5, {_b}, 3.5, 0.6, 0.8, "fire", "")
    bgLateDonut({_g}, {_pos}, 7.7, 17.5, {_c}, 3.5, 0.6, 0.8, "fire", "")
    if {-bg::boss::rage} is true:
        wait bgTicks({_c})
        if bgOk({_g}) is false:
            stop
        bgTCircle({_pos}, 13, 20)
        bgLateCircle({_g}, {_pos}, 6.5, 20, 3.5, 1.4, 0.8, "fire", "")
        bgSkillDone({_g}, 20)
        stop
    bgSkillDone({_g}, {_c})

# ═══════════════════════════════════════════════════════════ 지옥견 케르베로스
# 지옥 돌진: 대상 쪽으로 벽까지 돌진 (폭 5) → 지나간 길에 불길 3초
function bgSkCerbCharge(g: number):
    set {_pos} to bgBossPos()
    set {_yaw} to bgAimYaw()
    bgBossFace({_yaw})
    set {_len} to 4
    loop 30 times:
        if bgDist2(bgOff({_pos}, {_yaw}, loop-number, 0), {-bg::boss::home}) > 17:
            exit loop
        set {_len} to loop-number
    set {_t} to bgRT(28, 22)
    bgCastLen({_t} + 10)
    bgTRect({_pos}, {_yaw}, 5, {_len}, {_t})
    bgAnim("pounce")
    bgSoundAt({_pos}, "entity.ravager.roar", 2, 1.2)
    wait bgTicks({_t})
    if bgOk({_g}) is false:
        stop
    bgAnim("bite")
    set {_ps::*} to bgLairPlayers()
    loop {_ps::*}:
        if bgInRect(loop-value, {_pos}, {_yaw}, 5, {_len}) is true:
            bgHit(loop-value, 3.5, {_pos}, 1.6, 0.6)
            bgIgnite(loop-value, 3)
    loop 8 times:
        set {_n} to bgOff({_pos}, {_yaw}, {_len} * loop-number / 8, 0)
        bgCmd("execute in %bgDim()% run tp %{-bg::boss::uuid}% %bgC(x-coordinate of {_n})% %bgN(y-coordinate of {_n})% %bgC(z-coordinate of {_n})% %bgN({_yaw})% 0")
        bgBossSync()
        bgParticle({_n}, "flame", 1, 0.3, 1, 0.03, 10)
        if mod(loop-number, 3) is 0:
            add {_n} to {_locs::*}
            bgTDecal({_n}, "scorch", 4, 60, random number between 0 and 360)
        wait 1 tick
        if bgOk({_g}) is false:
            stop
    bgImpact(bgBossPos(), 3, "fire", true)
    bgCastEnd()
    bgHazard({_g}, {_locs::*}, 2, 60, "fire")

# 삼두 화염: 세 머리가 세 방향으로 불 숨 (부채꼴 60°) — 격노 때 사이사이로 한 번 더
function bgSkCerbTriflame(g: number):
    set {_pos} to bgBossPos()
    set {_yaw} to bgAimYaw()
    bgBossFace({_yaw})
    set {_t} to bgRT(30, 24)
    set {_total} to {_t}
    if {-bg::boss::rage} is true:
        set {_total} to {_t} + 24
    bgCastLen({_total})
    bgAnim("breath")
    bgSoundAt({_pos}, "entity.blaze.shoot", 3, 0.6)
    set {_dirs::*} to -50, 0 and 50
    loop {_dirs::*}:
        bgTCone({_pos}, {_yaw} + loop-value, 60, 11, {_t})
        bgLateCone({_g}, {_pos}, {_yaw} + loop-value, 60, 11, {_t}, 3, 0.6, 0.3, "fire", "")
    wait bgTicks({_t})
    if bgOk({_g}) is false:
        stop
    set {_ps::*} to bgLairPlayers()
    loop {_ps::*}:
        set {_v} to loop-value
        loop {_dirs::*}:
            if bgInCone({_v}, {_pos}, {_yaw} + loop-value-2, 60, 11) is true:
                bgIgnite({_v}, 4)
    if {-bg::boss::rage} is true:
        bgAnim("breath")
        set {_mid::*} to -25 and 25
        loop {_mid::*}:
            bgTCone({_pos}, {_yaw} + loop-value, 60, 11, 22)
            bgLateCone({_g}, {_pos}, {_yaw} + loop-value, 60, 11, 22, 2.5, 0.6, 0.3, "fire", "")
        bgSkillDone({_g}, 24)
        stop
    bgCastEnd()

# 용암 웅덩이: 모두의 발밑에 용암이 끓어오름 (격노 때 아무 데나 3곳 더) → 4초 불바닥
function bgSkCerbLava(g: number):
    set {_t} to bgRT(30, 24)
    bgCastLen({_t} + 6)
    bgAnim("howl")
    bgSoundAt(bgBossPos(), "entity.wolf.growl", 3, 0.4)
    set {_ps::*} to bgLairPlayers()
    loop {_ps::*}:
        add bgInLair(location of loop-value, 17) to {_locs::*}
    if {-bg::boss::rage} is true:
        loop 3 times:
            add bgRandLair(14) to {_locs::*}
    loop {_locs::*}:
        bgTCircle(loop-value, 6, {_t})
        bgLateCircle({_g}, loop-value, 3, {_t}, 3, 0.2, 1.2, "fire", "")
    wait bgTicks({_t})
    if bgOk({_g}) is false:
        stop
    loop {_locs::*}:
        bgTDecal(loop-value, "scorch", 6, 80, random number between 0 and 360)
        bgParticle(bgUp(loop-value, 0.3), "lava", 1.2, 0.2, 1.2, 0, 10)
    bgHazard({_g}, {_locs::*}, 3, 80, "fire")
    bgSkillDone({_g}, 6)
