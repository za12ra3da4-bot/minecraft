# 자동 생성 — 신화 아케이드 허브 표지 좌표 (arena/tools/hubgen.py)
on load:
    set {-bg::hubmk::myth_label::x} to -22.5
    set {-bg::hubmk::myth_label::y} to 4.2
    set {-bg::hubmk::myth_label::z} to -32.5
    set {-bg::hubmk::myth_label::yaw} to 0.0
    set {-bg::hubmk::myth_pad::x} to -22.5
    set {-bg::hubmk::myth_pad::y} to 1
    set {-bg::hubmk::myth_pad::z} to -32.5
    set {-bg::hubmk::myth_pad::yaw} to 0.0
    set {-bg::hubmk::pvp_label::x} to 23.5
    set {-bg::hubmk::pvp_label::y} to 4.2
    set {-bg::hubmk::pvp_label::z} to -32.5
    set {-bg::hubmk::pvp_label::yaw} to 0.0
    set {-bg::hubmk::pvp_pad::x} to 23.5
    set {-bg::hubmk::pvp_pad::y} to 1
    set {-bg::hubmk::pvp_pad::z} to -32.5
    set {-bg::hubmk::pvp_pad::yaw} to 0.0
    set {-bg::hubmk::soon1_label::x} to -30.5
    set {-bg::hubmk::soon1_label::y} to 4.2
    set {-bg::hubmk::soon1_label::z} to -17.5
    set {-bg::hubmk::soon1_label::yaw} to -90.0
    set {-bg::hubmk::soon1_pad::x} to -30.5
    set {-bg::hubmk::soon1_pad::y} to 1
    set {-bg::hubmk::soon1_pad::z} to -17.5
    set {-bg::hubmk::soon1_pad::yaw} to -90.0
    set {-bg::hubmk::soon2_label::x} to 31.5
    set {-bg::hubmk::soon2_label::y} to 4.2
    set {-bg::hubmk::soon2_label::z} to -17.5
    set {-bg::hubmk::soon2_label::yaw} to 90.0
    set {-bg::hubmk::soon2_pad::x} to 31.5
    set {-bg::hubmk::soon2_pad::y} to 1
    set {-bg::hubmk::soon2_pad::z} to -17.5
    set {-bg::hubmk::soon2_pad::yaw} to 90.0
    set {-bg::hubmk::spawn::x} to 0.5
    set {-bg::hubmk::spawn::y} to 1
    set {-bg::hubmk::spawn::z} to 26.5
    set {-bg::hubmk::spawn::yaw} to 180.0
