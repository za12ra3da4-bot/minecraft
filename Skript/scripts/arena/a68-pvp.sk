# ═════════════════════════════════════════════════════════════════════════════
#  왕관 쟁탈전 — PvP 연습장 2곳 (전장 맵 북쪽 하늘, 게임이 없을 때 자유 대전)
#   1 석영 투기장 (원형, 지름 58)   2 용암 투기장 (팔각, 폭 112, 가운데 용암 해자 · 대장간 탑 4)
#   관리자: /전장 연습장건설 (처음 한 번, 둘 다 지음 · 뒤에 1 또는 2 를 붙이면 하나만)
#   /연습장 (/pvp장, /pvp) : 투기장 고르기 화면 (안에서 쓰면 옮기기 · 나가기)   /연습장 나가기   /무기 : 무료 무기고
#   관리자: /연습장 전체나가기 (모두 대기실로) · /연습장 잠금 (잠그고 모두 내보냄) · /연습장 열기
#   전설 무기 16종 + 보스 무기 4종을 공짜로 골라서 스킬 연습. 죽어도 가방 유지, 연습장에서 부활
#   게임이 시작되면 모두 대기실로 돌아감
# ═════════════════════════════════════════════════════════════════════════════

function bgPvpOn(p: player) :: boolean:
    if {-bg::on} is true:
        return false
    if {-bg::pvp::%uuid of {_p}%} is true:
        return true
    return false

# 연습장 가운데 바닥 = 전장 원점 기준 (128, 30, -70). 입장문 4곳 안쪽(반지름 17)에서 부활, 가운데를 바라봄
function bgPvpCenter() :: location:
    return bgAt(128.5, 31, -69.5)

# 용암 투기장 가운데 바닥 = 전장 원점 기준 (128, 30, -178). 동서남북 입장문 안쪽(팔각 38)에서 부활 (팀 색 표시)
function bgPvpCenterN(n: number) :: location:
    if {_n} is 2:
        return bgAt(128.5, 31, -177.5)
    return bgPvpCenter()

# 지금 있는 투기장 번호 (1 석영 · 2 용암)
function bgPvpArena(p: player) :: number:
    return {-bg::pvpa::%uuid of {_p}%} ? 1

function bgPvpName(n: number) :: text:
    if {_n} is 2:
        return "&6용암 투기장"
    return "&f석영 투기장"

function bgPvpSpawnN(n: number) :: location:
    set {_a} to (random integer between 0 and 3) * 90
    if {_n} is 2:
        set {_l} to bgAt(128.5 + cos({_a}) * 38, 31, -177.5 + sin({_a}) * 38)
    else:
        set {_l} to bgAt(128.5 + cos({_a}) * 17, 31, -69.5 + sin({_a}) * 17)
    set yaw of {_l} to {_a} + 90
    return {_l}

function bgPvpSpawn() :: location:
    return bgPvpSpawnN(1)

function bgPvpCount(n: number) :: number:
    set {_c} to 0
    loop all players:
        if {-bg::pvp::%uuid of loop-player%} is true:
            if bgPvpArena(loop-player) is {_n}:
                add 1 to {_c}
    return {_c}

# 0 = 둘 다, 1 = 석영, 2 = 용암
function bgPvpBuild(p: player, which: number = 0):
    bgSyncOrigin()
    if {_which} is not 2:
        send "&6[연습장] &f석영 투기장을 짓는 중..." to {_p}
        bgCmd("function bg:pvp/fl")
        wait 40 ticks
        bgCmd("function bg:pvp/build")
        wait 5 ticks
        bgCmd("function bg:pvp/fl_rm")
        send "&6[연습장] &a석영 투기장 완성!" to {_p}
    if {_which} is not 1:
        send "&6[연습장] &f용암 투기장을 짓는 중... &7(약 5초 · 큰 건물이라 잠깐 끊길 수 있음)" to {_p}
        bgCmd("function bg:pvp2/build")
        wait 120 ticks
        send "&6[연습장] &a용암 투기장 완성!" to {_p}
    send "&6[연습장] &f/연습장 으로 들어가 보세요." to {_p}

function bgPvpKit(p: player):
    bgClassReset({_p})
    set {_n} to name of {_p}
    bgCmd("clear %{_n}%")
    bgCmd("effect clear %{_n}%")
    bgCmd("item replace entity %{_n}% armor.head with iron_helmet[unbreakable={}]")
    bgCmd("item replace entity %{_n}% armor.chest with iron_chestplate[unbreakable={}]")
    bgCmd("item replace entity %{_n}% armor.legs with iron_leggings[unbreakable={}]")
    bgCmd("item replace entity %{_n}% armor.feet with iron_boots[unbreakable={}]")
    bgCmd("give %{_n}% iron_sword[unbreakable={}]")
    bgCmd("give %{_n}% bow[unbreakable={}]")
    bgCmd("give %{_n}% arrow 32")
    bgCmd("give %{_n}% golden_apple 4")
    bgCmd("give %{_n}% cooked_beef 16")

function bgPvpEnter(p: player, n: number = 1):
    if {-bg::on} is true:
        send "&6[연습장] &c게임 중에는 연습장에 갈 수 없습니다." to {_p}
        stop
    if {bg::cfg::pvplock} is true:
        if {_p} is not op:
            send "&6[연습장] &c지금은 연습장이 잠겨 있습니다. &7(관리자가 /연습장 열기 로 엶)" to {_p}
            stop
        send "&6[연습장] &7잠겨 있지만 관리자라 들어갑니다." to {_p}
    if block at bgUp(bgPvpCenterN({_n}), -1) is air:
        send "&6[연습장] &c%bgPvpName({_n})%&c이(가) 아직 없습니다. &7관리자가 &e/전장 연습장건설 &7을 한 번 실행해 주세요." to {_p}
        stop
    # 이미 연습장 안: 다른 투기장으로 옮기기만 (가방 그대로)
    if {-bg::pvp::%uuid of {_p}%} is true:
        set {-bg::pvpa::%uuid of {_p}%} to {_n}
        teleport {_p} to bgPvpSpawnN({_n})
        bgTitleP({_p}, "%bgPvpName({_n})%", "&f투기장을 옮겼습니다 · &e/연습장 &f다시 고르기 · 나가기")
        play sound "entity.enderman.teleport" to {_p}
        stop
    set {-bg::pvp::%uuid of {_p}%} to true
    set {-bg::pvpa::%uuid of {_p}%} to {_n}
    teleport {_p} to bgPvpSpawnN({_n})
    set gamemode of {_p} to adventure
    heal {_p}
    set food level of {_p} to 20
    bgPvpKit({_p})
    bgTitleP({_p}, "&c&lPvP 연습장 &8· %bgPvpName({_n})%", "&f무기를 고르고 마음껏 싸우세요 · &e/무기 &f다시 고르기 · &e/연습장 &f옮기기 · 나가기")
    play sound "item.goat_horn.sound.0" to {_p}
    wait 10 ticks
    bgPvpShop({_p})

function bgPvpLeave(p: player):
    delete {-bg::pvp::%uuid of {_p}%}
    delete {-bg::pvpa::%uuid of {_p}%}
    bgToLobby({_p})
    send "&6[연습장] &f대기실로 돌아왔습니다." to {_p}

# 연습장에 있는 사람 모두 대기실로 (몇 명인지 돌려줌)
function bgPvpKickAll() :: number:
    set {_n} to 0
    loop all players:
        if {-bg::pvp::%uuid of loop-player%} is true:
            bgPvpLeave(loop-player)
            add 1 to {_n}
    return {_n}

command /연습장 [<text>]:
    aliases: /pvp장, /pvp
    trigger:
        if arg-1 is "전체나가기":
            if player is not op:
                send "&c관리자만 쓸 수 있습니다."
                stop
            set {_n} to bgPvpKickAll()
            bgSay("&c[연습장] &f관리자가 연습장을 비웠습니다 &7(%{_n}%명 대기실로)")
            stop
        if arg-1 is "잠금":
            if player is not op:
                send "&c관리자만 쓸 수 있습니다."
                stop
            set {bg::cfg::pvplock} to true
            set {_n} to bgPvpKickAll()
            bgSay("&c[연습장] &f연습장이 &c잠겼습니다 &7(있던 %{_n}%명 대기실로 · 관리자가 /연습장 열기 로 엶)")
            stop
        if arg-1 is "열기":
            if player is not op:
                send "&c관리자만 쓸 수 있습니다."
                stop
            delete {bg::cfg::pvplock}
            bgSay("&a[연습장] &f연습장이 열렸습니다 &7— /연습장 으로 들어가기")
            stop
        if arg-1 is "나가기":
            if {-bg::pvp::%uuid of player%} is true:
                bgPvpLeave(player)
            else:
                send "&6[연습장] &7연습장에 있지 않습니다."
            stop
        if arg-1 is "1" or "석영":
            bgPvpEnter(player, 1)
            stop
        if arg-1 is "2" or "용암":
            bgPvpEnter(player, 2)
            stop
        bgPvpSelect(player)

command /무기:
    trigger:
        if bgPvpOn(player) is false:
            send "&6[연습장] &f무료 무기고는 연습장에서만 열립니다. &e/연습장"
            stop
        bgPvpShop(player)

# 무료 무기고: 전설 무기 16종 + 보스 무기 4종
function bgPvpShop(p: player):
    set {_gui} to chest inventory with 6 rows named "&c&l연습장 무기고 &8| &a무료"
    set {_pane} to red stained glass pane named " "
    loop 54 times:
        set slot loop-number - 1 of {_gui} to {_pane}
    set {_i} to 0
    loop {-bg::w::list::*}:
        add 1 to {_i}
        set {_w} to loop-value
        set {_info::*} to "&a클릭해서 받기 (무료)"
        set {_it} to bgWShopItem({_w}, "&6&l%{-bg::w::%{_w}%::name}% &7(전설)", {_info::*})
        set slot {-bg::wslots::%{_i}%} of {_gui} to {_it}
    set {_i} to 0
    loop {-bg::w::bosslist::*}:
        add 1 to {_i}
        set {_w} to loop-value
        set {_info::*} to "&a연습장에서는 무료"
        set {_it} to bgWShopItem({_w}, "&c&l%{-bg::w::%{_w}%::name}% &7(보스 전용)", {_info::*})
        set slot {-bg::bslots::%{_i}%} of {_gui} to {_it}
    set {_x} to barrier named "&c&l가방 비우고 기본 장비로"
    set slot 49 of {_gui} to {_x}
    open {_gui} to {_p}
    set {-bg::pvpgui::%uuid of {_p}%} to true

on inventory close:
    delete {-bg::pvpgui::%uuid of player%}

on inventory drag:
    {-bg::pvpgui::%uuid of player%} is true
    cancel event

on inventory click:
    {-bg::pvpgui::%uuid of player%} is true
    cancel event
    # 연타 방지 (0.2초 안의 두 번째 클릭은 무시 — 중복 구매 · 복사 방지)
    if {-bg::shopclk::%uuid of player%} is set:
        if difference between {-bg::shopclk::%uuid of player%} and now < 0.2 seconds:
            stop
    set {-bg::shopclk::%uuid of player%} to now
    set {_s} to raw index of event-slot
    if {_s} >= 54:
        stop
    if {_s} is 49:
        bgPvpKit(player)
        send "&6[연습장] &f기본 장비로 바꿨습니다." to player
        stop
    set {_w} to {-bg::wslot::%{_s}%}
    if {_w} is not set:
        set {_w} to {-bg::bslot::%{_s}%}
    {_w} is set
    bgGiveWeapon(player, {_w})
    send "&6[연습장] &f%{-bg::w::%{_w}%::name}% 받음 &7— 우클릭으로 스킬" to player
    play sound "item.armor.equip_netherite" to player

# 연습장에서 죽으면: 가방 그대로 · 연습장 아무 곳에서 부활
on death of player:
    bgPvpOn(victim) is true
    delete {-bg::wcd::%uuid of victim%::*}
    # 가방 유지 + 바닥에 떨어지는 것 지우기 (안 지우면 복사됨)
    keep the inventory and experience
    clear drops
    if attacker is a player:
        set death message to "&c[연습장] &f%name of attacker% &7⚔ &f%name of victim%"
        stop
    set death message to "&c[연습장] &f%name of victim% &7쓰러짐"

on respawn:
    bgPvpOn(player) is true
    set respawn location to bgPvpSpawnN(bgPvpArena(player))
    wait 1 tick
    set gamemode of player to adventure
    bgCmd("effect give %name of player% resistance 3 4 true")

on quit:
    delete {-bg::pvp::%uuid of player%}
    delete {-bg::pvpa::%uuid of player%}

# 섬 밖으로 떨어지면 다시 연습장으로
every 1 second:
    loop all players:
        if {-bg::pvp::%uuid of loop-player%} is true:
            if {-bg::on} is not true:
                if (y-coordinate of loop-player) < (y-coordinate of bgPvpCenter()) - 14:
                    teleport loop-player to bgPvpSpawnN(bgPvpArena(loop-player))
                    play sound "entity.enderman.teleport" to loop-player


# ─────────────────────────────────────────────────────────── 투기장 고르기 화면 (/연습장)
# 리소스팩 그림 배경 (제목 글리프가 창 전체를 덮음: 두 투기장 그림 카드 · 입장 단추) — 칸 배치는 arena/tools/rp/arenagui.py 와 같아야 함
#   1~4줄 0~3열 + 45~48: 석영 투기장    1~4줄 5~8열 + 50~53: 용암 투기장    49: 닫기 (연습장 안이면 나가기)
function bgPvpSelItem(p: player, n: number) :: item:
    set {_cnt} to bgPvpCount({_n})
    if {_n} is 2:
        set {_it} to magma block
        set {_nm} to "&6&l용암 투기장 &c&l NEW"
        set {_lore::*} to "&7폭 112칸 팔각 흑요석 투기장", "&7현무암 기둥 엄폐 · 대장간 탑 4 (계단으로 올라감)", "&c가운데 용암 해자 &7— 밀려 떨어지면 불탑니다!", "&7동서남북 팀 색 문에서 부활"
    else:
        set {_it} to quartz block
        set {_nm} to "&f&l석영 투기장 &7(기본)"
        set {_lore::*} to "&7지름 58칸 원형 석영 투기장", "&7엄폐 기둥 4 · 낮은 벽 · 관중석", "&7가볍게 붙어 보기 좋은 크기", "&7입장문 4곳에서 부활"
    add "" to {_lore::*}
    add "&e지금 %{_cnt}%명 싸우는 중" to {_lore::*}
    add "" to {_lore::*}
    if {-bg::pvp::%uuid of {_p}%} is true:
        if bgPvpArena({_p}) is {_n}:
            add "&b● 지금 여기 있습니다" to {_lore::*}
        else:
            add "&a▶ 클릭해서 이 투기장으로 옮기기 &7(가방 그대로)" to {_lore::*}
    else:
        add "&a▶ 클릭해서 입장" to {_lore::*}
    if {-bg::gui::arena} is set:
        set {_it} to bgModelItem(paper, "gui/blank")
    set name of {_it} to {_nm}
    set lore of {_it} to {_lore::*}
    return {_it}

function bgPvpSelect(p: player):
    if {-bg::on} is true:
        send "&6[연습장] &c게임 중에는 연습장에 갈 수 없습니다." to {_p}
        stop
    set {_a} to bgPvpSelItem({_p}, 1)
    set {_b} to bgPvpSelItem({_p}, 2)
    if {-bg::pvp::%uuid of {_p}%} is true:
        set {_x} to barrier named "&c&l대기실로 나가기"
        set lore of {_x} to "&7연습장에서 나가 대기실로 돌아갑니다"
    else:
        set {_x} to barrier named "&7닫기"
    if {-bg::gui::arena} is set:
        set {_gui} to chest inventory with 6 rows named "&f%{-bg::gui::arena}%"
        set {_x} to bgModelItem({_x}, "gui/blank")
    else:
        # 리소스팩이 없을 때: 색 유리판 카드
        set {_gui} to chest inventory with 6 rows named "&c&lPvP 연습장 &8| &f투기장 고르기"
        set {_pw} to white stained glass pane named " "
        set {_pr} to orange stained glass pane named " "
        set {_pg} to black stained glass pane named " "
        loop 54 times:
            set {_i} to loop-number - 1
            set {_c} to mod({_i}, 9)
            if {_c} < 4:
                set slot {_i} of {_gui} to {_pw}
            else if {_c} > 4:
                set slot {_i} of {_gui} to {_pr}
            else:
                set slot {_i} of {_gui} to {_pg}
    loop 45 times:
        set {_i} to loop-number + 8
        set {_c} to mod({_i}, 9)
        if {_c} < 4:
            set slot {_i} of {_gui} to {_a}
        else if {_c} > 4:
            set slot {_i} of {_gui} to {_b}
    set slot 49 of {_gui} to {_x}
    # 먼저 열고 나서 표시 (다시 열 때 이전 창의 '닫힘' 이 표시를 지우는 것 방지)
    open {_gui} to {_p}
    set {-bg::pvpsel::%uuid of {_p}%} to true
    play sound "block.beacon.activate" to {_p}

on inventory close:
    delete {-bg::pvpsel::%uuid of player%}

on inventory drag:
    {-bg::pvpsel::%uuid of player%} is true
    cancel event

on inventory click:
    {-bg::pvpsel::%uuid of player%} is true
    cancel event
    if {-bg::shopclk::%uuid of player%} is set:
        if difference between {-bg::shopclk::%uuid of player%} and now < 0.3 seconds:
            stop
    set {-bg::shopclk::%uuid of player%} to now
    set {_s} to raw index of event-slot
    if {_s} >= 54:
        stop
    set {_c} to mod({_s}, 9)
    if {_s} is 49:
        close player's inventory
        if {-bg::pvp::%uuid of player%} is true:
            bgPvpLeave(player)
        stop
    if {_s} < 9:
        stop
    if {_c} is 4:
        stop
    set {_n} to 1
    if {_c} > 4:
        set {_n} to 2
    if {-bg::pvp::%uuid of player%} is true:
        if bgPvpArena(player) is {_n}:
            send "&6[연습장] &7이미 %bgPvpName({_n})%&7에 있습니다." to player
            play sound "block.note_block.bass" to player
            stop
    close player's inventory
    play sound "ui.button.click" to player
    bgPvpEnter(player, {_n})
