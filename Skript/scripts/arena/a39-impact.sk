# ═════════════════════════════════════════════════════════════════════════════
#  신화쟁탈전 — 타격 연출 (보스 스킬 · 특수무기 스킬이 터지는 순간 · 데미지 숫자 · 스킬 이름)
#   충격파 고리 → 세로 폭발 기둥 → 블록 파편이 튀었다 떨어짐 → 터진 자국이 잠깐 남음 + 파티클 · 소리 여러 겹
#   (시야를 흔드는 연출은 쓰지 않는다 — 맞을 때 화면이 돌아가 불편함)
#   그림: 리소스팩 bg:impact/{shock,crater,burst}_<종류>   움직임 · 수명: 데이터팩 bg:impact/* (매 틱 bg:impact/tick)
#   종류: fire(탈로스) · sand(스핑크스) · venom · gale(라돈) · stone(키클롭스) · holy(빛)
#         thunder(번개) · arcane(비전) · blood(피) · frost(서리) · soul(영혼)
# ═════════════════════════════════════════════════════════════════════════════

on load:
    loop "fire", "sand", "venom", "gale", "stone", "holy", "thunder", "arcane", "blood", "frost" and "soul":
        set {-bg::imp::kind::%loop-value%} to true
    set {-bg::imp::b1::fire} to "minecraft:magma_block"
    set {-bg::imp::b2::fire} to "minecraft:blackstone"
    set {-bg::imp::b1::sand} to "minecraft:sandstone"
    set {-bg::imp::b2::sand} to "minecraft:chiseled_sandstone"
    set {-bg::imp::b1::venom} to "minecraft:slime_block"
    set {-bg::imp::b2::venom} to "minecraft:moss_block"
    set {-bg::imp::b1::stone} to "minecraft:cobblestone"
    set {-bg::imp::b2::stone} to "minecraft:coarse_dirt"
    set {-bg::imp::b1::arcane} to "minecraft:amethyst_block"
    set {-bg::imp::b2::arcane} to "minecraft:purple_stained_glass"
    set {-bg::imp::b1::blood} to "minecraft:redstone_block"
    set {-bg::imp::b2::blood} to "minecraft:nether_wart_block"
    set {-bg::imp::b1::frost} to "minecraft:packed_ice"
    set {-bg::imp::b2::frost} to "minecraft:blue_ice"
    set {-bg::imp::b1::soul} to "minecraft:soul_soil"
    set {-bg::imp::b2::soul} to "minecraft:soul_sand"

# 경고 장판에 쓰던 파티클 이름 → 연출 종류 (종류 이름을 그대로 주면 그대로)
function bgImpKind(pt: text) :: text:
    if {-bg::imp::kind::%{_pt}%} is set:
        return {_pt}
    if {_pt} is "lava" or "flame":
        return "fire"
    if {_pt} is "dust_plume" or "enchant":
        return "sand"
    if {_pt} is "witch":
        return "venom"
    if {_pt} is "cloud":
        return "gale"
    if {_pt} is "wax_on":
        return "holy"
    return "stone"

# 바닥 높이: 보스 투기장 안이면 투기장 바닥, 밖(특수무기)이면 그 자리 높이
function bgImpY(c: location) :: number:
    if {-bg::boss::home} is set:
        if world of {_c} is world of {-bg::boss::home}:
            if bgDist2({_c}, {-bg::boss::home}) < 26:
                if abs((y-coordinate of {_c}) - (y-coordinate of {-bg::boss::home})) < 5:
                    return y-coordinate of {-bg::boss::home}
    return y-coordinate of {_c}

function bgImpXYZ(c: location) :: text:
    return "x:%bgC(x-coordinate of {_c})%,y:%bgN(bgImpY({_c}))%,z:%bgC(z-coordinate of {_c})%"

function bgImpAt(c: location, dy: number) :: location:
    return location(x-coordinate of {_c}, bgImpY({_c}) + {_dy}, z-coordinate of {_c}, world of {_c})

# yaw 방향으로 f 만큼 앞
function bgImpFwd(c: location, yaw: number, f: number) :: location:
    return location((x-coordinate of {_c}) - sin({_yaw}) * {_f}, y-coordinate of {_c}, (z-coordinate of {_c}) + cos({_yaw}) * {_f}, world of {_c})

# ─────────────────────────────────────────── 파티클 · 소리 (종류별로 여러 겹)
function bgImpFx(c: location, r: number, k: text):
    set {_l} to bgImpAt({_c}, 0.3)
    set {_h} to {_r} / 2
    set {_n} to min(60, round(6 + {_r} * 6))
    if {_k} is "fire":
        bgParticle({_l}, "lava", {_h}, 0.2, {_h}, 0, round({_n} / 3))
        bgParticle({_l}, "flame", {_h}, 0.3, {_h}, 0.12, {_n})
        bgParticle(bgImpAt({_c}, 1), "large_smoke", {_h}, 0.6, {_h}, 0.04, round({_n} / 2))
        bgParticle({_l}, "dust{color:[1.0,0.42,0.08],scale:2.5}", {_h}, 0.4, {_h}, 0, {_n})
        if {_r} >= 4:
            bgParticle(bgImpAt({_c}, 1), "explosion", {_h} * 0.6, 0.4, {_h} * 0.6, 0, 3)
        bgSoundAt({_c}, "entity.generic.explode", 1.6, 0.7)
        bgSoundAt({_c}, "entity.blaze.shoot", 1.4, 0.6)
        bgSoundAt({_c}, "item.mace.smash_ground_heavy", 1.4, 0.8)
    else if {_k} is "sand":
        bgParticle({_l}, "dust_plume", {_h}, 0.3, {_h}, 0.05, {_n})
        bgParticle(bgImpAt({_c}, 0.6), "block{block_state:{Name:""minecraft:sandstone""}}", {_h}, 0.4, {_h}, 0.3, {_n})
        bgParticle(bgImpAt({_c}, 2), "falling_dust{block_state:{Name:""minecraft:sand""}}", {_h}, 0.6, {_h}, 0, round({_n} / 2))
        bgParticle(bgImpAt({_c}, 1), "end_rod", {_h} * 0.5, 0.6, {_h} * 0.5, 0.12, 14)
        bgSoundAt({_c}, "block.sand.break", 2, 0.5)
        bgSoundAt({_c}, "item.mace.smash_ground", 1.5, 0.8)
        bgSoundAt({_c}, "entity.evoker.cast_spell", 1.2, 1.3)
    else if {_k} is "venom":
        bgParticle({_l}, "item_slime", {_h}, 0.4, {_h}, 0.2, {_n})
        bgParticle(bgImpAt({_c}, 0.8), "witch", {_h}, 0.5, {_h}, 0.1, {_n})
        bgParticle({_l}, "dust{color:[0.35,1.0,0.2],scale:2.2}", {_h}, 0.3, {_h}, 0, {_n})
        bgParticle(bgImpAt({_c}, 0.5), "sneeze", {_h} * 0.6, 0.3, {_h} * 0.6, 0.05, round({_n} / 2))
        bgSoundAt({_c}, "entity.slime.squish", 2, 0.5)
        bgSoundAt({_c}, "entity.generic.splash", 1.5, 0.7)
        bgSoundAt({_c}, "block.bubble_column.bubble_pop", 2, 0.6)
    else if {_k} is "gale":
        bgParticle(bgImpAt({_c}, 0.8), "gust", {_h} * 0.6, 0.3, {_h} * 0.6, 0, max(1, round({_r} / 2)))
        bgParticle({_l}, "cloud", {_h}, 0.4, {_h}, 0.18, {_n})
        bgParticle(bgImpAt({_c}, 1), "sweep_attack", {_h}, 0.5, {_h}, 0, round({_n} / 3))
        bgParticle(bgImpAt({_c}, 1), "white_smoke", {_h}, 0.6, {_h}, 0.06, round({_n} / 2))
        bgSoundAt({_c}, "entity.breeze.wind_burst", 2, 0.8)
        bgSoundAt({_c}, "entity.wind_charge.wind_burst", 1.6, 0.7)
    else if {_k} is "holy":
        bgParticle(bgImpAt({_c}, 1), "end_rod", {_h}, 1.5, {_h}, 0.2, 40)
        bgParticle(bgImpAt({_c}, 1), "totem_of_undying", {_h}, 1, {_h}, 0.5, 60)
        bgParticle({_l}, "wax_on", {_h}, 1.5, {_h}, 0.1, 30)
        bgSoundAt({_c}, "block.beacon.activate", 2, 1.4)
        bgSoundAt({_c}, "entity.player.levelup", 1.5, 0.6)
    else if {_k} is "thunder":
        bgParticle(bgImpAt({_c}, 0.8), "electric_spark", {_h}, 0.8, {_h}, 0.4, {_n} * 2)
        bgParticle(bgImpAt({_c}, 1), "end_rod", {_h} * 0.6, 1.2, {_h} * 0.6, 0.15, round({_n} / 2))
        bgParticle({_l}, "dust{color:[0.55,0.8,1.0],scale:2.2}", {_h}, 0.3, {_h}, 0, {_n})
        bgParticle(bgImpAt({_c}, 0.5), "firework", {_h} * 0.5, 0.3, {_h} * 0.5, 0.15, round({_n} / 3))
        bgSoundAt({_c}, "entity.lightning_bolt.impact", 1.6, 1.1)
        bgSoundAt({_c}, "item.trident.thunder", 1, 1.4)
    else if {_k} is "arcane":
        bgParticle(bgImpAt({_c}, 1), "witch", {_h}, 0.8, {_h}, 0.3, {_n})
        bgParticle(bgImpAt({_c}, 0.5), "portal", {_h}, 0.5, {_h}, 1.2, {_n} * 2)
        bgParticle(bgImpAt({_c}, 1), "end_rod", {_h} * 0.5, 1, {_h} * 0.5, 0.2, round({_n} / 2))
        bgParticle(bgImpAt({_c}, 1.2), "enchant", {_h}, 1, {_h}, 1, {_n})
        bgSoundAt({_c}, "entity.evoker.cast_spell", 1.6, 0.8)
        bgSoundAt({_c}, "block.amethyst_block.resonate", 2, 0.7)
    else if {_k} is "blood":
        bgParticle(bgImpAt({_c}, 0.8), "dust{color:[0.75,0.02,0.08],scale:2.2}", {_h}, 0.6, {_h}, 0, {_n})
        bgParticle(bgImpAt({_c}, 1), "damage_indicator", {_h} * 0.6, 0.5, {_h} * 0.6, 0.2, round({_n} / 3))
        bgParticle(bgImpAt({_c}, 1), "crimson_spore", {_h}, 0.8, {_h}, 0, {_n})
        bgParticle(bgImpAt({_c}, 1), "sweep_attack", {_h} * 0.6, 0.3, {_h} * 0.6, 0, max(1, round({_n} / 6)))
        bgSoundAt({_c}, "entity.player.attack.sweep", 1.5, 0.6)
        bgSoundAt({_c}, "entity.player.attack.strong", 1.5, 0.7)
    else if {_k} is "frost":
        bgParticle(bgImpAt({_c}, 0.8), "snowflake", {_h}, 0.8, {_h}, 0.15, {_n})
        bgParticle(bgImpAt({_c}, 0.6), "item_snowball", {_h}, 0.4, {_h}, 0.2, round({_n} / 2))
        bgParticle(bgImpAt({_c}, 1), "end_rod", {_h} * 0.5, 0.8, {_h} * 0.5, 0.1, round({_n} / 3))
        bgParticle({_l}, "dust{color:[0.7,0.9,1.0],scale:2.0}", {_h}, 0.3, {_h}, 0, {_n})
        bgSoundAt({_c}, "block.glass.break", 1.4, 0.8)
        bgSoundAt({_c}, "entity.player.hurt_freeze", 1.4, 1.2)
    else if {_k} is "soul":
        bgParticle({_l}, "soul_fire_flame", {_h}, 0.4, {_h}, 0.08, {_n})
        bgParticle(bgImpAt({_c}, 1), "soul", {_h}, 0.8, {_h}, 0.05, round({_n} / 2))
        bgParticle(bgImpAt({_c}, 1), "sculk_soul", {_h}, 0.8, {_h}, 0.05, round({_n} / 3))
        bgParticle(bgImpAt({_c}, 1.2), "large_smoke", {_h}, 0.5, {_h}, 0.03, round({_n} / 3))
        bgSoundAt({_c}, "particle.soul_escape", 2, 0.8)
        bgSoundAt({_c}, "block.soul_sand.break", 1.6, 0.6)
    else:
        bgParticle({_l}, "dust_pillar{block_state:{Name:""minecraft:cobblestone""}}", {_h}, 0.2, {_h}, 0, {_n})
        bgParticle(bgImpAt({_c}, 0.6), "block{block_state:{Name:""minecraft:stone""}}", {_h}, 0.4, {_h}, 0.3, {_n})
        bgParticle(bgImpAt({_c}, 0.8), "poof", {_h}, 0.4, {_h}, 0.08, round({_n} / 2))
        bgParticle(bgImpAt({_c}, 1.2), "campfire_cosy_smoke", {_h} * 0.6, 0.4, {_h} * 0.6, 0.02, round({_n} / 6) + 1)
        if {_r} >= 4:
            bgParticle(bgImpAt({_c}, 1), "explosion", {_h} * 0.6, 0.4, {_h} * 0.6, 0, 2)
        bgSoundAt({_c}, "item.mace.smash_ground_heavy", 2, 0.7)
        bgSoundAt({_c}, "entity.generic.explode", 1.4, 0.6)
        bgSoundAt({_c}, "block.stone.break", 2, 0.5)

# ─────────────────────────────────────────── 한 점 타격 (반지름 r) — deb: 파편 · 자국까지
function bgImpact(c: location, r: number, k: text, deb: boolean):
    set {_k} to bgImpKind({_k})
    set {_p} to bgImpXYZ({_c})
    set {_dim} to bgDim()
    bgCmd("execute in %{_dim}% run function bg:impact/shock {%{_p}%,k:%{_k}%,s0:%bgN(max(0.6, {_r} * 0.5))%,s1:%bgN({_r} * 2.5)%}")
    set {_bh} to min(3.2, max(0.9, {_r} * 0.55))
    set {_bw} to {_bh} * 0.9
    bgCmd("execute in %{_dim}% run function bg:impact/burst {%{_p}%,k:%{_k}%,bw:%bgN({_bw})%,bh:%bgN({_bh})%,bw0:%bgN({_bw} * 0.35)%,bh0:%bgN({_bh} * 0.25)%}")
    bgImpFx({_c}, {_r}, {_k})
    {_deb} is true
    set {_cl} to 24
    if {_r} >= 4:
        set {_cl} to 44
    bgCmd("execute in %{_dim}% run function bg:impact/crater {%{_p}%,k:%{_k}%,d:%bgN({_r} * 1.8)%,cl:%{_cl}%}")
    if {-bg::imp::b1::%{_k}%} is set:
        set {_sz} to 3
        if {_r} < 3.5:
            set {_sz} to 1
        else if {_r} < 6:
            set {_sz} to 2
        bgCmd("execute in %{_dim}% run function bg:impact/debris {%{_p}%,c:%{_sz}%,b1:""%{-bg::imp::b1::%{_k}%}%"",b2:""%{-bg::imp::b2::%{_k}%}%""}")

# 원 (bgLateCircle)
function bgImpactCircle(c: location, r: number, pt: text):
    bgImpact({_c}, {_r}, bgImpKind({_pt}), true)

# 도넛: 가운데에서 거대한 충격파가 고리 끝까지 퍼지고, 고리 위에서 기둥 · 파편이 차례로 터짐
function bgImpactRing(c: location, rin: number, rout: number, pt: text):
    set {_k} to bgImpKind({_pt})
    set {_p} to bgImpXYZ({_c})
    set {_dim} to bgDim()
    bgCmd("execute in %{_dim}% run function bg:impact/shock {%{_p}%,k:%{_k}%,s0:%bgN(max(1, {_rin} * 1.6))%,s1:%bgN({_rout} * 2.25)%}")
    set {_rm} to ({_rin} + {_rout}) / 2
    set {_ir} to min(3.5, ({_rout} - {_rin}) * 0.45)
    set {_a0} to random number between 0 and 360
    set {_cnt} to min(10, max(6, round({_rm} * 1.6)))
    loop {_cnt} times:
        set {_a} to {_a0} + loop-number * 360 / {_cnt}
        set {_l} to location((x-coordinate of {_c}) + cos({_a}) * {_rm}, y-coordinate of {_c}, (z-coordinate of {_c}) + sin({_a}) * {_rm}, world of {_c})
        set {_d} to false
        if mod(loop-number, 2) is 0:
            set {_d} to true
        bgImpact({_l}, {_ir}, {_k}, {_d})
        if mod(loop-number, 3) is 0:
            wait 1 tick

# 직선: 시작점에서 끝까지 땅이 차례로 터져 나감
function bgImpactLine(c: location, yaw: number, wd: number, len: number, pt: text):
    set {_k} to bgImpKind({_pt})
    set {_n} to max(1, ceil({_len} / 3))
    set {_r} to max(1.5, {_wd} * 0.6)
    loop {_n} times:
        set {_d} to false
        if mod(loop-number, 2) is 1:
            set {_d} to true
        bgImpact(bgImpFwd({_c}, {_yaw}, loop-number * 3 - 1.5), {_r}, {_k}, {_d})
        wait 1 tick

# 부채꼴: 가까운 곳 → 먼 곳으로 휩쓸며 터짐
function bgImpactCone(c: location, yaw: number, deg: number, r: number, pt: text):
    set {_k} to bgImpKind({_pt})
    set {_ir} to max(1.6, {_r} * 0.16)
    set {_rows::*} to 0.38, 0.62 and 0.88
    set {_i} to 0
    set {_cols} to 2
    if {_r} < 8:
        set {_cols} to 1
    loop {_rows::*}:
        set {_f} to {_r} * loop-value-1
        add 1 to {_cols}
        loop {_cols} times:
            set {_a} to {_yaw} - {_deg} / 2 + {_deg} * (loop-number-2 - 0.5) / {_cols}
            add 1 to {_i}
            set {_d} to false
            if mod({_i}, 3) is 1:
                set {_d} to true
            bgImpact(bgImpFwd({_c}, {_a}, {_f}), {_ir}, {_k}, {_d})
        wait 1 tick

# ─────────────────────────────────────────── 떠오르는 글자 (데미지 숫자 · 스킬 이름)
function bgFloatText(l: location, txt: text, col: text, s: number):
    bgCmd("execute in %bgDim()% run function bg:impact/num {x:%bgC(x-coordinate of {_l})%,y:%bgN(y-coordinate of {_l})%,z:%bgC(z-coordinate of {_l})%,txt:""%{_txt}%"",col:""%{_col}%"",s:%bgN({_s})%}")

# 보스를 때렸을 때 (기절 중이면 붉은 큰 숫자)
function bgDmgNum(at: location, d: number, crit: boolean):
    set {_hs} to {-bg::bd::%{-bg::boss::id}%::hitscale} ? 2
    set {_l} to location((x-coordinate of {_at}) + (random number between -0.7 and 0.7), (y-coordinate of {_at}) + 1.3 * {_hs} + (random number between 0 and 0.6), (z-coordinate of {_at}) + (random number between -0.7 and 0.7), world of {_at})
    set {_v} to max(1, round({_d}))
    set {_t} to "%{_v}%"
    set {_col} to "#FFD54A"
    set {_s} to 1.1
    if {_v} >= 40:
        set {_s} to 1.4
    if {_crit} is true:
        set {_t} to "✦%{_v}%"
        set {_col} to "#FF4A3A"
        set {_s} to {_s} + 0.4
    bgFloatText({_l}, {_t}, {_col}, {_s})

# 특수무기 스킬에 맞은 사람: 머리 위 주황 숫자(체력 칸) + 타격 불꽃
function bgHitFx(p: player, h: number):
    set {_at} to location of {_p}
    set {_l} to location((x-coordinate of {_at}) + (random number between -0.4 and 0.4), (y-coordinate of {_at}) + 2.1 + (random number between 0 and 0.4), (z-coordinate of {_at}) + (random number between -0.4 and 0.4), world of {_at})
    set {_v} to round({_h} * 2 * 10) / 10
    set {_s} to 0.9
    if {_h} >= 3:
        set {_s} to 1.15
    bgFloatText({_l}, "%{_v}%", "#FF9A3C", {_s})
    set {_c} to location(x-coordinate of {_at}, (y-coordinate of {_at}) + 1.1, z-coordinate of {_at}, world of {_at})
    bgParticle({_c}, "crit", 0.3, 0.5, 0.3, 0.35, 14)
    bgParticle({_c}, "enchanted_hit", 0.3, 0.5, 0.3, 0.3, 10)

# 스킬 이름 외치기: 시전자 머리 위에 무기 색으로 « 스킬 이름 » 이 떠오름
function bgSkillCall(p: player, w: text):
    set {_nm} to {-bg::w::%{_w}%::skill}
    {_nm} is set
    set {_col} to {-bg::w::%{_w}%::col} ? "gold"
    set {_at} to location of {_p}
    set {_l} to location(x-coordinate of {_at}, (y-coordinate of {_at}) + 2.5, z-coordinate of {_at}, world of {_at})
    bgFloatText({_l}, "« %{_nm}% »", {_col}, 1.0)
