# ═════════════════════════════════════════════════════════════════════════════
#  왕관 쟁탈전 — 대기실 (맵 가운데 하늘의 떠 있는 섬)
#   게임 전 · 후: 접속하면 대기실로. 팀 발판을 밟으면 그 팀으로 (게임 중엔 안 바뀜)
#   대기실 안: PvP · 블록 부수기 없음, 배고픔 · 체력 회복.  /로비 로 이동
# ═════════════════════════════════════════════════════════════════════════════

import:
    org.bukkit.Bukkit

function bgLobbyLoc() :: location:
    set {_l} to bgMk("lobby_spawn")
    set yaw of {_l} to 180
    return {_l}

function bgInLobby(p: player) :: boolean:
    if {-bg::mk::lobby_spawn::x} is not set:
        return false
    set {_c} to bgMk("lobby_spawn")
    if world of {_p} is not world of {_c}:
        return false
    if bgDist2(location of {_p}, {_c}) > 20:
        return false
    if abs((y-coordinate of {_p}) - (y-coordinate of {_c})) > 12:
        return false
    return true

function bgToLobby(p: player):
    if {-bg::mk::lobby_spawn::x} is not set:
        stop
    teleport {_p} to bgLobbyLoc()
    bgClassReset({_p})
    set gamemode of {_p} to adventure
    heal {_p}
    set food level of {_p} to 20
    # 게임 밖이면 인벤토리 · 효과 · 불 초기화 (전장 종료 → 대기실)
    if {-bg::on} is not true:
        clear {_p}'s inventory
        bgCmd("effect clear %name of {_p}%")
        extinguish {_p}

command /로비:
    aliases: /lobby
    trigger:
        if bgIsFighter(player) is true:
            send "&6[전장] &f게임 중에는 대기실로 갈 수 없습니다."
            stop
        bgToLobby(player)

# 최신 리소스팩을 sha1 과 함께 직접 보낸다 (server.properties 에 sha1 이 없으면 클라이언트가 옛 팩을 계속 쓰기 때문)
# Nexo 같은 리소스팩 플러그인이 있으면 그 플러그인이 팩을 보낸다 (여기서 보내면 그 팩을 덮어씀)
#  → 왕관 쟁탈전 팩은 plugins/Nexo/pack/external_packs 에 넣어 합친다.  /전장 팩 켬|끔 으로 직접 정할 수도 있음
function bgPackOwner() :: text:
    if {bg::cfg::packsend} is "off":
        return "config"
    if {bg::cfg::packsend} is "on":
        return ""
    loop "Nexo", "ItemsAdder" and "Oraxen":
        if Bukkit.getPluginManager().isPluginEnabled(loop-value) is true:
            return loop-value
    return ""

function bgSendPack(p: player):
    {-bg::pack::url} is set
    set {_o} to bgPackOwner()
    if {_o} is not "":
        stop
    send the resource pack from {-bg::pack::url} with hash {-bg::pack::sha1} to {_p}

command /리팩 [<text>]:
    aliases: /rp
    trigger:
        # update 후 /sk reload 를 안 해도 최신 팩 주소 · sha1 을 쓰도록 팩 정보 스크립트만 다시 읽는다
        execute console command "sk reload arena/a04-gen-pack.sk"
        wait 20 ticks
        if arg-1 is "확인":
            send "&6[리팩 확인] &f주소: &7%{-bg::pack::url}%"
            send "&6[리팩 확인] &fsha1: &7%{-bg::pack::sha1}%"
            set {_o} to bgPackOwner()
            if {_o} is "":
                send "&6[리팩 확인] &f보내는 쪽: &a이 스크립트 &7(/리팩 으로 보냄)"
            else:
                send "&6[리팩 확인] &f보내는 쪽: &c%{_o}% &7(이 스크립트는 안 보냄 — /전장 팩 켬 으로 강제)"
            stop
        if arg-1 is "강제":
            send the resource pack from {-bg::pack::url} with hash {-bg::pack::sha1} to player
            send "&6[전장] &f리소스팩을 강제로 보냈습니다. &7(팩 %{-bg::pack::sha1}%)"
            stop
        if arg-1 is "@a" or "all" or "전체":
            if sender is a player:
                if player is not op:
                    send "&c[전장] 전체에게 보내기는 관리자만 할 수 있습니다."
                    stop
            loop all players:
                bgSendPack(loop-player)
                send "&6[전장] &f최신 리소스팩을 보냈습니다. 화면에서 '예' 를 눌러주세요." to loop-player
            send "&6[전장] &f접속한 전원(%size of all players%명)에게 리소스팩을 다시 보냈습니다."
            stop
        if sender is not a player:
            send "&c사용법: /리팩 @a"
            stop
        if bgPackOwner() is not "":
            send "&6[전장] &f리소스팩은 &e%bgPackOwner()%&f 가 보냅니다. &7(왕관 쟁탈전 팩은 Nexo 의 external_packs 에 넣어 합치세요)"
            stop
        bgSendPack(player)
        send "&6[전장] &f최신 리소스팩을 보냈습니다. 화면에서 '예' 를 눌러주세요. &7(팩 %{-bg::pack::sha1}%)"

on join:
    wait 20 ticks
    bgSendPack(player)

# 들어올 때: 게임 전이면 모험 모드로 대기실 가운데 · 게임 중이면 관전 (중앙 성소 위에서 내려다봄)
on join:
    wait 3 ticks
    # 관전자 모드(/관전자): 접속해도 아무 일 없음
    if bgOptOut(player) is true:
        bgCmd("tag %name of player% add bg_optout")
        stop
    if {-bg::on} is not true:
        bgToLobby(player)
        send title "&6&l왕관 쟁탈전" with subtitle "&f팀 발판을 밟아 팀을 고르세요" to player for 60 ticks
        stop
    bgSetTeam(player, "none")
    clear player's inventory
    set gamemode of player to spectator
    if {-bg::mk::temple_core::x} is set:
        set {_l} to bgUp(bgMk("temple_core"), 18)
        set pitch of {_l} to 60
        teleport player to {_l}
    send title "&7&l관전 중" with subtitle "&f게임 진행 중 — &e/중참&f 으로 지금 참가할 수 있습니다" to player for 80 ticks
    send "&6[전장] &f게임이 진행 중입니다. &e/중참&f 을 입력하면 인원이 가장 적은 팀으로 바로 참가합니다."

# 팀 발판 · 대기실 회복
every 10 ticks:
    {-bg::mk::lobby_spawn::x} is set
    loop all players:
        if bgInLobby(loop-player) is true:
            set food level of loop-player to 20
            if {-bg::on} is not true:
                loop {-bg::teams::*}:
                    set {_m} to "lobby_pad_%loop-value-2%"
                    if bgDist2(location of loop-player, bgMk({_m})) < 2.3:
                        if {-bg::freeteam} is not true:
                            send action bar "&7지금은 관리자가 팀을 정합니다 &8(/자유팀선택 으로 켜야 발판으로 팀 선택)" to loop-player
                        else:
                            if bgOptOut(loop-player) is true:
                                send action bar "&7관전자 모드라 팀에 들어가지 않습니다 &8(/관전자 로 끄기)" to loop-player
                            else if bgTeam(loop-player) is not loop-value-2:
                                bgSetupTeams()
                                bgSetTeam(loop-player, loop-value-2)
                                play sound "block.note_block.pling" to loop-player
                                bgParticle(location of loop-player, "happy_villager", 0.6, 1, 0.6, 0, 12)
                            if bgOptOut(loop-player) is false:
                                send action bar "%{-bg::tcol::%loop-value-2%}%&l%{-bg::tname::%loop-value-2%}% 팀 &7— 팀원 %bgTeamCount(loop-value-2)%명" to loop-player

# 대기실 안 피해 없음 · 게임 밖에서는 사람끼리 못 때림
on damage of player:
    if bgInLobby(victim) is true:
        if {-bg::on} is not true:
            cancel event
            stop
    attacker is a player
    if {-bg::on} is not true:
        # 연습장끼리는 때릴 수 있음
        set {_a} to attacker
        set {_v} to victim
        if bgPvpOn({_a}) is true:
            if bgPvpOn({_v}) is true:
                stop
        cancel event
        stop
    set {_a} to attacker
    set {_v} to victim
    if bgIsFighter({_a}) is false:
        cancel event
        stop
    if bgIsFighter({_v}) is false:
        cancel event

on break:
    bgInLobby(player) is true
    gamemode of player is not creative
    cancel event

on place:
    bgInLobby(player) is true
    gamemode of player is not creative
    cancel event

# ─────────────────────────────────────────────────────────── 자유 팀 선택 (관리자가 켜야 발판으로 팀 고르기)
command /자유팀선택:
    permission: op
    trigger:
        if {-bg::freeteam} is true:
            delete {-bg::freeteam}
            bgSay("&6[전장] &f자유 팀 선택 &c꺼짐 &7— 관리자가 팀을 정합니다")
        else:
            set {-bg::freeteam} to true
            bgSay("&6[전장] &f자유 팀 선택 &a켜짐 &7— 대기실 색깔 발판을 밟으면 그 팀이 됩니다")

# ─────────────────────────────────────────────────────────── 팀 채팅
#   /팀 <말>  (/tc)  팀에게만.   /팀채팅 : 기본 채팅을 팀 채팅으로 켜고 끄기 (켠 상태에서 ! 로 시작하면 전체 채팅)
command /팀 <text>:
    aliases: /tc
    trigger:
        bgTeamSay(player, arg-1)

command /팀채팅:
    trigger:
        if {-bg::tchat::%uuid of player%} is true:
            delete {-bg::tchat::%uuid of player%}
            send "&6[팀 채팅] &f꺼짐 &7— 채팅이 전체에게 갑니다"
        else:
            set {-bg::tchat::%uuid of player%} to true
            send "&6[팀 채팅] &a켜짐 &7— 채팅이 팀에게만 갑니다 (! 로 시작하면 전체)"

function bgTeamSay(p: player, m: text):
    set {_t} to bgTeam({_p})
    if {_t} is "none":
        send "&7팀이 없습니다." to {_p}
        stop
    loop all players:
        if bgTeam(loop-player) is {_t}:
            send "%{-bg::tcol::%{_t}%}%[팀] &f%name of {_p}%&7: &f%{_m}%" to loop-player

on chat:
    {-bg::tchat::%uuid of player%} is true
    set {_m} to message
    if {_m} starts with "!":
        set message to subtext of {_m} from characters 2 to (length of {_m})
        stop
    cancel event
    bgTeamSay(player, {_m})
