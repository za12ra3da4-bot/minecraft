# ═════════════════════════════════════════════════════════════════════════════
#  왕관 쟁탈전 — 본진 코어 (본진 앞 신호기) · 결계 부적
#   적 코어를 30번 때리면 파괴: 그 팀 -100점 + 60초 약화 · 구속 · 발광. 90초 뒤 코어 복구
#   결계 부적(상점): 우클릭하면 60초 동안 적 본진의 수호 결계 피해를 받지 않음
# ═════════════════════════════════════════════════════════════════════════════

function bgCoreReset():
    loop {-bg::teams::*}:
        set {-bg::core::%loop-value%::hits} to 0
        set {-bg::core::%loop-value%::down} to false
        if {-bg::mk::base_%loop-value%_beacon::x} is set:
            set block at bgMk("base_%loop-value%_beacon") to beacon
        bgCoreShow(loop-value, true)
        bgCoreText(loop-value)

# 코어 위 체력 글씨 (데이터팩 장식 bg_coretext_<팀>)
function bgCoreText(t: text):
    set {_h} to 30 - ({-bg::core::%{_t}%::hits} ? 0)
    set {_c} to "white"
    if {_h} <= 10:
        set {_c} to "red"
    else if {_h} <= 20:
        set {_c} to "gold"
    if {-bg::core::%{_t}%::down} is true:
        bgCmd("data merge entity @e[tag=bg_coretext_%{_t}%,limit=1] {text:{text:""파괴됨 — 90초 뒤 복구"",color:""dark_gray"",bold:true}}")
        stop
    bgCmd("data merge entity @e[tag=bg_coretext_%{_t}%,limit=1] {text:{text:""%{_h}% / 30"",color:""%{_c}%"",bold:true}}")

# 부서지면 수정 · 빛기둥 숨기기
function bgCoreShow(t: text, on: boolean):
    if {_on} is true:
        bgCmd("execute as @e[tag=bg_core_%{_t}%] run data merge entity @s {view_range:2f}")
    else:
        bgCmd("execute as @e[tag=bg_core_%{_t}%] run data merge entity @s {view_range:0f}")

# 떠 있는 수정(interaction)을 때려도 코어 타격 — 데이터팩 tick 이 bg_wantcore_<팀> 태그를 붙인다
every 2 ticks:
    loop all players:
        loop {-bg::teams::*}:
            if scoreboard tags of loop-player contain "bg_wantcore_%loop-value-2%":
                remove "bg_wantcore_%loop-value-2%" from scoreboard tags of loop-player
                if bgIsFighter(loop-player) is true:
                    bgCoreHit(loop-player, loop-value-2)

on left click on beacon:
    bgIsFighter(player) is true
    set {_me} to bgTeam(player)
    loop {-bg::teams::*}:
        set {_t} to loop-value
        if {-bg::mk::base_%{_t}%_beacon::x} is set:
            set {_m} to bgMk("base_%{_t}%_beacon")
            if bgDist2(location of event-block, {_m}) < 1.2:
                if abs((y-coordinate of event-block) - (y-coordinate of {_m})) < 1.5:
                    bgCoreHit(player, {_t})
                    stop

function bgCoreHit(p: player, t: text):
    if bgTeam({_p}) is {_t}:
        send action bar "&7우리 팀 코어입니다 — 지켜야 합니다!" to {_p}
        stop
    if {-bg::core::%{_t}%::down} is true:
        stop
    # 너무 빠른 연타 방지 (0.3초)
    if {-bg::corecd::%uuid of {_p}%} is set:
        if difference between {-bg::corecd::%uuid of {_p}%} and now < 0.3 seconds:
            stop
    set {-bg::corecd::%uuid of {_p}%} to now
    add 1 to {-bg::core::%{_t}%::hits}
    set {_h} to {-bg::core::%{_t}%::hits}
    set {_m} to bgMk("base_%{_t}%_beacon")
    bgParticle({_m}, "crit", 0.6, 0.8, 0.6, 0.3, 12)
    bgSoundAt({_m}, "block.anvil.land", 1, 1.6)
    send action bar "%{-bg::tcol::%{_t}%}%%{-bg::tname::%{_t}%}% 코어 &f%{_h}%&7/30" to {_p}
    bgCoreText({_t})
    if mod({_h}, 10) is 0:
        if {_h} < 30:
            loop all players:
                if bgTeam(loop-player) is {_t}:
                    send title "" with subtitle "&c&l우리 코어가 공격받고 있습니다! &7(%{_h}%/30)" to loop-player for 40 ticks
                    play sound "block.bell.use" to loop-player
    if {_h} >= 30:
        bgCoreBreak({_t}, bgTeam({_p}))

function bgCoreBreak(t: text, by: text):
    set {-bg::core::%{_t}%::down} to true
    set {_m} to bgMk("base_%{_t}%_beacon")
    set block at {_m} to air
    bgCoreShow({_t}, false)
    bgCoreText({_t})
    bgParticle({_m}, "explosion_emitter", 0.5, 0.5, 0.5, 0, 2)
    bgParticle({_m}, "large_smoke", 1.5, 1.5, 1.5, 0.05, 60)
    bgSoundAt({_m}, "entity.generic.explode", 4, 0.7)
    bgSoundAt({_m}, "block.beacon.deactivate", 4, 0.6)
    set {-bg::score::%{_t}%} to max(0, ({-bg::score::%{_t}%} ? 0) - 100)
    bgCmd("effect give @a[team=bg_%{_t}%] weakness 60 0 true")
    bgCmd("effect give @a[team=bg_%{_t}%] slowness 60 0 true")
    bgCmd("effect give @a[team=bg_%{_t}%] glowing 60 0 true")
    bgTitle("%{-bg::tcol::%{_t}%}%&l%{-bg::tname::%{_t}%}% 코어 파괴!", "%{-bg::tcol::%{_by}%}%%{-bg::tname::%{_by}%}% 팀&f이 부쉈습니다 · &c-100점 · 60초 약화", 10, 60, 20)
    bgSay("%{-bg::tcol::%{_by}%}%%{-bg::tname::%{_by}%}% 팀&f이 %{-bg::tcol::%{_t}%}%%{-bg::tname::%{_t}%}% 팀&f의 코어를 파괴했습니다! &c(-100점, 60초 약화 · 구속 · 발광) &7— 90초 뒤 복구")
    wait 90 seconds
    if {-bg::on} is true:
        set block at {_m} to beacon
        set {-bg::core::%{_t}%::hits} to 0
        set {-bg::core::%{_t}%::down} to false
        bgCoreShow({_t}, true)
        bgCoreText({_t})
        bgSay("%{-bg::tcol::%{_t}%}%%{-bg::tname::%{_t}%}% 팀&f의 코어가 복구되었습니다.")

# ─────────────────────────────────────────────────────────── 결계 부적
on right click:
    player's tool is echo shard
    set {_nm} to uncolored name of player's tool
    {_nm} is set
    {_nm} contains "결계 부적"
    cancel event
    remove 1 of player's tool from player's tool
    set {-bg::ward::%uuid of player%} to now
    send title "&b&l결계 부적" with subtitle "&f60초 동안 적 본진의 수호 결계를 무시합니다" to player for 40 ticks
    play sound "block.beacon.power_select" to player
    bgParticle(location of player, "enchant", 0.6, 1, 0.6, 0.5, 60)

function bgWardOn(p: player) :: boolean:
    if {-bg::ward::%uuid of {_p}%} is not set:
        return false
    if difference between {-bg::ward::%uuid of {_p}%} and now < 60 seconds:
        return true
    return false

# ─────────────────────────────────────────────────────────── 광산 (본진 광석 바위)
#  본진 광석 바위에서만: 캐면 원석 · 보석이 가방에 (상점에서 일괄 판매: 철 · 구리 2 · 금 3 · 에메랄드 6 · 다이아 10). 2초 뒤 다시 채워짐
#  죽으면 광물은 그 자리에 떨어져서 적이 주워 갈 수 있다
#  (다른 곳 광석은 캘 수 없음 · 창작 모드 관리자는 예외)
function bgAtBaseOre(l: location) :: boolean:
    loop {-bg::teams::*}:
        if {-bg::mk::base_%loop-value%_class_2::x} is set:
            set {_m} to bgMk("base_%loop-value%_class_2")
            if world of {_l} is world of {_m}:
                if bgDist2({_l}, {_m}) <= 14:
                    return true
    return false

on break of iron ore or copper ore or gold ore or emerald ore or diamond ore:
    player's gamemode is not creative
    cancel event
    set {_l} to location of event-block
    bgAtBaseOre({_l}) is true
    set {_ty} to type of event-block
    set {_drop} to raw iron
    set {_nm} to "철 원석 (2코인)"
    if event-block is copper ore:
        set {_drop} to raw copper
        set {_nm} to "구리 원석 (2코인)"
    else if event-block is gold ore:
        set {_drop} to raw gold
        set {_nm} to "금 원석 (3코인)"
    else if event-block is emerald ore:
        set {_drop} to emerald
        set {_nm} to "에메랄드 (6코인)"
    else if event-block is diamond ore:
        set {_drop} to diamond
        set {_nm} to "다이아몬드 (10코인)"
    # 캔 자리는 기반암(못 캠)으로 → 2초 뒤 매초 검사가 원래 광석으로 되돌림 (리로드 · 재시작해도 유지)
    set block at {_l} to bedrock
    set {_k} to "%floor(x-coordinate of {_l})%_%floor(y-coordinate of {_l})%_%floor(z-coordinate of {_l})%"
    set {bg::oreq::%{_k}%} to true
    set {bg::oreq::%{_k}%::l} to {_l}
    set {bg::oreq::%{_k}%::t} to {_ty}
    set {bg::oreq::%{_k}%::at} to now
    if bgIsFighter(player) is true:
        give player 1 of {_drop}
        send action bar "&a+1 %{_nm}% &7— 상점 '광물 일괄 판매'에서 코인으로 · 죽으면 떨어뜨림" to player
        play sound "entity.item.pickup" to player
    play sound "block.amethyst_block.break" to player
    bgParticle({_l}, "wax_on", 0.4, 0.4, 0.4, 0.1, 10)

function bgOreRegen(all: boolean):
    loop {bg::oreq::*}:
        set {_k} to loop-index
        if {bg::oreq::%{_k}%::at} is set:
            set {_go} to {_all}
            if difference between {bg::oreq::%{_k}%::at} and now >= 2 seconds:
                set {_go} to true
            if {_go} is true:
                set {_l} to {bg::oreq::%{_k}%::l}
                if block at {_l} is bedrock:
                    set block at {_l} to {bg::oreq::%{_k}%::t}
                    bgParticle({_l}, "happy_villager", 0.4, 0.4, 0.4, 0, 6)
                delete {bg::oreq::%{_k}%::*}
                delete {bg::oreq::%{_k}%}

every 1 second:
    bgOreRegen(false)

on load:
    bgOreRegen(true)
