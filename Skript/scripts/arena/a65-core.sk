# ═════════════════════════════════════════════════════════════════════════════
#  왕관 쟁탈전 — 본진 코어 (본진 앞 신호기) · 결계 부적
#   코어 체력 50 (+팀 강화 '코어 보강' 단계마다 +25, Lv.3 은 자연 회복 2배). 다 깎이면 파괴: 그 팀 -50점 + 복구될 때까지(90초) 점수 정지
#   + 30초 약화 · 구속 · 발광 + 50% 확률로 그 팀이 점령한 거점 하나를 무작위로 잃음. 복구 뒤 60초 보호막
#   결계 부적(상점): 우클릭하면 60초 동안 적 본진의 수호 결계 피해를 받지 않음
# ═════════════════════════════════════════════════════════════════════════════

function bgCoreReset():
    loop {-bg::teams::*}:
        set {-bg::core::%loop-value%::hits} to 0
        set {-bg::core::%loop-value%::down} to false
        if {-bg::mk::base_%loop-value%_beacon::x} is set:
            set block at bgMk("base_%loop-value%_beacon") to beacon
        bgCoreShow(loop-value, true)
        bgCoreText(loop-value)

# 코어 위 체력 글씨 (데이터팩 장식 bg_coretext_<팀>)
# 코어 최대 체력 (기본 50 + 팀 강화 '코어 보강' Lv 당 25)
function bgCoreMax(t: text) :: number:
    return 50 + 25 * bgUpLv({_t}, "core")

function bgCoreText(t: text):
    set {_max} to bgCoreMax({_t})
    set {_h} to {_max} - ({-bg::core::%{_t}%::hits} ? 0)
    set {_c} to "white"
    if {_h} <= {_max} / 3:
        set {_c} to "red"
    else if {_h} <= {_max} * 2 / 3:
        set {_c} to "gold"
    if {-bg::core::%{_t}%::down} is true:
        set {_left} to bgCoreLeft({_t})
        bgCmd("data merge entity @e[tag=bg_coretext_%{_t}%,limit=1] {text:[{text:""파괴됨 — %{_left}%초 뒤 복구"",color:""gray"",bold:true},{text:""\n점수 정지"",color:""red"",bold:true}]}")
        stop
    bgCmd("data merge entity @e[tag=bg_coretext_%{_t}%,limit=1] {text:{text:""%{_h}% / %{_max}%"",color:""%{_c}%"",bold:true}}")

# 부서지면 수정 · 빛기둥 숨기기
function bgCoreShow(t: text, on: boolean):
    if {_on} is true:
        bgCmd("execute as @e[tag=bg_core_%{_t}%] run data merge entity @s {view_range:2f}")
    else:
        bgCmd("execute as @e[tag=bg_core_%{_t}%] run data merge entity @s {view_range:0f}")

# 떠 있는 수정(interaction)을 때려도 코어 타격 — 데이터팩 tick 이 bg_wantcore_<팀> 태그를 붙인다
every 2 ticks:
    loop all players:
        loop {-bg::teams::*}:
            if scoreboard tags of loop-player contain "bg_wantcore_%loop-value-2%":
                remove "bg_wantcore_%loop-value-2%" from scoreboard tags of loop-player
                if bgIsFighter(loop-player) is true:
                    bgCoreHit(loop-player, loop-value-2)

on left click on beacon:
    bgIsFighter(player) is true
    set {_me} to bgTeam(player)
    loop {-bg::teams::*}:
        set {_t} to loop-value
        if {-bg::mk::base_%{_t}%_beacon::x} is set:
            set {_m} to bgMk("base_%{_t}%_beacon")
            if bgDist2(location of event-block, {_m}) < 1.2:
                if abs((y-coordinate of event-block) - (y-coordinate of {_m})) < 1.5:
                    bgCoreHit(player, {_t})
                    stop

function bgCoreHit(p: player, t: text):
    if bgTeam({_p}) is {_t}:
        send action bar "&7우리 팀 코어입니다 — 지켜야 합니다!" to {_p}
        stop
    if {-bg::core::%{_t}%::down} is true:
        stop
    if {-bg::core::%{_t}%::shield} is set:
        set {_sl} to {-bg::core::%{_t}%::shieldlen} ? 60
        if difference between {-bg::core::%{_t}%::shield} and now < bgTicks({_sl} * 20):
            send action bar "&b코어 보호막 중입니다 (%{_sl}%초)" to {_p}
            stop
    # 너무 빠른 연타 방지 (0.3초)
    if {-bg::corecd::%uuid of {_p}%} is set:
        if difference between {-bg::corecd::%uuid of {_p}%} and now < 0.3 seconds:
            stop
    set {-bg::corecd::%uuid of {_p}%} to now
    set {-bg::core::%{_t}%::last} to now
    add 1 to {-bg::core::%{_t}%::hits}
    set {_h} to {-bg::core::%{_t}%::hits}
    set {_max} to bgCoreMax({_t})
    set {_m} to bgMk("base_%{_t}%_beacon")
    bgParticle({_m}, "crit", 0.6, 0.8, 0.6, 0.3, 12)
    bgSoundAt({_m}, "block.anvil.land", 1, 1.6)
    send action bar "%{-bg::tcol::%{_t}%}%%{-bg::tname::%{_t}%}% 코어 &f%{_h}%&7/%{_max}%" to {_p}
    bgCoreText({_t})
    if mod({_h}, 10) is 0:
        if {_h} < {_max}:
            loop all players:
                if bgTeam(loop-player) is {_t}:
                    send title "" with subtitle "&c&l우리 코어가 공격받고 있습니다! &7(%{_h}%/%{_max}%)" to loop-player for 40 ticks
                    play sound "block.bell.use" to loop-player
    if {_h} >= {_max}:
        bgCoreBreak({_t}, bgTeam({_p}))

function bgCoreBreak(t: text, by: text):
    set {-bg::core::%{_t}%::down} to true
    set {-bg::core::%{_t}%::downsec} to {-bg::sec} ? 0
    set {_m} to bgMk("base_%{_t}%_beacon")
    set block at {_m} to air
    bgCoreShow({_t}, false)
    bgCoreText({_t})
    bgParticle({_m}, "explosion_emitter", 0.5, 0.5, 0.5, 0, 2)
    bgParticle({_m}, "large_smoke", 1.5, 1.5, 1.5, 0.05, 60)
    bgSoundAt({_m}, "entity.generic.explode", 4, 0.7)
    bgSoundAt({_m}, "block.beacon.deactivate", 4, 0.6)
    set {-bg::score::%{_t}%} to max(0, ({-bg::score::%{_t}%} ? 0) - 50)
    # 50% 확률로 점령해 둔 거점 하나를 무작위로 잃는다
    set {_lost} to ""
    if chance of 50%:
        loop {-bg::pts::*}:
            if {-bg::own::%loop-value%} is {_t}:
                add loop-value to {_mine::*}
        if size of {_mine::*} > 0:
            set {_lp} to random element out of {_mine::*}
            set {-bg::own::%{_lp}%} to "none"
            set {-bg::capt::%{_lp}%} to "none"
            set {-bg::capv::%{_lp}%} to 0
            bgPointVisual({_lp}, "none")
            bgSoundAt(bgMk({-bg::ptmk::%{_lp}%}), "block.beacon.deactivate", 3, 0.8)
            set {_lost} to " &7· &e%{-bg::ptname::%{_lp}%}% &c박탈"
    bgCmd("effect give @a[team=bg_%{_t}%] weakness 30 0 true")
    bgCmd("effect give @a[team=bg_%{_t}%] slowness 30 0 true")
    bgCmd("effect give @a[team=bg_%{_t}%] glowing 30 0 true")
    bgTitle("%{-bg::tcol::%{_t}%}%&l%{-bg::tname::%{_t}%}% 코어 파괴!", "%{-bg::tcol::%{_by}%}%%{-bg::tname::%{_by}%}% 팀&f이 부쉈습니다 · &c-50점 · 복구까지 점수 정지%{_lost}%", 10, 60, 20)
    bgSay("%{-bg::tcol::%{_by}%}%%{-bg::tname::%{_by}%}% 팀&f이 %{-bg::tcol::%{_t}%}%%{-bg::tname::%{_t}%}% 팀&f의 코어를 파괴했습니다! &c(-50점, 복구까지 90초 동안 점수 정지, 30초 약화 · 구속 · 발광) &7— 복구 뒤 60초 보호막")
    if {_lost} is not "":
        bgSay("%{-bg::tcol::%{_t}%}%%{-bg::tname::%{_t}%}% 팀&f이 코어를 잃으며 &e%{-bg::ptname::%{_lp}%}%&f 의 점령도 잃었습니다!")
    wait 90 seconds
    if {-bg::on} is true:
        set block at {_m} to beacon
        set {-bg::core::%{_t}%::hits} to 0
        set {-bg::core::%{_t}%::down} to false
        set {-bg::core::%{_t}%::shield} to now
        set {-bg::core::%{_t}%::shieldlen} to 60
        bgCoreShow({_t}, true)
        bgCoreText({_t})
        bgSay("%{-bg::tcol::%{_t}%}%%{-bg::tname::%{_t}%}% 팀&f의 코어가 복구되었습니다. &a점수가 다시 오릅니다.")

# 코어 복구까지 남은 초
function bgCoreLeft(t: text) :: number:
    return max(0, 90 - (({-bg::sec} ? 0) - ({-bg::core::%{_t}%::downsec} ? 0)))

# 코어가 부서진 팀: 코어 글씨에 남은 시간 · 팀원에게 "점수 정지" 알림 (매초)
every 1 second:
    {-bg::on} is true
    loop {-bg::teams::*}:
        if {-bg::core::%loop-value%::down} is true:
            bgCoreText(loop-value)
            set {_left} to bgCoreLeft(loop-value)
            set {_t} to loop-value
            loop all players:
                if bgTeam(loop-player) is {_t}:
                    send action bar "&c&l코어 파괴됨 &7— &f복구까지 &e%{_left}%초 &7· &c점수가 오르지 않습니다" to loop-player

# ─────────────────────────────────────────────────────────── 결계 부적
on right click:
    player's tool is echo shard
    set {_nm} to uncolored name of player's tool
    {_nm} is set
    {_nm} contains "결계 부적"
    cancel event
    remove 1 of player's tool from player's tool
    set {-bg::ward::%uuid of player%} to now
    send title "&b&l결계 부적" with subtitle "&f60초 동안 적 본진의 수호 결계를 무시합니다" to player for 40 ticks
    play sound "block.beacon.power_select" to player
    bgParticle(location of player, "enchant", 0.6, 1, 0.6, 0.5, 60)

function bgWardOn(p: player) :: boolean:
    if {-bg::ward::%uuid of {_p}%} is not set:
        return false
    if difference between {-bg::ward::%uuid of {_p}%} and now < 60 seconds:
        return true
    return false

# ─────────────────────────────────────────────────────────── 광산 (본진 광석 바위)
#  본진 광석 바위(5초 리젠) + 맵 곳곳 광맥(3초 리젠, 금 · 에메랄드 · 다이아 많음): 캐면 원석 · 보석이 가방에 (상점에서 일괄 판매: 철 · 구리 2 · 금 3 · 에메랄드 6 · 다이아 10). 2초 뒤 다시 채워짐
#  죽으면 광물은 그 자리에 떨어져서 적이 주워 갈 수 있다
#  (다른 곳 광석은 캘 수 없음 · 창작 모드 관리자는 예외)
function bgAtBaseOre(l: location) :: boolean:
    if bgBaseOreTeam({_l}) is "none":
        return false
    return true

# 어느 팀 본진 광석 바위인지 (아니면 "none")
function bgBaseOreTeam(l: location) :: text:
    loop {-bg::teams::*}:
        if {-bg::mk::base_%loop-value%_class_2::x} is set:
            set {_m} to bgMk("base_%loop-value%_class_2")
            if world of {_l} is world of {_m}:
                if bgDist2({_l}, {_m}) <= 14:
                    return loop-value
    return "none"

on break of iron ore or copper ore or gold ore or emerald ore or diamond ore:
    player's gamemode is not creative
    cancel event
    set {_l} to location of event-block
    # 본진 광석 바위 = 5초 리젠 (팀 강화 '광산 강화' 로 4 · 3 · 2초) · 맵 곳곳 광맥 = 3초 리젠 (전장 맵 안에서만)
    set {_rg} to 3
    set {_bt} to bgBaseOreTeam({_l})
    if {_bt} is not "none":
        set {_rg} to bgMineRegen({_bt})
    else:
        set {_lx} to (x-coordinate of {_l}) - {bg::cfg::ox}
        set {_lz} to (z-coordinate of {_l}) - {bg::cfg::oz}
        if {_lx} < 0:
            stop
        if {_lx} > 256:
            stop
        if {_lz} < 0:
            stop
        if {_lz} > 256:
            stop
    set {_ty} to type of event-block
    set {_drop} to "raw_iron"
    set {_nm} to "철 원석 (1코인)"
    if event-block is copper ore:
        set {_drop} to "raw_copper"
        set {_nm} to "구리 원석 (1코인)"
    else if event-block is gold ore:
        set {_drop} to "raw_gold"
        set {_nm} to "금 원석 (2코인)"
    else if event-block is emerald ore:
        set {_drop} to "emerald"
        set {_nm} to "에메랄드 (3코인)"
    else if event-block is diamond ore:
        set {_drop} to "diamond"
        set {_nm} to "다이아몬드 (5코인)"
    # 캔 자리는 기반암(못 캠)으로 → 2초 뒤 매초 검사가 원래 광석으로 되돌림 (리로드 · 재시작해도 유지)
    # 캔 자리는 주변 바위 블록으로 잠깐 메움 (기반암처럼 튀지 않게)
    set {_ph} to stone
    loop 6 times:
        set {_q} to location(x-coordinate of {_l}, y-coordinate of {_l}, z-coordinate of {_l}, world of {_l})
        if loop-number is 1:
            remove 1 from y-coordinate of {_q}
        else if loop-number is 2:
            add 1 to x-coordinate of {_q}
        else if loop-number is 3:
            remove 1 from x-coordinate of {_q}
        else if loop-number is 4:
            add 1 to z-coordinate of {_q}
        else if loop-number is 5:
            remove 1 from z-coordinate of {_q}
        else:
            add 1 to y-coordinate of {_q}
        if bgIsRock(block at {_q}) is true:
            set {_ph} to type of block at {_q}
            exit loop
    set block at {_l} to {_ph}
    set {_k} to "%floor(x-coordinate of {_l})%_%floor(y-coordinate of {_l})%_%floor(z-coordinate of {_l})%"
    set {bg::oreq::%{_k}%} to true
    set {bg::oreq::%{_k}%::l} to {_l}
    set {bg::oreq::%{_k}%::t} to {_ty}
    set {bg::oreq::%{_k}%::at} to now
    set {bg::oreq::%{_k}%::rg} to {_rg}
    if {_bt} is not "none":
        set {bg::oreq::%{_k}%::base} to true
    set {bg::oreq::%{_k}%::ph} to {_ph}
    if bgIsFighter(player) is true:
        # 풍부한 광맥 (팀 강화): 확률로 2개
        set {_amt} to bgOreBonus(player)
        bgCmd("give %name of player% minecraft:%{_drop}% %{_amt}%")
        if {_amt} > 1:
            send action bar "&e&l+%{_amt}% %{_nm}% &6(풍부한 광맥!) &7— 상점 '광물 일괄 판매'에서 코인으로" to player
        else:
            send action bar "&a+1 %{_nm}% &7— 상점 '광물 일괄 판매'에서 코인으로 · 죽으면 떨어뜨림" to player
        play sound "entity.item.pickup" to player
    play sound "block.amethyst_block.break" to player
    bgParticle({_l}, "wax_on", 0.4, 0.4, 0.4, 0.1, 10)

function bgOreRegen(all: boolean):
    loop {bg::oreq::*}:
        set {_k} to loop-index
        if {bg::oreq::%{_k}%::at} is set:
            set {_go} to {_all}
            set {_rgs} to "%{bg::oreq::%{_k}%::rg} ? 3% seconds" parsed as timespan
            if difference between {bg::oreq::%{_k}%::at} and now >= {_rgs}:
                set {_go} to true
            if {_go} is true:
                set {_l} to {bg::oreq::%{_k}%::l}
                set {_ph} to {bg::oreq::%{_k}%::ph} ? bedrock
                if block at {_l} is {_ph}:
                    # 다시 채울 때 광석 종류는 무작위 (본진 바위: 철 · 구리 · 금 / 맵 광맥: 철 · 금 · 에메랄드 · 다이아)
                    set {_r} to random integer between 1 and 10
                    # 본진 바위인지 (예전 기록은 리젠 5초 = 본진)
                    set {_isb} to false
                    if {bg::oreq::%{_k}%::base} is true:
                        set {_isb} to true
                    if {bg::oreq::%{_k}%::rg} is 5:
                        set {_isb} to true
                    if {_isb} is true:
                        if {_r} <= 4:
                            set block at {_l} to iron ore
                        else if {_r} <= 8:
                            set block at {_l} to copper ore
                        else:
                            set block at {_l} to gold ore
                    else:
                        if {_r} <= 3:
                            set block at {_l} to iron ore
                        else if {_r} <= 7:
                            set block at {_l} to gold ore
                        else if {_r} <= 9:
                            set block at {_l} to emerald ore
                        else:
                            set block at {_l} to diamond ore
                    bgParticle({_l}, "happy_villager", 0.4, 0.4, 0.4, 0, 6)
                delete {bg::oreq::%{_k}%::*}
                delete {bg::oreq::%{_k}%}

every 1 second:
    bgOreRegen(false)

on load:
    bgOreRegen(true)

# ─────────────────────────────────────────────────────────── 못 버리는 아이템
#  귀속 저주가 붙은 아이템(기본 장비 · 산 장비) · 전설 무기는 Q 로 버릴 수 없음 (죽으면 전설 무기는 떨어짐)
on drop:
    player's gamemode is not creative
    set {_i} to event-item
    if {_i} is enchanted with curse of binding:
        cancel event
        send action bar "&c이 아이템은 버릴 수 없습니다 (귀속)" to player
        stop
    if bgIsLegend({_i}) is not "":
        cancel event
        send action bar "&c전설 무기는 버릴 수 없습니다" to player

# 코어 자연 회복: 15초 동안 안 맞으면 3초마다 1칸씩 회복
every 3 seconds:
    {-bg::on} is true
    loop {-bg::teams::*}:
        set {_t} to loop-value
        if {-bg::core::%{_t}%::down} is not true:
            if ({-bg::core::%{_t}%::hits} ? 0) > 0:
                set {_ok} to true
                if {-bg::core::%{_t}%::last} is set:
                    if difference between {-bg::core::%{_t}%::last} and now < 15 seconds:
                        set {_ok} to false
                if {_ok} is true:
                    remove 1 from {-bg::core::%{_t}%::hits}
                    # 코어 보강 Lv.3: 회복 2배
                    if bgUpLv({_t}, "core") >= 3:
                        if {-bg::core::%{_t}%::hits} > 0:
                            remove 1 from {-bg::core::%{_t}%::hits}
                    bgCoreText({_t})
                    bgParticle(bgUp(bgMk("base_%{_t}%_beacon"), 3), "happy_villager", 0.6, 0.6, 0.6, 0, 4)

function bgIsRock(b: block) :: boolean:
    if {_b} is stone:
        return true
    if {_b} is andesite:
        return true
    if {_b} is cobblestone:
        return true
    if {_b} is tuff:
        return true
    if {_b} is mossy cobblestone:
        return true
    return false

# ─────────────────────────────────────────────────────────── 보관함 못 열게
#  상자 · 통 · 셜커 상자 · 엔더 상자 · 호퍼 등에 아이템을 넣어 뒀다가 다음 판에 꺼내 쓰는 것을 막음 (크리에이티브 관리자는 예외)
on right click on chest or trapped chest or barrel or ender chest or shulker box or hopper or dispenser or dropper or crafter or decorated pot or chiseled bookshelf:
    player's gamemode is not creative
    cancel event
    send action bar "&c보관함은 열 수 없습니다" to player

on inventory open:
    player's gamemode is not creative
    set {_t} to "%inventory type of event-inventory%"
    if {_t} contains "shulker":
        cancel event
    else if {_t} contains "ender":
        cancel event
    else if {_t} contains "barrel":
        cancel event
    else if {_t} contains "hopper":
        cancel event
    else if {_t} contains "dispenser":
        cancel event
    else if {_t} contains "dropper":
        cancel event
