# ═════════════════════════════════════════════════════════════════════════════
#  포털 다리 · 포털 파쿠르
#   허브 가운데 스폰 바로 앞 하늘색 발판을 밟으면 → 그 사람 화면에만 빛나는 무지개 색유리 조각(디스플레이)이
#     발판 앞에서부터 한 줄씩 사사사삭 아래에서 솟아올라 고리까지 다리를 이어 감 (약 2초) → 그 다리를 타고 고리로 올라감
#     (발판 쪽부터 빨 · 주 · 노 · 초 · 하늘 · 파 · 보라 · 4칸마다 한 칸씩 올라감)
#     (다른 사람에게는 안 보이고 밟을 수도 없음 · 다리 위에서는 떨어져도 다치지 않음 · 60초 또는 다리에서 벗어나면 사라짐)
#   고리 안으로 들어가면 → 포털 파쿠르 (허브 남쪽 하늘 · 우주 배경): 빛나는 행성 둘레를 돌며 올라가는 50단 · 꼭대기 트로피
#     체크포인트 없음 — 떨어지면 처음부터 (기록도 다시) · 기록 타이머 · 최고 기록 · /파쿠르 랭킹 · 9번 칸 나가기 버튼 (허브로)
#     다른 사람은 안 보이고 안 밀림: 팀 0hubpk (충돌 없음 · 이름표 숨김 · 같은 팀 투명 안 보임) + 파티클 없는 투명 효과
#   파쿠르 원점 = 허브 원점 + (0, 10, 200)  (storage bg:pk origin, arena/tools/pkgen.py)
#   맵 2 천공의 정원 = 허브 원점 + (0, 10, 340)  (storage bg:pk2 origin, arena/tools/pkgen2.py) — 떠 있는 섬 5층 지그재그 · 사다리 탑 · 황금 신전
#   고리에 들어가면 맵 고르는 창 (닫으면 지난번 맵) · 기록 · 랭킹은 맵마다 따로 ({bg::pk::best::*} · {bg::pk2::best::*})
# ═════════════════════════════════════════════════════════════════════════════

import:
    org.bukkit.Bukkit
    org.bukkit.Color
    org.bukkit.entity.BlockDisplay

# ─────────────────────────────────────────────────────────── 포털 다리 (플레이어마다 따로 — 가짜 블록)
#  발판 앞(z -7)에서 고리 면(z -38)까지 31칸, 바닥 + 1 에서 고리 구멍 바닥 높이(+8)까지 한 칸씩 올라감 · 폭 3
#  칸 = "x:y:z:색번호" (색번호 0~6 = 무지개, 줄마다)
function bgBridgeCells() :: texts:
    set {_k} to 0
    while {_k} < 31:
        set {_y} to floor(({_k} + 1) * 9 / 32)
        set {_half} to floor({_k} * 7 / 31)
        set {_z} to -7 - {_k}
        set {_x} to -1
        while {_x} <= 1:
            add "%{_x}%:%{_y}%:%{_z}%:%{_half}%" to {_out::*}
            add 1 to {_x}
        add 1 to {_k}
    return {_out::*}

function bgRainbow(i: number) :: text:
    set {_c::*} to "red", "orange", "yellow", "lime", "light_blue", "blue" and "purple"
    set {_n} to mod({_i}, 7) + 1
    return "minecraft:%{_c::%{_n}%}%_stained_glass"

function bgRainbowRGB(i: number) :: number:
    set {_c::*} to 16726072, 16747520, 16771584, 7995136, 5294079, 3359999 and 11817215
    set {_n} to mod({_i}, 7) + 1
    return {_c::%{_n}%}

function bgBridge(p: player, on: boolean):
    loop bgBridgeCells():
        set {_c::*} to loop-value split at ":"
        set {_x} to {_c::1} parsed as integer
        set {_y} to {_c::2} parsed as integer
        set {_z} to {_c::3} parsed as integer
        set {_hf} to {_c::4} parsed as integer
        set {_l} to bgHubAt({_x}, {_y}, {_z})
        set {_l2} to bgHubAt({_x}, {_y} + 1, {_z})
        if {_on} is true:
            {_p}.sendBlockChange({_l}, Bukkit.createBlockData(bgRainbow({_hf})))
        else:
            {_p}.sendBlockChange({_l}, (block at {_l}).getBlockData())
            {_p}.sendBlockChange({_l2}, (block at {_l2}).getBlockData())

function bgBridgeOn(p: player):
    set {_u} to "%uuid of {_p}%"
    set {-bg::bridge::%{_u}%} to now
    set {_tok} to random number between 0 and 1000000
    set {-bg::bridge::tok::%{_u}%} to {_tok}
    # 가짜 블록 위에 서 있으면 서버는 '떠 있다' 고 봄 → 날기 허용 (날기 시작은 막음)
    {_p}.setAllowFlight(true)
    play sound "block.beacon.activate" with volume 1 and pitch 1.6 to {_p}
    send action bar "&b✦ 포털이 응답합니다 &7— 고리에서 다리가 내려옵니다" to {_p}
    bgBridgeAnim({_p}, {_tok})

# 유리 조각을 한 줄(3칸)씩 제자리 2.5칸 아래에 만들어 위로 솟게 함 (발판 쪽 줄부터 고리 쪽으로)
#  t 틱: 줄 t 를 제자리 아래에 만듦 → 2틱 뒤 제자리로 순간이동 (teleport_duration 6틱 = 부드럽게 솟음)
#        → 9틱 뒤 그 줄을 밟을 수 있는 가짜 블록으로 바꾸고 조각은 지움
#  조각은 그 사람에게만 보임 (setVisibleByDefault false + showEntity)
function bgBridgeAnim(p: player, tok: number):
    set {_u} to "%uuid of {_p}%"
    set {_pl} to Bukkit.getPluginManager().getPlugin("Skript")
    set {_w} to bgWorld()
    set {_cells::*} to bgBridgeCells()
    set {_t} to 0
    while {_t} <= 40:
        if {-bg::bridge::tok::%{_u}%} is not {_tok}:
            stop
        if {_p} is not online:
            stop
        # 쏘기
        set {_k} to {_t}
        if {_k} <= 30:
            loop 3 times:
                set {_c::*} to {_cells::%{_k} * 3 + loop-number%} split at ":"
                set {_x} to {_c::1} parsed as integer
                set {_y} to {_c::2} parsed as integer
                set {_z} to {_c::3} parsed as integer
                set {_d} to Bukkit.createBlockData(bgRainbow({_c::4} parsed as integer))
                set {_glow} to Color.fromRGB(bgRainbowRGB({_c::4} parsed as integer))
                set {_n} to loop-number
                set {_e} to {_w}.spawn(bgHubAt({_x}, {_y} - 2.5, {_z}), BlockDisplay)
                {_e}.setPersistent(false)
                {_e}.setVisibleByDefault(false)
                {_p}.showEntity({_pl}, {_e})
                {_e}.setBlock({_d})
                {_e}.setTeleportDuration(6)
                {_e}.setGlowing(true)
                {_e}.setGlowColorOverride({_glow})
                add {_e} to {-bg::bridge::ents::%{_u}%::*}
                set {_row::%{_k}%::%{_n}%} to {_e}
                set {_dst::%{_k}%::%{_n}%} to bgHubAt({_x}, {_y}, {_z})
            play sound "block.amethyst_block.chime" with volume 0.9 and pitch (0.7 + {_t} * 0.04) to {_p}
            if mod({_t}, 3) is 0:
                bgParticle(bgHubAt(0.5, {_y} - 1, {_z} + 0.5), "end_rod", 1, 0.4, 0.3, 0.04, 6)
        # 날리기
        set {_k} to {_t} - 2
        if {_k} >= 0:
            if {_k} <= 30:
                loop {_row::%{_k}%::*}:
                    set {_e} to loop-value
                    {_e}.teleport({_dst::%{_k}%::%loop-index%})
        # 내려앉기 → 밟을 수 있게
        set {_k} to {_t} - 9
        if {_k} >= 0:
            if {_k} <= 30:
                loop {_row::%{_k}%::*}:
                    set {_e} to loop-value
                    {_p}.sendBlockChange({_dst::%{_k}%::%loop-index%}, {_e}.getBlock())
                    remove {_e} from {-bg::bridge::ents::%{_u}%::*}
                    {_e}.remove()
                play sound "block.glass.place" with volume 0.35 and pitch 1.7 to {_p}
                bgParticle(bgUp({_dst::%{_k}%::2}, 1.1), "end_rod", 1, 0.1, 0.3, 0.01, 3)
        add 1 to {_t}
        wait 1 tick
    send action bar "&b✦ 포털 다리가 열렸습니다 &7— 다리를 타고 로봇의 고리로 들어가세요" to {_p}

function bgBridgeOff(p: player):
    {-bg::bridge::%uuid of {_p}%} is set
    set {_u} to "%uuid of {_p}%"
    delete {-bg::bridge::%{_u}%}
    delete {-bg::bridge::tok::%{_u}%}
    loop {-bg::bridge::ents::%{_u}%::*}:
        set {_e} to loop-value
        {_e}.remove()
    delete {-bg::bridge::ents::%{_u}%::*}
    bgBridge({_p}, false)
    if gamemode of {_p} is not creative or spectator:
        {_p}.setAllowFlight(false)

on toggle flight:
    {-bg::bridge::%uuid of player%} is set
    gamemode of player is not creative
    cancel event

# 고리 안에 들어왔는지 (원점 기준 고리 가운데 · 반지름 4 · 고리 면 앞뒤 2칸)
function bgInPortal(p: player) :: boolean:
    bgHubReady() is true
    set {_c} to bgHubAt({-bg::hubmk::portal::x}, {-bg::hubmk::portal::y}, {-bg::hubmk::portal::z})
    if world of {_p} is not world of {_c}:
        return false
    set {_dx} to (x-coordinate of {_p}) - (x-coordinate of {_c})
    set {_dy} to (y-coordinate of {_p}) + 1 - (y-coordinate of {_c})
    set {_dz} to (z-coordinate of {_p}) - (z-coordinate of {_c})
    if abs({_dz}) > 2.2:
        return false
    if sqrt({_dx} * {_dx} + {_dy} * {_dy}) > 4.6:
        return false
    return true

every 5 ticks:
    bgHubReady() is true
    loop all players:
        set {_p} to loop-player
        if bgArea({_p}) is "hub":
            # 발판 밟으면 다리
            if bgDist2(location of {_p}, bgHubMk("bridge_pad")) < 1.9:
                if abs((y-coordinate of {_p}) - (y-coordinate of bgHubMk("bridge_pad"))) < 1.5:
                    if {-bg::bridge::%uuid of {_p}%} is not set:
                        bgBridgeOn({_p})
                    else:
                        set {-bg::bridge::%uuid of {_p}%} to now
            if {-bg::bridge::%uuid of {_p}%} is set:
                # 고리 통과 → 파쿠르
                if bgInPortal({_p}) is true:
                    if {-bg::pkgui::%uuid of {_p}%} is not set:
                        bgPkChoose({_p})
                else:
                    # 다리 근처에서 벗어나거나 60초 지나면 다리 닫기
                    set {_hx} to (x-coordinate of {_p}) - {bg::hub::x}
                    set {_hz} to (z-coordinate of {_p}) - {bg::hub::z}
                    if abs({_hx}) > 4:
                        bgBridgeOff({_p})
                    else if {_hz} > 2:
                        bgBridgeOff({_p})
                    else if difference between {-bg::bridge::%uuid of {_p}%} and now > 60 seconds:
                        bgBridgeOff({_p})
                    else:
                        bgParticle(bgUp(bgHubMk("portal"), 0), "portal", 2.5, 2.5, 0.4, 0.3, 20)
        else if {-bg::bridge::%uuid of {_p}%} is set:
            bgBridgeOff({_p})

# 포털 빛 (허브에 누가 있으면 늘)
every 1 second:
    bgHubReady() is true
    bgHubCount("hub") > 0
    set {_c} to bgHubMk("portal")
    bgParticle({_c}, "end_rod", 2.2, 2.2, 0.2, 0.01, 6)
    bgParticle({_c}, "reverse_portal", 3, 3, 0.3, 0.05, 14)

on quit:
    if {-bg::pkinv::%uuid of player%} is set:
        delete {-bg::pkinv::%uuid of player%}
        bgCmd("effect clear %name of player% invisibility")
    loop {-bg::bridge::ents::%uuid of player%::*}:
        set {_e} to loop-value
        {_e}.remove()
    delete {-bg::bridge::ents::%uuid of player%::*}
    delete {-bg::bridge::tok::%uuid of player%}
    delete {-bg::bridge::%uuid of player%}
    delete {-bg::pk::in::%uuid of player%}
    delete {-bg::pk::top::%uuid of player%}

# ─────────────────────────────────────────────────────────── 포털 파쿠르
function bgPkOn(p: player) :: boolean:
    if {-bg::pk::in::%uuid of {_p}%} is true:
        return true
    return false

# 맵 1 = 포털 파쿠르 (pk) · 맵 2 = 천공의 정원 (pk2)
function bgPkMap(p: player) :: number:
    return {-bg::pk::map::%uuid of {_p}%} ? 1

function bgPkKey(m: number) :: text:
    if {_m} is 2:
        return "pk2"
    return "pk"

function bgPkName(m: number) :: text:
    if {_m} is 2:
        return "천공의 정원"
    return "포털 파쿠르"

function bgPkCol(m: number) :: text:
    if {_m} is 2:
        return "&a"
    return "&d"

function bgPkAtM(m: number, dx: number, dy: number, dz: number) :: location:
    set {_oz} to 200
    if {_m} is 2:
        set {_oz} to 340
    return location({bg::hub::x} + {_dx}, {bg::hub::y} + 10 + {_dy}, {bg::hub::z} + {_oz} + {_dz}, bgWorld())

function bgPkMkM(m: number, n: text) :: location:
    set {_k} to "pkmk"
    if {_m} is 2:
        set {_k} to "pk2mk"
    set {_l} to bgPkAtM({_m}, {-bg::%{_k}%::%{_n}%::x}, {-bg::%{_k}%::%{_n}%::y}, {-bg::%{_k}%::%{_n}%::z})
    set yaw of {_l} to {-bg::%{_k}%::%{_n}%::yaw} ? 0
    return {_l}

# 그 사람이 있는 맵의 표지
function bgPkMk2(p: player, n: text) :: location:
    return bgPkMkM(bgPkMap({_p}), {_n})

function bgPkBest(m: number, u: text) :: number:
    set {_k} to bgPkKey({_m})
    return {bg::%{_k}%::best::%{_u}%}

function bgPkBuilt(m: number) :: boolean:
    set {_k} to bgPkKey({_m})
    if {bg::%{_k}%::built} is true:
        return true
    return false

# ─────────────────────────────────────────────────────────── 맵 고르기 (고리에 들어갔을 때)
function bgPkMapItem(p: player, m: number) :: item:
    if {_m} is 2:
        set {_it} to cherry sapling
        add "&7구름 위 떠 있는 섬 5층을 지그재그로" to {_lore::*}
        add "&7기믹: &a점프대 &7· &b빙판 멀리뛰기 &7· &f무너지는 구름" to {_lore::*}
        add "&7      &d공명 수정 (켜졌다 꺼짐) &7· &6황금 연속 점프대" to {_lore::*}
        add "&e난이도 &a1층 쉬움 &7→ &c5층 어려움" to {_lore::*}
    else:
        set {_it} to ender eye
        add "&7빛나는 행성 둘레를 돌며 올라가는 50단" to {_lore::*}
        add "&7우주 배경 · 꼭대기 트로피" to {_lore::*}
    add "" to {_lore::*}
    set {_b} to bgPkBest({_m}, "%uuid of {_p}%")
    if {_b} is set:
        add "&f내 최고 &6%bgPkTime({_b})%" to {_lore::*}
    else:
        add "&f내 최고 &7아직 없음" to {_lore::*}
    set {_k} to bgPkKey({_m})
    set {_ids::*} to sorted indices of {bg::%{_k}%::best::*} in ascending order
    if {_ids::1} is set:
        set {_u1} to {_ids::1}
        set {_n1} to {bg::pk::name::%{_u1}%} ? "?"
        add "&f1위 &e%{_n1}% &7· &a%bgPkTime(bgPkBest({_m}, {_u1}))%" to {_lore::*}
    if bgPkBuilt({_m}) is false:
        add "&c아직 안 지어짐 &7(관리자 /파쿠르 건설)" to {_lore::*}
    add "" to {_lore::*}
    add "&a▶ 클릭해서 출발" to {_lore::*}
    set name of {_it} to "%bgPkCol({_m})%&l%{_m}%. %bgPkName({_m})%"
    set lore of {_it} to {_lore::*}
    return {_it}

function bgPkChoose(p: player):
    set {_gui} to chest inventory with 3 rows named "&8&l파쿠르 &8| &7맵 고르기"
    set {_pane} to black stained glass pane named " "
    loop 27 times:
        set slot loop-number - 1 of {_gui} to {_pane}
    set slot 11 of {_gui} to bgPkMapItem({_p}, 1)
    set slot 15 of {_gui} to bgPkMapItem({_p}, 2)
    open {_gui} to {_p}
    set {-bg::pkgui::%uuid of {_p}%} to true
    play sound "block.portal.trigger" with volume 0.3 and pitch 1.8 to {_p}

function bgPkGo(p: player, m: number):
    delete {-bg::pkgui::%uuid of {_p}%}
    bgBridgeOff({_p})
    bgPkEnter({_p}, {_m})

on inventory click:
    {-bg::pkgui::%uuid of player%} is true
    cancel event
    set {_s} to raw index of event-slot
    set {_m} to 0
    if {_s} is 11:
        set {_m} to 1
    else if {_s} is 15:
        set {_m} to 2
    {_m} > 0
    delete {-bg::pkgui::%uuid of player%}
    close player's inventory
    play sound "ui.button.click" to player
    wait 1 tick
    bgPkGo(player, {_m})

on inventory drag:
    {-bg::pkgui::%uuid of player%} is true
    cancel event

# 고르지 않고 닫으면 지난번 맵으로 (다리 위 공중에 남지 않게)
on inventory close:
    {-bg::pkgui::%uuid of player%} is true
    delete {-bg::pkgui::%uuid of player%}
    wait 1 tick
    if player is online:
        if bgPkOn(player) is false:
            if {-bg::bridge::%uuid of player%} is set:
                bgPkGo(player, bgPkMap(player))

function bgPkTime(ms: number) :: text:
    set {_s} to floor({_ms} / 1000)
    set {_m} to floor({_s} / 60)
    set {_r} to mod({_s}, 60)
    set {_d} to floor(mod({_ms}, 1000) / 100)
    if {_r} < 10:
        return "%{_m}%:0%{_r}%.%{_d}%"
    return "%{_m}%:%{_r}%.%{_d}%"

function bgPkElapsed(p: player) :: number:
    set {_t0} to {-bg::pk::t0::%uuid of {_p}%}
    {_t0} is set
    return (difference between {_t0} and now) / (1 tick) * 50

# 처음부터 (떨어졌을 때 · /파쿠르 처음)
function bgPkRestart(p: player):
    set {-bg::pk::t0::%uuid of {_p}%} to now
    set {-bg::pk::top::%uuid of {_p}%} to y-coordinate of bgPkMk2({_p}, "start")
    teleport {_p} to bgPkMk2({_p}, "start")

function bgPkEnter(p: player, m: number = 0):
    if {_m} is 0:
        set {_m} to bgPkMap({_p})
    if bgPkBuilt({_m}) is false:
        if {_p} is op:
            send "&d[파쿠르] &f코스가 없어서 지금 짓습니다..." to {_p}
            bgPkBuild({_p})
            stop
        send "&d[파쿠르] &f아직 코스가 없습니다. &7관리자가 &e/파쿠르 건설" to {_p}
        stop
    set {-bg::pk::map::%uuid of {_p}%} to {_m}
    set {-bg::pk::in::%uuid of {_p}%} to true
    set {-bg::where::%uuid of {_p}%} to "pk"
    set {bg::pk::name::%uuid of {_p}%} to name of {_p}
    bgParticle(location of {_p}, "reverse_portal", 0.6, 1, 0.6, 0.2, 60)
    bgPkRestart({_p})
    clear {_p}'s inventory
    bgExitItem({_p})
    bgCmd("effect give %name of {_p}% invisibility infinite 0 true")
    set {-bg::pkinv::%uuid of {_p}%} to true
    bgCmd("team join 0hubpk %name of {_p}%")
    set {-bg::tabteam::%uuid of {_p}%} to "0hubpk"
    play sound "block.portal.travel" with volume 0.4 and pitch 1.6 to {_p}
    if {_m} is 2:
        bgTitleP({_p}, "&a&l천공의 정원", "&f떠 있는 섬을 올라 꼭대기 황금 신전까지! &7· 떨어지면 처음부터")
    else:
        bgTitleP({_p}, "&d&l포털 파쿠르", "&f행성 둘레를 돌아 꼭대기 트로피까지! &7· 떨어지면 처음부터")

function bgPkLeave(p: player):
    delete {-bg::pk::in::%uuid of {_p}%}
    delete {-bg::pk::top::%uuid of {_p}%}
    bgToHub({_p})

function bgPkBuild(p: player):
    {bg::hub::x} is set
    bgCmd("data merge storage bg:pk {origin:{x:%{bg::hub::x}%,y:%{bg::hub::y} + 10%,z:%{bg::hub::z} + 200%}}")
    if bgBuildGo("pk") is true:
        loop 1200 times:
            wait 10 ticks
            if bgBuilt("pk") is true:
                exit loop
        set {bg::pk::built} to true
        send "&d[파쿠르] &a1. 포털 파쿠르 완성! &7(2. 천공의 정원 짓는 중…)" to {_p}
    bgCmd("data merge storage bg:pk2 {origin:{x:%{bg::hub::x}%,y:%{bg::hub::y} + 10%,z:%{bg::hub::z} + 340%}}")
    if bgBuildGo("pk2") is false:
        stop
    loop 1200 times:
        wait 10 ticks
        if bgBuilt("pk2") is true:
            exit loop
    set {bg::pk2::built} to true
    send "&d[파쿠르] &a2. 천공의 정원 완성!" to {_p}

every 5 ticks:
    loop all players:
        set {_p} to loop-player
        bgPkOn({_p}) is true
        set {_u} to "%uuid of {_p}%"
        set food level of {_p} to 20
        # 가장 높이 올라간 자리보다 6칸 넘게 떨어지면 → 처음부터 (코스는 계속 올라가기만 함)
        set {_y} to y-coordinate of {_p}
        set {_top} to {-bg::pk::top::%{_u}%} ? (y-coordinate of bgPkMk2({_p}, "start"))
        if {_y} > {_top}:
            if {_p} is on ground:
                set {-bg::pk::top::%{_u}%} to {_y}
        else if {_y} < {_top} - 6:
            bgPkRestart({_p})
            send title " " with subtitle "&c✖ 떨어졌다! &7처음부터" to {_p} for 25 ticks with fade in 0 ticks and fade out 8 ticks
            play sound "entity.enderman.teleport" with volume 0.6 and pitch 1.4 to {_p}

# ─────────────────────────────────────────────────────────── 결승 (매 틱 확인 → 기록이 늦게 찍히지 않게)
#  금 결승 발판(7×7) 위 어디든 닿는 순간 완주 — 결승 표지는 발판 가운데에서 남쪽 2칸 (pkgen.py) 이라 가운데 = 표지 z - 2
every tick:
    loop all players:
        bgPkOn(loop-player) is true
        set {_f} to bgPkMk2(loop-player, "finish")
        set {_dy} to (y-coordinate of loop-player) - (y-coordinate of {_f})
        if {_dy} > -0.3:
            if {_dy} < 1.6:
                if abs((x-coordinate of loop-player) - (x-coordinate of {_f})) <= 3.6:
                    if abs((z-coordinate of loop-player) - ((z-coordinate of {_f}) - 2)) <= 3.6:
                        bgPkFinish(loop-player)

# ─────────────────────────────────────────────────────────── 천공의 정원 기믹 (pkgen2.py)
#  점프대 (라임 유약 테라코타): 밟으면 표지 padv_<k> 속도로 다음 큰 섬까지 날아감
#  무너지는 구름 (흰 양털): 밟고 0.6초 뒤 그 사람 화면에서만 사라짐 (진짜로 빠짐) → 3.5초 뒤 돌아옴
#  공명 수정 (blinkA_<k> · blinkB_<k>): 1.5초마다 A ↔ B 번갈아 켜지고 꺼짐 · 꺼지기 0.5초 전 반짝 + 소리
every tick:
    loop all players:
        bgPkOn(loop-player) is true
        bgPkMap(loop-player) is 2
        set {_p} to loop-player
        set {_b} to block at bgUp(location of {_p}, -0.2)
        if type of {_b} is lime glazed terracotta:
            set {_u} to "%uuid of {_p}%"
            set {_k} to 0
            if {-bg::pk::padcd::%{_u}%} is set:
                if difference between {-bg::pk::padcd::%{_u}%} and now < 0.6 seconds:
                    set {_k} to 99
            while {-bg::pk2mk::pad_%{_k}%::x} is set:
                if bgDist2(location of {_p}, bgPkMkM(2, "pad_%{_k}%")) < 3:
                    set {-bg::pk::padcd::%{_u}%} to now
                    set velocity of {_p} to vector({-bg::pk2mk::padv_%{_k}%::x}, {-bg::pk2mk::padv_%{_k}%::y}, {-bg::pk2mk::padv_%{_k}%::z})
                    play sound "entity.breeze.jump" with volume 1 and pitch 1.2 to {_p}
                    play sound "block.amethyst_block.chime" with volume 1 and pitch 1.5 to {_p}
                    bgParticle(location of {_p}, "cherry_leaves", 1.2, 0.3, 1.2, 0, 30)
                    bgParticle(location of {_p}, "end_rod", 0.4, 0.2, 0.4, 0.15, 12)
                    set {_k} to 99
                add 1 to {_k}
        else if type of {_b} is white wool:
            set {_bl} to location of {_b}
            set {_key} to "%floor(x-coordinate of {_bl})%_%floor(y-coordinate of {_bl})%_%floor(z-coordinate of {_bl})%"
            if {-bg::pk::cr::%uuid of {_p}%::%{_key}%} is not set:
                set {-bg::pk::cr::%uuid of {_p}%::%{_key}%} to true
                bgPkCrumble({_p}, {_bl}, {_key})

function bgPkCrumble(p: player, l: location, key: text):
    play sound "block.wool.step" with volume 1 and pitch 0.6 to {_p}
    bgParticle(bgUp({_l}, 1), "cloud", 0.6, 0.05, 0.6, 0.01, 6)
    wait 12 ticks
    set {_dx} to -2
    while {_dx} <= 2:
        set {_dz} to -2
        while {_dz} <= 2:
            set {_c} to location((x-coordinate of {_l}) + {_dx}, y-coordinate of {_l}, (z-coordinate of {_l}) + {_dz}, world of {_l})
            if type of block at {_c} is white wool:
                add {_c} to {_gone::*}
                if {_p} is online:
                    {_p}.sendBlockChange({_c}, Bukkit.createBlockData("minecraft:air"))
            add 1 to {_dz}
        add 1 to {_dx}
    if {_p} is online:
        play sound "block.wool.break" with volume 1 and pitch 0.7 to {_p}
        bgParticle(bgUp({_l}, 0.5), "cloud", 1.2, 0.1, 1.2, 0.02, 30)
    wait 70 ticks
    if {_p} is online:
        loop {_gone::*}:
            {_p}.sendBlockChange(loop-value, (block at loop-value).getBlockData())
    delete {-bg::pk::cr::%uuid of {_p}%::%{_key}%}

function bgPkBlinkSet(on: text):
    set {_k} to 0
    while {-bg::pk2mk::blinkA_%{_k}%::x} is set:
        loop "A" and "B":
            set {_m} to "blink%loop-value%_%{_k}%"
            set {_l} to bgPkAtM(2, {-bg::pk2mk::%{_m}%::x}, {-bg::pk2mk::%{_m}%::y}, {-bg::pk2mk::%{_m}%::z})
            set {_x} to floor(x-coordinate of {_l})
            set {_y} to floor(y-coordinate of {_l})
            set {_z} to floor(z-coordinate of {_l})
            set {_blk} to "minecraft:air"
            if loop-value is {_on}:
                set {_blk} to "minecraft:amethyst_block"
                if loop-value is "B":
                    set {_blk} to "minecraft:purple_stained_glass"
            bgCmd("execute in %bgDim()% run fill %{_x} - 1% %{_y}% %{_z} - 1% %{_x} + 1% %{_y}% %{_z} + 1% %{_blk}%")
        add 1 to {_k}

function bgPkBlinkWarn(on: text):
    set {_k} to 0
    while {-bg::pk2mk::blink%{_on}%_%{_k}%::x} is set:
        set {_m} to "blink%{_on}%_%{_k}%"
        set {_l} to bgPkAtM(2, {-bg::pk2mk::%{_m}%::x} + 0.5, {-bg::pk2mk::%{_m}%::y} + 1.1, {-bg::pk2mk::%{_m}%::z} + 0.5)
        bgParticle({_l}, "wax_off", 1.2, 0.05, 1.2, 0, 14)
        add 1 to {_k}

every 5 ticks:
    {bg::pk2::built} is true
    set {_n} to 0
    loop all players:
        if bgPkOn(loop-player) is true:
            if bgPkMap(loop-player) is 2:
                add 1 to {_n}
                add loop-player to {_ps::*}
    {_n} > 0
    set {-bg::pk::blc} to mod(({-bg::pk::blc} ? 0) + 1, 12)
    set {_c} to {-bg::pk::blc}
    if {_c} is 0:
        bgPkBlinkSet("A")
        loop {_ps::*}:
            play sound "block.amethyst_block.resonate" with volume 0.7 and pitch 1.4 to loop-value
    else if {_c} is 6:
        bgPkBlinkSet("B")
        loop {_ps::*}:
            play sound "block.amethyst_block.resonate" with volume 0.7 and pitch 1.0 to loop-value
    else if {_c} is 4:
        bgPkBlinkWarn("A")
        loop {_ps::*}:
            play sound "block.note_block.hat" with volume 0.5 and pitch 1.6 to loop-value
    else if {_c} is 10:
        bgPkBlinkWarn("B")
        loop {_ps::*}:
            play sound "block.note_block.hat" with volume 0.5 and pitch 1.6 to loop-value

function bgPkFinish(p: player):
    set {_u} to "%uuid of {_p}%"
    {-bg::pk::in::%{_u}%} is true
    set {_ms} to bgPkElapsed({_p})
    delete {-bg::pk::in::%{_u}%}
    delete {-bg::pk::top::%{_u}%}
    set {_m} to bgPkMap({_p})
    set {_k} to bgPkKey({_m})
    set {_best} to {bg::%{_k}%::best::%{_u}%}
    set {_tt} to bgPkTime({_ms})
    if {_best} is not set:
        set {bg::%{_k}%::best::%{_u}%} to {_ms}
        set {_msg} to "&6첫 완주!"
    else if {_ms} < {_best}:
        set {bg::%{_k}%::best::%{_u}%} to {_ms}
        set {_msg} to "&6&l최고 기록 경신!"
    else:
        set {_msg} to "&7최고 기록 %bgPkTime({_best})%"
    add 1 to {bg::%{_k}%::clears::%{_u}%}
    bgTitleP({_p}, "&e&l완주! &f%{_tt}%", "%{_msg}%")
    play sound "ui.toast.challenge_complete" to {_p}
    bgParticle(location of {_p}, "firework", 1, 2, 1, 0.1, 80)
    broadcast "&d[파쿠르] &e%name of {_p}%&f 님이 %bgPkCol({_m})%%bgPkName({_m})%&f 완주! &6%{_tt}%"
    bgPkBoard()
    wait 3 seconds
    if {_p} is online:
        if bgPkOn({_p}) is false:
            if bgArea({_p}) is "myth":
                bgToHub({_p})

# 파쿠르 안 = 투명 (파티클 없음) · 나가면 바로 풀림 (어디로 나가든: 변수로 기억)
every 1 second:
    loop all players:
        if bgPkOn(loop-player) is true:
            bgCmd("effect give %name of loop-player% invisibility infinite 0 true")
            set {-bg::pkinv::%uuid of loop-player%} to true
        else if {-bg::pkinv::%uuid of loop-player%} is set:
            delete {-bg::pkinv::%uuid of loop-player%}
            bgCmd("effect clear %name of loop-player% invisibility")

every 2 ticks:
    loop all players:
        bgPkOn(loop-player) is true
        set {_u} to "%uuid of loop-player%"
        set {_ms} to bgPkElapsed(loop-player)
        set {_m} to bgPkMap(loop-player)
        set {_h} to floor((y-coordinate of loop-player) - (y-coordinate of bgPkMkM({_m}, "start")))
        set {_hm} to floor((y-coordinate of bgPkMkM({_m}, "finish")) - (y-coordinate of bgPkMkM({_m}, "start")))
        set {_best} to bgPkBest({_m}, {_u})
        set {_nm} to "%bgPkCol({_m})%&l%bgPkName({_m})%"
        if {_best} is set:
            send action bar "%{_nm}% &8| &f%bgPkTime({_ms})% &8| &b높이 %{_h}%/%{_hm}% &8| &7최고 &6%bgPkTime({_best})%" to loop-player
        else:
            send action bar "%{_nm}% &8| &f%bgPkTime({_ms})% &8| &b높이 %{_h}%/%{_hm}% &8| &7첫 완주에 도전!" to loop-player

on damage of player:
    bgPkOn(victim) is true
    cancel event

on break:
    bgPkOn(player) is true
    gamemode of player is not creative
    cancel event

on place:
    bgPkOn(player) is true
    gamemode of player is not creative
    cancel event

command /파쿠르 [<text>] [<text>] [<text>]:
    aliases: /parkour, /pk
    trigger:
        if arg-1 is "건설":
            if sender is a player:
                if player is op:
                    bgPkBuild(player)
                    send "&d[파쿠르] &f코스 2개를 짓는 중... (약 25초)"
            stop
        # 전체 이동 (관리자): 서버의 모든 사람 (신화쟁탈전 게임 중 · 관전 끔 제외) → 파쿠르 시작 발판 (/파쿠르 전체 [1|2])
        if arg-1 is "전체" or "@a" or "all":
            if sender is a player:
                if player is not op:
                    send "&c다른 사람을 보내는 건 관리자만 할 수 있습니다."
                    stop
            set {_m} to 1
            if arg-2 is "2":
                set {_m} to 2
            if bgPkBuilt({_m}) is false:
                send "&d[파쿠르] &c코스가 아직 없습니다. &e/파쿠르 건설 &7을 먼저 해 주세요"
                stop
            set {_n} to 0
            loop all players:
                if bgPkOn(loop-player) is false:
                    if bgInGame(loop-player) is false:
                        if bgOptOut(loop-player) is false:
                            delete {-bg::forced::%uuid of loop-player%}
                            bgToHub(loop-player)
                            bgBridgeOff(loop-player)
                            bgPkEnter(loop-player, {_m})
                            bgForcedSet(loop-player, "pk")
                            add 1 to {_n}
            broadcast "&d[파쿠르] &f관리자가 &e%{_n}%명&f을 %bgPkCol({_m})%%bgPkName({_m})%&f(으)로 보냈습니다."
            stop
        # 기록 지우기: /파쿠르 기록삭제 (내 기록 · 두 맵) · 관리자: /파쿠르 기록삭제 <플레이어|전체> [1|2] (맵 안 쓰면 두 맵 다)
        if arg-1 is "기록삭제" or "기록지우기":
            set {_ms::*} to 1 and 2
            if arg-3 is "1" or "2":
                set {_ms::*} to arg-3 parsed as integer
            if arg-2 is set:
                if arg-2 is "1" or "2":
                    if sender is a player:
                        set {_ms::*} to arg-2 parsed as integer
                        loop {_ms::*}:
                            set {_k} to bgPkKey(loop-value)
                            delete {bg::%{_k}%::best::%uuid of player%}
                            delete {bg::%{_k}%::clears::%uuid of player%}
                        send "&d[파쿠르] &f내 %bgPkName(arg-2 parsed as integer)% 기록을 지웠습니다."
                        bgPkBoard()
                    stop
                if sender is a player:
                    if player is not op:
                        send "&c다른 사람 기록은 관리자만 지울 수 있습니다."
                        stop
                if arg-2 is "전체" or "all":
                    loop {_ms::*}:
                        set {_k} to bgPkKey(loop-value)
                        delete {bg::%{_k}%::best::*}
                        delete {bg::%{_k}%::clears::*}
                    broadcast "&d[파쿠르] &f관리자가 랭킹을 지웠습니다. &7(%size of {_ms::*}%개 맵)"
                    bgPkBoard()
                    stop
                set {_t} to arg-2 parsed as offline player
                set {_tu} to "%uuid of {_t}%"
                set {_had} to false
                loop {_ms::*}:
                    set {_k} to bgPkKey(loop-value)
                    if {bg::%{_k}%::best::%{_tu}%} is set:
                        set {_had} to true
                    delete {bg::%{_k}%::best::%{_tu}%}
                    delete {bg::%{_k}%::clears::%{_tu}%}
                if {_had} is false:
                    send "&d[파쿠르] &7%arg-2% 의 기록이 없습니다."
                    stop
                send "&d[파쿠르] &f%arg-2% 의 기록을 지웠습니다."
                bgPkBoard()
                stop
            if sender is not a player:
                stop
            loop {_ms::*}:
                set {_k} to bgPkKey(loop-value)
                delete {bg::%{_k}%::best::%uuid of player%}
                delete {bg::%{_k}%::clears::%uuid of player%}
            send "&d[파쿠르] &f내 기록을 지웠습니다. &7(두 맵)"
            bgPkBoard()
            stop
        if arg-1 is "랭킹" or "순위":
            set {_m} to 1
            if arg-2 is "2":
                set {_m} to 2
            else if arg-2 is not set:
                if sender is a player:
                    set {_m} to bgPkMap(player)
            set {_k} to bgPkKey({_m})
            set {_ids::*} to sorted indices of {bg::%{_k}%::best::*} in ascending order
            send "%bgPkCol({_m})%&l[%bgPkName({_m})% 랭킹] &7가장 빠른 기록 10위 &8(/파쿠르 랭킹 1 · 2)"
            set {_i} to 0
            loop {_ids::*}:
                add 1 to {_i}
                if {_i} <= 10:
                    set {_u} to loop-value
                    set {_nm} to {bg::pk::name::%{_u}%} ? "?"
                    send "&e  %{_i}%위 &f%{_nm}% &7— &6%bgPkTime(bgPkBest({_m}, {_u}))%"
            if {_i} is 0:
                send "&7  아직 기록이 없습니다."
            stop
        # 맵 바꾸기 (파쿠르 안에서 · 허브에서): /파쿠르 맵 [1|2]
        if arg-1 is "맵" or "1" or "2":
            if sender is not a player:
                stop
            set {_m} to 0
            if arg-1 is "1" or "2":
                set {_m} to arg-1 parsed as integer
            else if arg-2 is "1" or "2":
                set {_m} to arg-2 parsed as integer
            if {_m} is 0:
                send "&d[파쿠르] &f맵: &d1. 포털 파쿠르 &7· &a2. 천공의 정원 &7— &e/파쿠르 맵 2"
                stop
            if bgPkOn(player) is false:
                if bgArea(player) is not "hub":
                    send "&d[파쿠르] &7허브에서만 바로 갈 수 있어요."
                    stop
            bgPkEnter(player, {_m})
            stop
        if sender is not a player:
            stop
        if arg-1 is "나가기":
            if bgForced(player) is true:
                stop
            if bgPkOn(player) is true:
                bgPkLeave(player)
            stop
        if arg-1 is "처음":
            if bgPkOn(player) is true:
                bgPkRestart(player)
            stop
        send "&d[파쿠르] &f허브 가운데 앞 하늘색 발판을 밟고 다리를 건너 로봇의 고리로 들어가세요. &7(/파쿠르 맵 · 랭킹 · 처음 · 나가기)"

# ─────────────────────────────────────────────────────────── 랭킹판 (로봇 고리 안 · 맵마다 가장 빠른 기록 10위 · 왼쪽 맵 1 · 오른쪽 맵 2 · 오락실 글꼴 bg:arcade)
#  완주 · 기록 지우기 · 허브 짓기 뒤 · 1분마다 다시 그림
function bgPkBoard():
    bgHubReady() is true
    bgCmd("kill @e[type=text_display,tag=bg_pkrank]")
    bgPkBoardOne(1, -2.15)
    bgPkBoardOne(2, 2.15)

function bgPkBoardOne(m: number, ox: number):
    set {_k} to bgPkKey({_m})
    set {_ids::*} to sorted indices of {bg::%{_k}%::best::*} in ascending order
    set {_hc} to "§d"
    if {_m} is 2:
        set {_hc} to "§a"
    set {_t} to "%{_hc}%§l🏆 %bgPkName({_m})%§r\n§7가장 빠른 기록\n"
    set {_i} to 0
    loop {_ids::*}:
        add 1 to {_i}
        if {_i} <= 10:
            set {_u} to loop-value
            set {_nm} to {bg::pk::name::%{_u}%} ? "?"
            set {_c} to "§f"
            if {_i} is 1:
                set {_c} to "§6§l"
            else if {_i} is 2:
                set {_c} to "§e"
            else if {_i} is 3:
                set {_c} to "§b"
            set {_t} to "%{_t}%\n%{_c}%%{_i}%위 §f%{_nm}% §7· §a%bgPkTime(bgPkBest({_m}, {_u}))%"
    if {_i} is 0:
        set {_t} to "%{_t}%\n§7아직 기록이 없습니다\n§8첫 완주에 도전!"
    set {_l} to bgHubMk("portal")
    bgCmd("execute in %bgDim()% run summon text_display %bgC((x-coordinate of {_l}) + {_ox})% %bgN((y-coordinate of {_l}) - 0.7)% %bgC(z-coordinate of {_l})% {Tags:[""bg"",""bg_pkrank""],billboard:""vertical"",shadow:1b,background:1342177280,line_width:200,brightness:{sky:15,block:15},view_range:1f,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.85f,0.85f,0.85f]},text:{text:""%{_t}%"",font:""bg:arcade""}}")

on load:
    wait 100 ticks
    bgPkBoard()

every 60 seconds:
    bgPkBoard()
