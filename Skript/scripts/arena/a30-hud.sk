# ═════════════════════════════════════════════════════════════════════════════
#  왕관 쟁탈전 — 화면 위 보스바 (마인크래프트 기본 보스바, 폰트 없음 → 리소스팩 없어도 보임)
#   게임 중: 팀별 점수 · 남은 시간 막대 (내 팀 이름 굵게)
#   보스 출현: 빨간 체력 막대 + 이름 · 체력 숫자 · 격노/기절/시전 중 표시 (게임과 상관없이 모두에게)
# ═════════════════════════════════════════════════════════════════════════════

function bgPad2(n: number) :: text:
    if {_n} < 10:
        return "0%{_n}%"
    return "%{_n}%"

function bgHudCreate():
    loop "red", "blue", "green", "yellow" and "none":
        bgCmd("bossbar add bg:hud_%loop-value% """"")
        bgCmd("bossbar set bg:hud_%loop-value% style notched_10")
        bgCmd("bossbar set bg:hud_%loop-value% visible true")
        delete {-bg::hudlast::%loop-value%}
    bgCmd("bossbar set bg:hud_red color red")
    bgCmd("bossbar set bg:hud_blue color blue")
    bgCmd("bossbar set bg:hud_green color green")
    bgCmd("bossbar set bg:hud_yellow color yellow")
    bgCmd("bossbar set bg:hud_none color white")
    set {-bg::hudon} to true

function bgHudRemove():
    set {-bg::hudon} to false
    loop "red", "blue", "green", "yellow" and "none":
        bgCmd("bossbar remove bg:hud_%loop-value%")

# 점수 한 줄 (텍스트 컴포넌트, 내 팀은 굵게)
function bgHudLine(me: text) :: text:
    set {_s} to ""
    loop {-bg::teams::*}:
        set {_t} to loop-value
        set {_sc} to floor({-bg::score::%{_t}%} ? 0)
        set {_b} to "false"
        if {_t} is {_me}:
            set {_b} to "true"
        set {_s} to "%{_s}%{text:""%{-bg::tname::%{_t}%}% %{_sc}%   "",color:""%{-bg::tvan::%{_t}%}%"",bold:%{_b}%},"
    set {_left} to max(0, {bg::cfg::minutes} * 60 - ({-bg::sec} ? 0))
    set {_m} to floor({_left} / 60)
    set {_sec} to {_left} - {_m} * 60
    set {_s} to "%{_s}%{text:""남은 시간 %bgPad2({_m})%:%bgPad2({_sec})%"",color:""white""}"
    return "[{text:""""},%{_s}%]"

every 10 ticks:
    {-bg::hudon} is true
    set {_total} to max(1, {bg::cfg::minutes} * 60)
    set {_left} to max(0, {_total} - ({-bg::sec} ? 0))
    set {_v} to round(100 * {_left} / {_total})
    loop "red", "blue", "green", "yellow" and "none":
        set {_line} to bgHudLine(loop-value)
        if {-bg::hudlast::%loop-value%} is not {_line}:
            set {-bg::hudlast::%loop-value%} to {_line}
            bgCmd("bossbar set bg:hud_%loop-value% name %{_line}%")
        bgCmd("bossbar set bg:hud_%loop-value% max 100")
        bgCmd("bossbar set bg:hud_%loop-value% value %{_v}%")

every 1 second:
    {-bg::hudon} is true
    loop "red", "blue", "green" and "yellow":
        bgCmd("bossbar set bg:hud_%loop-value% players @a[team=bg_%loop-value%]")
    bgCmd("bossbar set bg:hud_none players @a[team=!bg_red,team=!bg_blue,team=!bg_green,team=!bg_yellow]")

# ─────────────────────────────────────────────────────────── 보스 체력 막대
function bgBossBarShow():
    bgCmd("bossbar add bg:boss """"")
    bgCmd("bossbar set bg:boss color red")
    bgCmd("bossbar set bg:boss style notched_20")
    bgCmd("bossbar set bg:boss visible true")
    bgCmd("bossbar set bg:boss players @a")
    delete {-bg::bosslast}

function bgBossBarHide():
    bgCmd("bossbar remove bg:boss")
    delete {-bg::bosslast}

every 4 ticks:
    {-bg::boss::id} is set
    set {_id} to {-bg::boss::id}
    set {_max} to max(1, {-bg::boss::max})
    set {_hp} to max(0, ceil({-bg::boss::hp}))
    set {_tag} to ""
    if {-bg::boss::rage} is true:
        set {_tag} to ",{text:""  [격노]"",color:""dark_red"",bold:true}"
    if {-bg::boss::state} is "stun":
        set {_tag} to ",{text:""  [기절 - 받는 피해 1.5배]"",color:""yellow"",bold:true}"
    else if {-bg::boss::skill} is set:
        set {_tag} to "%{_tag}%,{text:""  > %{-bg::boss::skill}%"",color:""gold""}"
    set {_name} to "[{text:""%{-bg::bd::%{_id}%::name}%  "",color:""red"",bold:true},{text:""%{_hp}% / %{_max}%"",color:""white""}%{_tag}%]"
    if {-bg::bosslast} is not {_name}:
        set {-bg::bosslast} to {_name}
        bgCmd("bossbar set bg:boss name %{_name}%")
    bgCmd("bossbar set bg:boss max %{_max}%")
    bgCmd("bossbar set bg:boss value %{_hp}%")

every 2 seconds:
    {-bg::boss::id} is set
    bgCmd("bossbar set bg:boss players @a")
    if {-bg::boss::rage} is true:
        bgCmd("bossbar set bg:boss color purple")
