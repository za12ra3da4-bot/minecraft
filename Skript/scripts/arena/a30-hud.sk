# ═════════════════════════════════════════════════════════════════════════════
#  왕관 쟁탈전 — 화면 위 HUD (보스바 이름 = 폰트 글리프 합성)
#   윗줄: 팀 점수판 4개 (내 팀 강조) + 남은 시간
#   아랫줄(보스 출현 시): 초상화 원 · 이름 배너 · 칸 나뉜 체력바 · 숫자 · 번개 원 · 시전 게이지
#  글리프 · 공백 문자는 a01-gen-hud.sk 가 만든다. 보스 이름은 시전 중에도 바뀌지 않는다.
# ═════════════════════════════════════════════════════════════════════════════

function bgDigits(txt: text, cx: number, key: text) :: text:
    set {_len} to length of {_txt}
    set {_w} to {_len} * 8
    set {_x} to round({_cx} - {_w} / 2)
    set {_s} to ""
    loop {_len} times:
        set {_ch} to subtext of {_txt} from characters loop-number to loop-number
        if {_ch} is "/":
            set {_ch} to "s"
        else if {_ch} is ":":
            set {_ch} to "c"
        set {_s} to "%{_s}%%{-bg::hud::%{_key}%::%{_ch}%}%"
    set {_back} to -1 * ({_x} + {_w})
    return "%{-bg::sp::%{_x}%}%%{_s}%%{-bg::sp::%{_back}%}%"

function bgPad2(n: number) :: text:
    if {_n} < 10:
        return "0%{_n}%"
    return "%{_n}%"

# 공통 윗줄 (점수 · 시간) — 내 팀 판만 다르다
function bgHudTop(me: text) :: text:
    set {_s} to ""
    loop {-bg::teams::*}:
        if loop-value is {_me}:
            set {_s} to "%{_s}%%{-bg::hud::plate::%loop-value%_me}%"
        else:
            set {_s} to "%{_s}%%{-bg::hud::plate::%loop-value%}%"
    loop {-bg::teams::*}:
        set {_sc} to floor({-bg::score::%loop-value%} ? 0)
        set {_d} to bgDigits("%{_sc}%", {-bg::hud::platecx::%loop-value%}, "hd")
        set {_s} to "%{_s}%%{_d}%"
    set {_left} to max(0, {bg::cfg::minutes} * 60 - ({-bg::sec} ? 0))
    set {_m} to floor({_left} / 60)
    set {_sec} to {_left} - {_m} * 60
    set {_d} to bgDigits("%bgPad2({_m})%:%bgPad2({_sec})%", 150, "td")
    set {_s} to "%{_s}%%{-bg::hud::timer}%%{_d}%"
    return {_s}

function bgHudBoss() :: text:
    set {_id} to {-bg::boss::id}
    set {_max} to {-bg::boss::max}
    set {_hp} to max(0, {-bg::boss::hp})
    set {_fw} to {-bg::hud::fill_w}
    set {_tr} to max({_hp}, {-bg::boss::trail} - {_max} * 0.012)
    set {-bg::boss::trail} to {_tr}
    set {_tp} to round({_fw} * min(1, {_tr} / {_max}))
    set {_hpx} to round({_fw} * min(1, {_hp} / {_max}))
    if {_hp} > 0:
        if {_hpx} is 0:
            set {_hpx} to 1
    set {_st} to "normal"
    if {-bg::boss::rage} is true:
        set {_st} to "rage"
    set {_stat} to {_st}
    if {-bg::boss::state} is "stun":
        set {_stat} to "stun"
    set {_cpx} to round({-bg::hud::cast_w} * min(1, max(0, {-bg::boss::cast} ? 0)))
    set {_dia} to "idle"
    if {-bg::boss::skill} is set:
        set {_dia} to "lit"
    set {_s} to "%{-bg::hud::boss_back}%%{-bg::hud::trail::%{_tp}%}%%{-bg::hud::hp::%{_hpx}%}%%{-bg::hud::boss_front}%"
    set {_s} to "%{_s}%%{-bg::hud::banner::%{_st}%}%%{-bg::hud::name::%{_id}%}%%{-bg::hud::portrait::%{_id}%}%%{-bg::hud::status::%{_stat}%}%"
    set {_s} to "%{_s}%%{-bg::hud::cast::%{_cpx}%}%%{-bg::hud::diamond::%{_dia}%}%"
    set {_d} to bgDigits("%ceil({_hp})%/%{_max}%", {-bg::hud::boss_x} + 120, "bd")
    set {_s} to "%{_s}%%{_d}%"
    return {_s}

# 모든 막대 공통: 기본 막대는 리소스팩이 투명하게 지우고(white), 이름 자리에 글리프 그림을 겹친다
function bgBarInit(id: text):
    bgCmd("bossbar add %{_id}% """"")
    bgCmd("bossbar set %{_id}% color white")
    bgCmd("bossbar set %{_id}% style progress")
    bgCmd("bossbar set %{_id}% max 1")
    bgCmd("bossbar set %{_id}% value 0")
    bgCmd("bossbar set %{_id}% visible true")

function bgHudCreate():
    # 팀마다 두 개: bg:hud_<팀> (점수판 + 보스 체력) · bg:hud_<팀>_nb (점수판만) — 보스 근처에 있는 사람만 앞의 것
    loop "red", "blue", "green", "yellow" and "none":
        bgBarInit("bg:hud_%loop-value%")
        bgBarInit("bg:hud_%loop-value%_nb")
        delete {-bg::hudlast::%loop-value%}
        delete {-bg::hudlast::%loop-value%_nb}
    set {-bg::hudon} to true
    bgCmd("bossbar set bg:boss players")
    bgSideCreate()

function bgHudRemove():
    set {-bg::hudon} to false
    bgSideRemove()
    loop "red", "blue", "green", "yellow" and "none":
        bgCmd("bossbar remove bg:hud_%loop-value%")
        bgCmd("bossbar remove bg:hud_%loop-value%_nb")
        delete {-bg::hudlast::%loop-value%}
        delete {-bg::hudlast::%loop-value%_nb}
    delete {-bg::bosslast}

function bgHudName(id: text, s: text):
    set {_half} to {-bg::hud::total_w} / 2
    set {_str} to "%{-bg::sp::-%{_half}%}%%{_s}%%{-bg::sp::%{_half}%}%"
    bgCmd("bossbar set %{_id}% name {text:""%{_str}%"",font:""bg:hud"",color:""white"",shadow_color:0}")

every 4 ticks:
    {-bg::hud::ready} is true
    set {_boss} to ""
    if {-bg::boss::id} is set:
        set {_boss} to bgHudBoss()
    if {-bg::hudon} is true:
        loop "red", "blue", "green", "yellow" and "none":
            set {_top} to bgHudTop(loop-value)
            set {_str} to "%{_top}%%{_boss}%"
            # 바뀔 때만 보낸다 (깜빡임 방지)
            if {-bg::hudlast::%loop-value%} is not {_str}:
                set {-bg::hudlast::%loop-value%} to {_str}
                bgHudName("bg:hud_%loop-value%", {_str})
            if {-bg::hudlast::%loop-value%_nb} is not {_top}:
                set {-bg::hudlast::%loop-value%_nb} to {_top}
                bgHudName("bg:hud_%loop-value%_nb", {_top})
    else if {-bg::boss::id} is set:
        if {-bg::bosslast} is not {_boss}:
            set {-bg::bosslast} to {_boss}
            bgHudName("bg:boss", {_boss})

# 보스 체력은 보스 투기장 근처(40칸)에 있는 사람에게만
function bgNearBossSel(extra: text, near: boolean) :: text:
    if {_near} is true:
        return "@a[%{_extra}%distance=..40]"
    return "@a[%{_extra}%distance=40..]"

every 10 ticks:
    {-bg::hudon} is true
    loop "red", "blue", "green", "yellow" and "none":
        set {_f} to "team=bg_%loop-value%,"
        if loop-value is "none":
            set {_f} to "team=!bg_red,team=!bg_blue,team=!bg_green,team=!bg_yellow,"
        if {-bg::boss::id} is set:
            set {_h} to {-bg::boss::home}
            set {_at} to "execute in %bgDim()% positioned %bgC(x-coordinate of {_h})% %bgN(y-coordinate of {_h})% %bgC(z-coordinate of {_h})% run"
            bgCmd("%{_at}% bossbar set bg:hud_%loop-value% players %bgNearBossSel({_f}, true)%")
            bgCmd("%{_at}% bossbar set bg:hud_%loop-value%_nb players %bgNearBossSel({_f}, false)%")
        else:
            set {_sel} to "@a[team=bg_%loop-value%]"
            if loop-value is "none":
                set {_sel} to "@a[team=!bg_red,team=!bg_blue,team=!bg_green,team=!bg_yellow]"
            bgCmd("bossbar set bg:hud_%loop-value% players")
            bgCmd("bossbar set bg:hud_%loop-value%_nb players %{_sel}%")

# ─────────────────────────────────────────────────────────── 게임 밖 보스 막대 (보스만)
function bgBossBarShow():
    bgBarInit("bg:boss")
    delete {-bg::bosslast}
    set {-bg::boss::trail} to {-bg::boss::max}

function bgBossBarHide():
    bgCmd("bossbar remove bg:boss")
    delete {-bg::bosslast}

every 10 ticks:
    {-bg::boss::id} is set
    if {-bg::hudon} is true:
        bgCmd("bossbar set bg:boss players")
    else:
        set {_h} to {-bg::boss::home}
        bgCmd("execute in %bgDim()% positioned %bgC(x-coordinate of {_h})% %bgN(y-coordinate of {_h})% %bgC(z-coordinate of {_h})% run bossbar set bg:boss players @a[distance=..40]")

# ─────────────────────────────────────────────────────────── 오른쪽 거점 안내판 (점수판 옆)
#  어떤 거점을 먹으면 무슨 효과인지 + 지금 누가 가졌는지 / 쟁탈 · 점령 중
#  팀마다 따로 (sidebar.team.<색>) → 우리 팀이 가진 거점은 "우리 팀" 으로 강조. 관전 · 팀 없음은 공용 sidebar
on load:
    set {-bg::side::ic::temple} to "♛"
    set {-bg::side::ic::ares} to "⚔"
    set {-bg::side::ic::athena} to "⛨"
    set {-bg::side::ic::hermes} to "➶"
    set {-bg::side::ic::demeter} to "❤"
    set {-bg::side::icc::temple} to "gold"
    set {-bg::side::icc::ares} to "red"
    set {-bg::side::icc::athena} to "aqua"
    set {-bg::side::icc::hermes} to "green"
    set {-bg::side::icc::demeter} to "light_purple"
    set {-bg::side::eff::temple} to "점수 +3/초"
    set {-bg::side::eff::ares} to "힘 I"
    set {-bg::side::eff::athena} to "저항 I"
    set {-bg::side::eff::hermes} to "신속 I"
    set {-bg::side::eff::demeter} to "회복 · 배부름"

function bgSideCreate():
    loop "red", "blue", "green", "yellow" and "none":
        set {_o} to "bg_side_%loop-value%"
        bgCmd("scoreboard objectives remove %{_o}%")
        bgCmd("scoreboard objectives add %{_o}% dummy {text:""⚑ 거점 효과 ⚑"",color:""gold"",bold:true}")
        bgCmd("scoreboard objectives modify %{_o}% numberformat blank")
        set {_i} to 0
        loop 14 times:
            add 1 to {_i}
            bgCmd("scoreboard players set bgs%{_i}% %{_o}% %15 - {_i}%")
        delete {-bg::sidelast::%loop-value%::*}
        if loop-value is "none":
            bgCmd("scoreboard objectives setdisplay sidebar %{_o}%")
        else:
            bgCmd("scoreboard objectives setdisplay sidebar.team.%{-bg::tvan::%loop-value%}% %{_o}%")
    set {-bg::sideon} to true
    bgSideUpdate()

function bgSideRemove():
    set {-bg::sideon} to false
    loop "red", "blue", "green", "yellow" and "none":
        bgCmd("scoreboard objectives remove bg_side_%loop-value%")
        delete {-bg::sidelast::%loop-value%::*}

# 줄 하나 (바뀔 때만 보냄)
function bgSideSet(me: text, n: number, j: text):
    if {-bg::sidelast::%{_me}%::%{_n}%} is {_j}:
        stop
    set {-bg::sidelast::%{_me}%::%{_n}%} to {_j}
    bgCmd("scoreboard players display name bgs%{_n}% bg_side_%{_me}% %{_j}%")

# 거점 상태 한 줄
function bgSideState(p: text, me: text) :: text:
    set {_own} to {-bg::own::%{_p}%} ? "none"
    set {_capt} to {-bg::capt::%{_p}%} ? "none"
    set {_v} to floor({-bg::capv::%{_p}%} ? 0)
    if {-bg::contest::%{_p}%} is true:
        return "{text:""   ⚔ 쟁탈 중!"",color:""red"",bold:true}"
    if {_own} is not "none":
        set {_col} to {-bg::tvan::%{_own}%}
        set {_who} to "%{-bg::tname::%{_own}%}% 팀"
        set {_bold} to "false"
        if {_own} is {_me}:
            set {_who} to "우리 팀"
            set {_bold} to "true"
        if {_v} < 100:
            return "[{text:""   ▸ %{_who}% "",color:""%{_col}%"",bold:%{_bold}%},{text:""⚠ 흔들림 %{_v}%%%"",color:""red"",bold:false}]"
        return "[{text:""   ▸ "",color:""gray""},{text:""%{_who}% 점령"",color:""%{_col}%"",bold:%{_bold}%}]"
    if {_capt} is not "none":
        if {_v} > 0:
            set {_col} to {-bg::tvan::%{_capt}%}
            set {_who} to "%{-bg::tname::%{_capt}%}% 팀"
            if {_capt} is {_me}:
                set {_who} to "우리 팀"
            return "[{text:""   ▸ "",color:""gray""},{text:""%{_who}% 점령 중 %{_v}%%%"",color:""%{_col}%""}]"
    return "{text:""   ▸ 비어 있음"",color:""dark_gray""}"

function bgSideTeam(me: text):
    set {_n} to 1
    bgSideSet({_me}, {_n}, """""")
    loop {-bg::pts::*}:
        add 1 to {_n}
        set {_p} to loop-value
        set {_j} to "[{text:""%{-bg::side::ic::%{_p}%}% "",color:""%{-bg::side::icc::%{_p}%}%""},{text:""%{-bg::ptname::%{_p}%}% "",color:""white"",bold:true},{text:""%{-bg::side::eff::%{_p}%}%"",color:""yellow""}]"
        bgSideSet({_me}, {_n}, {_j})
        add 1 to {_n}
        bgSideSet({_me}, {_n}, bgSideState({_p}, {_me}))
    add 1 to {_n}
    bgSideSet({_me}, {_n}, """""")
    add 1 to {_n}
    bgSideSet({_me}, {_n}, "{text:""제단: 팀 전원 효과 · 점수 +1/초"",color:""gray""}")
    add 1 to {_n}
    bgSideSet({_me}, {_n}, "{text:""성소: 점수 3배 — 중앙을 지켜라"",color:""gray""}")

function bgSideUpdate():
    {-bg::sideon} is true
    loop "red", "blue", "green", "yellow" and "none":
        bgSideTeam(loop-value)

every 1 second:
    {-bg::sideon} is true
    bgSideUpdate()
