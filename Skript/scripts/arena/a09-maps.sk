# ═════════════════════════════════════════════════════════════════════════════
#  신화쟁탈전 — 맵 3개 (올림포스 · 빙하 왕국 · 화산 군도)
#   /전장 맵 <id> 로 고르고 → /전장 건설 로 그 자리에 짓는다 (같은 구조: 본진 4 · 대신전 · 제단 4 · 투기장 4 · 대기실)
#   맵 좌표는 a02-gen-map*.sk 가 {-bg::mks::<맵>::<마커>::x|y|z|radius|yaw|boss} 에 넣어 두고,
#   고른 맵 것만 {-bg::mk::*} 로 옮긴다 (게임 코드는 전부 bgMk 로 {-bg::mk::*} 를 읽음)
#   데이터팩: 올림포스 = bg:map/* · 다른 맵 = bg:maps/<id>/*
# ═════════════════════════════════════════════════════════════════════════════

on load:
    set {-bg::maplist::*} to "olympus", "frost" and "volcano"
    set {-bg::mapname::olympus} to "올림포스"
    set {-bg::mapname::frost} to "빙하 왕국"
    set {-bg::mapname::volcano} to "화산 군도"
    set {-bg::mapdesc::olympus} to "푸른 들판 · 신전 · 숲 — 기본 맵"
    set {-bg::mapdesc::frost} to "눈 덮인 설산 · 얼어붙은 강과 호수 · 거대한 얼음 첨탑"
    set {-bg::mapdesc::volcano} to "현무암 대지 · 용암 해자와 용암 강 · 가장자리 화산 네 개"
    if {bg::cfg::map} is not set:
        set {bg::cfg::map} to "olympus"
    if {-bg::mapname::%{bg::cfg::map}%} is not set:
        set {bg::cfg::map} to "olympus"
    bgMapApply({bg::cfg::map})

function bgMapId() :: text:
    return {bg::cfg::map} ? "olympus"

function bgMapName() :: text:
    return {-bg::mapname::%bgMapId()%} ? "올림포스"

# 데이터팩 함수 폴더
function bgMapFn() :: text:
    if bgMapId() is "olympus":
        return "map"
    return "maps/%bgMapId()%"

# 고른 맵의 마커를 게임용 {-bg::mk::*} 로
function bgMapApply(id: text):
    if {-bg::mks::%{_id}%::names::*} is not set:
        send "[전장] 맵 '%{_id}%' 좌표 파일(a02-gen-map)이 없습니다" to console
        stop
    delete {-bg::mk::*}
    loop {-bg::mks::%{_id}%::names::*}:
        set {_n} to loop-value
        set {-bg::mk::%{_n}%::x} to {-bg::mks::%{_id}%::%{_n}%::x}
        set {-bg::mk::%{_n}%::y} to {-bg::mks::%{_id}%::%{_n}%::y}
        set {-bg::mk::%{_n}%::z} to {-bg::mks::%{_id}%::%{_n}%::z}
        if {-bg::mks::%{_id}%::%{_n}%::radius} is set:
            set {-bg::mk::%{_n}%::radius} to {-bg::mks::%{_id}%::%{_n}%::radius}
        if {-bg::mks::%{_id}%::%{_n}%::yaw} is set:
            set {-bg::mk::%{_n}%::yaw} to {-bg::mks::%{_id}%::%{_n}%::yaw}
        if {-bg::mks::%{_id}%::%{_n}%::boss} is set:
            set {-bg::mk::%{_n}%::boss} to {-bg::mks::%{_id}%::%{_n}%::boss}
    set {-bg::mk::size} to {-bg::mks::%{_id}%::size} ? 256
    set {-bg::mk::ready} to true

function bgMapSelect(id: text):
    set {bg::cfg::map} to {_id}
    bgMapApply({_id})

function bgMapLines() :: texts:
    add "&6[전장] &f맵 목록 &7(지금: &e%bgMapName()%&7)" to {_o::*}
    loop {-bg::maplist::*}:
        set {_m} to "&7 · "
        if loop-value is bgMapId():
            set {_m} to "&a ▶ "
        add "%{_m}%&e%{-bg::mapname::%loop-value%}% &8(%loop-value%) &7— %{-bg::mapdesc::%loop-value%}%" to {_o::*}
    add "&7  /전장 맵 <id> → 맵 한가운데로 갈 자리에서 /전장 건설" to {_o::*}
    return {_o::*}

# 이 맵에서 나오는 보스 (없으면 전체)
function bgBossPool() :: texts:
    if {-bg::mapboss::%bgMapId()%::*} is set:
        loop {-bg::mapboss::%bgMapId()%::*}:
            if {-bg::bd::%loop-value%::name} is set:
                add loop-value to {_out::*}
        if size of {_out::*} > 0:
            return {_out::*}
    return {-bg::bd::list::*}

# ─────────────────────────────────────────────────────────── 날씨 연출 (맵 안 사람 주변)
#  빙하 왕국: 눈발 · 입김   화산 군도: 재 · 불티 · 가끔 용암 튐
every 10 ticks:
    if bgMapId() is "olympus":
        stop
    set {_w} to bgWorld()
    loop all players:
        if world of loop-player is {_w}:
            set {_l} to location of loop-player
            if bgMapId() is "frost":
                bgParticleTo(loop-player, bgUp({_l}, 7), "snowflake", 9, 3, 9, 0.02, 26)
                bgParticleTo(loop-player, bgUp({_l}, 3), "white_ash", 8, 3, 8, 0.01, 10)
            else:
                bgParticleTo(loop-player, bgUp({_l}, 6), "ash", 9, 4, 9, 0.01, 30)
                bgParticleTo(loop-player, bgUp({_l}, 3), "white_ash", 8, 3, 8, 0.01, 8)
                if random integer between 1 and 4 is 1:
                    bgParticleTo(loop-player, bgUp({_l}, 1), "lava", 8, 1, 8, 0, 2)

# 한 사람에게만 보이는 파티클 (날씨는 각자 화면에)
function bgParticleTo(p: player, l: location, pt: text, dx: number, dy: number, dz: number, spd: number, n: number):
    bgCmd("particle %{_pt}% %bgC(x-coordinate of {_l})% %bgN(y-coordinate of {_l})% %bgC(z-coordinate of {_l})% %bgN({_dx})% %bgN({_dy})% %bgN({_dz})% %bgN({_spd})% %{_n}% normal %bgPName({_p})%")
