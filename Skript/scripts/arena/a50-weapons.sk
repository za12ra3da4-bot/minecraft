    set {-bg::gear::pspeed::rgb::*} to 124, 175 and 198
    set {-bg::gear::pstr::rgb::*} to 147, 36 and 35
    set {-bg::gear::pregen::rgb::*} to 205, 92 and 171
    set {-bg::gear::pfire::rgb::*} to 228, 154 and 58
    set {-bg::gear::ppoison::rgb::*} to 78, 147 and 49
    set {-bg::gear::pleap::rgb::*} to 34, 255 and 76
    set {-bg::gear::heal::rgb::*} to 248, 36 and 35
    set {-bg::gear::ward::name} to "결계 부적"
    set {-bg::gear::ward::desc} to "우클릭 → 60초 동안 적 본진 결계 피해 무시 (코어 공격용)"
    set {-bg::gear::ward::price} to 35
    set {-bg::gear::ward::icon} to echo shard
    set {-bg::gear::ward::slot} to 13
    set {-bg::gear::food::name} to "구운 스테이크 16개"
    set {-bg::gear::food::desc} to "소모품 · 배고픔 회복"
    set {-bg::gear::food::price} to 5
    set {-bg::gear::food::icon} to cooked beef
    set {-bg::gear::food::slot} to 33
    set {-bg::gear::iron::name} to "철 갑옷 (투구 · 흉갑 · 부츠)"
    set {-bg::gear::iron::desc} to "바지는 병과 바지 그대로 (병과 구분) · 다이아 흉갑이 있으면 흉갑 유지 · 죽어도 유지"
    set {-bg::gear::iron::price} to 40
    set {-bg::gear::iron::icon} to iron chestplate
    set {-bg::gear::iron::slot} to 10
    set {-bg::gear::diamond::name} to "다이아몬드 흉갑"
    set {-bg::gear::diamond::desc} to "죽어도 유지됩니다"
    set {-bg::gear::diamond::price} to 80
    set {-bg::gear::diamond::icon} to diamond chestplate
    set {-bg::gear::diamond::slot} to 11
    set {-bg::gear::sword::name} to "주무기 강화"
    set {-bg::gear::sword::desc} to "병과에 맞는 주무기 (전사 검 · 수호자 도끼 · 궁수 활)"
    set {-bg::gear::sword::price} to 50
    set {-bg::gear::sword::icon} to iron sword
    set {-bg::gear::sword::slot} to 12
    set {-bg::gear::arrows::name} to "화살 32개"
    set {-bg::gear::arrows::desc} to "소모품"
    set {-bg::gear::arrows::price} to 14
    set {-bg::gear::arrows::icon} to arrow
    set {-bg::gear::arrows::slot} to 28
    set {-bg::gear::gapple::name} to "황금 사과"
    set {-bg::gear::gapple::desc} to "소모품"
    set {-bg::gear::gapple::price} to 15
    set {-bg::gear::gapple::icon} to golden apple
    set {-bg::gear::gapple::slot} to 34
    set {-bg::gear::heal::name} to "치유의 투척 물약"
    set {-bg::gear::heal::desc} to "던지면 즉시 2하트 회복"
    set {-bg::gear::heal::price} to 25
    set {-bg::gear::heal::icon} to splash potion
    set {-bg::gear::heal::slot} to 19
    # 칸 표 새로 만들기 (예전 배치의 칸 번호가 남아 있으면 빈칸을 눌러도 사지는 문제)
    delete {-bg::gearslot::*}
    delete {-bg::wslot::*}
    delete {-bg::bslot::*}
    loop {-bg::gear::list::*}:
        set {-bg::gearslot::%{-bg::gear::%loop-value%::slot}%} to loop-value
    # 전설 무기 진열 칸
    # 1쪽: 전설 무기 2줄 x 8 · 보스 무기 4 (3줄 가운데) / 2쪽: 장비 · 물약 · 화살 · 광물 판매
    set {-bg::wslots::*} to 9, 10, 11, 12, 13, 14, 15, 16, 18, 19, 20, 21, 22, 23, 24 and 25
    set {-bg::bslots::*} to 29, 30, 31 and 32
    set {_k} to 0
    loop {-bg::w::bosslist::*}:
        add 1 to {_k}
        set {-bg::bslot::%{-bg::bslots::%{_k}%}%} to loop-value
    set {_i} to 0
    loop {-bg::w::list::*}:
        add 1 to {_i}
        set {-bg::wslot::%{-bg::wslots::%{_i}%}%} to loop-value

# 리소스팩 그림으로 보이게 (item_model = bg:<m>)
function bgModelItem(i: item, m: text) :: item:
    set {_x} to {_i}.getItemMeta()
    {_x}.setItemModel(new NamespacedKey("bg", {_m}))
    {_i}.setItemMeta({_x})
    return {_i}

# 상점 아이콘용: 물약 · 화살에 색 입히기
function bgPotionIcon(i: item, r: number, g: number, b: number) :: item:
    set {_m} to {_i}.getItemMeta()
    {_m}.setColor(Color.fromRGB({_r}, {_g}, {_b}))
    {_i}.setItemMeta({_m})
    return {_i}

function bgGearDef(id: text, name: text, desc: text, price: number, icon: item, slot: number):
    set {-bg::gear::%{_id}%::name} to {_name}
    set {-bg::gear::%{_id}%::desc} to {_desc}
    set {-bg::gear::%{_id}%::price} to {_price}
    set {-bg::gear::%{_id}%::icon} to {_icon}
    set {-bg::gear::%{_id}%::slot} to {_slot}

# 팀 색 갑옷 장식 (철 · 다이아 · 사슬 갑옷은 염색이 안 돼서 팀 구별용) — 레드=레드스톤 · 블루=청금석 · 그린=에메랄드 · 옐로=금
function bgTrim(p: player) :: text:
    set {_t} to bgTeam({_p})
    set {_m} to "quartz"
    if {_t} is "red":
        set {_m} to "redstone"
    else if {_t} is "blue":
        set {_m} to "lapis"
    else if {_t} is "green":
        set {_m} to "emerald"
    else if {_t} is "yellow":
        set {_m} to "gold"
    return "{material:""minecraft:%{_m}%"",pattern:""minecraft:silence""}"

function bgGiveGear(p: player, g: text):
    set {_n} to name of {_p}
    if {_g} is "iron":
        set {bg::owned::%uuid of {_p}%::iron} to true
        bgCmd("item replace entity %{_n}% armor.head with iron_helmet[unbreakable={},enchantments={""minecraft:binding_curse"":1},enchantment_glint_override=false,trim=%bgTrim({_p})%]")
        bgCmd("item replace entity %{_n}% armor.feet with iron_boots[unbreakable={},enchantments={""minecraft:binding_curse"":1},enchantment_glint_override=false,trim=%bgTrim({_p})%]")
        # 다이아 흉갑을 이미 샀으면 흉갑은 그대로
        if {bg::owned::%uuid of {_p}%::diamond} is not true:
            bgCmd("item replace entity %{_n}% armor.chest with iron_chestplate[unbreakable={},enchantments={""minecraft:binding_curse"":1},enchantment_glint_override=false,trim=%bgTrim({_p})%]")
    else if {_g} is "diamond":
        set {bg::owned::%uuid of {_p}%::diamond} to true
        bgCmd("item replace entity %{_n}% armor.chest with diamond_chestplate[unbreakable={},enchantments={""minecraft:binding_curse"":1},enchantment_glint_override=false,trim=%bgTrim({_p})%]")
    else if {_g} is "sword":
        bgMainBuy({_p})
    else if {_g} is "arrows":
        bgCmd("give %{_n}% arrow[enchantments={""minecraft:binding_curse"":1},enchantment_glint_override=false] 32")
    else if {_g} is "gapple":
        bgCmd("give %{_n}% golden_apple 1")
    else if {_g} is "food":
        bgCmd("give %{_n}% cooked_beef 16")
    else if {_g} is "arrows64":
        bgCmd("give %{_n}% arrow[enchantments={""minecraft:binding_curse"":1},enchantment_glint_override=false] 64")
    else if {_g} is "spectral":
        bgCmd("give %{_n}% spectral_arrow[enchantments={""minecraft:binding_curse"":1},enchantment_glint_override=false] 16")
    else if {_g} is "parrow":
        bgCmd("give %{_n}% tipped_arrow[enchantments={""minecraft:binding_curse"":1},enchantment_glint_override=false,potion_contents={custom_color:5149489,custom_effects:[{id:""minecraft:poison"",amplifier:0b,duration:480}]}] 6")
    else if {_g} is "pspeed":
        bgCmd("give %{_n}% potion[potion_contents={custom_color:8171462,custom_effects:[{id:""minecraft:speed"",amplifier:0b,duration:300}]}] 1")
    else if {_g} is "pstr":
        bgCmd("give %{_n}% potion[potion_contents={custom_color:9643043,custom_effects:[{id:""minecraft:strength"",amplifier:0b,duration:160}]}] 1")
    else if {_g} is "pregen":
        bgCmd("give %{_n}% potion[potion_contents={custom_color:13458603,custom_effects:[{id:""minecraft:regeneration"",amplifier:0b,duration:160}]}] 1")
    else if {_g} is "pfire":
        bgCmd("give %{_n}% potion[potion_contents={custom_color:14981690,custom_effects:[{id:""minecraft:fire_resistance"",amplifier:0b,duration:600}]}] 1")
    else if {_g} is "ppoison":
        bgCmd("give %{_n}% splash_potion[potion_contents={custom_color:5149489,custom_effects:[{id:""minecraft:poison"",amplifier:0b,duration:80}]}] 1")
    else if {_g} is "pleap":
        bgCmd("give %{_n}% potion[potion_contents={custom_color:2293580,custom_effects:[{id:""minecraft:jump_boost"",amplifier:1b,duration:300}]}] 1")
    else if {_g} is "ward":
        bgCmd("give %{_n}% echo_shard[custom_name={text:""결계 부적"",color:""aqua"",bold:true,italic:false},lore=[{text:""우클릭: 60초 동안 적 본진 결계 피해 무시"",color:""gray"",italic:false}],enchantment_glint_override=true] 1")
    else:
        bgCmd("give %{_n}% splash_potion[potion_contents={potion:""minecraft:healing""}] 1")

# 부활 때 산 장비·전설 무기를 다시 준다 (bgKit 끝에서 호출)
function bgShopRestore(p: player):
    set {_u} to uuid of {_p}
    if {bg::owned::%{_u}%::iron} is true:
        bgGiveGear({_p}, "iron")
    if {bg::owned::%{_u}%::diamond} is true:
        bgGiveGear({_p}, "diamond")
    # 예전 '철 검' 구매 기록 → 주무기 강화 Lv.1 (주무기는 bgClassGear 가 단계에 맞게 준다)
    if {bg::owned::%{_u}%::sword} is true:
        delete {bg::owned::%{_u}%::sword}
        if ({bg::owned::%{_u}%::wlv} ? 0) < 1:
            set {bg::owned::%{_u}%::wlv} to 1
            bgClassSwitch({_p}, {bg::cls::%{_u}%} ? 0)
    loop {-bg::w::all::*}:
        if {bg::owned::%{_u}%::%loop-value%} is true:
            bgGiveWeapon({_p}, loop-value)

command /코인:
    trigger:
        set {_c} to {bg::coin::%uuid of player%} ? 0
        send "&6[코인] &f보유 &e%{_c}% 코인 &7— 10초마다 +1 · 처치 +10 · 점령 +15 · 점령 지점당 10초마다 +1 · 보스 +40"

# 관리자: 원하는 사람에게 코인 주기 / 빼기 / 정하기  (all = 접속한 전원)
command /코인주기 <text> <integer>:
    aliases: /givecoin
    permission: op
    usage: &c/코인주기 <플레이어|all> <수>  (음수면 뺌)
    trigger:
        if arg-1 is "all":
            loop all players:
                add arg-2 to {bg::coin::%uuid of loop-player%}
                set {_c} to {bg::coin::%uuid of loop-player%}
                send "&6[코인] &f관리자가 &e%arg-2%&f 코인을 줬습니다 &7(보유 %{_c}%)" to loop-player
            send "&6[전장] &f접속한 전원에게 %arg-2% 코인"
            stop
        set {_p} to arg-1 parsed as player
        if {_p} is not set:
            send "&c[전장] 플레이어 '%arg-1%' 를 찾을 수 없습니다 (접속 중이어야 함)."
            stop
        add arg-2 to {bg::coin::%uuid of {_p}%}
        set {_c} to {bg::coin::%uuid of {_p}%}
        send "&6[코인] &f관리자가 &e%arg-2%&f 코인을 줬습니다 &7(보유 %{_c}%)" to {_p}
        send "&6[전장] &f%name of {_p}% 에게 %arg-2% 코인 → 보유 %{_c}%"

command /코인설정 <player> <integer>:
    permission: op
    usage: &c/코인설정 <플레이어> <수>
    trigger:
        set {bg::coin::%uuid of arg-1%} to arg-2
        send "&6[코인] &f보유 코인이 &e%arg-2%&f 로 정해졌습니다." to arg-1
        send "&6[전장] &f%name of arg-1% 코인 = %arg-2%"

# ─────────────────────────────────────────────────────────── 상점
command /상점:
    aliases: /shop
    trigger:
        if {-bg::on} is true:
            if bgTeam(player) is not "none":
                if bgDist2(location of player, bgMk("base_%bgTeam(player)%")) > 24:
                    if bgInLobby(player) is false:
                        send "&6[상점] &f상점은 &e자기 본진&f이나 &e대기실&f에서만 열 수 있습니다."
                        stop
        bgShopOpen(player)

# 상점 상인 (블록 디스플레이 + 클릭 판정 interaction, 태그 bg_shopnpc) — 우클릭 · 좌클릭 모두 상점
on right click on entity:
    scoreboard tags of event-entity contain "bg_shopnpc"
    cancel event
    add "bg_wantshop" to scoreboard tags of player

# 데이터팩(tick)도 interaction 클릭을 잡아 같은 태그를 붙인다 → 여기서 한 번만 연다
every 2 ticks:
    loop all players:
        if scoreboard tags of loop-player contain "bg_wantshop":
            remove "bg_wantshop" from scoreboard tags of loop-player
            if {-bg::shop::%uuid of loop-player%} is not true:
                bgShopOpen(loop-player)


# 6줄 상자: 보라 유리판 바탕 + 전설 무기 8칸 (리소스팩 그림) + 장비 6칸 + 보유 코인
function bgShopOpen(p: player):
    bgShopPage({_p}, 1)

# 1쪽 = 전설 무기 · 보스 무기   2쪽 = 장비 · 물약 · 화살 · 광물 판매   3쪽 = 팀 강화 · 기지 함정 (a78)   (아래 화살표 칸으로 넘기기)
function bgShopPage(p: player, pg: number):
    set {_c} to {bg::coin::%uuid of {_p}%} ? 0
    # 리소스팩 그림 배경 (제목 글리프가 창 전체를 덮음) — 글리프가 없으면 유리판 상자
    set {_bgg} to {-bg::gui::shop%{_pg}%}
    if {_bgg} is set:
        set {_gui} to chest inventory with 6 rows named "&f%{_bgg}%"
    if {_gui} is not set:
        set {_gui} to chest inventory with 6 rows named "&5&l왕국 무기고 %{_pg}%/3 &8| &6%{_c}% 코인"
        set {_pane} to purple stained glass pane named " "
        loop 54 times:
            set slot loop-number - 1 of {_gui} to {_pane}
        if {_pg} is 1:
            set slot 53 of {_gui} to arrow named "&e&l다음 쪽 ▶ &f장비 · 소모품"
        else if {_pg} is 2:
            set slot 45 of {_gui} to arrow named "&e&l◀ 이전 쪽 &f전설 무기"
            set slot 53 of {_gui} to arrow named "&e&l다음 쪽 ▶ &f팀 강화 · 함정"
        else:
            set slot 45 of {_gui} to arrow named "&e&l◀ 이전 쪽 &f장비 · 소모품"
    if {_pg} is 1:
        # 광물 일괄 판매 (1쪽에도, 보유 코인 바로 위)
        set slot 40 of {_gui} to bgSellItem({_p})
        # 전설 무기 반납 (반값 환불) — 다음 쪽 화살표 바로 위
        set {_rf} to barrier named "&c&l전설 무기 반납"
        set lore of {_rf} to "&7마음에 안 드는 전설 무기를 돌려주고", "&7가격의 30%%(&e120 코인&7)를 돌려받습니다", "", "&f지금 가진 전설 무기: &e%bgLegendCount({_p})%&7/3", "&7(보스 · 신화 무기는 개수에 안 들어감)", "", "&c클릭해서 고르기"
        set slot 44 of {_gui} to {_rf}
        set {_i} to 0
        loop {-bg::w::list::*}:
            add 1 to {_i}
            set {_w} to loop-value
            set {_info::*} to "&7재사용 대기 &f%bgWCd({_p}, {_w})%초" and "&e%{-bg::w::%{_w}%::price}% 코인 &7· 클릭해서 구매"
            set {_it} to bgWShopItem({_w}, "&6&l%{-bg::w::%{_w}%::name}% &7(전설)", {_info::*})
            set slot {-bg::wslots::%{_i}%} of {_gui} to {_it}
        set {_i} to 0
        loop {-bg::w::bosslist::*}:
            add 1 to {_i}
            set {_w} to loop-value
            set {_info::*} to "&c상점에서 못 삼" and "&7보스 보상 상자에서만"
            set {_it} to bgWShopItem({_w}, "&c&l%{-bg::w::%{_w}%::name}% &7(보스 전용)", {_info::*})
            set slot {-bg::bslots::%{_i}%} of {_gui} to {_it}
    else if {_pg} is 3:
        bgUpFill({_gui}, bgTeam({_p}))
    else:
        loop {-bg::gear::list::*}:
            set {_g} to loop-value
            set {_it} to {-bg::gear::%{_g}%::icon}
            if {-bg::gear::%{_g}%::rgb::1} is set:
                set {_it} to bgPotionIcon({_it}, {-bg::gear::%{_g}%::rgb::1}, {-bg::gear::%{_g}%::rgb::2}, {-bg::gear::%{_g}%::rgb::3})
            set name of {_it} to "&f&l%{-bg::gear::%{_g}%::name}%"
            set lore of {_it} to "&7%{-bg::gear::%{_g}%::desc}%", "" and "&e가격: %{-bg::gear::%{_g}%::price}% 코인"
            set slot {-bg::gear::%{_g}%::slot} of {_gui} to {_it}
        # 주무기 강화 칸은 사람마다 (병과 · 단계)
        set slot 12 of {_gui} to bgMainShopItem({_p})
        set slot 40 of {_gui} to bgSellItem({_p})
    set {_coin} to sunflower named "&6&l보유 코인: &e%{_c}%"
    set lore of {_coin} to "&7처치 +10 · 점령 +15 · 보스 기여도", "&710초마다 +1 (점령 지점당 +1)"
    set slot 49 of {_gui} to {_coin}
    # 먼저 열고 나서 표시 (다시 열 때 이전 창의 '닫힘' 이 표시를 지워서 아이템을 빼 갈 수 있었음 — 복사 버그)
    open {_gui} to {_p}
    set {-bg::shop::%uuid of {_p}%} to true
    set {-bg::shoppage::%uuid of {_p}%} to {_pg}
    play sound "item.book.page_turn" to {_p}

# ─────────────────────────────────────────────────────────── 광물 (캐면 가방에, 죽으면 떨어뜨림, 상점에서 일괄 판매)
# 광물 아이템: 마인크래프트 이름(Material)으로 판별 — 'raw iron' 같은 글자는 Skript 가 잘못 읽을 수 있어서 쓰지 않음
function bgOreKey(i: item) :: text:
    set {_t} to {_i}.getType()
    return "%{_t}%"

function bgOreVal(i: item) :: number:
    set {_m} to bgOreKey({_i})
    if {_m} is "RAW_IRON":
        return 2
    if {_m} is "RAW_COPPER":
        return 2
    if {_m} is "RAW_GOLD":
        return 3
    if {_m} is "EMERALD":
        return 4
    if {_m} is "DIAMOND":
        return 7
    return 0

function bgOreTotal(p: player) :: number:
    set {_n} to 0
    loop all items in {_p}'s inventory:
        set {_v} to bgOreVal(loop-item)
        if {_v} > 0:
            add {_v} * (item amount of loop-item) to {_n}
    return {_n}

function bgOreCount(p: player) :: number:
    set {_n} to 0
    loop all items in {_p}'s inventory:
        if bgOreVal(loop-item) > 0:
            add (item amount of loop-item) to {_n}
    return {_n}

# 광물 일괄 판매 버튼
function bgSellItem(p: player) :: item:
    set {_sell} to hopper named "&a&l광물 일괄 판매"
    set {_tot} to bgOreTotal({_p})
    set lore of {_sell} to "&7가방의 광물을 전부 한 번에 코인으로 바꿉니다", "", "&f철 원석 · 구리 원석 &e2 &7· &f금 원석 &e3", "&f에메랄드 &e4 &7· &f다이아몬드 &e7", "", "&a지금 팔면: &e%{_tot}% 코인 &7(클릭)"
    return {_sell}

function bgOreSell(p: player):
    set {_n} to bgOreTotal({_p})
    if {_n} <= 0:
        send "&6[상점] &7팔 광물이 없습니다. &f본진 광석 바위 · 맵 곳곳 광석 바위를 곡괭이로 캐 오세요." to {_p}
        play sound "entity.villager.no" to {_p}
        stop
    set {_k} to bgOreCount({_p})
    loop "raw_iron", "raw_copper", "raw_gold", "emerald" and "diamond":
        bgCmd("clear %name of {_p}% minecraft:%loop-value%")
    add {_n} to {bg::coin::%uuid of {_p}%}
    send "&6[상점] &a광물 %{_k}%개 일괄 판매 &e+%{_n}% 코인 &7(보유 %{bg::coin::%uuid of {_p}%}%)" to {_p}
    play sound "entity.experience_orb.pickup" to {_p}
    play sound "block.amethyst_block.resonate" to {_p}
    wait 1 tick
    bgShopPage({_p}, {-bg::shoppage::%uuid of {_p}%} ? 2)

# 상점 진열용 전설 무기 아이템 (리소스팩 그림이 보이도록 item_model 지정)
function bgWeaponItem(w: text) :: item:
    set {_it} to iron sword named "&6&l%{-bg::w::%{_w}%::name}% &7(전설)"
    set {_m} to {_it}.getItemMeta()
    {_m}.setItemModel(new NamespacedKey("bg", "weapon/%{_w}%"))
    {_it}.setItemMeta({_m})
    return {_it}

# 설명창에 스킬 미리보기 영상이 나오는 진열용 무기 (리소스팩 tooltip/w_<무기>_background — arena/tools/rp/shoptip.py)
#  설명창 배경은 설명창 크기에 맞게 늘어나므로 크기를 고정한다: 글자 폭 180 · 줄 15 (이름 + 설명 3 + 빈 줄 + 안내 2 + 영상 8)
#  설명은 17글자씩 끊어 3줄 · 안내(info)는 2줄까지 (한 줄이 180 픽셀을 넘지 않게 짧게)
function bgWShopItem(w: text, name: text, info: texts) :: item:
    set {_it} to bgWeaponItem({_w})
    set name of {_it} to {_name}
    set {_ws::*} to {-bg::w::%{_w}%::desc} split at " "
    set {_ln} to 1
    set {_cur} to ""
    loop {_ws::*}:
        if {_cur} is "":
            set {_cur} to loop-value
        else if length of "%{_cur}% %loop-value%" > 17:
            set {_dl::%{_ln}%} to {_cur}
            add 1 to {_ln}
            set {_cur} to loop-value
        else:
            set {_cur} to "%{_cur}% %loop-value%"
    set {_dl::%{_ln}%} to {_cur}
    loop 3 times:
        if {_dl::%loop-number%} is set:
            add "&7%{_dl::%loop-number%}%" to {_lines::*}
        else:
            add "" to {_lines::*}
    add "" to {_lines::*}
    set {_k} to 0
    loop {_info::*}:
        if {_k} < 2:
            add loop-value to {_lines::*}
            add 1 to {_k}
    while {_k} < 2:
        add "" to {_lines::*}
        add 1 to {_k}
    # 영상 칸 (빈 줄 7 + 폭을 180 으로 고정하는 공백 글자 줄)
    loop 7 times:
        add "" to {_lines::*}
    add bgSpBuild(180) to {_lines::*}
    set lore of {_it} to {_lines::*}
    set {_m} to {_it}.getItemMeta()
    {_m}.setTooltipStyle(new NamespacedKey("bg", "w_%{_w}%"))
    {_it}.setItemMeta({_m})
    return {_it}

on inventory close:
    delete {-bg::shop::%uuid of player%}

# 상점 창에서는 끌어 놓기도 막음
on inventory drag:
    {-bg::shop::%uuid of player%} is true
    cancel event

on inventory click:
    {-bg::shop::%uuid of player%} is true
    cancel event
    # 연타 방지 (0.2초 안의 두 번째 클릭은 무시 — 중복 구매 · 복사 방지)
    if {-bg::shopclk::%uuid of player%} is set:
        if difference between {-bg::shopclk::%uuid of player%} and now < 0.2 seconds:
            stop
    set {-bg::shopclk::%uuid of player%} to now
    set {_s} to raw index of event-slot
    if {_s} >= 54:
        stop
    set {_pg} to {-bg::shoppage::%uuid of player%} ? 1
    if {_pg} is 3:
        if {_s} is 45:
            bgShopPage(player, 2)
            stop
        if {-bg::upslot::%{_s}%} is set:
            bgUpBuy(player, {-bg::upslot::%{_s}%})
        stop
    if {_pg} is 2:
        if {_s} is 45:
            bgShopPage(player, 1)
            stop
        if {_s} is 53:
            bgShopPage(player, 3)
            stop
        if {_s} is 40:
            bgOreSell(player)
            stop
        if {-bg::gearslot::%{_s}%} is not set:
            stop
        set {_g} to {-bg::gearslot::%{_s}%}
        # 주무기 강화는 단계별 가격 (bgMainBuy 가 코인 처리)
        if {_g} is "sword":
            bgMainBuy(player)
            stop
        set {_price} to {-bg::gear::%{_g}%::price}
        if ({bg::coin::%uuid of player%} ? 0) < {_price}:
            set {_c} to {bg::coin::%uuid of player%} ? 0
            send "&6[상점] &c코인이 부족합니다. &7(필요 %{_price}%, 보유 %{_c}%)" to player
            play sound "entity.villager.no" to player
            stop
        remove {_price} from {bg::coin::%uuid of player%}
        bgGiveGear(player, {_g})
        send "&6[상점] &f%{-bg::gear::%{_g}%::name}% 구매 &7(남은 코인 %{bg::coin::%uuid of player%}%)" to player
        play sound "entity.experience_orb.pickup" to player
        stop
    if {_s} is 53:
        bgShopPage(player, 2)
        stop
    if {_s} is 40:
        bgOreSell(player)
        stop
    if {_s} is 44:
        bgRefundOpen(player)
        stop
    if {-bg::bslot::%{_s}%} is set:
        send "&6[상점] &c보스 전용 무기는 보스를 쓰러뜨리고 보상 상자를 열어야 얻을 수 있습니다." to player
        stop
    if {-bg::wslot::%{_s}%} is not set:
        stop
    set {_w} to {-bg::wslot::%{_s}%}
    # 한 사람 전설 무기 최대 3개 (보스 · 신화 무기는 따로)
    if bgLegendCount(player) >= 3:
        send "&6[상점] &c전설 무기는 한 사람 최대 3개까지입니다. &7오른쪽 아래 &c반납&7 칸에서 하나를 돌려주고(30%% 환불) 사세요." to player
        play sound "entity.villager.no" to player
        stop
    set {_price} to {-bg::w::%{_w}%::price}
    if ({bg::coin::%uuid of player%} ? 0) < {_price}:
        set {_c} to {bg::coin::%uuid of player%} ? 0
        send "&6[상점] &c코인이 부족합니다. &7(필요 %{_price}%, 보유 %{_c}%)" to player
        play sound "entity.villager.no" to player
        stop
    set {bg::owned::%uuid of player%::%{_w}%} to true
    remove {_price} from {bg::coin::%uuid of player%}
    bgGiveWeapon(player, {_w})
    close player's inventory
    send title "&6&l%{-bg::w::%{_w}%::name}%" with subtitle "&f획득! 우클릭으로 전용 스킬" to player for 50 ticks
    play sound "ui.toast.challenge_complete" to player
    bgWfx(location of player, "wfx_barrier", 5, 30, 0)

# 이 사람의 실제 재사용 대기 (초) — 팀 강화 '전설의 숨결' 반영
function bgWCd(p: player, w: text) :: number:
    return max(1, round({-bg::w::%{_w}%::cd} * (1 - bgCdrRate({_p}))))

function bgItemCd(p: player, w: text, t: number):
    # 무기마다 따로 도는 쿨타임 그룹 (예전에 받은 무기에도 지금 붙인다) → 다른 철 검 · 무기는 영향 없음
    bgCmd("item modify entity %name of {_p}% weapon.mainhand {function:""minecraft:set_components"",components:{""minecraft:use_cooldown"":{seconds:%bgWCd({_p}, {_w})%,cooldown_group:""bg:w_%{_w}%""}}}")
    set {_it} to {_p}.getInventory().getItemInMainHand()
    {_p}.setCooldown({_it}, round({_t}))

function bgGiveWeapon(p: player, w: text):
    set {_nm} to {-bg::w::%{_w}%::name}
    bgCmd("give %name of {_p}% %{-bg::w::%{_w}%::base}%[item_model=""bg:weapon/%{_w}%"",custom_name={text:""%{_nm}%"",color:""%{-bg::w::%{_w}%::col}%"",bold:true,italic:false},lore=[{text:""%{-bg::w::%{_w}%::desc}%"",color:""gray"",italic:false}],custom_data={bgw:""%{_w}%""},unbreakable={},enchantments={""minecraft:binding_curse"":1},rarity=""epic"",enchantment_glint_override=true,use_cooldown={seconds:%bgWCd({_p}, {_w})%,cooldown_group:""bg:w_%{_w}%""}]")

# 목록 루프 값(종류 모름)에도 확실히 먹도록 플레이어 인자로 받는 도우미
function bgDmg(p: player, h: number):
    # 전설 무기 스킬 피해 (전체 너프: 1.6배 → 1.0배)
    damage {_p} by {_h}
    bgHitFx({_p}, {_h})

function bgIgnite(p: player, s: number):
    set {_t} to "%{_s}% seconds" parsed as timespan
    ignite {_p} for {_t}

function bgVel(p: player, v: vector):
    set velocity of {_p} to {_v}

# ─────────────────────────────────────────────────────────── 움직이는 효과 (텍스쳐가 날아가거나 퍼짐)
# 날아가는 참격: 바닥 효과 그림을 공중에 눕혀 앞으로 날린다 (step 칸/틱, ticks 동안)
function bgFxFly(l: location, m: text, size: number, yaw: number, step: number, ticks: number, dy: number):
    set {_id} to "bgfly%bgTid()%"
    set {_s} to bgN({_size})
    bgCmd("execute in %bgDim()% run summon item_display %bgC(x-coordinate of {_l})% %bgN((y-coordinate of {_l}) + {_dy})% %bgC(z-coordinate of {_l})% {Tags:[""bg"",""bgfx"",""%{_id}%""],Rotation:[%bgN({_yaw})%f,0f],item:{id:""minecraft:paper"",count:1,components:{""minecraft:item_model"":""bg:tele/%{_m}%""}},item_display:""none"",brightness:{sky:15,block:15},view_range:4f,teleport_duration:2,interpolation_duration:3,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[%{_s}%f,1f,%{_s}%f]}}")
    loop {_ticks} times:
        wait 1 tick
        bgCmd("execute as @e[tag=%{_id}%,limit=1] at @s run tp @s ^ ^ ^%bgN({_step})%")
    set {_s2} to bgN({_size} * 1.3)
    bgCmd("data merge entity @e[tag=%{_id}%,limit=1] {start_interpolation:0,interpolation_duration:5,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[%{_s2}%f,0.01f,%{_s2}%f]}}")
    wait 5 ticks
    bgCmd("kill @e[tag=%{_id}%]")

# 퍼지는 충격: 작게 생겨서 크게 번지며 돌다가 사라짐
function bgFxGrow(l: location, m: text, s0: number, s1: number, ticks: number, dy: number):
    set {_id} to "bggrow%bgTid()%"
    bgCmd("execute in %bgDim()% run summon item_display %bgC(x-coordinate of {_l})% %bgN((y-coordinate of {_l}) + {_dy})% %bgC(z-coordinate of {_l})% {Tags:[""bg"",""bgfx"",""bg_spin_fast"",""%{_id}%""],item:{id:""minecraft:paper"",count:1,components:{""minecraft:item_model"":""bg:tele/%{_m}%""}},item_display:""none"",brightness:{sky:15,block:15},view_range:4f,teleport_duration:2,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[%bgN({_s0})%f,1f,%bgN({_s0})%f]}}")
    wait 1 tick
    bgCmd("data merge entity @e[tag=%{_id}%,limit=1] {start_interpolation:0,interpolation_duration:%{_ticks}%,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[%bgN({_s1})%f,1f,%bgN({_s1})%f]}}")
    wait bgTicks({_ticks})
    bgCmd("data merge entity @e[tag=%{_id}%,limit=1] {start_interpolation:0,interpolation_duration:6,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[%bgN({_s1} * 1.15)%f,0.01f,%bgN({_s1} * 1.15)%f]}}")
    wait 6 ticks
    bgCmd("kill @e[tag=%{_id}%]")

# 잔상: 돌진하는 동안 발밑 그림을 2틱마다 남긴다
function bgFxTrail(p: player, m: text, size: number, n: number):
    loop {_n} times:
        bgFxGrow(location of {_p}, {_m}, {_size}, {_size} * 1.2, 6, 0.1)
        wait 2 ticks

# 전설 무기를 들고 있으면 무기 기운이 돈다
every 5 ticks:
    loop all players:
        set {_w} to bgIsLegend(loop-player's tool)
        if {_w} is not "":
            set {_l} to location of loop-player
            add 1.1 to y-coordinate of {_l}
            if {_w} is "thunder":
                bgParticle({_l}, "electric_spark", 0.35, 0.4, 0.35, 0.05, 3)
            else if {_w} is "dragon":
                bgParticle({_l}, "flame", 0.3, 0.4, 0.3, 0.01, 2)
            else if {_w} is "wind":
                bgParticle({_l}, "white_ash", 0.5, 0.5, 0.5, 0.02, 6)
            else if {_w} is "phoenix":
                bgParticle({_l}, "wax_on", 0.35, 0.45, 0.35, 0.02, 2)
            else if {_w} is "blackiron":
                bgParticle({_l}, "crimson_spore", 0.4, 0.5, 0.4, 0.01, 4)
            else if {_w} is "tiger":
                bgParticle({_l}, "reverse_portal", 0.3, 0.4, 0.3, 0.02, 3)
            else if {_w} is "staff":
                bgParticle({_l}, "enchant", 0.4, 0.6, 0.4, 0.3, 5)
            else:
                bgParticle({_l}, "small_flame", 0.3, 0.4, 0.3, 0.01, 3)

# ─────────────────────────────────────────────────────────── 바닥 효과
function bgWfx(l: location, m: text, d: number, t: number, yaw: number):
    set {_id} to bgTid()
    bgCmd("function bg:tele/decal {x:%bgC(x-coordinate of {_l})%,y:%bgN(y-coordinate of {_l})%,z:%bgC(z-coordinate of {_l})%,m:%{_m}%,d:%bgN({_d})%,t:%{_t}%,yaw:%bgN({_yaw})%,id:%{_id}%}")

function bgWRune(l: location, m: text, d: number, t: number):
    set {_id} to bgTid()
    bgCmd("function bg:tele/rune {x:%bgC(x-coordinate of {_l})%,y:%bgN(y-coordinate of {_l})%,z:%bgC(z-coordinate of {_l})%,m:%{_m}%,d:%bgN({_d})%,t:%{_t}%,id:%{_id}%}")

# 적 판정: 다른 팀 전투 참가자
function bgEnemies(p: player, c: location, r: number) :: players:
    # 스킬 범위 안에 보스가 있으면 보스도 맞는다
    bgBossSkillHit({_p}, {_c}, {_r})
    loop all players:
        if bgIsFighter(loop-player) is true:
            # 연습장(게임 밖)은 자유 대전 — 나 말고 전부 적
            set {_foe} to false
            if {-bg::on} is not true:
                if loop-player is not {_p}:
                    set {_foe} to true
            else if bgTeam(loop-player) is not bgTeam({_p}):
                set {_foe} to true
            if {_foe} is true:
                if world of loop-player is world of {_c}:
                    if distance between loop-player and {_c} <= {_r}:
                        add loop-player to {_out::*}
    return {_out::*}

# ─────────────────────────────────────────────────────────── 전용 스킬 (우클릭)
on right click:
    set {_nm} to uncolored name of player's tool
    {_nm} is set
    loop {-bg::w::all::*}:
        if {_nm} contains {-bg::w::%loop-value%::name}:
            set {_w} to loop-value
    {_w} is set
    cancel event
    set {_k} to "%uuid of player%::%{_w}%"
    if {-bg::wcd::%{_k}%} is set:
        set {_left} to bgWCd(player, {_w}) - (difference between {-bg::wcd::%{_k}%} and now) / 1 second
        if {_left} > 0:
            stop
    set {-bg::wcd::%{_k}%} to now
    # 아이템 쿨타임 표시 (엔더 진주처럼 무기 칸이 하얗게 차오름)
    bgItemCd(player, {_w}, bgWCd(player, {_w}) * 20)
    bgSkillCall(player, {_w})
    if {_w} is "thunder":
        bgSkThunder(player)
    else if {_w} is "dragon":
        bgSkDragon(player)
    else if {_w} is "wind":
        bgSkWind(player)
    else if {_w} is "phoenix":
        bgSkPhoenix(player)
    else if {_w} is "blackiron":
        bgSkBlood(player)
    else if {_w} is "tiger":
        bgSkClaw(player)
    else if {_w} is "staff":
        bgSkStaff(player)
    else if {_w} is "peachwood":
        bgSkFire(player)
    else if {_w} is "frost":
        bgSkFrost(player)
    else if {_w} is "storm":
        bgSkStorm(player)
    else if {_w} is "scythe":
        bgSkScythe(player)
    else if {_w} is "lance":
        bgSkLance(player)
    else if {_w} is "skull":
        bgSkSkull(player)
    else if {_w} is "chakram":
        bgSkChakram(player)
    else if {_w} is "chain":
        bgSkChain(player)
    else if {_w} is "gauntlet":
        bgSkGauntlet(player)
    else if {_w} is "b_talos":
        bgSkBTalos(player)
    else if {_w} is "b_sphinx":
        bgSkBSphinx(player)
    else if {_w} is "b_ladon":
        bgSkBLadon(player)
    else if {_w} is "b_cyclops":
        bgSkBCyclops(player)

function bgSkThunder(p: player):
    set {_b} to target block of {_p}
    if {_b} is set:
        set {_l} to location of {_b}
        add 1 to y-coordinate of {_l}
    else:
        set {_l} to location of {_p}
    if distance between {_p} and {_l} > 24:
        set {_l} to location of {_p}
    bgVfxThunder({_l})
    bgWfx({_l}, "wfx_thunder", 8, 14, random number between 0 and 360)
    bgSkillArt({_l}, "thunder", 2.8)
    bgParticle({_l}, "electric_spark", 1.5, 2, 1.5, 0.3, 60)
    bgSoundAt({_l}, "item.trident.thunder", 2, 1.3)
    wait 11 ticks
    strike lightning effect at {_l}
    bgImpact({_l}, 4, "thunder", true)
    set {_es::*} to bgEnemies({_p}, {_l}, 4)
    loop {_es::*}:
        bgDmg(loop-value, 3.5)
        bgIgnite(loop-value, 2)
        bgParticle(location of loop-value, "electric_spark", 0.4, 1, 0.4, 0.2, 20)

# 대회전 베기: 앞쪽 120° 반경 5.5
function bgSkDragon(p: player):
    bgVfxDragon({_p})
    bgSkillArt(location of {_p}, "dragon", 2.4)
    set {_l} to location of {_p}
    set {_yaw} to yaw of {_p}
    set {_fx} to -1 * sin({_yaw})
    set {_fz} to cos({_yaw})
    set {_c} to location((x-coordinate of {_l}) + {_fx} * 1.5, y-coordinate of {_l}, (z-coordinate of {_l}) + {_fz} * 1.5, world of {_l})
    bgWfx({_c}, "wfx_crescent", 10, 18, {_yaw})
    bgImpactCone({_l}, {_yaw}, 120, 5.5, "fire")
    bgSoundAt({_l}, "entity.player.attack.sweep", 2, 0.6)
    bgSoundAt({_l}, "entity.ender_dragon.flap", 1.5, 1.3)
    loop 5 times:
        set {_a} to {_yaw} - 60 + (loop-number - 1) * 30
        set {_q} to location((x-coordinate of {_l}) - sin({_a}) * 3.5, (y-coordinate of {_l}) + 1, (z-coordinate of {_l}) + cos({_a}) * 3.5, world of {_l})
        bgParticle({_q}, "sweep_attack", 0.3, 0.2, 0.3, 0, 1)
    set {_es::*} to bgEnemies({_p}, {_l}, 5.5)
    loop {_es::*}:
        set {_dx} to (x-coordinate of loop-value) - (x-coordinate of {_l})
        set {_dz} to (z-coordinate of loop-value) - (z-coordinate of {_l})
        set {_d} to max(0.4, sqrt({_dx} * {_dx} + {_dz} * {_dz}))
        if ({_dx} * {_fx} + {_dz} * {_fz}) / {_d} >= 0.5:
            bgDmg(loop-value, 3)
            bgVel(loop-value, vector({_dx} / {_d} * 1.1, 0.4, {_dz} / {_d} * 1.1))
            bgParticle(location of loop-value, "crit", 0.3, 0.8, 0.3, 0.2, 12)

function bgSkWind(p: player):
    bgVfxWind({_p})
    bgSkillArt(location of {_p}, "wind", 2.0)
    set {_l} to location of {_p}
    bgWfx({_l}, "wfx_wind", 5, 20, yaw of {_p})
    set {_v} to vector(-1 * sin(yaw of {_p}) * cos(pitch of {_p}) * 1.8, 0.25, cos(yaw of {_p}) * cos(pitch of {_p}) * 1.8)
    set velocity of {_p} to {_v}
    bgCmd("effect give %name of {_p}% speed 3 1 true")
    bgSoundAt({_l}, "entity.breeze.wind_burst", 1.5, 1.2)
    loop 4 times:
        bgParticle(location of {_p}, "cloud", 0.3, 0.2, 0.3, 0.02, 8)
        bgImpact(location of {_p}, 1.3, "gale", false)
        set {_hit::*} to bgEnemies({_p}, location of {_p}, 2.2)
        loop {_hit::*}:
            if {_done::%uuid of loop-value-2%} is not set:
                set {_done::%uuid of loop-value-2%} to true
                bgDmg(loop-value-2, 2)
        wait 2 ticks
    bgWfx(location of {_p}, "wfx_wind", 4, 16, yaw of {_p})
    bgImpact(location of {_p}, 2.4, "gale", true)

function bgSkPhoenix(p: player):
    bgVfxHammer(location of {_p}, yaw of {_p})
    bgSkillArt(location of {_p}, "phoenix", 2.4)
    set {_l} to location of {_p}
    bgWfx({_l}, "wfx_barrier", 12, 24, 0)
    bgSoundAt({_l}, "item.shield.block", 2, 0.7)
    bgSoundAt({_l}, "block.beacon.power_select", 1.5, 1.4)
    bgParticle({_l}, "wax_on", 3, 1, 3, 0.1, 40)
    bgCmd("effect give %name of {_p}% resistance 4 1 true")
    loop all players:
        if bgTeam(loop-player) is bgTeam({_p}):
            if distance between loop-player and {_l} <= 6:
                bgCmd("effect give %name of loop-player% absorption 8 1 true")
    set {_es::*} to bgEnemies({_p}, {_l}, 4)
    loop {_es::*}:
        set {_dx} to (x-coordinate of loop-value) - (x-coordinate of {_l})
        set {_dz} to (z-coordinate of loop-value) - (z-coordinate of {_l})
        set {_d} to max(0.5, sqrt({_dx} * {_dx} + {_dz} * {_dz}))
        bgVel(loop-value, vector({_dx} / {_d} * 1.3, 0.45, {_dz} / {_d} * 1.3))


# 혈풍참: 바라보는 방향으로 8칸 돌진, 지나간 길 폭 2 안의 적 3하트 + 시듦
function bgSkBlood(p: player):
    bgVfxGreatsword({_p})
    bgSkillArt(location of {_p}, "blackiron", 2.4)
    set {_l} to location of {_p}
    set {_yaw} to yaw of {_p}
    set {_fx} to -1 * sin({_yaw})
    set {_fz} to cos({_yaw})
    set {_mid} to location((x-coordinate of {_l}) + {_fx} * 4, y-coordinate of {_l}, (z-coordinate of {_l}) + {_fz} * 4, world of {_l})
    bgWfx({_mid}, "wfx_blood", 9, 20, {_yaw})
    set velocity of {_p} to vector({_fx} * 2.2, 0.15, {_fz} * 2.2)
    bgImpactLine({_l}, {_yaw}, 2.4, 9, "blood")
    bgSoundAt({_l}, "entity.player.attack.sweep", 2, 0.5)
    bgSoundAt({_l}, "item.trident.riptide_1", 1.5, 1.2)
    set {_es::*} to bgEnemies({_p}, {_mid}, 5.5)
    loop {_es::*}:
        set {_dx} to (x-coordinate of loop-value) - (x-coordinate of {_l})
        set {_dz} to (z-coordinate of loop-value) - (z-coordinate of {_l})
        set {_along} to {_dx} * {_fx} + {_dz} * {_fz}
        set {_perp} to abs({_dx} * {_fz} - {_dz} * {_fx})
        if {_along} >= -0.5:
            if {_along} <= 9:
                if {_perp} <= 2:
                    bgDmg(loop-value, 3)
                    bgCmd("effect give %bgPName(loop-value)% wither 2 1 true")
                    bgParticle(location of loop-value, "damage_indicator", 0.3, 0.8, 0.3, 0.1, 8)

# 호조연격: 앞쪽 100° 반경 3.5 — 3연속 (4틱 간격)
function bgSkClaw(p: player):
    bgVfxDaggers({_p})
    bgSkillArt(location of {_p}, "tiger", 2.0)
    loop 3 times:
        set {_l} to location of {_p}
        set {_yaw} to yaw of {_p}
        set {_fx} to -1 * sin({_yaw})
        set {_fz} to cos({_yaw})
        set {_c} to location((x-coordinate of {_l}) + {_fx} * 1.8, y-coordinate of {_l}, (z-coordinate of {_l}) + {_fz} * 1.8, world of {_l})
        bgWfx({_c}, "wfx_claw", 4, 10, {_yaw} + (loop-number - 2) * 25)
        bgImpact(bgImpFwd({_l}, {_yaw}, 2.2), 1.6, "arcane", false)
        bgSoundAt({_l}, "entity.player.attack.strong", 1.5, 1.4)
        set {_es::*} to bgEnemies({_p}, {_l}, 3.5)
        loop {_es::*}:
            set {_dx} to (x-coordinate of loop-value-2) - (x-coordinate of {_l})
            set {_dz} to (z-coordinate of loop-value-2) - (z-coordinate of {_l})
            set {_d} to max(0.4, sqrt({_dx} * {_dx} + {_dz} * {_dz}))
            if ({_dx} * {_fx} + {_dz} * {_fz}) / {_d} >= 0.64:
                bgDmg(loop-value-2, 1.1)
                bgCmd("effect give %bgPName(loop-value-2)% slowness 1 1 true")
        wait 4 ticks

# 여의천강: 봉으로 땅을 내리쳐 반경 4.5 적을 공중으로
function bgSkStaff(p: player):
    bgVfxCrystals(location of {_p})
    bgSkillArt(location of {_p}, "staff", 2.4)
    set {_l} to location of {_p}
    # 비전 구체를 모으는 동안 (10틱) 기다렸다가 터질 때 판정
    wait 11 ticks
    bgWfx({_l}, "wfx_staff", 10, 20, random number between 0 and 360)
    bgSoundAt({_l}, "item.mace.smash_ground_heavy", 2, 0.8)
    bgParticle({_l}, "explosion", 2, 0.2, 2, 0, 4)
    bgImpact({_l}, 4.5, "arcane", true)
    set {_es::*} to bgEnemies({_p}, {_l}, 4.5)
    loop {_es::*}:
        bgDmg(loop-value, 2.5)
        bgVel(loop-value, vector(0, 1.1, 0))

# 화염부: 부적 불꽃 고리 — 반경 5 적 1.5하트 + 4초 화상
function bgSkFire(p: player):
    bgVfxSpears(location of {_p})
    bgSkillArt(location of {_p}, "peachwood", 2.4)
    set {_l} to location of {_p}
    bgWfx({_l}, "wfx_fire", 11, 24, random number between 0 and 360)
    bgSoundAt({_l}, "item.firecharge.use", 2, 0.8)
    bgParticle({_l}, "flame", 3.5, 0.4, 3.5, 0.02, 80)
    bgImpactRing({_l}, 1, 5, "fire")
    set {_es::*} to bgEnemies({_p}, {_l}, 5)
    loop {_es::*}:
        bgDmg(loop-value, 2)
        bgIgnite(loop-value, 4)

# 전설 무기 판별 (이름으로) — 상점 무기 + 보스 무기
function bgIsLegend(i: item) :: text:
    set {_n} to uncolored name of {_i}
    if {_n} is not set:
        return ""
    loop {-bg::w::all::*}:
        if {_n} contains {-bg::w::%loop-value%::name}:
            return loop-value
    return ""


# 스킬 연출: 무기 · 이펙트 그림이 그 자리에서 커지며 솟았다가 사라짐 (항상 플레이어 쪽을 봄)
function bgSkillArt(l: location, w: text, k: number):
    # 솟아오르는 세로 효과는 쓰지 않음 (바닥 마법진 효과만)
    stop

# ─────────────────────────────────────────────────────────── 병과 주무기 (상점 2쪽 '주무기 강화' Lv.0~3)
#  전사   : 돌 검 → 철 검 → 철 검 + 날카로움 I → 다이아 검   (Lv.3 은 아주 비쌈 — 전설 무기보다 비쌈)
#  수호자 : 돌 도끼 → 철 도끼 → 철 도끼 + 날카로움 I → 다이아 도끼   (검은 못 씀)
#  궁수   : 나무 검(근접은 이것만) + 활 → 힘 I → 힘 II → 힘 III · 밀치기 I
#  Lv.2 까지는 전설 무기(스킬)보다 약하게 — 주무기는 기본기, 전설 무기가 진짜 강화
#  단계는 사람마다 저장 → 병과를 바꾸면 새 병과의 같은 단계 무기로. 모든 주무기에 custom_data {bgmain:1b} (병과 바꿀 때 지우기용)
function bgMainWeapon(p: player, c: number):
    set {_n} to name of {_p}
    set {_lv} to {bg::owned::%uuid of {_p}%::wlv} ? 0
    set {_tag} to "custom_data={bgmain:1b},unbreakable={},enchantment_glint_override=false"
    # 날카로움 · 힘 같은 진짜 인챈트가 붙은 무기는 반짝이게 (귀속 저주만 있으면 안 반짝임)
    set {_tagg} to "custom_data={bgmain:1b},unbreakable={},enchantment_glint_override=true"
    if {_c} is 1:
        bgCmd("give %{_n}% wooden_sword[%{_tag}%,enchantments={""minecraft:binding_curse"":1}]")
        set {_e} to """minecraft:binding_curse"":1"
        if {_lv} is 1:
            set {_e} to "%{_e}%,""minecraft:power"":1"
        else if {_lv} is 2:
            set {_e} to "%{_e}%,""minecraft:power"":2"
        else if {_lv} >= 3:
            set {_e} to "%{_e}%,""minecraft:power"":3,""minecraft:punch"":1"
        if {_lv} >= 1:
            bgCmd("give %{_n}% bow[%{_tagg}%,enchantments={%{_e}%}]")
        else:
            bgCmd("give %{_n}% bow[%{_tag}%,enchantments={%{_e}%}]")
        stop
    set {_m} to "stone"
    if {_lv} is 1:
        set {_m} to "iron"
    else if {_lv} is 2:
        set {_m} to "iron"
    else if {_lv} >= 3:
        set {_m} to "diamond"
    set {_e} to """minecraft:binding_curse"":1"
    if {_lv} is 2:
        set {_e} to "%{_e}%,""minecraft:sharpness"":1"
        set {_tag} to {_tagg}
    if {_c} is 2:
        bgCmd("give %{_n}% %{_m}%_axe[%{_tag}%,enchantments={%{_e}%}]")
    else:
        bgCmd("give %{_n}% %{_m}%_sword[%{_tag}%,enchantments={%{_e}%}]")

# 단계별 이름 · 가격
function bgMainName(c: number, lv: number) :: text:
    if {_c} is 1:
        if {_lv} is 1:
            return "활 강화 I &7(힘 I)"
        if {_lv} is 2:
            return "활 강화 II &7(힘 II)"
        return "활 강화 III &7(힘 III · 밀치기 I)"
    set {_w} to "검"
    if {_c} is 2:
        set {_w} to "도끼"
    if {_lv} is 1:
        return "철 %{_w}%"
    if {_lv} is 2:
        return "철 %{_w}% &7(날카로움 I)"
    return "다이아 %{_w}%"

function bgMainPrice(lv: number) :: number:
    if {_lv} is 1:
        return 50
    if {_lv} is 2:
        return 120
    return 450

function bgMainShopItem(p: player) :: item:
    set {_c} to {bg::cls::%uuid of {_p}%} ? 0
    set {_lv} to {bg::owned::%uuid of {_p}%::wlv} ? 0
    set {_it} to iron sword
    if {_c} is 1:
        set {_it} to bow
    else if {_c} is 2:
        set {_it} to iron axe
    set {_nx} to {_lv} + 1
    if {_lv} >= 3:
        set name of {_it} to "&6&l주무기 강화 &7[최대]"
        set lore of {_it} to "&7지금: &f%bgMainName({_c}, 3)%", "", "&6&l최대 단계"
    else:
        set name of {_it} to "&f&l주무기 강화 &7[Lv.%{_lv}% → %{_nx}%]"
        set lore of {_it} to "&a다음: &f%bgMainName({_c}, {_nx})%", "&7병과를 바꾸면 그 병과의 같은 단계 무기로 바뀝니다", "&7(수호자는 도끼만 · 궁수는 근접에 나무 검만)", "", "&e가격: %bgMainPrice({_nx})% 코인"
    return {_it}

function bgMainBuy(p: player):
    set {_u} to uuid of {_p}
    set {_lv} to {bg::owned::%{_u}%::wlv} ? 0
    if {_lv} >= 3:
        send "&6[상점] &7주무기는 이미 최대 단계입니다." to {_p}
        play sound "entity.villager.no" to {_p}
        stop
    set {_nx} to {_lv} + 1
    set {_price} to bgMainPrice({_nx})
    if ({bg::coin::%{_u}%} ? 0) < {_price}:
        set {_c} to {bg::coin::%{_u}%} ? 0
        send "&6[상점] &c코인이 부족합니다. &7(필요 %{_price}%, 보유 %{_c}%)" to {_p}
        play sound "entity.villager.no" to {_p}
        stop
    remove {_price} from {bg::coin::%{_u}%}
    set {bg::owned::%{_u}%::wlv} to {_nx}
    set {_c} to {bg::cls::%{_u}%} ? 0
    bgClassSwitch({_p}, {_c})
    send "&6[상점] &f주무기 강화 → &e%bgMainName({_c}, {_nx})% &7(남은 코인 %{bg::coin::%{_u}%}%)" to {_p}
    play sound "block.anvil.use" to {_p}
    play sound "entity.player.levelup" to {_p}
    wait 1 tick
    bgShopPage({_p}, 2)

# 병과 무기 제한: 수호자는 검(전설 무기 제외) 못 씀 · 궁수는 나무 검 말고 다른 검 · 도끼 못 씀
function bgWeaponOk(p: player) :: boolean:
    if bgIsFighter({_p}) is false:
        return true
    set {_tool} to tool of {_p}
    if bgIsLegend({_tool}) is not "":
        return true
    set {_k} to bgOreKey({_tool})
    set {_c} to {bg::cls::%uuid of {_p}%} ? 0
    if {_c} is 2:
        if {_k} ends with "_SWORD":
            send action bar "&9수호자는 도끼만 쓸 수 있습니다" to {_p}
            return false
    else if {_c} is 1:
        if {_k} ends with "_AXE":
            send action bar "&a궁수는 근접 무기로 나무 검만 쓸 수 있습니다" to {_p}
            return false
        if {_k} ends with "_SWORD":
            if {_k} is not "WOODEN_SWORD":
                send action bar "&a궁수는 근접 무기로 나무 검만 쓸 수 있습니다" to {_p}
                return false
    return true

on damage of player:
    {-bg::on} is true
    attacker is a player
    set {_a} to attacker
    if bgWeaponOk({_a}) is false:
        cancel event

# ─────────────────────────────────────────────────────────── 전설 무기 개수 제한 (한 사람 3개, 보스 · 신화 무기 제외) · 반납
function bgLegendCount(p: player) :: number:
    set {_n} to 0
    loop all items in {_p}'s inventory:
        if bgIsShopLegend(loop-item) is true:
            add 1 to {_n}
    return {_n}

# 상점 전설 무기인지 (보스 · 신화 무기 b_* 는 아님)
function bgIsShopLegend(i: item) :: boolean:
    set {_w} to bgIsLegend({_i})
    if {_w} is "":
        return false
    if {_w} starts with "b_":
        return false
    return true

# 주울 때도 3개가 넘으면 안 주워짐
on pickup:
    bgIsShopLegend(event-item) is true
    player's gamemode is not creative
    bgLegendCount(player) >= 3
    cancel event
    if {-bg::pickmsg::%uuid of player%} is not set:
        set {-bg::pickmsg::%uuid of player%} to true
        send action bar "&c전설 무기는 3개까지만 들 수 있습니다 &7(상점 1쪽 '반납'으로 정리)" to player
        wait 2 seconds
        delete {-bg::pickmsg::%uuid of player%}

# 반납 창: 가방의 전설 무기를 보여 주고, 클릭하면 그 무기를 없애고 가격의 30% 환불
function bgRefundOpen(p: player):
    set {_gui} to chest inventory with 3 rows named "&4&l전설 무기 반납 &8| &7클릭하면 30%% 환불"
    set {_pane} to gray stained glass pane named " "
    loop 27 times:
        set slot loop-number - 1 of {_gui} to {_pane}
    delete {-bg::refslot::%uuid of {_p}%::*}
    set {_i} to 10
    loop all items in {_p}'s inventory:
        set {_w} to bgIsLegend(loop-item)
        if bgIsShopLegend(loop-item) is true:
            if {_i} <= 16:
                if {_i} >= 10:
                    set {_back} to floor({-bg::w::%{_w}%::price} * 0.3)
                    set {_info::*} to "&c클릭하면 반납 &e+%{_back}% 코인"
                    set {_it} to bgWShopItem({_w}, "&6&l%{-bg::w::%{_w}%::name}% &7(전설)", {_info::*})
                    set slot {_i} of {_gui} to {_it}
                    set {-bg::refslot::%uuid of {_p}%::%{_i}%} to {_w}
                    add 1 to {_i}
    if {_i} is 10:
        set slot 13 of {_gui} to paper named "&7반납할 전설 무기가 없습니다"
    set slot 22 of {_gui} to arrow named "&e&l◀ 상점으로"
    open {_gui} to {_p}
    set {-bg::refgui::%uuid of {_p}%} to true
    play sound "item.book.page_turn" to {_p}

on inventory close:
    delete {-bg::refgui::%uuid of player%}

on inventory drag:
    {-bg::refgui::%uuid of player%} is true
    cancel event

on inventory click:
    {-bg::refgui::%uuid of player%} is true
    cancel event
    if {-bg::shopclk::%uuid of player%} is set:
        if difference between {-bg::shopclk::%uuid of player%} and now < 0.2 seconds:
            stop
    set {-bg::shopclk::%uuid of player%} to now
    set {_s} to raw index of event-slot
    if {_s} is 22:
        bgShopPage(player, 1)
        stop
    set {_w} to {-bg::refslot::%uuid of player%::%{_s}%}
    {_w} is set
    bgRefund(player, {_w})

function bgRefund(p: player, w: text):
    # 실제로 가방에 있는지 다시 확인 (복사 방지)
    set {_has} to false
    loop all items in {_p}'s inventory:
        if bgIsLegend(loop-item) is {_w}:
            set {_has} to true
    if {_has} is false:
        bgRefundOpen({_p})
        stop
    bgCmd("clear %name of {_p}% %{-bg::w::%{_w}%::base}%[minecraft:custom_data={bgw:""%{_w}%""}] 1")
    delete {bg::owned::%uuid of {_p}%::%{_w}%}
    set {_back} to floor({-bg::w::%{_w}%::price} * 0.3)
    add {_back} to {bg::coin::%uuid of {_p}%}
    send "&6[상점] &f%{-bg::w::%{_w}%::name}% 반납 &e+%{_back}% 코인 &7(보유 %{bg::coin::%uuid of {_p}%}%)" to {_p}
    play sound "block.anvil.destroy" to {_p}
    play sound "entity.experience_orb.pickup" to {_p}
    wait 1 tick
    bgRefundOpen({_p})
