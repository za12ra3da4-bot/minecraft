    set {-bg::w::tiger::col} to "white"
    set {-bg::w::tiger::icon} to iron sword
    set {-bg::w::tiger::desc} to "우클릭 연속 할퀴기: 앞쪽 3연속 (1.2하트 x3 + 구속) · 10초"
    set {-bg::w::staff::name} to "대마법사의 지팡이"
