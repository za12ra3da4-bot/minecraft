    set {-bg::gear::list::*} to "iron", "diamond", "sword", "food", "arrows", "gapple", "heal", "ward", "arrows64", "spectral", "parrow", "pspeed", "pstr", "pregen", "pfire", "ppoison" and "pleap"
    # 빈칸: 화살 · 물약 (전부 짧고 약하게 — 전설 무기 스킬보다 약한 보조용)
    bgGearDef("arrows64", "화살 64개", "소모품 · 한 묶음", 25, arrow, 29)
    bgGearDef("spectral", "분광 화살 16개", "맞은 적 10초 발광 (벽 너머로 보임)", 20, spectral arrow, 30)
    bgGearDef("parrow", "독 화살 6개", "맞으면 독 I 3초", 30, tipped arrow, 31)
    bgGearDef("pspeed", "신속 물약", "마시면 신속 I · 15초", 30, potion, 20)
