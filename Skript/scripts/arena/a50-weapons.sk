    bgGearDef("ppoison", "독의 투척 물약", "던지면 독 I · 4초", 35, splash potion, 24)
    bgGearDef("pleap", "도약 물약", "마시면 점프 강화 II · 15초", 20, potion, 25)
    # 상점 아이콘 물약 색
