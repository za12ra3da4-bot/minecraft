    set {-bg::w::thunder::base} to "netherite_sword"
    set {-bg::w::thunder::price} to 150
    set {-bg::w::thunder::cd} to 15
    set {-bg::w::thunder::col} to "aqua"
    set {-bg::w::thunder::icon} to netherite sword
    set {-bg::w::thunder::desc} to "우클릭 뇌격: 바라보는 곳(24칸)에 낙뢰 — 반경 3.5 적 3하트 · 15초"
