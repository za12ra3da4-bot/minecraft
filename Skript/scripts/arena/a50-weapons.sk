# ═════════════════════════════════════════════════════════════════════════════
#  왕관 쟁탈전 — 코인 · 무기 상점(/상점) · 전설 무기 전용 스킬 (우클릭)
#
#  코인: 시작 20 · 10초마다 +1(+점령 지점당 1) · 처치 +10 · 점령 +15 · 보스 +40
#  무기 (리소스팩 2D 아이콘 bg:weapon/*, 스킬마다 빛나는 마법진 바닥 효과 bg:tele/wfx_*)
#    천둥의 성검 150 · 용살자의 도끼 130 · 질풍의 레이피어 90 · 성기사의 전쟁망치 120
#    흑기사의 대검 140 · 그림자 쌍단검 110 · 대마법사의 지팡이 100 · 불사조의 창 120
# ═════════════════════════════════════════════════════════════════════════════

import:
    org.bukkit.NamespacedKey
    org.bukkit.Color
    org.bukkit.Bukkit
    net.kyori.adventure.text.Component
    net.kyori.adventure.key.Key
    net.kyori.adventure.text.format.TextColor

# 상점 화면 (일반 상자, 폰트 없음)
function bgShopInv(c: number) :: inventory:
    return chest inventory with 3 rows named "&6&l왕국 무기고 &8| &e%{_c}% 코인"

# 무기 정의 한 줄: 이름 · 가격 · 재사용(초) · 이름 색 · 설명
function bgWDef(id: text, name: text, price: number, cd: number, col: text, desc: text):
    set {-bg::w::%{_id}%::name} to {_name}
    set {-bg::w::%{_id}%::base} to "iron_sword"
    set {-bg::w::%{_id}%::price} to {_price}
    # 재사용 대기: 처음 값 × 1.3 × 2.5 (팀 강화 '전설의 숨결' 로 최대 -50%%)
    set {-bg::w::%{_id}%::cd} to round({_cd} * 1.3 * 2.5)
    # 보스(신화) 무기는 예전 그대로
    if {_id} starts with "b_":
        set {-bg::w::%{_id}%::cd} to round({_cd} * 1.3)
    set {-bg::w::%{_id}%::col} to {_col}
    set {-bg::w::%{_id}%::desc} to {_desc}
    # 스킬 이름 = 설명의 '우클릭 ' 과 ':' 사이 (머리 위에 띄움 — a39 bgSkillCall)
    set {_a::*} to {_desc} split at ":"
    set {_b::*} to {_a::1} split at "우클릭 "
    set {-bg::w::%{_id}%::skill} to last element of {_b::*}

on load:
    # 상점 전설 무기 16종 (특수무기답게 비싸게)
    set {-bg::w::list::*} to "thunder", "dragon", "wind", "phoenix", "blackiron", "tiger", "staff", "peachwood", "frost", "storm", "scythe", "lance", "skull", "chakram", "chain" and "gauntlet"
    # 보스 전용 무기 4종 (상점에 없음 — 그 보스의 보상 상자에서만)
    set {-bg::w::bosslist::*} to "b_talos", "b_sphinx", "b_ladon" and "b_cyclops"
    set {-bg::w::all::*} to {-bg::w::list::*}
    add {-bg::w::bosslist::*} to {-bg::w::all::*}
    bgWDef("thunder", "천둥의 성검", 400, 15, "aqua", "우클릭 심판의 낙뢰: 하늘에서 성검이 내리꽂힘 — 반경 4 강한 피해")
    bgWDef("dragon", "용살자의 도끼", 400, 12, "red", "우클릭 화염 선풍: 도끼가 두 바퀴 돌며 앞 120° 베기")
    bgWDef("wind", "질풍의 레이피어", 400, 8, "green", "우클릭 질풍 삼연격: 질주하며 세 번 찌르기")
    bgWDef("phoenix", "성기사의 전쟁망치", 400, 18, "gold", "우클릭 신성 강타: 거대한 망치가 떨어져 결계 (저항 II)")
    bgWDef("blackiron", "흑기사의 대검", 400, 12, "dark_red", "우클릭 피의 돌진: 돌진 뒤 거대한 대검으로 가로 베기")
    bgWDef("tiger", "그림자 쌍단검", 400, 10, "dark_purple", "우클릭 그림자 교차: 단검 두 자루가 X자로 교차 (3연속)")
    bgWDef("staff", "대마법사의 지팡이", 400, 14, "light_purple", "우클릭 비전 폭발: 비전 구체를 모았다 터뜨려 적을 띄움")
    bgWDef("peachwood", "불사조의 창", 400, 16, "gold", "우클릭 불창의 비: 불창 여섯 자루가 쏟아짐 (화상)")
    bgWDef("frost", "서리 여왕의 장궁", 400, 12, "aqua", "우클릭 빙결 사격: 얼음 화살 세 발 — 맞은 적 자리에 얼음 가시 (구속 IV)")
    bgWDef("storm", "폭풍의 삼지창", 400, 16, "blue", "우클릭 폭풍 투척: 삼지창을 던져 번개가 적 3명에게 튀어감")
    bgWDef("scythe", "망자의 낫", 400, 14, "dark_gray", "우클릭 영혼 수확: 낫이 한 바퀴 돌며 베고, 맞은 적마다 2.5하트 회복 + 재생")
    bgWDef("lance", "성광의 기병창", 400, 12, "yellow", "우클릭 성광 돌격: 9칸 돌격 — 길 위의 적을 띄우고 발광")
    bgWDef("skull", "저주받은 해골 지팡이", 400, 12, "dark_green", "우클릭 저주의 해골: 날아가는 해골이 터지며 독 구름")
    bgWDef("chakram", "태양의 원반", 400, 10, "gold", "우클릭 태양 원반: 원반이 날아갔다 돌아오며 두 번 벰")
    bgWDef("chain", "사냥꾼의 사슬낫", 400, 12, "gray", "우클릭 사슬 끌어오기: 앞의 적을 사슬로 끌어와 기절")
    bgWDef("gauntlet", "거인의 건틀렛", 400, 14, "gold", "우클릭 대지 분쇄: 앞으로 돌기둥이 줄지어 솟아 적을 띄움")
    bgWDef("b_talos", "탈로스의 청동 대검", 0, 18, "gold", "보스 전용 · 우클릭 청동 폭주: 세 번 연속 돌진 + 저항 · 힘 (5초)")
    bgWDef("b_sphinx", "스핑크스의 모래시계", 0, 20, "yellow", "보스 전용 · 우클릭 시간의 모래폭풍: 반경 7 적 구속 V · 실명 (3초)")
    bgWDef("b_ladon", "히드라의 삼두 채찍", 0, 14, "dark_green", "보스 전용 · 우클릭 삼두 채찍질: 세 갈래로 독 채찍 (독 · 시듦)")
    # 보스에게 주는 스킬 피해 (하트, 1.6배 · 보스 체력은 6배로 깎임) — 기본 5, 한 방 스킬은 더 세게
    set {-bg::w::thunder::bossdmg} to 7
    set {-bg::w::phoenix::bossdmg} to 6
    set {-bg::w::staff::bossdmg} to 6
    set {-bg::w::tiger::bossdmg} to 3
    set {-bg::w::wind::bossdmg} to 4
    set {-bg::w::skull::bossdmg} to 3
    set {-bg::w::chakram::bossdmg} to 4
    set {-bg::w::gauntlet::bossdmg} to 6
    set {-bg::w::storm::bossdmg} to 7
    set {-bg::w::b_talos::bossdmg} to 6
    set {-bg::w::b_cyclops::bossdmg} to 7
    bgWDef("b_cyclops", "외눈 거인의 곤봉", 0, 20, "gold", "보스 전용 · 우클릭 거암 투척: 거대한 바위를 던져 땅을 뒤흔듦")

# ─────────────────────────────────────────────────────────── 코인
function bgCoin(p: player, n: number, why: text):
    add {_n} to {bg::coin::%uuid of {_p}%}
    send action bar "&6+%{_n}% 코인 &7(%{_why}%) &f· 보유 &e%{bg::coin::%uuid of {_p}%}%" to {_p}

function bgCoinTeam(t: text, n: number, why: text):
    loop all players:
        if bgTeam(loop-player) is {_t}:
            bgCoin(loop-player, {_n}, {_why})

every 10 seconds:
    {-bg::on} is true
    loop all players:
        if bgIsFighter(loop-player) is true:
            set {_n} to 1
            loop {-bg::pts::*}:
                if {-bg::own::%loop-value-2%} is bgTeam(loop-player):
                    add 1 to {_n}
            add {_n} to {bg::coin::%uuid of loop-player%}

on death of player:
    {-bg::on} is true
    attacker is a player
    bgTeam(attacker) is not bgTeam(victim)
    bgTeam(attacker) is not "none"
    bgCoin(attacker, 10, "처치")
    if bgLeader() is bgTeam(victim):
        bgCoin(attacker, 5, "1등 팀 현상금")

