    set {-bg::w::dragon::cd} to 12
    set {-bg::w::dragon::col} to "red"
    set {-bg::w::dragon::icon} to netherite axe
    set {-bg::w::dragon::desc} to "우클릭 대회전 베기: 앞 120° 반경 5.5 (3하트 + 밀쳐냄) · 12초"
    set {-bg::w::wind::name} to "질풍의 단검"
