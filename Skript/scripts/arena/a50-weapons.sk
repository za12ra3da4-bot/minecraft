# ═════════════════════════════════════════════════════════════════════════════
#  신들의 전장 — 코인 · 무기 상점(/상점) · 전설 무기 전용 스킬 (우클릭)
#
#  코인: 처치 +5 · 지점 점령 +8(팀 전원) · 보스 처치 +25(팀 전원) · 20초마다 +1
#  무기 (리소스팩 3D 모델 bg:weapon/*, 스킬마다 수묵 붓터치 바닥 효과 bg:tele/wfx_*)
#    뇌정검     60코인  뇌정일섬: 바라보는 곳(24칸)에 낙뢰 — 반경 3.5 적 3하트          (15초)
#    청룡언월도 55코인  반월참: 앞쪽 120° 반경 5.5 베기 — 적 3하트 + 밀쳐냄           (12초)
#    풍혼선     35코인  질풍보: 바라보는 방향으로 질주 + 신속 II 3초                  (8초)
#    방천화극   45코인  금강결계: 나 저항 II 4초, 주변 아군 흡수, 적 밀쳐냄           (18초)
# ═════════════════════════════════════════════════════════════════════════════

on load:
    set {-bg::w::list::*} to "thunder", "dragon", "wind" and "phoenix"
    set {-bg::w::thunder::name} to "뇌정검"
    set {-bg::w::thunder::base} to "iron_sword"
    set {-bg::w::thunder::price} to 150
    set {-bg::w::thunder::cd} to 15
    set {-bg::w::thunder::col} to "light_purple"
    set {-bg::w::thunder::icon} to netherite sword
    set {-bg::w::thunder::desc} to "우클릭 뇌정일섬: 낙뢰 (반경 3.5, 3하트) · 15초"
    set {-bg::w::dragon::name} to "청룡언월도"
    set {-bg::w::dragon::base} to "iron_axe"
    set {-bg::w::dragon::price} to 130
    set {-bg::w::dragon::cd} to 12
    set {-bg::w::dragon::col} to "dark_aqua"
    set {-bg::w::dragon::icon} to netherite axe
    set {-bg::w::dragon::desc} to "우클릭 반월참: 앞 120° 베기 (3하트, 밀쳐냄) · 12초"
    set {-bg::w::wind::name} to "풍혼선"
    set {-bg::w::wind::base} to "stone_sword"
    set {-bg::w::wind::price} to 90
    set {-bg::w::wind::cd} to 8
    set {-bg::w::wind::col} to "aqua"
    set {-bg::w::wind::icon} to iron sword
    set {-bg::w::wind::desc} to "우클릭 질풍보: 질주 + 신속 II · 8초"
    set {-bg::w::phoenix::name} to "방천화극"
    set {-bg::w::phoenix::base} to "iron_sword"
    set {-bg::w::phoenix::price} to 120
    set {-bg::w::phoenix::cd} to 18
    set {-bg::w::phoenix::col} to "gold"
    set {-bg::w::phoenix::icon} to diamond sword
    set {-bg::w::phoenix::desc} to "우클릭 금강결계: 저항 II · 아군 흡수 · 적 밀쳐냄 · 18초"

# ─────────────────────────────────────────────────────────── 코인
function bgCoin(p: player, n: number, why: text):
    add {_n} to {bg::coin::%uuid of {_p}%}
    send action bar "&6+%{_n}% 코인 &7(%{_why}%) &f· 보유 &e%{bg::coin::%uuid of {_p}%}%" to {_p}

function bgCoinTeam(t: text, n: number, why: text):
    loop all players:
        if bgTeam(loop-player) is {_t}:
            bgCoin(loop-player, {_n}, {_why})

every 10 seconds:
    {-bg::on} is true
    loop all players:
        if bgIsFighter(loop-player) is true:
            set {_n} to 1
            loop {-bg::pts::*}:
                if {-bg::own::%loop-value-2%} is bgTeam(loop-player):
                    add 1 to {_n}
            add {_n} to {bg::coin::%uuid of loop-player%}

on death of player:
    {-bg::on} is true
    attacker is a player
    bgTeam(attacker) is not bgTeam(victim)
    bgTeam(attacker) is not "none"
    bgCoin(attacker, 10, "처치")

# ─────────────────────────────────────────────────────────── 장비 · 소모품 (상점 2~3줄)
on load:
    set {-bg::gear::list::*} to "iron", "diamond", "sword", "arrows", "gapple" and "heal"
    set {-bg::gear::iron::name} to "철 갑옷 (흉갑·각반·장화)"
    set {-bg::gear::iron::desc} to "죽어도 유지됩니다"
    set {-bg::gear::iron::price} to 40
    set {-bg::gear::iron::icon} to iron chestplate
    set {-bg::gear::iron::slot} to 10
    set {-bg::gear::diamond::name} to "다이아몬드 흉갑"
    set {-bg::gear::diamond::desc} to "죽어도 유지됩니다"
    set {-bg::gear::diamond::price} to 80
    set {-bg::gear::diamond::icon} to diamond chestplate
    set {-bg::gear::diamond::slot} to 11
    set {-bg::gear::sword::name} to "철 검"
    set {-bg::gear::sword::desc} to "죽어도 유지됩니다"
    set {-bg::gear::sword::price} to 25
    set {-bg::gear::sword::icon} to iron sword
    set {-bg::gear::sword::slot} to 12
    set {-bg::gear::arrows::name} to "화살 32개"
    set {-bg::gear::arrows::desc} to "소모품"
    set {-bg::gear::arrows::price} to 8
    set {-bg::gear::arrows::icon} to arrow
    set {-bg::gear::arrows::slot} to 14
    set {-bg::gear::gapple::name} to "황금 사과"
    set {-bg::gear::gapple::desc} to "소모품"
    set {-bg::gear::gapple::price} to 15
    set {-bg::gear::gapple::icon} to golden apple
    set {-bg::gear::gapple::slot} to 15
    set {-bg::gear::heal::name} to "치유의 투척 물약 II"
    set {-bg::gear::heal::desc} to "소모품"
    set {-bg::gear::heal::price} to 12
    set {-bg::gear::heal::icon} to splash potion
    set {-bg::gear::heal::slot} to 16
    loop {-bg::gear::list::*}:
        set {-bg::gearslot::%{-bg::gear::%loop-value%::slot}%} to loop-value

function bgGiveGear(p: player, g: text):
    set {_n} to name of {_p}
    if {_g} is "iron":
        set {bg::owned::%uuid of {_p}%::iron} to true
        bgCmd("item replace entity %{_n}% armor.chest with iron_chestplate[unbreakable={}]")
        bgCmd("item replace entity %{_n}% armor.legs with iron_leggings[unbreakable={}]")
        bgCmd("item replace entity %{_n}% armor.feet with iron_boots[unbreakable={}]")
    else if {_g} is "diamond":
        set {bg::owned::%uuid of {_p}%::diamond} to true
        bgCmd("item replace entity %{_n}% armor.chest with diamond_chestplate[unbreakable={}]")
    else if {_g} is "sword":
        set {bg::owned::%uuid of {_p}%::sword} to true
        bgCmd("give %{_n}% iron_sword[unbreakable={}]")
    else if {_g} is "arrows":
        bgCmd("give %{_n}% arrow 32")
    else if {_g} is "gapple":
        bgCmd("give %{_n}% golden_apple 1")
    else:
        bgCmd("give %{_n}% splash_potion[potion_contents={potion:""minecraft:strong_healing""}] 1")

# 부활 때 산 장비·전설 무기를 다시 준다 (bgKit 끝에서 호출)
function bgShopRestore(p: player):
    set {_u} to uuid of {_p}
    if {bg::owned::%{_u}%::iron} is true:
        bgGiveGear({_p}, "iron")
    if {bg::owned::%{_u}%::diamond} is true:
        bgGiveGear({_p}, "diamond")
    if {bg::owned::%{_u}%::sword} is true:
        bgGiveGear({_p}, "sword")
    loop {-bg::w::list::*}:
        if {bg::owned::%{_u}%::%loop-value%} is true:
            bgGiveWeapon({_p}, loop-value)

command /코인:
    trigger:
        send "&6[코인] &f보유 &e%{bg::coin::%uuid of player%} ? 0% 코인 &7— 10초마다 +1 · 처치 +10 · 점령 +15 · 점령 지점당 10초마다 +1 · 보스 +40"

# ─────────────────────────────────────────────────────────── 상점
command /상점:
    aliases: /shop
    trigger:
        if {-bg::on} is true:
            if bgTeam(player) is not "none":
                if bgDist2(location of player, bgMk("base_%bgTeam(player)%")) > 24:
                    send "&6[상점] &f상점은 &e자기 본진&f에서만 열 수 있습니다."
                    stop
        set {_c} to {bg::coin::%uuid of player%} ? 0
        set {_gui} to chest inventory with 3 rows named "&6&l천하 병기고 &8| &e%{_c}% 코인"
        set {_i} to 1
        loop {-bg::w::list::*}:
            set {_w} to loop-value
            set {_it} to {-bg::w::%{_w}%::icon}
            set name of {_it} to "&6&l%{-bg::w::%{_w}%::name}% &7(전설)"
            set lore of {_it} to "&7%{-bg::w::%{_w}%::desc}%", "" and "&e가격: %{-bg::w::%{_w}%::price}% 코인"
            set slot {_i} of {_gui} to {_it}
            add 2 to {_i}
        loop {-bg::gear::list::*}:
            set {_g} to loop-value
            set {_it} to {-bg::gear::%{_g}%::icon}
            set name of {_it} to "&f&l%{-bg::gear::%{_g}%::name}%"
            set lore of {_it} to "&7%{-bg::gear::%{_g}%::desc}%", "" and "&e가격: %{-bg::gear::%{_g}%::price}% 코인"
            set slot {-bg::gear::%{_g}%::slot} of {_gui} to {_it}
        set {-bg::shop::%uuid of player%} to true
        open {_gui} to player
        play sound "block.chest.open" to player

on inventory close:
    delete {-bg::shop::%uuid of player%}

on inventory click:
    {-bg::shop::%uuid of player%} is true
    cancel event
    set {_s} to index of event-slot
    if {-bg::gearslot::%{_s}%} is set:
        set {_g} to {-bg::gearslot::%{_s}%}
        set {_price} to {-bg::gear::%{_g}%::price}
        if ({bg::coin::%uuid of player%} ? 0) < {_price}:
            send "&6[상점] &c코인이 부족합니다. &7(필요 %{_price}%, 보유 %{bg::coin::%uuid of player%} ? 0%)" to player
            play sound "entity.villager.no" to player
            stop
        remove {_price} from {bg::coin::%uuid of player%}
        bgGiveGear(player, {_g})
        send "&6[상점] &f%{-bg::gear::%{_g}%::name}% 구매 &7(남은 코인 %{bg::coin::%uuid of player%}%)" to player
        play sound "entity.experience_orb.pickup" to player
        stop
    if {_s} is not 1, 3, 5 or 7:
        stop
    set {_w} to {-bg::w::list::%({_s} + 1) / 2%}
    set {_price} to {-bg::w::%{_w}%::price}
    if ({bg::coin::%uuid of player%} ? 0) < {_price}:
        send "&6[상점] &c코인이 부족합니다. &7(필요 %{_price}%, 보유 %{bg::coin::%uuid of player%} ? 0%)" to player
        play sound "entity.villager.no" to player
        stop
    set {bg::owned::%uuid of player%::%{_w}%} to true
    remove {_price} from {bg::coin::%uuid of player%}
    bgGiveWeapon(player, {_w})
    close player's inventory
    send title "&6&l%{-bg::w::%{_w}%::name}%" with subtitle "&f획득! 우클릭으로 전용 스킬" to player for 50 ticks
    play sound "ui.toast.challenge_complete" to player
    bgWfx(location of player, "wfx_barrier", 5, 30, 0)

function bgGiveWeapon(p: player, w: text):
    set {_nm} to {-bg::w::%{_w}%::name}
    bgCmd("give %name of {_p}% %{-bg::w::%{_w}%::base}%[item_model=""bg:weapon/%{_w}%"",custom_name={text:""%{_nm}%"",color:""%{-bg::w::%{_w}%::col}%"",bold:true,italic:false},lore=[{text:""%{-bg::w::%{_w}%::desc}%"",color:""gray"",italic:false}],custom_data={bgw:""%{_w}%""},unbreakable={},rarity:""epic""]")

# ─────────────────────────────────────────────────────────── 바닥 효과
function bgWfx(l: location, m: text, d: number, t: number, yaw: number):
    set {_id} to bgTid()
    bgCmd("function bg:tele/decal {x:%bgN(x-coordinate of {_l})%,y:%bgN(y-coordinate of {_l})%,z:%bgN(z-coordinate of {_l})%,m:%{_m}%,d:%bgN({_d})%,t:%{_t}%,yaw:%bgN({_yaw})%,id:%{_id}%}")

function bgWRune(l: location, m: text, d: number, t: number):
    set {_id} to bgTid()
    bgCmd("function bg:tele/rune {x:%bgN(x-coordinate of {_l})%,y:%bgN(y-coordinate of {_l})%,z:%bgN(z-coordinate of {_l})%,m:%{_m}%,d:%bgN({_d})%,t:%{_t}%,id:%{_id}%}")

# 적 판정: 다른 팀 전투 참가자
function bgEnemies(p: player, c: location, r: number) :: players:
    loop all players:
        if bgIsFighter(loop-player) is true:
            if bgTeam(loop-player) is not bgTeam({_p}):
                if world of loop-player is world of {_c}:
                    if distance between loop-player and {_c} <= {_r}:
                        add loop-player to {_out::*}
    return {_out::*}

# ─────────────────────────────────────────────────────────── 전용 스킬 (우클릭)
on right click:
    set {_nm} to uncolored name of player's tool
    {_nm} is set
    loop {-bg::w::list::*}:
        if {_nm} contains {-bg::w::%loop-value%::name}:
            set {_w} to loop-value
    {_w} is set
    cancel event
    set {_k} to "%uuid of player%::%{_w}%"
    if {-bg::wcd::%{_k}%} is set:
        set {_left} to {-bg::w::%{_w}%::cd} - (difference between {-bg::wcd::%{_k}%} and now) / 1 second
        if {_left} > 0:
            send action bar "&7%{-bg::w::%{_w}%::name}% &f재사용 대기 &e%ceil({_left})%초" to player
            stop
    set {-bg::wcd::%{_k}%} to now
    if {_w} is "thunder":
        bgSkThunder(player)
    else if {_w} is "dragon":
        bgSkDragon(player)
    else if {_w} is "wind":
        bgSkWind(player)
    else:
        bgSkPhoenix(player)

function bgSkThunder(p: player):
    set {_b} to target block of {_p}
    if {_b} is set:
        set {_l} to location of {_b}
        add 1 to y-coordinate of {_l}
    else:
        set {_l} to location of {_p}
    if distance between {_p} and {_l} > 24:
        set {_l} to location of {_p}
    bgWfx({_l}, "wfx_thunder", 8, 14, random number between 0 and 360)
    bgParticle({_l}, "electric_spark", 1.5, 2, 1.5, 0.3, 60)
    bgSoundAt({_l}, "item.trident.thunder", 2, 1.3)
    wait 10 ticks
    strike lightning effect at {_l}
    bgWRune({_l}, "wfx_thunder", 5, 20)
    set {_es::*} to bgEnemies({_p}, {_l}, 3.5)
    loop {_es::*}:
        damage loop-value by 3
        ignite loop-value for 1 second
        bgParticle(location of loop-value, "electric_spark", 0.4, 1, 0.4, 0.2, 20)

# 반월참: 앞쪽 120° 반경 5.5 — 초승달 붓획이 앞을 가른다
function bgSkDragon(p: player):
    set {_l} to location of {_p}
    set {_yaw} to yaw of {_p}
    set {_fx} to -1 * sin({_yaw})
    set {_fz} to cos({_yaw})
    set {_c} to location((x-coordinate of {_l}) + {_fx} * 1.5, y-coordinate of {_l}, (z-coordinate of {_l}) + {_fz} * 1.5, world of {_l})
    bgWfx({_c}, "wfx_crescent", 10, 18, {_yaw})
    bgSoundAt({_l}, "entity.player.attack.sweep", 2, 0.6)
    bgSoundAt({_l}, "entity.ender_dragon.flap", 1.5, 1.3)
    loop 5 times:
        set {_a} to {_yaw} - 60 + (loop-number - 1) * 30
        set {_q} to location((x-coordinate of {_l}) - sin({_a}) * 3.5, (y-coordinate of {_l}) + 1, (z-coordinate of {_l}) + cos({_a}) * 3.5, world of {_l})
        bgParticle({_q}, "sweep_attack", 0.3, 0.2, 0.3, 0, 1)
    set {_es::*} to bgEnemies({_p}, {_l}, 5.5)
    loop {_es::*}:
        set {_dx} to (x-coordinate of loop-value) - (x-coordinate of {_l})
        set {_dz} to (z-coordinate of loop-value) - (z-coordinate of {_l})
        set {_d} to max(0.4, sqrt({_dx} * {_dx} + {_dz} * {_dz}))
        if ({_dx} * {_fx} + {_dz} * {_fz}) / {_d} >= 0.5:
            damage loop-value by 3
            set velocity of loop-value to vector({_dx} / {_d} * 1.1, 0.4, {_dz} / {_d} * 1.1)
            bgParticle(location of loop-value, "crit", 0.3, 0.8, 0.3, 0.2, 12)

function bgSkWind(p: player):
    set {_l} to location of {_p}
    bgWfx({_l}, "wfx_wind", 5, 20, yaw of {_p})
    set {_v} to vector(-1 * sin(yaw of {_p}) * cos(pitch of {_p}) * 1.8, 0.25, cos(yaw of {_p}) * cos(pitch of {_p}) * 1.8)
    set velocity of {_p} to {_v}
    bgCmd("effect give %name of {_p}% speed 3 1 true")
    bgSoundAt({_l}, "entity.breeze.wind_burst", 1.5, 1.2)
    loop 4 times:
        bgParticle(location of {_p}, "cloud", 0.3, 0.2, 0.3, 0.02, 8)
        wait 2 ticks
    bgWfx(location of {_p}, "wfx_wind", 4, 16, yaw of {_p})

function bgSkPhoenix(p: player):
    set {_l} to location of {_p}
    bgWRune({_l}, "wfx_barrier", 9, 40)
    bgWfx({_l}, "wfx_barrier", 12, 24, 0)
    bgSoundAt({_l}, "item.shield.block", 2, 0.7)
    bgSoundAt({_l}, "block.beacon.power_select", 1.5, 1.4)
    bgParticle({_l}, "wax_on", 3, 1, 3, 0.1, 40)
    bgCmd("effect give %name of {_p}% resistance 4 1 true")
    loop all players:
        if bgTeam(loop-player) is bgTeam({_p}):
            if distance between loop-player and {_l} <= 6:
                bgCmd("effect give %name of loop-player% absorption 8 0 true")
    set {_es::*} to bgEnemies({_p}, {_l}, 4)
    loop {_es::*}:
        set {_dx} to (x-coordinate of loop-value) - (x-coordinate of {_l})
        set {_dz} to (z-coordinate of loop-value) - (z-coordinate of {_l})
        set {_d} to max(0.5, sqrt({_dx} * {_dx} + {_dz} * {_dz}))
        set velocity of loop-value to vector({_dx} / {_d} * 1.3, 0.45, {_dz} / {_d} * 1.3)
