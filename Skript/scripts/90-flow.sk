# =====================================================================================
#  신들의 전쟁: 올림포스  /  90-flow.sk  -  게임 시작 절차 · 시대 연출 · 접속 · 관리자 명령
# -------------------------------------------------------------------------------------
#  의존: 00~14 (맨 위 층. 모든 모듈의 초기화 함수를 여기서 부른다)
#
#  /oly start  한 번이면:
#    1) 로비에서 고른 세력을 기억 → 게임 데이터 초기화 → 모든 모듈 초기화
#    2) 월드 규칙 (자연 몬스터·불 번짐·몹 그리핑 끔, 위치 표시줄 끔 …)
#    3) 올림포스 봉인 닫기, 보스 일정(시간이 지나야 깨어남), 사건 일정
#    4) 세력 없는 사람은 자동 배정 → 수도로 이동 · 모험 모드 · 병종 장비
#    5) 평화의 시대 시작
#  시대가 바뀌면: 신들의 전쟁 시대에 올림포스 봉인이 풀린다.
#                 그 전에는 올림포스 신전 영토에 들어가면 산문 앞으로 되돌려 보낸다.
# =====================================================================================

on load:
    olyModReady("admin")

function olyWorldRules():
    loop "spawn_monsters false", "spawn_patrols false", "spawn_phantoms false", "spawn_wandering_traders false", "raids false", "mob_griefing false", "fire_spread_radius_around_player 0", "tnt_explodes false", "projectiles_can_break_blocks false", "show_advancement_messages false", "immediate_respawn true", "locator_bar false" and "keep_inventory false":
        olyCmd("gamerule %loop-value%")
    olyCmd("time set 1000")
    olyCmd("weather clear")
    olyCmd("difficulty normal")
# ── 올림포스 산문 봉인 (true = 닫힘)
function olySeal(closed: boolean):
    set {_a} to {oly::map::olympus::seal::a}
    set {_b} to {oly::map::olympus::seal::b}
    if {_a} is not set:
        stop
    if {_closed} is true:
        set blocks within {_a} and {_b} to light blue stained glass
    else:
        set blocks within {_a} and {_b} to air
        olyCmd("particle minecraft:end_rod %x-coordinate of {_a}% %y-coordinate of {_a}% %z-coordinate of {_a}% 2 3 0.3 0.05 200 force")
function olyGameStart():
    # 1. 로비에서 고른 세력 기억
    loop all players:
        set {_keep::%uuid of loop-player%} to olyFacOf(loop-player)
    set {oly::state::running} to false
    olyWipeGame()
    olyFacInit()
    loop {oly::flist::*}:
        delete {oly::f::%loop-value%::leader}
    olyFacTeamSetup()
    olyEcoReset()
    olyTerrReset()
    olyCityReset()
    olyMoraleReset()
    olyHeroReset()
    olyGodReset()
    olyWarReset()
    olyDipReset()
    olyWorldRules()
    olySeal(true)
    # 2. 시계 시작 (런타임 정리 포함) → 보스·사건 일정은 0초 기준
    olyStart()
    olyBossReset()
    olyEvReset()
    # 3. 배정
    loop all players:
        if loop-player's gamemode is not spectator:
            set {_f} to {_keep::%uuid of loop-player%} ? "none"
            if {_f} is "none":
                set {_f} to olyFacSmallest()
            olyFacJoin(loop-player, {_f}, true)
    loop {oly::flist::*}:
        if {oly::f::%loop-value%::leader} is not set:
            olyFacAutoLeader(loop-value)
    olyUiInit()
    loop all players:
        if loop-player's gamemode is not spectator:
            olyCmd("effect clear %loop-player%")
            set loop-player's food level to 20
            olyPlayerSetup(loop-player)
            set {_f} to olyFacOf(loop-player)
            send "&8&m                                                  " to loop-player
            send "  &6&l신들의 전쟁: 올림포스" to loop-player
            send "  &7당신은 %olyFacFull({_f})% &7소속입니다. 지휘관 &f%olyFacLeaderName({_f})%" to loop-player
            send "  &e9번 칸 네더의 별&7(올림포스 메뉴)을 우클릭하면 모든 것을 할 수 있습니다." to loop-player
            send "  &7'@' 로 시작하는 채팅은 세력 채팅입니다." to loop-player
            send "&8&m                                                  " to loop-player
    olyLog("게임 시작 - 접속 %number of all players%명")

# ── 시대 전환 훅
function olyOnPhase(ph: text):
    if {_ph} is "war":
        olySeal(false)
        olyOracle("올림포스의 봉인이 풀렸습니다", "산문이 열렸습니다. 올림포스 신전을 차지한 세력만이 제우스를 부를 수 있습니다.")
        stop
    if {_ph} is "end":
        # 남은 보스 모델 정리
        olyBossReset()
        stop
    olySeal(true)

every second:
    set {_ph} to olyPhase()
    if {oly::rt::flow::phase} is not {_ph}:
        set {oly::rt::flow::phase} to {_ph}
        olyOnPhase({_ph})
    if olyLive() is not true:
        stop
    if {_ph} is "war":
        stop
    # 봉인 전 올림포스 출입 금지
    loop all players:
        if loop-player's gamemode is adventure or survival:
            if olyTerrOf(loop-player) is "olympus":
                teleport loop-player to {oly::map::tp::olympus_gate}
                send title "&e&l봉 인" with subtitle "&7올림포스는 신들의 전쟁 시대에 열립니다" to loop-player for 2 seconds
                play sound "block.beacon.deactivate" with volume 1 with pitch 1 at location of loop-player for loop-player

on join:
    wait 5 ticks
    if player is not online:
        stop
    set {_f} to olyFacOf(player)
    if olyLive() is not true:
        if player is not op:
            set gamemode of player to adventure
        if {oly::map::tp::altar} is set:
            teleport player to {oly::map::tp::altar}
        send "&7게임이 곧 시작됩니다. &e/세력 &7으로 미리 세력을 고를 수 있습니다."
        stop
    if {_f} is "none":
        set gamemode of player to adventure
        if {oly::map::tp::altar} is set:
            teleport player to {oly::map::tp::altar}
        clear player's inventory
        set slot 8 of player's inventory to nether star named "&6&l올림포스 메뉴 &7(우클릭)"
        send "&e게임이 진행 중입니다. 세력을 골라 합류하세요!"
        wait 2 seconds
        if player is online:
            olyMenuJoin(player)


# =====================================================================================
#  관리자 명령
# =====================================================================================

command /oly [<text>] [<text>] [<text>]:
    aliases: /olympus
    executable by: players
    trigger:
        if player is not op:
            send "&c관리자만 사용할 수 있습니다."
            stop
        if arg-1 is not set:
            olyHelp(player)
            stop
        set {_a} to arg-1

        if {_a} is "start":
            if olyLive() is true:
                if arg-2 is not "force":
                    send "&c이미 진행 중입니다. &7새로 시작하려면 &f/oly start force"
                    stop
            if size of {oly::tlist::*} is 0:
                send "&c맵 데이터가 없습니다. &7(/olymap reload)"
                stop
            olyGameStart()
            send "&a[올림포스] &7새 게임을 시작했습니다."
            stop

        if {_a} is "resume":
            if olyLive() is true:
                send "&c이미 진행 중입니다."
                stop
            if olyPhase() is "end":
                send "&c끝난 게임입니다. &7/oly start"
                stop
            set {oly::state::running} to true
            olyBarInit()
            olyBarStyle(olyPhase())
            olyBarUpdate()
            olyBc("&a[올림포스] &7게임이 재개되었습니다.")
            stop

        if {_a} is "stop":
            if olyLive() is not true:
                send "&c진행 중이 아닙니다."
                stop
            olyStop()
            stop

        if {_a} is "end":
            if olyLive() is not true:
                send "&c진행 중이 아닙니다."
                stop
            olyEnd("관리자 종료")
            stop

        if {_a} is "status":
            olyStatus(player)
            stop

        if {_a} is "phase":
            if arg-2 is not set:
                send "&7사용법 &f/oly phase <peace|wrath|war>"
                stop
            set {_p} to arg-2
            if {_p} is not "peace":
                if {_p} is not "wrath":
                    if {_p} is not "war":
                        send "&c peace / wrath / war 중 하나여야 합니다."
                        stop
            if olyLive() is not true:
                send "&c진행 중이 아닙니다. 먼저 /oly start"
                stop
            olyPhaseSet({_p})
            send "&a[올림포스] &7시대를 &f%olyPhaseName({_p})% &7로 변경했습니다."
            stop

        if {_a} is "time":
            set {_n} to arg-2 parsed as number
            if {_n} is not set:
                send "&7사용법 &f/oly time <초>"
                stop
            set {oly::state::left} to {_n}
            send "&a[올림포스] &7현재 시대 남은 시간을 &f%{_n}%초 &7로 설정했습니다."
            stop

        if {_a} is "cfg":
            if arg-2 is not set:
                send "&7사용법 &f/oly cfg <키> [값]"
                send "&7예시 &f/oly cfg phase.peace.sec 600"
                stop
            set {_k} to arg-2
            if arg-3 is not set:
                if {oly::cfg::%{_k}%} is not set:
                    send "&c그런 키가 없습니다: &f%{_k}%"
                    stop
                send "&7%{_k}% &8= &f%{oly::cfg::%{_k}%}%"
                stop
            set {_v} to arg-3 parsed as number
            if {_v} is set:
                olyCfgPut({_k}, {_v})
            else:
                olyCfgPut({_k}, arg-3)
            send "&a[올림포스] &7%{_k}% &8= &f%{oly::cfg::%{_k}%}% &8(리로드하면 기본값으로 돌아감)"
            stop

        if {_a} is "mods":
            send "&6[올림포스] 모듈 로드 상태"
            loop "config", "data", "game", "factions", "economy", "territory", "army", "city", "heroes", "gods", "bossdata", "monsters", "war", "diplomacy", "ui", "events" and "admin":
                if {oly::mod::%loop-value%} is true:
                    send "  &a[O] &7%loop-value%"
                else:
                    send "  &c[X] &7%loop-value% &8(로드 실패 - 콘솔 확인)"
            stop

        if {_a} is "log":
            send "&6[올림포스] 최근 기록"
            if size of {oly::log::*} is 0:
                send "  &8기록 없음"
                stop
            set {_n} to size of {oly::log::*}
            set {_i} to 0
            loop {oly::log::*}:
                add 1 to {_i}
                if {_i} > {_n} - 20:
                    send "  %loop-value%"
            stop

        # ── 테스트 · 진행 보조
        if {_a} is "boss":
            if arg-2 is not set:
                send "&7사용법 &f/oly boss <id> &8(nemean_lion chimera scylla medusa minotaur hydra cerberus)"
                set {_cur} to olyBossAny()
                if {_cur} is not "none":
                    send "  &c%olyBossName({_cur})% &7- 나와 있음"
                set {_nx} to ({oly::m::next} ? 0) - olySec()
                send "  &7다음 보스까지 &f%olyTime(max(0, {_nx}))% &8(앞 보스가 쓰러져야 시작)"
                set {_q} to ""
                loop {oly::m::queue::*}:
                    set {_q} to "%{_q}%%olyBossName(loop-value)% "
                send "  &7남은 순서 &f%{_q}%"
                stop
            if olyBossList() does not contain arg-2:
                send "&c그런 보스가 없습니다."
                stop
            if olyBossAlive(arg-2) is true:
                send "&c이미 깨어 있습니다."
                stop
            olyBossSpawn(arg-2)
            stop

        if {_a} is "event":
            if olyEvList() does not contain arg-2:
                send "&7사용법 &f/oly event <harvest|drought|plague|zeus|blessing|raid|pirates|temple|herosale|relic>"
                stop
            olyEvRun(arg-2)
            if {oly::ev::lastloc} is set:
                set {_l} to {oly::ev::lastloc}
                send "&7위치: &f%rounded x-coordinate of {_l}% %rounded y-coordinate of {_l}% %rounded z-coordinate of {_l}%"
            stop

        if {_a} is "join":
            set {_t} to arg-2 parsed as player
            set {_f} to olyFacParse(arg-3)
            if {_t} is not set:
                send "&7사용법 &f/oly join <플레이어> <세력>"
                stop
            if {_f} is "none":
                send "&c그런 세력이 없습니다."
                stop
            olyFacJoin({_t}, {_f}, true)
            olyPlayerSetup({_t})
            send "&a%{_t}% → %olyFacFull({_f})%"
            stop

        if {_a} is "leader":
            set {_f} to olyFacParse(arg-2)
            set {_t} to arg-3 parsed as player
            if {_f} is "none":
                send "&7사용법 &f/oly leader <세력> <플레이어>"
                stop
            if {_t} is not set:
                send "&7사용법 &f/oly leader <세력> <플레이어>"
                stop
            olyFacSetLeader({_f}, "%uuid of {_t}%")
            olyFacBc({_f}, "&6[세력] &f%{_t}%&6이(가) 지휘관으로 임명되었습니다.")
            stop

        if {_a} is "res":
            set {_f} to olyFacParse(arg-2)
            if arg-3 is set:
                set {_y::*} to arg-3 split at ":"
                set {_n} to {_y::2} parsed as number
            if {_f} is "none":
                send "&7사용법 &f/oly res <세력> <자원>:<양> &8(예: /oly res 아테네 gold:500)"
                stop
            if {_n} is not set:
                send "&7사용법 &f/oly res <세력> <자원>:<양> &8(예: /oly res 아테네 gold:500)"
                stop
            olyResAdd({_f}, {_y::1}, {_n})
            send "&a%olyFacName({_f})% %{_y::1}% +%{_n}% → %olyRes({_f}, {_y::1})%"
            stop

        if {_a} is "renown":
            set {_f} to olyFacParse(arg-2)
            set {_n} to arg-3 parsed as number
            if {_f} is "none":
                send "&7사용법 &f/oly renown <세력> <양>"
                stop
            if {_n} is not set:
                send "&7사용법 &f/oly renown <세력> <양>"
                stop
            olyRenownAdd({_f}, {_n}, "관리자")
            stop

        if {_a} is "war":
            set {_f} to olyFacParse(arg-2)
            set {_t} to olyFacParse(arg-3)
            if {_f} is "none":
                send "&7사용법 &f/oly war <세력> <세력> &8(준비 없이 즉시 전쟁)"
                stop
            if {_t} is "none":
                send "&7사용법 &f/oly war <세력> <세력>"
                stop
            olyWarBegin({_f}, {_t})
            stop

        if {_a} is "reset":
            if arg-2 is not "confirm":
                send "&c[경고] &7게임 데이터(세력 자원·명성·소속·외교)를 전부 지웁니다."
                send "&7맵 설정(영토·도시)은 유지됩니다. 실행하려면 &f/oly reset confirm"
                stop
            olyBossReset()
            olyWipeGame()
            olyBarOff()
            olyUiOff()
            send "&a[올림포스] &7게임 데이터를 초기화했습니다."
            stop

        if {_a} is "wipemap":
            if arg-2 is not "confirm":
                send "&4[위험] &7영토·도시·청크 인덱스까지 전부 지웁니다. 맵을 새로 깔 때만 쓰세요."
                send "&7실행하려면 &f/oly wipemap confirm"
                stop
            olyWipeAll()
            send "&a[올림포스] &7맵 데이터까지 전부 초기화했습니다."
            stop

        olyHelp(player)
